#!/usr/bin/env bash
# git-worktree-stub -- Test stub for git worktree list and for-each-ref.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

# Answers `git -C <path> rev-parse --path-format=absolute --git-dir` the way git
# does: an admin directory for a path that is a worktree, and a failure for one
# that is not. The mapping is /admin/<basename> so a testcase can name an
# identity without knowing a real repository layout.
#
# Only paths listed in STUB_GIT_WORKTREE_PORCELAIN resolve, which is what lets a
# testcase choose between exercising the identity and exercising the path and
# branch fallback.
function rev_parse() {
  local worktree="${1}"
  local line

  while IFS= read -r line; do
    [[ "${line}" == "worktree ${worktree}" ]] || continue
    printf '/admin/%s\n' "${worktree##*/}"
    return 0
  done <<< "${STUB_GIT_WORKTREE_PORCELAIN:-}"

  return 128
}

function main() {
  # The exact invocation, so a change to the flags is a stub failure rather
  # than something a looser match would absorb while the tests kept passing.
  if [[ $# -eq 5 && "${1}" == "-C" && "${3}" == "rev-parse" && "${4}" == "--path-format=absolute" && "${5}" == "--git-dir" ]]; then
    rev_parse "${2}"
    return
  fi

  if [[ "${3:-}" == "rev-parse" ]]; then
    die "expected git -C <path> rev-parse --path-format=absolute --git-dir invocation"
  fi

  # `git for-each-ref --format=... refs/heads/`, used to find an existing
  # branch for an issue number. One branch name per line in STUB_GIT_BRANCHES.
  if [[ $# -eq 3 && "${1}" == "for-each-ref" && "${2}" == --format=* && "${3}" == "refs/heads/" ]]; then
    if [[ -n "${STUB_GIT_BRANCHES:-}" ]]; then
      printf '%s\n' "${STUB_GIT_BRANCHES}"
    fi
    return 0
  fi

  # `git check-ref-format --branch <name>`, used to reject a generated name
  # that git would not accept. Delegated to the real git so the stub cannot
  # disagree with it; STUB_GIT_INVALID_REF=1 forces a rejection instead.
  if [[ $# -eq 3 && "${1}" == "check-ref-format" && "${2}" == "--branch" ]]; then
    if [[ "${STUB_GIT_INVALID_REF:-}" == "1" ]]; then
      return 1
    fi
    /usr/bin/git check-ref-format --branch "${3}" > /dev/null 2>&1
    return $?
  fi

  if [[ $# -lt 3 || "${1}" != "worktree" || "${2}" != "list" || "${3}" != "--porcelain" ]]; then
    die "expected git worktree list --porcelain, for-each-ref, or check-ref-format invocation"
  fi

  # STUB_GIT_WORKTREE_PORCELAIN is written in the readable newline form. Under
  # -z git terminates each field with a NUL instead of a newline, and separates
  # records with an extra one, which is exactly what translating every newline
  # gives for a fixture that already separates records with a blank line.
  if [[ $# -eq 4 && "${4}" == "-z" ]]; then
    printf '%s' "${STUB_GIT_WORKTREE_PORCELAIN:-}" | tr '\n' '\0'
    return 0
  fi

  if [[ $# -eq 3 ]]; then
    printf '%s' "${STUB_GIT_WORKTREE_PORCELAIN:-}"
    return 0
  fi

  die "expected git worktree list --porcelain, for-each-ref, or check-ref-format invocation"
}

main "$@"
