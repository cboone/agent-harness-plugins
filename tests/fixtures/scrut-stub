#!/usr/bin/env bash
# scrut-stub -- Test stub for the scrut process bin/run-scrut-documents starts.
#
# Tests copy it into a directory named `scrut` on PATH. It takes the document
# from its last argument and acts on the document's name:
#   *kill*  SIGKILLs its parent worker, so xargs stops starting documents
#   *slow*  appends its own PID to STUB_SCRUT_PIDS, then sleeps for 30 seconds,
#           so a test can signal the runner while documents are in flight
#   *missing*, *unrecognized*, *duplicate*, *inconsistent* print invalid summaries
#   *error* prints stderr and exits 7
#   *signals* prints ignored INT/QUIT traps, then a marker and a passing summary
#   other   prints "ran DOCUMENT" and a passing summary
set -euo pipefail

function main() {
  local document="${*: -1}"

  case "${document}" in
    *signals*)
      trap -p INT QUIT
      printf 'signal probe ran\n'
      printf 'Result: 1 document(s) with 1 testcase(s): 1 succeeded, 0 failed and 0 skipped\n'
      ;;
    *kill*)
      kill -KILL "${PPID}"
      ;;
    *slow*)
      printf '%s\n' "$$" >> "${STUB_SCRUT_PIDS:?STUB_SCRUT_PIDS must be set}"
      sleep 30 &
      local child=$!
      if [[ -n "${STUB_SCRUT_CHILD_PIDS:-}" ]]; then
        printf 'stub diagnostics before waiting\n' >&2
        printf '%s\n' "${child}" > "${STUB_SCRUT_CHILD_PIDS}"
      fi
      wait "${child}"
      ;;
    *duplicate*)
      printf 'Result: 1 document(s) with 1 testcase(s): 1 succeeded, 0 failed and 0 skipped\n'
      printf 'Result: surprise\n'
      ;;
    *inconsistent*) printf 'Result: 1 document(s) with 2 testcase(s): 1 succeeded, 0 failed and 0 skipped\n' ;;
    *error*)
      printf 'stub tool error\n' >&2
      exit 7
      ;;
    *missing*) printf 'stub stderr\n' >&2 ;;
    *unrecognized*) printf 'Result: surprise\nstub stderr\n' >&2 ;;
    *)
      printf 'ran %s\n' "${document}"
      printf 'Result: 1 document(s) with 1 testcase(s): 1 succeeded, 0 failed and 0 skipped\n'
      ;;
  esac
}

main "$@"
