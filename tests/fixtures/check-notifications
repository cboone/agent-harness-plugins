#!/usr/bin/env bash
# check-notifications -- Exercise notifications without sending macOS alerts.
# Generated stubs expand these variables when executed, not when written.
# shellcheck disable=SC2016
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "${REPO_ROOT:?REPO_ROOT is required}/bin/lib/git-environment.bash"

# shellcheck source=bin/lib/capture-child.bash
source "${REPO_ROOT}/bin/lib/capture-child.bash"

# Transcript helpers append one Claude Code record to the file in $1.
# Appends a prompt, with the extra fields in optional JSON $2.
function transcript_prompt() {
  jq -nc --argjson extra "${2:-"{}"}" '{type: "user", message: {content: "Sample prompt"}} + $extra' >> "${1}"
}

# Appends a tool_use with id $2, name $3 and JSON input $4.
function transcript_tool_use() {
  jq -nc --arg id "${2}" --arg name "${3}" --argjson input "${4}" \
    '{type: "assistant", message: {content: [{type: "tool_use", id: $id, name: $name, input: $input}]}}' >> "${1}"
}

# Appends the tool_result answering tool_use id $2, with the extra fields in
# optional JSON $3.
function transcript_result() {
  jq -nc --arg id "${2}" --argjson extra "${3:-"{}"}" \
    '{type: "user", message: {content: [{type: "tool_result", tool_use_id: $id, content: "ok"}]}} + $extra' >> "${1}"
}

# Appends assistant text $2.
function transcript_text() {
  jq -nc --arg text "${2}" '{type: "assistant", message: {content: [{type: "text", text: $text}]}}' >> "${1}"
}

# Appends a turn whose prompt and tool result share promptId $2, with the extra
# fields in JSON $3 on the prompt.
function transcript_turn() {
  # Sample promptIds are plain tokens, so they need no JSON escaping.
  local id_field="{\"promptId\":\"${2}\"}"
  transcript_prompt "${1}" "$(jq -nc --argjson id "${id_field}" --argjson extra "${3}" '$id + $extra')"
  transcript_tool_use "${1}" "tool-${2}" Bash '{"command":"make"}'
  transcript_result "${1}" "tool-${2}" "${id_field}"
  transcript_text "${1}" "Completed sample"
}

# Writes to $1 a Codex transcript whose session source is JSON $2.
function codex_transcript() {
  jq -nc --argjson source "${2}" '{type: "session_meta", payload: {source: $source}}' > "${1}"
}

# Writes to $1 a turn whose pending tool use is $2 with input $3.
function write_transcript() {
  transcript_prompt "${1}"
  transcript_tool_use "${1}" tool-1 "${2}" "${3}"
}

# Retries the command in $2... every 0.02 seconds, up to $1 times, until it succeeds.
function poll() {
  local tries="${1}"
  shift
  until "$@"; do
    [[ "${tries}" -gt 0 ]] || return 1
    tries=$((tries - 1))
    sleep 0.02
  done
}

function alert_count_is() {
  [[ "$(wc -l < "${NOTIFY_TEST_LOG}" | tr -d ' ')" == "${1}" ]]
}

function not_running() {
  ! kill -0 "${1}" 2> /dev/null # error-output-allow: process existence predicate verifies fixture shutdown
}

# Sets HELD_PID to the held alerter stub's PID; fails if none.
function find_held_pid() {
  HELD_PID="$(pgrep -f -- "${NOTIFY_TEST_STUB} --title" | head -n 1)" || true
  [[ -n "${HELD_PID}" ]]
}

# Polls for up to 3 seconds until the alerter stub has logged $1 calls.
function wait_for_alerts() {
  poll 150 alert_count_is "${1}" || true
}

# Tier scenarios run the notifier under /bin/bash, which is bash 3.2 on macOS.

function write_tiers() {
  mkdir -p "${XDG_CONFIG_HOME}/agent-harness-notify"
  printf '%s\n' "$@" > "${XDG_CONFIG_HOME}/agent-harness-notify/tiers"
}

function explain() {
  /bin/bash "${NOTIFY_BIN:?}" explain "$@"
}

# Runs notify event $2 with JSON payload $3; the alerter stub logs label $1.
# The notifier runs through TIER_NOTIFY, a path under the scenario's directory,
# so its detached processes carry that path on their command lines.
function tier_event() {
  printf '%s' "${3}" | NOTIFY_TEST_EVENT="${1}" /bin/bash "${TIER_NOTIFY:?}" "${2}"
}

# Runs Stop event $2 labeled $1 for transcript $3, as session $1.
function tier_stop() {
  tier_event "${1}" "${2}" "$(jq -nc --arg id "${1}" --arg path "${3}" \
    '{session_id: $id, transcript_path: $path, last_assistant_message: "Completed sample"}')"
}

function contract_event() {
  tier_event "${1}" cc-failure "${2}"
  printf '%s' "${2}" | /bin/bash "${3}" hook StopFailure
  printf '%s-log: %s\n' "${1}" "$(tail -n 1 "${ATTENTION_LOG_DIR}/events.jsonl" | jq -r '.event')"
}

function no_detached_notifier() {
  ! pgrep -f -- "${TIER_NOTIFY}" > /dev/null
}

# Prints each label's alert as "label: title | subtitle | sound", or
# "label: none", once every detached notifier has finished.
function print_alerts() {
  local label line
  poll 300 no_detached_notifier || return 1
  for label in "$@"; do
    line="$(jq -r --arg label "${label}" '
      index("--test-event") as $i
      | select($i != null and .[$i + 1] == $label)
      | "\(.[index("--title") + 1]) | \(.[index("--subtitle") + 1]) | \(.[index("--sound") + 1])"' "${NOTIFY_TEST_LOG}")"
    printf '%s: %s\n' "${label}" "${line:-none}"
  done
}

# Fires one event of each kind, naming transcripts from prefix $1, and prints
# what each posted.
function tier_policy() {
  write_transcript "${1}-bash.jsonl" Bash '{"command":"make test"}'
  write_transcript "${1}-plan.jsonl" ExitPlanMode '{"plan":"# Split the parser"}'
  tier_event stop cc-stop '{"session_id":"stop","last_assistant_message":"Completed sample"}'
  tier_event permission cc-permission "$(jq -nc --arg path "${1}-bash.jsonl" \
    '{session_id: "permission", transcript_path: $path, message: "Claude needs your permission"}')"
  tier_event plan cc-permission "$(jq -nc --arg path "${1}-plan.jsonl" \
    '{session_id: "plan", transcript_path: $path, message: "Claude Code needs your approval for the plan"}')"
  tier_event question cc-question '{"session_id":"question","tool_input":{"questions":[{"question":"Choose a branch?"}]}}'
  tier_event elicit cc-elicit '{"session_id":"elicit","message":"Sign in to the sample server"}'
  tier_event codex-question codex-question '{"session_id":"codex-question","tool_input":{"questions":[{"question":"Choose a branch?"}]}}'
  tier_event codex-stop codex-stop '{"session_id":"codex-stop","last_assistant_message":"Completed sample"}'
  print_alerts stop permission plan question elicit codex-question codex-stop
}

# Writes to $1 a Claude Code turn in which the person answered a $2 call.
function answered_turn() {
  transcript_prompt "${1}"
  transcript_tool_use "${1}" asked "${2}" '{}'
  transcript_result "${1}" asked
  transcript_text "${1}" "Completed sample"
}

# Writes to $1 a Claude Code turn whose $2 call ended in an error result with
# text $3.
function errored_turn() {
  transcript_prompt "${1}"
  transcript_tool_use "${1}" asked "${2}" '{}'
  jq -nc --arg text "${3}" \
    '{type: "user", message: {content: [{type: "tool_result", tool_use_id: "asked", is_error: true, content: $text}]}}' >> "${1}"
  transcript_text "${1}" "Completed sample"
}

# Writes to $1 a Codex session whose current turn answered a question.
function codex_answered_turn() {
  codex_transcript "${1}" '"cli"'
  {
    jq -nc '{type: "event_msg", payload: {type: "task_started"}}'
    jq -nc '{type: "response_item", payload: {type: "function_call", name: "request_user_input", call_id: "asked", arguments: "{}"}}'
    jq -nc '{type: "response_item", payload: {type: "function_call_output", call_id: "asked", output: "Yes"}}'
  } >> "${1}"
}

# Installs empty stop, permission and attention sounds, indices 0 to 4, in
# directory $1 for each remaining stem, such as Chord or Chord-worker.
function install_sounds() {
  local sound_dir="${1}" stem role index
  shift
  mkdir -p "${sound_dir}"
  for stem in "$@"; do
    for role in stop permission attention; do
      for index in 0 1 2 3 4; do
        : > "${sound_dir}/${stem}-${role}-${index}.aiff"
      done
    done
  done
}

function tier_scenario() {
  local scenario="${1}" dir="${2}"
  : > "${NOTIFY_TEST_LOG}"
  # Keeps plugin assets beside the script in each scenario.
  if [[ "${scenario}" == tier-refusal-contract ]]; then
    cp -R "$(dirname "${NOTIFY_BIN:?}")/.." "${dir}/plugin"
  else
    ln -s "$(cd "$(dirname "${NOTIFY_BIN:?}")/.." && pwd)" "${dir}/plugin"
  fi
  TIER_NOTIFY="${dir}/plugin/scripts/notify"
  export NOTIFY_TEST_SESSION=atlas NOTIFY_TEST_WINDOW="w 42-fix-parser"
  case "${scenario}" in
    tier-refusal-contract)
      local payload log_script
      cp -R "$(dirname "${ATTENTION_LOG_BIN:?}")/.." "${dir}/attention-plugin"
      log_script="${dir}/attention-plugin/scripts/attention-log"
      ln -s "${log_script}" "${dir}/attention-entry"
      log_script="${dir}/attention-entry"
      export ATTENTION_LOG_DIR="${dir}/attention-state"
      payload="$(jq -nc --arg path "${dir}/contract.jsonl" \
        '{session_id:"shared",transcript_path:$path,error:"invalid_request"}')"
      transcript_prompt "${dir}/contract.jsonl"
      jq -nc '{type:"system",subtype:"model_refusal_no_fallback"}' >> "${dir}/contract.jsonl"
      jq -nc '{type:"user",isMeta:true,message:{content:"Reminder"}}' >> "${dir}/contract.jsonl"
      jq -nc '{type:"user",message:{content:"<local-command-stdout>status</local-command-stdout>"}}' >> "${dir}/contract.jsonl"
      contract_event metadata "${payload}" "${log_script}"
      jq -nc '{type:"human",message:{content:"New prompt"}}' >> "${dir}/contract.jsonl"
      contract_event human "${payload}" "${log_script}"
      jq -nc '{type:"assistant",isApiErrorMessage:true,message:{stop_reason:"refusal"}}' >> "${dir}/contract.jsonl"
      transcript_result "${dir}/contract.jsonl" sample-tool
      contract_event result "${payload}" "${log_script}"
      transcript_text "${dir}/contract.jsonl" "Ordinary reply"
      contract_event reply "${payload}" "${log_script}"
      # Replacing the fixture copies proves both entry points call the helper.
      printf '%s\n' 'def shows_refusal: reduce inputs as $record (true; .);' '# Trailing comment' > "${dir}/plugin/scripts/claude-transcript.jq"
      cp "${dir}/plugin/scripts/claude-transcript.jq" "${dir}/attention-plugin/scripts/claude-transcript.jq"
      contract_event helper "${payload}" "${log_script}"
      print_alerts metadata human result reply helper
      ;;
    tier-failure-sounds)
      export HOME="${dir}/home" NOTIFY_SOUND_SET=Chord
      install_sounds "${HOME}/Library/Sounds" Chord
      tier_event failure cc-failure '{"session_id":"sample","error":"rate_limit"}'
      tier_event approval cc-permission '{"session_id":"sample","message":"Approve sample"}'
      print_alerts failure approval
      ;;
    tier-failures)
      local tier payload
      jq -nc '{type:"agent-name",agentName:"MONITOR"}' > "${dir}/failure.jsonl"
      transcript_prompt "${dir}/failure.jsonl" '{"promptId":"failure-turn","turnOrigin":"task-notification"}'
      jq -nc '{type:"assistant",isApiErrorMessage:true,message:{stop_reason:"refusal"}}' >> "${dir}/failure.jsonl"
      export NOTIFY_TEST_FRONT=com.apple.Terminal NOTIFY_TEST_VISIBLE='%7|attached,focused,UTF-8'
      tier_event completed cc-stop '{"session_id":"failure","last_assistant_message":"Completed sample"}'
      NOTIFY_TEST_FRONT=com.example.background tier_stop background cc-stop "${dir}/failure.jsonl"
      for tier in untiered top lead worker; do
        export NOTIFY_TIER="${tier}"
        payload="$(jq -nc --arg path "${dir}/failure.jsonl" \
          '{session_id:"failure",transcript_path:$path,error:"rate_limit",last_assistant_message:"API limit reached"}')"
        tier_event "${tier}-error" cc-failure "${payload}"
        tier_event "${tier}-refusal" cc-failure "$(printf '%s' "${payload}" | jq '.error="invalid_request"')"
        tier_event "${tier}-approval" cc-permission '{"session_id":"failure","message":"Approve sample operation"}'
      done
      print_alerts background untiered-error untiered-refusal untiered-approval top-error top-refusal top-approval \
        lead-error lead-refusal lead-approval worker-error worker-refusal worker-approval
      jq -r 'select(index("--test-event") != null) | .[index("--message")+1]' "${NOTIFY_TEST_LOG}" | sort -u
      ;;
    tier-failure-boundaries)
      local payload
      payload="$(jq -nc --arg path "${dir}/failure.jsonl" \
        '{session_id:"thread-42",transcript_path:$path,error:"invalid_request",last_assistant_message:"Private refusal text"}')"
      transcript_prompt "${dir}/failure.jsonl"
      jq -nc '{type:"system",subtype:"model_refusal_no_fallback"}' >> "${dir}/failure.jsonl"
      tier_event system cc-failure "${payload}"
      jq -nc '{type:"user",isMeta:true,message:{content:"System reminder"}}' >> "${dir}/failure.jsonl"
      tier_event metadata cc-failure "${payload}"
      jq -nc '{type:"user",message:{content:"<local-command-stdout>status</local-command-stdout>"}}' >> "${dir}/failure.jsonl"
      tier_event local-output cc-failure "${payload}"
      transcript_prompt "${dir}/failure.jsonl"
      tier_event new-turn cc-failure "${payload}"
      jq -nc '{type:"system",subtype:"model_refusal_no_fallback"}' >> "${dir}/failure.jsonl"
      transcript_text "${dir}/failure.jsonl" "Ordinary reply"
      tier_event new-reply cc-failure "${payload}"
      transcript_prompt "${dir}/failure.jsonl"
      # Persist the marker after the first tail read, so success needs a retry.
      NOTIFY_TEST_REAL_TAIL="$(command -v tail)"
      export NOTIFY_TEST_REAL_TAIL NOTIFY_TEST_DELAYED_PATH="${dir}/failure.jsonl"
      printf '%s\n' '#!/usr/bin/env bash' \
        '"${NOTIFY_TEST_REAL_TAIL}" "$@" || exit' \
        'if [[ "$*" == "-n 20 ${NOTIFY_TEST_DELAYED_PATH}" && ! -f "${NOTIFY_TEST_DELAYED_PATH}.written" ]]; then' \
        '  touch "${NOTIFY_TEST_DELAYED_PATH}.written"' \
        '  printf '\''{"type":"system","subtype":"model_refusal_no_fallback"}\n'\'' >> "${NOTIFY_TEST_DELAYED_PATH}"' \
        'fi' > "${dir}/bin/tail"
      chmod +x "${dir}/bin/tail"
      [[ "$(command -v tail)" == "${dir}/bin/tail" ]] || return 1
      tier_event delayed cc-failure "${payload}"
      tier_event missing cc-failure '{"session_id":"thread-42","error":"invalid_request","last_assistant_message":"Private refusal text"}'
      tier_event subagent cc-failure '{"session_id":"thread-42","agent_id":"child","error":"rate_limit"}'
      print_alerts system metadata local-output new-turn new-reply delayed missing subagent
      jq -r '.[index("--message")+1]' "${NOTIFY_TEST_LOG}" | sort -u
      ;;
    tier-worker)
      export NOTIFY_TIER=worker
      tier_policy "${dir}/policy"
      ;;
    tier-lead)
      export NOTIFY_TIER=lead NOTIFY_TEST_WINDOW=conductor
      tier_policy "${dir}/policy"
      ;;
    tier-top)
      export NOTIFY_TIER=top NOTIFY_TEST_SESSION=hub NOTIFY_TEST_WINDOW=coordinator
      tier_policy "${dir}/policy"
      ;;
    tier-unmatched)
      write_tiers 'lead window ^conductor$'
      tier_policy "${dir}/policy"
      ;;
    tier-answered)
      export NOTIFY_TIER=lead NOTIFY_TEST_WINDOW=conductor
      answered_turn "${dir}/question.jsonl" AskUserQuestion
      answered_turn "${dir}/plan.jsonl" ExitPlanMode
      errored_turn "${dir}/rejected.jsonl" AskUserQuestion "The user doesn't want to proceed with this tool use. The tool use was rejected."
      errored_turn "${dir}/failed.jsonl" AskUserQuestion "<tool_use_error>InputValidationError: sample</tool_use_error>"
      transcript_prompt "${dir}/tool.jsonl"
      transcript_tool_use "${dir}/tool.jsonl" tool-1 Bash '{"command":"make"}'
      transcript_result "${dir}/tool.jsonl" tool-1
      transcript_text "${dir}/tool.jsonl" "Completed sample"
      answered_turn "${dir}/earlier.jsonl" AskUserQuestion
      transcript_prompt "${dir}/earlier.jsonl"
      transcript_text "${dir}/earlier.jsonl" "Completed sample"
      codex_answered_turn "${dir}/codex.jsonl"
      tier_stop question cc-stop "${dir}/question.jsonl"
      tier_stop plan cc-stop "${dir}/plan.jsonl"
      tier_stop rejected cc-stop "${dir}/rejected.jsonl"
      tier_stop failed cc-stop "${dir}/failed.jsonl"
      tier_stop tool cc-stop "${dir}/tool.jsonl"
      tier_stop earlier cc-stop "${dir}/earlier.jsonl"
      tier_stop codex codex-stop "${dir}/codex.jsonl"
      (
        unset NOTIFY_TIER
        tier_stop untiered cc-stop "${dir}/question.jsonl"
      )
      print_alerts question plan rejected failed tool earlier codex untiered
      ;;
    tier-rules-order)
      write_tiers '# tier field pattern' '' 'bogus window ^w' 'worker color ^w' 'worker window [' \
        'worker window ^w[ ]' 'lead window ^w'
      explain
      ;;
    tier-rules-session)
      write_tiers 'lead session ^atlas$'
      explain
      ;;
    tier-rules-server)
      write_tiers 'lead server ^notify-test-server$'
      explain
      ;;
    tier-rules-name)
      jq -nc '{type: "agent-name", agentName: "MONITOR"}' > "${dir}/named.jsonl"
      # Adds quoted records to catch name lookups that inspect only trailing matches.
      local quoted
      quoted="$(jq -nc '{type: "user", agentName: "QUOTED", message: {content: "Sample prompt"}, note: {type: "agent-name"}}')"
      for _ in {1..150}; do printf '%s\n' "${quoted}"; done >> "${dir}/named.jsonl"
      write_tiers 'lead name ^[[:upper:]]+$'
      explain "${dir}/named.jsonl"
      ;;
    tier-rules-custom-title)
      jq -nc '{type: "custom-title", customTitle: "Sample Title"}' > "${dir}/titled.jsonl"
      write_tiers 'lead name ^Sample[ ]'
      explain "${dir}/titled.jsonl"
      ;;
    tier-rules-renamed)
      jq -nc '{type: "agent-name", agentName: "OLD NAME"}' > "${dir}/renamed.jsonl"
      jq -nc '{type: "custom-title", customTitle: "Renamed Title"}' >> "${dir}/renamed.jsonl"
      write_tiers 'worker name ^OLD' 'lead name ^Renamed'
      explain "${dir}/renamed.jsonl"
      ;;
    tier-name-hook)
      local glyph=$'\xef\x91\xa9'
      export NOTIFY_TEST_WINDOW="${glyph}"
      write_tiers 'lead name ^[[:upper:]]+$'
      jq -nc '{type: "agent-name", agentName: "ATLAS"}' > "${dir}/named.jsonl"
      write_transcript "${dir}/named.jsonl" Bash '{"command":"make test"}'
      tier_event permission cc-permission "$(jq -nc --arg path "${dir}/named.jsonl" \
        '{session_id: "permission", transcript_path: $path, message: "Claude needs your permission"}')"
      tier_event question cc-question "$(jq -nc --arg path "${dir}/named.jsonl" \
        '{session_id: "question", transcript_path: $path, tool_input: {questions: [{question: "Choose a branch?"}]}}')"
      print_alerts permission question
      ;;
    tier-explain-lookup)
      write_tiers 'lead name ^LOOKUP$'
      mkdir -p "${dir}/claude/projects/sample-project" "${dir}/home/.claude/projects/sample-project"
      jq -nc '{type: "agent-name", agentName: "LOOKUP"}' > "${dir}/claude/projects/sample-project/sample-session.jsonl"
      cp "${dir}/claude/projects/sample-project/sample-session.jsonl" "${dir}/home/.claude/projects/sample-project/"
      CLAUDE_CODE_SESSION_ID=sample-session CLAUDE_CONFIG_DIR="${dir}/claude" explain | grep -E '^(tier|name):'
      CLAUDE_CODE_SESSION_ID=sample-session HOME="${dir}/home" explain | grep -E '^(tier|name):'
      ;;
    tier-explain-errors)
      local status=0
      capture_child - --replace "${dir}" '<dir>' --replay-stdout -- explain "${dir}/missing.jsonl" || status=$?
      echo "exit ${status}"
      mkdir -p "${dir}/claude/projects/sample-project"
      jq -nc '{type: "agent-name", agentName: "LOOKUP"}' > "${dir}/claude/projects/sample-project/unreadable.jsonl"
      chmod 000 "${dir}/claude/projects/sample-project/unreadable.jsonl"
      for session in absent unreadable 'bad/../id'; do
        status=0
        CLAUDE_CODE_SESSION_ID="${session}" CLAUDE_CONFIG_DIR="${dir}/claude" \
          capture_child - --replace "${dir}" '<dir>' --replay-stdout -- explain || status=$?
        echo "exit ${status}"
      done
      status=0
      mkdir -p "${XDG_CONFIG_HOME}/agent-harness-notify/tiers"
      status=0
      capture_child - --replace "${dir}" '<dir>' --replay-stdout -- explain || status=$?
      echo "exit ${status}"
      ;;
    tier-rules-dir)
      write_tiers 'top dir /sample-repo$' 'worker dir /worktrees/'
      explain
      CLAUDE_PROJECT_DIR=/tmp/sample/worktrees/42 explain
      ;;
    tier-rules-env)
      write_tiers 'worker window ^w[ ]'
      NOTIFY_TIER=top explain
      NOTIFY_TIER=boss explain
      ;;
    tier-rules-none)
      write_tiers 'lead window ^conductor$' 'lead name ^'
      explain
      ;;
    tier-rules-missing) explain ;;
    tier-rules-multibyte)
      export NOTIFY_TEST_WINDOW="λ 42-fix-parser"
      write_tiers 'lead window ^♮$' 'worker window ^λ[ ]'
      explain
      LC_ALL=C explain
      ;;
    tier-place-glyph)
      local glyph=$'\xef\x91\xa9'
      export NOTIFY_TIER=lead NOTIFY_TEST_SESSION=hub NOTIFY_TEST_WINDOW="${glyph}"
      jq -nc '{type: "agent-name", agentName: "MONITOR"}' > "${dir}/named.jsonl"
      explain "${dir}/named.jsonl"
      explain
      NOTIFY_TEST_WINDOW="${glyph} BOARDS" explain
      ;;
    tier-place-outside-tmux)
      export NOTIFY_TIER=lead
      unset TMUX TMUX_PANE
      explain
      ;;
    tier-sounds)
      export HOME="${dir}/home" NOTIFY_SOUND_SET=Chord
      install_sounds "${HOME}/Library/Sounds" Chord Chord-worker
      NOTIFY_TIER=worker explain | grep sounds
      NOTIFY_TIER=lead explain | grep sounds
      explain | grep sounds
      rm "${HOME}/Library/Sounds/Chord-worker-stop-0.aiff"
      NOTIFY_TIER=worker explain | grep sounds
      unset NOTIFY_SOUND_SET
      NOTIFY_TIER=worker explain | grep sounds
      ;;
    *)
      echo "Unknown tier scenario: ${scenario}" >&2
      return 1
      ;;
  esac
}

function main() {
  local scenario="${1}" test_dir quoted_test_dir
  test_dir="$(mktemp -d "${TMPDIR:-/tmp}/fixture.XXXXXX")"
  # Expand the local path now because EXIT runs after main returns.
  # printf %q escapes the path, so a TMPDIR holding quotes or shell
  # metacharacters cannot break out of the trap command.
  printf -v quoted_test_dir '%q' "${test_dir}"
  # Also stops held alerter stubs, even after a failed assertion.
  # shellcheck disable=SC2064
  trap "[[ -z \${NOTIFY_TEST_HOLD:-} ]] || pkill -KILL -f ${quoted_test_dir}/bin/alerter 2> /dev/null || true; rm -rf ${quoted_test_dir}" EXIT # error-output-allow: fixture cleanup tolerates an already stopped alerter
  : "${NOTIFY_BIN:?Set NOTIFY_BIN to the notification script}"
  mkdir "${test_dir}/bin"
  export NOTIFY_TEST_LOG="${test_dir}/alerts"
  NOTIFY_TEST_STUB="${test_dir}/bin/alerter"
  export NOTIFY_TEST_FRONT="com.example.background"
  export NOTIFY_TEST_VISIBLE="%99|attached,focused,UTF-8"
  export NOTIFY_TEST_TITLE="✳ Sample task"
  export PATH="${test_dir}/bin:${PATH}"
  export XDG_CACHE_HOME="${test_dir}/cache" XDG_CONFIG_HOME="${test_dir}/config"
  export TMUX="/tmp/notify-test-server,123,0" TMUX_PANE="%7" TERM_PROGRAM="Apple_Terminal"
  # Keeps inherited notify settings, session identity and terminal out of the
  # scenarios.
  unset NOTIFY_WAIT_LIMIT NOTIFY_SOUND_SET NOTIFY_TIER CLAUDE_PROJECT_DIR CLAUDE_CODE_SESSION_ID \
    CLAUDE_CONFIG_DIR __CFBundleIdentifier

  # The stub logs SIGTERM, which makes the real alerter remove its banner.
  # The trap is set before the call is logged, since scenarios wait for that log.
  # NOTIFY_TEST_HOLD keeps the stub waiting like an unanswered banner, and
  # NOTIFY_TEST_EVENT labels the call for the tier scenarios.
  printf '%s\n' '#!/usr/bin/env bash' \
    'trap '\''echo TERM >> "${NOTIFY_TEST_LOG}.signals"; exit 143'\'' TERM' \
    'jq -nc --args '\''$ARGS.positional'\'' -- "$@" ${NOTIFY_TEST_EVENT:+--test-event "${NOTIFY_TEST_EVENT}"} >> "${NOTIFY_TEST_LOG}"' \
    'if [[ -n "${NOTIFY_TEST_HOLD:-}" ]]; then for _ in {1..300}; do sleep 0.1; done; fi' \
    > "${test_dir}/bin/alerter"
  # display-message answers the pane title query (#T) and otherwise the
  # session and window names; show-environment fails without
  # NOTIFY_TEST_GLOBAL_TERM, like a variable the server lacks.
  printf '%s\n' '#!/usr/bin/env bash' \
    'case "$1" in' \
    'display-message)' \
    '  if [[ "$5" == "#T" ]]; then printf "%s\\n" "${NOTIFY_TEST_TITLE}"' \
    '  else printf "%s\\037%s\\n" "${NOTIFY_TEST_SESSION:-sample-session}" "${NOTIFY_TEST_WINDOW:-sample-window}"; fi ;;' \
    'list-clients) printf "%s\\n" "${NOTIFY_TEST_VISIBLE}" ;;' \
    'show-environment) [[ -n "${NOTIFY_TEST_GLOBAL_TERM:-}" ]] && printf "TERM_PROGRAM=%s\\n" "${NOTIFY_TEST_GLOBAL_TERM}" ;;' \
    'esac' > "${test_dir}/bin/tmux"
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s\\n" "${NOTIFY_TEST_FRONT}"' > "${test_dir}/bin/osascript"
  # Stubs the parent's terminal and command line; the default has no terminal,
  # like an agent-run command.
  printf '%s\n' '#!/usr/bin/env bash' \
    'printf "%s %s\\n" "${NOTIFY_TEST_TTY:-??}" "${NOTIFY_TEST_PARENT:-bash check-notifications}"' > "${test_dir}/bin/ps"
  chmod +x "${test_dir}/bin/alerter" "${test_dir}/bin/tmux" "${test_dir}/bin/osascript" "${test_dir}/bin/ps"
  local stub
  for stub in alerter tmux osascript ps; do
    [[ "$(command -v "${stub}")" == "${test_dir}/bin/${stub}" ]] || return 1
  done

  # Subtitles name the repository and fall back to the branch suffix. An empty
  # template keeps a personal init.templateDir out of the sample repository.
  local repo="${test_dir}/sample-repo"
  git init -q --template= -b feature/sample-branch "${repo}"
  cd "${repo}"
  # The logical path; mktemp leaves a doubled slash when TMPDIR ends in /.
  repo="${PWD}"

  if [[ "${scenario}" == sound-* ]]; then
    local fixture_home="${test_dir}/home" sound_dir prefix=Chord
    : > "${NOTIFY_TEST_LOG}"
    sound_dir="${fixture_home}/Library/Sounds"
    install_sounds "${sound_dir}" "${prefix}"
    export NOTIFY_SOUND_SET="${prefix}"
    case "${scenario}" in
      sound-unset) unset NOTIFY_SOUND_SET ;;
      sound-empty) export NOTIFY_SOUND_SET="" ;;
      sound-invalid) export NOTIFY_SOUND_SET='../Chord' ;;
      sound-gap) rm "${sound_dir}/Chord-stop-2.aiff" ;;
      sound-missing) rm "${sound_dir}"/Chord-permission-*.aiff ;;
      sound-zero) rm "${sound_dir}/Chord-stop-0.aiff" ;;
      sound-counts) rm "${sound_dir}/Chord-permission-3.aiff" ;;
      sound-extensions)
        mv "${sound_dir}/Chord-stop-4.aiff" "${sound_dir}/Chord-stop-4.wav"
        mv "${sound_dir}/Chord-attention-4.aiff" "${sound_dir}/Chord-attention-4.caf"
        : > "${sound_dir}/Chord-permission-0.wav"
        ;;
      sound-other)
        git init -q --template= -b sample "${test_dir}/another-repo"
        cd "${test_dir}/another-repo"
        ;;
      sound-outside)
        mkdir "${test_dir}/outside-repo"
        cd "${test_dir}/outside-repo"
        ;;
      sound-worktree)
        git -c user.name=Sample -c user.email=sample@example.com -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q --allow-empty -m sample
        git worktree add -q -b sample "${test_dir}/worktree-folder"
        cd "${test_dir}/worktree-folder"
        ;;
      sound-full) ;;
      *)
        echo "Unknown sound scenario: ${scenario}" >&2
        return 1
        ;;
    esac
    local event calls=0 sound_transcript="${test_dir}/sound-transcript.jsonl"
    write_transcript "${sound_transcript}" ExitPlanMode '{"plan":"# Sample plan"}'
    for event in cc-stop codex-stop cc-permission cc-question codex-question cc-elicit cc-permission; do
      calls=$((calls + 1))
      local sound_payload
      sound_payload="$(jq -nc --arg session "sound-${calls}" \
        --arg transcript "$(if [[ "${calls}" -eq 7 ]]; then printf '%s' "${sound_transcript}"; fi)" \
        --arg message "$(if [[ "${calls}" -eq 7 ]]; then printf '%s' 'Claude Code needs your approval for the plan'; fi)" \
        '{session_id: $session, message: $message, transcript_path: $transcript}')"
      printf '%s' "${sound_payload}" | HOME="${fixture_home}" /bin/bash "${NOTIFY_BIN}" "${event}"
      poll 150 alert_count_is "${calls}" || return 1
    done
    jq -r '.[index("--sound") + 1]' "${NOTIFY_TEST_LOG}"
    return
  fi
  if [[ "${scenario}" == tier-* ]]; then
    tier_scenario "${scenario}" "${test_dir}"
    return
  fi

  local payload='{"session_id":"session-one","last_assistant_message":"Completed sample"}'
  local action="codex-stop" transcript="${test_dir}/transcript.jsonl" message=""
  case "${scenario}" in
    claude-completion | claude-reset) action="cc-stop" ;;
    claude-question)
      action="cc-question"
      payload='{"session_id":"session-one","tool_input":{"questions":[{"question":"Choose a branch?"}]}}'
      ;;
    question)
      action="codex-question"
      payload='{"session_id":"session-one","tool_input":{"questions":[{"question":"Choose a branch?"}]}}'
      ;;
    question-string)
      action="codex-question"
      payload='{"session_id":"session-one","tool_input":"{\"questions\":[{\"question\":\"Choose a branch?\"}]}"}'
      ;;
    questions)
      action="cc-question"
      payload='{"session_id":"session-one","tool_input":{"questions":[{"question":"Choose a branch?"},{"question":"Push now?"},{"question":"Open a PR?"}]}}'
      ;;
    summary)
      action="cc-stop"
      payload="$(jq -nc --arg reply $'▸ 572 · checks 20/20 · mergeable CLEAN\n\n## PR #12: ready\n\n| a | b |\n| - | - |\n\n```text\nlog output\n```\n\n- **Checks** pass on `abc123`, see [the run](https://example.com/run).\n- Copilot left *one* note' \
        '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    status-only)
      payload="$(jq -nc --arg reply $'▸ 572 · checks 20/20\n▸ waiting on review' \
        '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    code-only)
      payload="$(jq -nc --arg reply $'```bash\nmake test\n```' '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    pipeless-table)
      payload="$(jq -nc --arg reply $'Results:\n\nCheck | State\n:--- | ---:\nLint | pass\n\nAll good.' '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    short-room)
      payload="$(jq -nc --arg reply "$(printf 'word %.0s' {1..22})ends here. A second sentence that cannot fit in the room left." \
        '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    stop-empty)
      action="cc-stop"
      transcript_text "${transcript}" "Earlier turn reply."
      transcript_prompt "${transcript}"
      transcript_text "${transcript}" "Running the build now."
      payload="$(jq -nc --arg path "${transcript}" '{session_id: "session-one", transcript_path: $path, last_assistant_message: ""}')"
      ;;
    stop-tool-only)
      action="cc-stop"
      transcript_text "${transcript}" "Earlier turn reply."
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"make"}'
      transcript_result "${transcript}" tool-1
      payload="$(jq -nc --arg path "${transcript}" '{session_id: "session-one", transcript_path: $path}')"
      ;;
    stop-slash-command)
      action="cc-stop"
      transcript_text "${transcript}" "Earlier turn reply."
      jq -nc '{type: "user", message: {content: "<command-message>sample</command-message>\n<command-name>/sample</command-name>"}}' >> "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"make"}'
      transcript_result "${transcript}" tool-1
      payload="$(jq -nc --arg path "${transcript}" '{session_id: "session-one", transcript_path: $path}')"
      ;;
    status-dots)
      payload="$(jq -nc --arg reply $'PR 572 · checks 20/20 · mergeable CLEAN\n\nReady to merge.' \
        '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    unclosed-fence)
      payload="$(jq -nc --arg reply $'Here is the fix:\n```bash\nmake test' '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    elicit)
      action="cc-elicit"
      payload='{"session_id":"session-one","message":"Sign in to\nthe sample server"}'
      ;;
    manifests)
      # Every subcommand the hook manifests register must dispatch.
      local hooks sub
      hooks="$(dirname "${NOTIFY_BIN}")/../hooks"
      while IFS= read -r sub; do
        printf '%s' '{"session_id":"manifest"}' | "${NOTIFY_BIN}" "${sub}" > /dev/null 2>&1 || echo "Not dispatched: ${sub}" # error-output-allow: manifest dispatch probe reports Not dispatched on failure
      done < <(jq -r '.. | .command? // empty | split(" ") | last' "${hooks}"/*.json | sort -u)
      echo "Every manifest subcommand dispatches"
      return 0
      ;;
    stop-transcript)
      action="cc-stop"
      transcript_text "${transcript}" "Earlier turn reply."
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"make"}'
      transcript_result "${transcript}" tool-1
      transcript_text "${transcript}" "Current turn reply."
      payload="$(jq -nc --arg path "${transcript}" '{session_id: "session-one", transcript_path: $path}')"
      ;;
    long-question)
      action="cc-question"
      payload="$(jq -nc --arg first "Which $(printf 'very %.0s' {1..40})long question?" \
        '{session_id: "session-one", tool_input: {questions: [{question: $first}, {question: "Two?"}, {question: "Three?"}]}}')"
      ;;
    question-shape)
      action="cc-question"
      payload='{"session_id":"session-one","tool_input":{"questions":["plain text"]}}'
      ;;
    long-summary)
      payload="$(jq -nc --arg reply 'The overnight throttle is on. I stopped the previous watcher and started a new one that checks the pull request hourly until the morning, then every two minutes.' \
        '{session_id: "session-one", last_assistant_message: $reply}')"
      ;;
    json-summary)
      payload='{"session_id":"session-one","last_assistant_message":"{\"verdict\":\"needs-attention\",\"summary\":\"Do not implement this plan unchanged.\"}"}'
      ;;
    long-json-summary)
      payload="$(jq -nc '{session_id: "session-one", last_assistant_message: ({summary: "Short JSON summary.", details: ("x" * 25000)} | tojson)}')"
      ;;
    generic-title) export NOTIFY_TEST_TITLE="user@host:~/sample-repo" ;;
    worktree)
      git -c user.name=Sample -c user.email=sample@example.com -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -q --allow-empty -m sample
      git worktree add -q -b feature/worktree-branch "${test_dir}/worktree-folder"
      cd "${test_dir}/worktree-folder"
      export NOTIFY_TEST_TITLE="zsh"
      ;;
    permission-write)
      action="cc-permission"
      write_transcript "${transcript}" Write "$(jq -nc --arg path "${repo}/docs/plans/todo/$(printf 'long-name-%.0s' {1..14}).md" '{file_path: $path}')"
      ;;
    permission-bash)
      action="cc-permission"
      write_transcript "${transcript}" Bash "$(jq -nc --arg command "cd ${repo} && make test" '{command: $command}')"
      ;;
    permission-question)
      action="cc-permission"
      write_transcript "${transcript}" AskUserQuestion '{"questions":[{"question":"Choose a branch?"}]}'
      ;;
    permission-symlink)
      action="cc-permission"
      ln -s "${repo}" "${test_dir}/linked-repo"
      cd "${test_dir}/linked-repo"
      write_transcript "${transcript}" Write "$(jq -nc --arg path "${PWD}/docs/a.md" '{file_path: $path}')"
      ;;
    permission-mcp)
      action="cc-permission"
      message="Claude needs your permission to use github - create_issue (MCP)"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 mcp__srv__issue '{"title":"Older"}'
      transcript_tool_use "${transcript}" tool-2 mcp__github__create_issue '{"title":"Sample"}'
      ;;
    permission-stale-question)
      action="cc-permission"
      message="Claude needs your permission to use Bash"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 AskUserQuestion '{"questions":[{"question":"Choose a branch?"}]}'
      transcript_result "${transcript}" tool-1
      transcript_text "${transcript}" "Running the build now."
      ;;
    permission-parallel)
      action="cc-permission"
      message="Claude needs your permission to use Bash"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"ls -la"}'
      transcript_tool_use "${transcript}" tool-2 ExitPlanMode '{"plan":"# Sample plan"}'
      ;;
    permission-fallback)
      action="cc-permission"
      message="Claude needs your permission to use TodoWrite"
      transcript_prompt "${transcript}"
      ;;
    permission-answered)
      action="cc-permission"
      message="Claude needs your permission"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"ls"}'
      transcript_result "${transcript}" tool-1
      transcript_tool_use "${transcript}" tool-2 Bash '{"command":"make deploy"}'
      ;;
    permission-skip-interactive)
      action="cc-permission"
      message="Claude needs your permission"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 AskUserQuestion '{"questions":[{"question":"Choose a branch?"}]}'
      transcript_tool_use "${transcript}" tool-2 ExitPlanMode '{"plan":"# Sample plan"}'
      transcript_tool_use "${transcript}" tool-3 Bash '{"command":"make test"}'
      ;;
    permission-meta)
      action="cc-permission"
      message="Claude needs your permission"
      write_transcript "${transcript}" Bash '{"command":"make test"}'
      jq -nc '{type: "user", isMeta: true, message: {content: "<system-reminder>Sample</system-reminder>"}}' >> "${transcript}"
      ;;
    permission-mcp-display)
      action="cc-permission"
      message="Claude needs your permission to use Create Issue"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 mcp__srv__issue '{"title":"Older"}'
      transcript_tool_use "${transcript}" tool-2 mcp__github__create_issue '{"title":"Sample"}'
      ;;
    plan-pending)
      action="cc-permission"
      message="Claude Code needs your approval for the plan"
      transcript_prompt "${transcript}"
      ;;
    permission-interactive)
      action="cc-permission"
      message="Claude needs your permission"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"echo first"}'
      transcript_tool_use "${transcript}" tool-2 Bash '{"command":"echo second"}'
      transcript_tool_use "${transcript}" tool-3 ExitPlanMode '{"plan":"# Sample plan"}'
      ;;
    permission-sandbox)
      action="cc-permission"
      message="A sandboxed command needs network access"
      write_transcript "${transcript}" Bash '{"command":"curl example.com"}'
      ;;
    plan-message)
      action="cc-permission"
      message="Claude Code needs your approval for the plan"
      transcript_prompt "${transcript}"
      transcript_tool_use "${transcript}" tool-1 Bash '{"command":"ls"}'
      transcript_tool_use "${transcript}" tool-2 ExitPlanMode '{"plan":"# Sample plan"}'
      ;;
    plan)
      action="cc-permission"
      write_transcript "${transcript}" ExitPlanMode '{"plan":"Intro\n\n# Add a `sample` skill\n\n## Steps"}'
      ;;
    plan-no-heading)
      action="cc-permission"
      write_transcript "${transcript}" ExitPlanMode '{"plan":"\nRename the **sample** helper.\n\nMore detail."}'
      ;;
    plan-fenced)
      action="cc-permission"
      write_transcript "${transcript}" ExitPlanMode '{"plan":"```bash\n# not a heading\n```\n\n## Real heading"}'
      ;;
    plan-empty)
      action="cc-permission"
      write_transcript "${transcript}" ExitPlanMode '{"plan":""}'
      ;;
    visible) export NOTIFY_TEST_FRONT="com.apple.Terminal" NOTIFY_TEST_VISIBLE="%7|attached,focused,UTF-8" ;;
    # tmux 3.2 and later set TERM_PROGRAM=tmux in every pane.
    quiet-visible-tmux-bundle)
      export TERM_PROGRAM=tmux __CFBundleIdentifier=com.apple.Terminal
      export NOTIFY_TEST_FRONT="com.apple.Terminal" NOTIFY_TEST_VISIBLE="%7|attached,focused,UTF-8"
      ;;
    quiet-visible-tmux-global)
      export TERM_PROGRAM=tmux NOTIFY_TEST_GLOBAL_TERM=Apple_Terminal
      export NOTIFY_TEST_FRONT="com.apple.Terminal" NOTIFY_TEST_VISIBLE="%7|attached,focused,UTF-8"
      ;;
    tmux-unknown-terminal)
      export TERM_PROGRAM=tmux
      export NOTIFY_TEST_FRONT="com.apple.Terminal" NOTIFY_TEST_VISIBLE="%7|attached,focused,UTF-8"
      ;;
    other-window) export NOTIFY_TEST_FRONT="com.apple.Terminal" NOTIFY_TEST_VISIBLE="%7|attached,UTF-8" ;;
    other-pane) export NOTIFY_TEST_FRONT="com.apple.Terminal" ;;
    subagent) payload='{"session_id":"session-one","agent_id":"child"}' ;;
    codex-cli) codex_transcript "${transcript}" '"cli"' ;;
    quiet-codex-exec) codex_transcript "${transcript}" '"exec"' ;;
    quiet-codex-subagent) codex_transcript "${transcript}" '{"subagent":{"other":"guardian"}}' ;;
    quiet-codex-exec-resume)
      codex_transcript "${transcript}" '"cli"'
      export NOTIFY_TEST_PARENT="codex -c model=sample exec resume sample-session"
      ;;
    quiet-codex-exec-alias)
      codex_transcript "${transcript}" '"cli"'
      export NOTIFY_TEST_PARENT="/opt/sample/bin/codex e Sample prompt" NOTIFY_TEST_TTY=ttys001
      ;;
    quiet-codex-spaced-value)
      codex_transcript "${transcript}" '"cli"'
      export NOTIFY_TEST_PARENT="codex --cd /tmp/sample project exec resume sample-session"
      ;;
    # --ephemeral writes no transcript, so the payload's path does not exist.
    quiet-codex-exec-ephemeral) export NOTIFY_TEST_PARENT="codex exec --ephemeral --cd /tmp/sample Sample prompt" ;;
    quiet-codex-review)
      codex_transcript "${transcript}" '"cli"'
      export NOTIFY_TEST_PARENT="codex review"
      ;;
    codex-spaced-value-terminal)
      codex_transcript "${transcript}" '"exec"'
      export NOTIFY_TEST_PARENT="codex --cd /tmp/sample exec" NOTIFY_TEST_TTY=ttys001
      ;;
    quiet-codex-exec-terminal)
      codex_transcript "${transcript}" '"cli"'
      export NOTIFY_TEST_PARENT="codex exec Sample prompt" NOTIFY_TEST_TTY=ttys001
      ;;
    codex-terminal-prompt)
      codex_transcript "${transcript}" '"exec"'
      export NOTIFY_TEST_PARENT="codex Sample prompt" NOTIFY_TEST_TTY=ttys001
      ;;
    codex-interactive-resume)
      codex_transcript "${transcript}" '"exec"'
      export NOTIFY_TEST_PARENT="codex resume sample-session"
      ;;
    codex-option-value)
      codex_transcript "${transcript}" '"exec"'
      export NOTIFY_TEST_PARENT="codex --model exec Sample prompt" NOTIFY_TEST_TTY=ttys001
      ;;
    turn-human) transcript_turn "${transcript}" p1 '{"turnOrigin":"human","origin":{"kind":"human"}}' ;;
    turn-human-legacy) transcript_turn "${transcript}" p1 '{"origin":{"kind":"human"}}' ;;
    turn-untagged) transcript_turn "${transcript}" p1 '{}' ;;
    turn-without-prompt-id)
      transcript_turn "${transcript}" p1 '{"turnOrigin":"task_notification"}'
      transcript_prompt "${transcript}"
      transcript_text "${transcript}" "Completed sample"
      ;;
    quiet-turn-task) transcript_turn "${transcript}" p1 '{"turnOrigin":"task_notification","origin":{"kind":"task-notification"}}' ;;
    quiet-turn-peer) transcript_turn "${transcript}" p1 '{"turnOrigin":"peer","origin":{"kind":"peer"},"isMeta":true}' ;;
    quiet-turn-scheduled) transcript_turn "${transcript}" p1 '{"turnOrigin":"scheduled","isMeta":true}' ;;
    quiet-turn-sdk) transcript_turn "${transcript}" p1 '{"turnOrigin":"sdk"}' ;;
    quiet-turn-legacy) transcript_turn "${transcript}" p1 '{"origin":{"kind":"task-notification"}}' ;;
    quiet-turn-meta) transcript_turn "${transcript}" p1 '{"isMeta":true}' ;;
    quiet-turn-compacted)
      transcript_turn "${transcript}" p1 '{"isMeta":true}'
      transcript_prompt "${transcript}" '{"promptId":"p1","isCompactSummary":true}'
      ;;
    quiet-turn-after-human)
      transcript_turn "${transcript}" p1 '{"turnOrigin":"human"}'
      transcript_turn "${transcript}" p2 '{"turnOrigin":"task_notification"}'
      ;;
    delivery | delivery-leading-zero)
      export NOTIFY_TEST_HOLD=1
      # A leading zero fails validation, so the default grace period applies.
      [[ "${scenario}" == delivery ]] || export NOTIFY_WAIT_LIMIT=09
      local started="${SECONDS}"
      ;;
    *) ;;
  esac
  if [[ "${scenario}" =~ ^(quiet-)?(codex|turn)- ]]; then
    [[ ! "${scenario}" =~ ^(quiet-)?turn- ]] || action="cc-stop"
    payload="$(jq -nc --arg path "${transcript}" '{session_id: "session-one", transcript_path: $path, last_assistant_message: "Completed sample"}')"
  fi
  if [[ "${action}" == cc-permission ]]; then
    payload="$(jq -nc --arg path "${transcript}" --arg message "${message}" \
      '{session_id: "session-one", transcript_path: $path} + (if $message == "" then {} else {message: $message} end)')"
  fi
  printf '%s' "${payload}" | "${NOTIFY_BIN}" "${action}"
  # Polls for up to 3 seconds for the detached alerter stub to log its call.
  local count=0
  case "${scenario}" in
    visible | subagent | permission-question | quiet-*) ;;
    *)
      while [[ ! -s "${NOTIFY_TEST_LOG}" && "${count}" -lt 150 ]]; do
        sleep 0.02
        count=$((count + 1))
      done
      [[ -s "${NOTIFY_TEST_LOG}" ]] || exit 1
      ;;
  esac
  case "${scenario}" in
    duplicate)
      printf '%s' "${payload}" | "${NOTIFY_BIN}" codex-stop
      # Polls for up to 3 seconds for a detached duplicate before asserting none came.
      wait_for_alerts 2
      alert_count_is 1 || exit 1
      echo "One completion alert per turn"
      ;;
    reset | claude-reset)
      printf '%s' "${payload}" | "${NOTIFY_BIN}" "${action%-stop}-turn-start"
      printf '%s' "${payload}" | "${NOTIFY_BIN}" "${action}"
      wait_for_alerts 2
      [[ "$(wc -l < "${NOTIFY_TEST_LOG}" | tr -d ' ')" == 2 ]] || exit 1
      echo "Next user prompt allows another completion"
      ;;
    groups)
      printf '%s' '{"session_id":"session-two"}' | "${NOTIFY_BIN}" codex-stop
      wait_for_alerts 2
      [[ "$(jq -sr 'map(.[index("--group") + 1]) | unique | length' "${NOTIFY_TEST_LOG}")" == 2 ]]
      echo "Separate sessions retain separate banners"
      ;;
    delivery | delivery-leading-zero)
      # `|| exit 1` throughout: a failing [[ ]] does not trigger errexit in bash 3.2.
      poll 150 find_held_pid || exit 1
      # The default grace period is 2 seconds; allow 6 under parallel load.
      poll 300 not_running "${HELD_PID}" || exit 1
      # Two 1-second sleeps precede the stop, so whole-second SECONDS shows at least 2.
      [[ $((SECONDS - started)) -ge 2 ]] || exit 1
      # SIGTERM would make the real alerter remove its banner.
      [[ ! -e "${NOTIFY_TEST_LOG}.signals" ]] || exit 1
      [[ "$(jq -r '.[index("--timeout") + 1]' "${NOTIFY_TEST_LOG}")" == 86400 ]] || exit 1
      echo "Alerter stops after the grace period without SIGTERM"
      ;;
    visible | subagent | permission-question | quiet-*)
      # Gives a detached alerter time to appear before asserting none did.
      sleep 0.2
      [[ ! -e "${NOTIFY_TEST_LOG}" ]] || exit 1
      echo "No alert"
      ;;
    *) jq -r '.[index("--title") + 1], .[index("--subtitle") + 1], .[index("--message") + 1], .[index("--sound") + 1], (.[index("--app-icon") + 1] | split("/") | last)' "${NOTIFY_TEST_LOG}" ;;
  esac
}

main "$@"
