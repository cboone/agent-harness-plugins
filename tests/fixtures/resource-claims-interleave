#!/usr/bin/env bash
# Exercise the real claims script with a writer paused after its snapshot read.
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "${REPO_ROOT:?REPO_ROOT is required}/bin/lib/git-environment.bash"

# shellcheck source=bin/lib/capture-child.bash
source "${REPO_ROOT}/bin/lib/capture-child.bash"

: "${RESOURCE_CLAIMS_INTERLEAVE_STUB_BIN:?}" "${MANAGE_RESOURCE_CLAIMS_BIN:?}"

FIXTURE_DIRECTORY=""
FIRST_WRITER=""
SECOND_WRITER=""

function cleanup() {
  local exit_code=$?
  trap - EXIT
  trap '' HUP INT TERM
  if [[ -n "${FIXTURE_DIRECTORY}" ]]; then
    if [[ -d "${FIXTURE_DIRECTORY}/barrier" ]]; then
      touch "${FIXTURE_DIRECTORY}/barrier/release-first" || exit_code=1
      touch "${FIXTURE_DIRECTORY}/barrier/release-cleanup" "${FIXTURE_DIRECTORY}/barrier/release-second" || exit_code=1
      touch "${FIXTURE_DIRECTORY}/barrier/release-waiter" || exit_code=1
    fi
    if [[ -n "${FIRST_WRITER}" ]]; then
      capture_child - --wait-log "${FIXTURE_DIRECTORY}/first.log" "${FIRST_WRITER}" || :
    fi
    if [[ -n "${SECOND_WRITER}" ]]; then
      capture_child - --wait-log "${FIXTURE_DIRECTORY}/second.log" "${SECOND_WRITER}" || :
    fi
    rm -r -- "${FIXTURE_DIRECTORY}" || exit_code=1
  fi
  exit "${exit_code}"
}

function await_event() {
  local attempt
  for ((attempt = 0; attempt < 160; attempt++)); do
    if [[ -f "${CLAIMS_BARRIER}/${1}" || -f "${CLAIMS_BARRIER}/${2:-${1}}" ]]; then
      return 0
    fi
    sleep 0.05
  done
  echo "barrier timed out: ${1}" >&2
  return 1
}

function main() {
  local root stub first second first_status=0 second_status=0
  root="$(mktemp -d "${TMPDIR:-/tmp}/scrut.XXXXXX")"
  FIXTURE_DIRECTORY="${root}"
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  stub="${RESOURCE_CLAIMS_INTERLEAVE_STUB_BIN}"
  export CLAIMS_REAL_MKDIR CLAIMS_REAL_SLEEP CLAIMS_REAL_RM CLAIMS_INTERLEAVE_MODE="${1:-snapshot}"
  CLAIMS_REAL_MKDIR="$(command -v mkdir)"
  CLAIMS_REAL_SLEEP="$(command -v sleep)"
  CLAIMS_REAL_RM="$(command -v rm)"
  mkdir "${root}/bin" "${root}/barrier"
  cp "${stub}" "${root}/bin/git"
  cp "${stub}" "${root}/bin/mkdir"
  cp "${stub}" "${root}/bin/sleep"
  cp "${stub}" "${root}/bin/rm"
  export PATH="${root}/bin:${PATH}"
  local tool
  for tool in git mkdir sleep rm; do
    [[ "$(command -v "${tool}")" == "${root}/bin/${tool}" ]] || return 1
  done
  export CLAIMS_BARRIER="${root}/barrier"
  export WORKTREE_RESOURCES_FILE="${root}/claims.json"
  export STUB_GIT_WORKTREE_PORCELAIN='worktree /repo/live
HEAD aaa
branch refs/heads/main
'
  # Seed a file so both writers exercise the validated snapshot read.
  printf '{"version":1,"claims":[]}' > "${WORKTREE_RESOURCES_FILE}"
  if [[ "${CLAIMS_INTERLEAVE_MODE}" == stale ]]; then
    mkdir "${WORKTREE_RESOURCES_FILE}.lock"
    sh -c 'echo $$' > "${WORKTREE_RESOURCES_FILE}.lock/owner"
    CLAIMS_WRITER=second capture_child - --exec-log "${root}/second.log" -- bash "${MANAGE_RESOURCE_CLAIMS_BIN}" claim simulator --worktree /repo/live --branch main &
    second=$!
    SECOND_WRITER="${second}"
    await_event second-blocked || return 1
    # Simulate explicit removal of this fixture's stale owner before a live
    # writer takes over. The waiting subject must never remove the replacement.
    rm "${WORKTREE_RESOURCES_FILE}.lock/owner"
    CLAIMS_WRITER=first capture_child - --exec-log "${root}/first.log" -- bash "${MANAGE_RESOURCE_CLAIMS_BIN}" claim logic --worktree /repo/live --branch main &
    first=$!
    FIRST_WRITER="${first}"
    await_event first-read || return 1
    touch "${CLAIMS_BARRIER}/release-waiter"
    wait "${second}" || second_status=$?
    SECOND_WRITER=''
    if [[ "${second_status}" != 1 || "$(cat "${WORKTREE_RESOURCES_FILE}.lock/owner")" != "${first}" ]] \
      || ! grep -q 'which is still running' "${root}/second.log"; then
      cat "${root}/first.log" "${root}/second.log"
      return 1
    fi
    touch "${CLAIMS_BARRIER}/release-first"
    capture_child - --wait-log "${root}/first.log" "${first}" || first_status=$?
    FIRST_WRITER=''
    ((first_status == 0)) || return 1
    echo 'stale waiter refused; live owner preserved'
    return
  fi
  CLAIMS_WRITER=first capture_child - --exec-log "${root}/first.log" -- bash "${MANAGE_RESOURCE_CLAIMS_BIN}" claim logic --worktree /repo/live --branch main &
  first=$!
  FIRST_WRITER="${first}"
  if ! await_event first-read; then
    touch "${CLAIMS_BARRIER}/release-first"
    capture_child - --wait-log "${root}/first.log" "${first}" || first_status=$?
    FIRST_WRITER=''
    printf 'claim writer exit statuses: logic=%s simulator=not-started\n' "${first_status}"
    return 1
  fi
  if [[ "${CLAIMS_INTERLEAVE_MODE}" == release ]]; then
    touch "${CLAIMS_BARRIER}/release-first"
    await_event first-owner-removed || return 1
  fi
  CLAIMS_WRITER=second capture_child - --exec-log "${root}/second.log" -- bash "${MANAGE_RESOURCE_CLAIMS_BIN}" claim simulator --worktree /repo/live --branch main &
  second=$!
  SECOND_WRITER="${second}"
  if [[ "${CLAIMS_INTERLEAVE_MODE}" == release ]]; then
    await_event second-read || return 1
    touch "${CLAIMS_BARRIER}/release-cleanup"
    capture_child - --wait-log "${root}/first.log" "${first}" || first_status=$?
    FIRST_WRITER=''
    [[ "$(cat "${WORKTREE_RESOURCES_FILE}.lock/owner")" == "${second}" ]] || return 1
    touch "${CLAIMS_BARRIER}/release-second"
    capture_child - --wait-log "${root}/second.log" "${second}" || second_status=$?
    SECOND_WRITER=''
    ((first_status == 0 && second_status == 0)) || return 1
    jq -c '[.claims[].resource] | sort' "${WORKTREE_RESOURCES_FILE}"
    return
  fi
  if ! await_event second-blocked second-read; then
    touch "${CLAIMS_BARRIER}/release-first"
    capture_child - --wait-log "${root}/first.log" "${first}" || first_status=$?
    FIRST_WRITER=''
    capture_child - --wait-log "${root}/second.log" "${second}" || second_status=$?
    SECOND_WRITER=''
    printf 'claim writer exit statuses: logic=%s simulator=%s\n' "${first_status}" "${second_status}"
    return 1
  fi
  if [[ -n "${CLAIMS_INTERRUPT_CONTROL:-}" ]]; then
    printf '%s %s\n' "${first}" "${second}" > "${CLAIMS_INTERRUPT_CONTROL}/writers"
    touch "${CLAIMS_INTERRUPT_CONTROL}/ready"
    await_event interrupt-release || return 1
  fi
  # Without serialization, finish the second writer before releasing the old snapshot.
  if [[ -f "${CLAIMS_BARRIER}/second-read" ]]; then
    capture_child - --wait-log "${root}/second.log" "${second}" || second_status=$?
    SECOND_WRITER=''
  fi
  touch "${CLAIMS_BARRIER}/release-first"
  capture_child - --wait-log "${root}/first.log" "${first}" || first_status=$?
  FIRST_WRITER=''
  if [[ -n "${SECOND_WRITER}" ]]; then
    capture_child - --wait-log "${root}/second.log" "${second}" || second_status=$?
    SECOND_WRITER=''
  fi
  if [[ "${first_status}" -ne 0 || "${second_status}" -ne 0 ]]; then
    printf 'claim writer exit statuses: logic=%s simulator=%s\n' "${first_status}" "${second_status}"
    return 1
  fi
  jq -c '[.claims[].resource] | sort' "${WORKTREE_RESOURCES_FILE}"
}

main "$@"
