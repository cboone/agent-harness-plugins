#!/usr/bin/env bash
# Check reservation identity without relying on PID contents.
set -euo pipefail
# shellcheck source=bin/lib/capture-child.bash
source "${REPO_ROOT:?}/bin/lib/capture-child.bash"
# shellcheck source=plugins/workmux/scripts/owner-lock.bash
source "${OWNER_LOCK_LIBRARY:?}"
PROBE_DIRECTORY=""
FIRST_PID=""
SECOND_PID=""

function await_marker() {
  local root="${1}" first="${2}" second="${3:-${2}}" attempt
  for ((attempt = 0; attempt < 300; attempt++)); do
    [[ ! -e "${root}/${first}" && ! -e "${root}/${second}" ]] || return 0
    sleep 0.02
  done
  echo "owner contention barrier timed out: ${first}" >&2
  return 1
}

function probe_cleanup() {
  local result=$?
  trap - EXIT
  touch "${PROBE_DIRECTORY}/open-first" "${PROBE_DIRECTORY}/open-second" "${PROBE_DIRECTORY}/release-first" "${PROBE_DIRECTORY}/release-second" || result=1
  if [[ -n "${FIRST_PID}" ]]; then wait "${FIRST_PID}" || :; fi
  if [[ -n "${SECOND_PID}" ]]; then wait "${SECOND_PID}" || :; fi
  rm -r -- "${PROBE_DIRECTORY}" || result=1
  exit "${result}"
}

function contention_actor() {
  local root="${1}" role="${2}" slot="${3}" token result
  # Pause both actors after the owner-existence precheck so they contend at the exclusive open.
  function mktemp() {
    local temporary
    temporary="$(command mktemp "$@")" || return 1
    touch "${root}/ready-${role}"
    await_marker "${root}" "open-${role}" || return 1
    printf '%s' "${temporary}"
  }
  if owner_lock_reserve "${root}/owner" "${slot}"; then
    token="${OWNER_LOCK_TOKEN}"
    touch "${root}/owned-${role}"
    await_marker "${root}" "release-${role}" || return 3
    if owner_lock_release "${root}/owner" "${token}"; then return 0; else return 3; fi
  else
    result=$?
    printf '%s' "${result}" > "${root}/result-${role}"
    touch "${root}/done-${role}"
    return "${result}"
  fi
}

function contention_probe() {
  local root="${1}" slot="${2}" first_status=0 second_status=0
  capture_child - --exec-log "${root}/first.log" -- "${BASH}" "${BASH_SOURCE[0]}" actor "${root}" first "${slot}" &
  FIRST_PID=$!
  capture_child - --exec-log "${root}/second.log" -- "${BASH}" "${BASH_SOURCE[0]}" actor "${root}" second "${slot}" &
  SECOND_PID=$!
  await_marker "${root}" ready-first || return 1
  await_marker "${root}" ready-second || return 1
  touch "${root}/open-first"
  await_marker "${root}" owned-first || return 1
  touch "${root}/open-second"
  await_marker "${root}" done-second owned-second || return 1
  if [[ -e "${root}/owned-second" ]]; then
    echo 'two actors acquired the same owner' >&2
    return 1
  fi
  capture_child - --wait-log "${root}/second.log" "${SECOND_PID}" || second_status=$?
  SECOND_PID=""
  [[ "${second_status}" == 1 && "$(cat "${root}/result-second")" == 1 && ! -s "${root}/second.log" ]] || {
    cat "${root}/second.log"
    return 1
  }
  touch "${root}/release-first"
  capture_child - --wait-log "${root}/first.log" "${FIRST_PID}" || first_status=$?
  FIRST_PID=""
  [[ "${first_status}" == 0 && ! -e "${root}/owner" ]] || {
    cat "${root}/first.log"
    return 1
  }
  echo "slot ${slot}: exclusive open refused the second actor without diagnostics"
}

function open_error_actor() {
  local root="${1}" result
  function mktemp() {
    local temporary
    temporary="$(command mktemp "$@")" || return 1
    chmod 500 "${root}"
    printf '%s' "${temporary}"
  }
  if owner_lock_reserve "${root}/owner" 8; then
    chmod 700 "${root}"
    return 1
  else
    result=$?
  fi
  chmod 700 "${root}"
  [[ "${result}" == 2 && -z "${OWNER_LOCK_TOKEN}" && ! -e "${root}/owner" ]] || return 1
}

function open_error_probe() {
  local root="${1}" error
  capture_child error -- "${BASH}" "${BASH_SOURCE[0]}" open-error-actor "${root}" || return 1
  [[ "${error}" == *"cannot create ${root}/owner:"* && "${error}" == *'Permission denied'* ]] || return 1
  echo 'exclusive-open error: status 2; owner path and reason retained; no token'
}

function main() {
  if [[ "${1:-}" == open-error-actor ]]; then
    open_error_actor "${2}"
    return "$?"
  fi
  if [[ "${1:-}" == actor ]]; then
    contention_actor "${2}" "${3}" "${4}"
    return "$?"
  fi
  local root path first second
  root="$(mktemp -d "${TMPDIR:-/tmp}/scrut.XXXXXX")"
  PROBE_DIRECTORY="${root}"
  trap probe_cleanup EXIT
  if [[ "${1}" == open-error ]]; then
    open_error_probe "${root}"
    return "$?"
  fi
  if [[ "${1}" == contend8 || "${1}" == contend9 ]]; then
    contention_probe "${root}" "${1#contend}"
    return "$?"
  fi
  path="${root}/owner"
  owner_lock_reserve "${path}" 8 || exit 1
  first="${OWNER_LOCK_TOKEN}"
  case "${1}" in
    empty)
      [[ -f "${path}" && ! -s "${path}" ]] || exit 1
      owner_lock_release "${path}" "${first}" || exit 1
      [[ ! -e "${path}" ]] || exit 1
      echo 'empty reservation released'
      ;;
    successor)
      mv "${path}" "${root}/prior"
      printf 'successor\n' > "${path}"
      if owner_lock_release "${path}" "${first}"; then exit 1; fi
      [[ "$(cat "${path}")" == successor ]] || exit 1
      echo 'successor identity preserved'
      ;;
    stale)
      owner_lock_release "${path}" "${first}" || exit 1
      owner_lock_reserve "${path}" 8 || exit 1
      second="${OWNER_LOCK_TOKEN}"
      if owner_lock_release "${path}" "${first}"; then exit 1; fi
      owner_lock_release "${path}" "${second}" || exit 1
      echo 'stale token refused; current reservation released'
      ;;
    nested)
      owner_lock_reserve "${root}/rotation" 9 || exit 1
      second="${OWNER_LOCK_TOKEN}"
      owner_lock_release "${root}/rotation" "${second}" || exit 1
      owner_lock_release "${path}" "${first}" || exit 1
      echo 'independent session and rotation identities released'
      ;;
    *) exit 2 ;;
  esac
}

main "$@"
