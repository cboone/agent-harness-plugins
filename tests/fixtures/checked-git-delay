#!/usr/bin/env bash
# Delay Git only inside the fixture-owned stub PATH.
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "${CHECKED_GIT_FIXTURE_ROOT:?fixture root is required}/bin/lib/git-environment.bash"

function main() {
  local selected
  selected="$(command -v git)"
  if [[ ! "${selected}" -ef "${CHECKED_GIT_STUB:?stub path is required}" || ! "${BASH_SOURCE[0]}" -ef "${CHECKED_GIT_STUB}" ]]; then
    printf '%s\n' 'Git fixture requires its own stub PATH' >&2
    return 1
  fi
  printf '%s\n' ready > "${CHECKED_GIT_READY_FILE:?ready file is required}"
  sleep "${CHECKED_GIT_DELAY:?delay is required}"
  exec "${CHECKED_REAL_GIT:?real Git is required}" "$@"
}

main "$@"
