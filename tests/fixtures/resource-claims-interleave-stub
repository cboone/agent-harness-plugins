#!/usr/bin/env bash
# Pause the first writer after its snapshot read.
# Record when the second writer cannot acquire the lock.
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "${REPO_ROOT:?REPO_ROOT is required}/bin/lib/git-environment.bash"

CLAIMS_WRITER="${CLAIMS_WRITER:-controller}"
: "${CLAIMS_REAL_MKDIR:?}" "${WORKTREE_RESOURCES_FILE:?}"
: "${CLAIMS_BARRIER:?}" "${WORKTREE_GIT_STUB_BIN:?}"

function await_release() {
  local marker="${1}" message="${2}" attempt
  for ((attempt = 0; attempt < 200; attempt++)); do
    [[ ! -f "${CLAIMS_BARRIER}/${marker}" ]] || return 0
    "${CLAIMS_REAL_SLEEP:?}" 0.05
  done
  echo "${message}" >&2
  return 1
}

case "${0##*/}" in
  mkdir)
    status=0
    "${CLAIMS_REAL_MKDIR}" "$@" || status=$?
    if [[ $# -eq 1 && "${1}" == "${WORKTREE_RESOURCES_FILE}.lock" && "${CLAIMS_INTERLEAVE_MODE:-snapshot}" != snapshot && -d "${1}" ]]; then
      status=0
    fi
    exit "${status}"
    ;;
  sleep)
    if [[ "${CLAIMS_WRITER}" == second ]]; then
      touch "${CLAIMS_BARRIER}/second-blocked"
      if [[ "${CLAIMS_INTERLEAVE_MODE:-snapshot}" == stale ]]; then
        await_release release-waiter 'stale waiter barrier timed out'
        exit 0
      fi
    fi
    exec "${CLAIMS_REAL_SLEEP:?}" "$@"
    ;;
  rm)
    "${CLAIMS_REAL_RM:?}" "$@"
    if [[ "${CLAIMS_INTERLEAVE_MODE:-snapshot}" == release && "${CLAIMS_WRITER}" == first && "${1:-}" == "${WORKTREE_RESOURCES_FILE}.lock/owner" ]]; then
      touch "${CLAIMS_BARRIER}/first-owner-removed"
      await_release release-cleanup 'cleanup barrier timed out'
      exit 0
    fi
    ;;
  git)
    if [[ "${1:-}" == worktree ]]; then
      if [[ "${CLAIMS_WRITER}" == first ]]; then
        touch "${CLAIMS_BARRIER}/first-read"
        for ((attempt = 0; attempt < 200; attempt++)); do
          if [[ -f "${CLAIMS_BARRIER}/release-first" ]]; then
            if [[ -n "${CLAIMS_INTERRUPT_CONTROL:-}" ]]; then
              touch "${CLAIMS_INTERRUPT_CONTROL}/first-released"
            fi
            exec "${WORKTREE_GIT_STUB_BIN}" "$@"
          fi
          sleep 0.05
        done
        echo 'first writer barrier timed out' >&2
        exit 1
      fi
      touch "${CLAIMS_BARRIER}/second-read"
      if [[ "${CLAIMS_INTERLEAVE_MODE:-snapshot}" == release ]]; then
        await_release release-second 'second writer barrier timed out'
        exec "${WORKTREE_GIT_STUB_BIN}" "$@"
      fi
    fi
    exec "${WORKTREE_GIT_STUB_BIN}" "$@"
    ;;
  *)
    echo 'install this fixture as git, mkdir, sleep and rm' >&2
    exit 1
    ;;
esac
