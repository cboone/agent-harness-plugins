#!/usr/bin/env bash
# gh-stub -- Test stub for the gh calls dependabot-prs fetch, bugs-gather and
# copilot-rounds-report make.
#
# Responses are JSON files under STUB_GH_DIR:
#   repo.json          gh repo view
#   dependabot.json    gh pr list --author app/dependabot
#   open.json          gh pr list (every author)
#   api/KEY.json       gh api ENDPOINT, where KEY is the endpoint with the
#                      repos/OWNER/REPO/ prefix and the query string removed and
#                      each / replaced by _ (compare_main...SHA, pulls_12_files)
#   graphql/search-KIND.json
#                      gh api graphql with search.graphql, where KIND is
#                      open-labels, closed-labels, open-type, or closed-type,
#                      read from the qualifiers in q; a missing file answers
#                      with no results
#   graphql/repository-NAME.json
#                      gh api graphql with repository.graphql
#   graphql/NAME.json  gh api graphql with any other NAME.graphql, such as
#                      copilot-rounds-report's copilot-rounds.graphql, whose
#                      file holds the array of pages --slurp returns
#
# An api call with no response file fails the way gh does for a missing
# resource. STUB_GH_API_FAIL names one KEY that fails with a permission error
# instead, STUB_GH_AUTH_FAIL=1 makes gh auth token fail, and STUB_GH_LOG, when
# set, receives every invocation, one per line. A graphql call is logged as
# its query file and variables, without the path of the query file.
# STUB_GH_GRAPHQL_FAIL names one search KIND, repository-NAME or other query
# NAME that fails.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

function respond() {
  local file="${STUB_GH_DIR:?STUB_GH_DIR must be set}/${1}"
  [[ -f "${file}" ]] || die "missing stub response ${file}"
  cat "${file}"
}

function api_key() {
  local endpoint="${1}"

  endpoint="${endpoint%%\?*}"
  if [[ "${endpoint}" =~ ^repos/[^/]+/[^/]+/(.*)$ ]]; then
    endpoint="${BASH_REMATCH[1]}"
  fi
  printf '%s' "${endpoint//\//_}"
}

function do_api() {
  local endpoint=""
  local arg
  for arg in "${@}"; do
    case "${arg}" in
      --paginate | --slurp) ;;
      -*) die "unexpected gh api flag ${arg}" ;;
      *)
        [[ -z "${endpoint}" ]] || die "unexpected second gh api operand ${arg}"
        endpoint="${arg}"
        ;;
    esac
  done
  [[ -n "${endpoint}" ]] || die "gh api needs an endpoint"

  local key
  key="$(api_key "${endpoint}")"

  if [[ "${key}" == "${STUB_GH_API_FAIL:-}" ]]; then
    echo "gh: Resource not accessible by integration (HTTP 403)" >&2
    exit 1
  fi

  if [[ ! -f "${STUB_GH_DIR:?STUB_GH_DIR must be set}/api/${key}.json" ]]; then
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
  fi
  respond "api/${key}.json"
}

function do_pr_list() {
  local arg
  for arg in "${@}"; do
    if [[ "${arg}" == "app/dependabot" ]]; then
      respond "dependabot.json"
      return 0
    fi
  done
  respond "open.json"
}

# Answers gh api graphql. bugs-gather passes the query as -F query=@FILE and
# its variables as -f or -F NAME=VALUE. Its searches run with --paginate
# --slurp, so a search file holds the array of pages --slurp returns; the
# repository query runs without them, so its file holds one response.
function do_graphql() {
  local query_name="" search_text="" repo_name="" arg value
  local -a variables=()
  while [[ $# -gt 0 ]]; do
    arg="${1}"
    shift
    case "${arg}" in
      --paginate | --slurp) ;;
      -f | -F)
        [[ $# -gt 0 ]] || die "gh api graphql ${arg} needs a value"
        value="${1}"
        shift
        case "${value}" in
          query=@*)
            query_name="${value#query=@}"
            query_name="${query_name##*/}"
            query_name="${query_name%.graphql}"
            ;;
          q=*)
            search_text="${value#q=}"
            variables+=("${value}")
            ;;
          name=*)
            repo_name="${value#name=}"
            variables+=("${value}")
            ;;
          *) variables+=("${value}") ;;
        esac
        ;;
      *) die "unexpected gh api graphql argument ${arg}" ;;
    esac
  done
  [[ -n "${query_name}" ]] || die "gh api graphql needs -F query=@FILE"

  if [[ -n "${STUB_GH_LOG:-}" ]]; then
    printf 'gh api graphql %s %s\n' "${query_name}" "${variables[*]:-}" >> "${STUB_GH_LOG}"
  fi

  local key
  if [[ "${query_name}" == "search" ]]; then
    case " ${search_text} " in
      *" is:open "*"label:"*) key="open-labels" ;;
      *" is:closed "*"label:"*) key="closed-labels" ;;
      *" is:open "*"type:"*) key="open-type" ;;
      *" is:closed "*"type:"*) key="closed-type" ;;
      *) die "unexpected search ${search_text}" ;;
    esac
  elif [[ "${query_name}" == "repository" ]]; then
    key="repository-${repo_name}"
  else
    key="${query_name}"
  fi

  if [[ "${key}" == "${STUB_GH_GRAPHQL_FAIL:-}" ]]; then
    echo "gh: HTTP 502: Bad Gateway (https://api.github.com/graphql)" >&2
    exit 1
  fi

  local file="${STUB_GH_DIR:?STUB_GH_DIR must be set}/graphql/${key}.json"
  [[ "${query_name}" != "search" ]] || file="${STUB_GH_DIR}/graphql/search-${key}.json"
  if [[ -f "${file}" ]]; then
    cat "${file}"
  elif [[ "${query_name}" == "search" ]]; then
    printf '[{"data":{"search":{"issueCount":0,"pageInfo":{"hasNextPage":false,"endCursor":null},"nodes":[]}}}]\n'
  elif [[ "${query_name}" == "repository" ]]; then
    echo "gh: Could not resolve to a Repository with the name ${repo_name}." >&2
    exit 1
  else
    die "missing stub response ${file}"
  fi
}

function main() {
  if [[ -n "${STUB_GH_LOG:-}" && "${1:-} ${2:-}" != "api graphql" ]]; then
    printf 'gh %s\n' "${*}" >> "${STUB_GH_LOG}"
  fi

  case "${1:-} ${2:-}" in
    "api graphql") do_graphql "${@:3}" ;;
    "auth token")
      if [[ "${STUB_GH_AUTH_FAIL:-}" == "1" ]]; then
        echo "no oauth token found for github.com" >&2
        exit 1
      fi
      echo "stub-token"
      ;;
    "repo view") respond "repo.json" ;;
    "pr list") do_pr_list "${@:3}" ;;
    api\ *) do_api "${@:2}" ;;
    *) die "unexpected invocation: gh ${*}" ;;
  esac
}

main "${@}"
