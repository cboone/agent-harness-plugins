#!/usr/bin/env bash
# Synchronize both claim attempts before delegating to the real filesystem.
set -euo pipefail

function main() {
  local target="" barrier="${ROLLOUT_CLAIM_BARRIER:-}" attempt
  if [[ -n "${barrier}" ]]; then
    exec 2>> "${barrier}/${ROLLOUT_READER:?}.log"
    printf 'mkdir start %s: %s\n' "$(date -u +%FT%TZ)" "$*" >&2
  fi
  for target in "$@"; do :; done
  if [[ -n "${barrier}" ]]; then
    case "${target}" in
      "${XDG_CACHE_HOME:?}/agent-harness-notify/codex-failures/"*)
        if /bin/mkdir "${barrier}/first" 2> /dev/null; then
          echo 'first reader reached barrier' >&2
        else
          echo 'second reader reached barrier' >&2
          /bin/mkdir "${barrier}/second"
        fi
        for ((attempt = 0; attempt < 150; attempt++)); do
          [[ ! -d "${barrier}/second" ]] || break
          /bin/sleep 0.02
        done
        if ((attempt == 150)); then
          ls -la "${barrier}" "${XDG_CACHE_HOME}" >&2
          echo 'Concurrent claim barrier was not reached by both readers' >&2
          return 1
        fi
        printf 'barrier released %s after %s attempts\n' "$(date -u +%FT%TZ)" "${attempt}" >&2
        ;;
      *) ;;
    esac
  fi
  exec /bin/mkdir "$@"
}

main "$@"
