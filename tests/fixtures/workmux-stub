#!/usr/bin/env bash
# Test stub for workmux add.
set -euo pipefail

function die() {
  echo "workmux-stub: ${1}" >&2
  exit "${2:-1}"
}

function main() {
  if [[ $# -lt 2 || "${1}" != "add" ]]; then
    die "expected workmux add invocation"
  fi
  shift

  local branch=""
  local prompt_file=""
  local base_branch=""
  local open_if_exists="false"
  local auto_name="false"
  local dry_run="false"

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --open-if-exists)
        open_if_exists="true"
        shift
        ;;
      -A)
        auto_name="true"
        shift
        ;;
      --dry-run)
        dry_run="true"
        shift
        ;;
      -P)
        if [[ $# -lt 2 ]]; then
          die "-P requires a prompt file"
        fi
        prompt_file="${2}"
        shift 2
        ;;
      --base)
        if [[ $# -lt 2 ]]; then
          die "--base requires a branch"
        fi
        base_branch="${2}"
        shift 2
        ;;
      -*)
        die "unexpected argument: ${1}"
        ;;
      *)
        if [[ -n "${branch}" ]]; then
          die "unexpected argument: ${1}"
        fi
        branch="${1}"
        shift
        ;;
    esac
  done

  if [[ -z "${prompt_file}" ]]; then
    die "missing -P prompt file"
  fi

  # Branch-name generation: `workmux add -A -P <file> --dry-run` runs the LLM
  # and prints the name twice, once from the generator and once from the
  # dry-run summary, without creating anything.
  if [[ "${dry_run}" == "true" ]]; then
    if [[ "${auto_name}" != "true" ]]; then
      die "--dry-run is only stubbed for -A"
    fi
    if [[ -n "${branch}" ]]; then
      die "unexpected branch name with -A: ${branch}"
    fi

    if [[ -n "${STUB_STATE:-}" ]]; then
      mkdir -p "${STUB_STATE}"
      cp "${prompt_file}" "${STUB_STATE}/auto_name_input"
    fi

    if [[ "${STUB_AUTO_NAME_FAIL:-}" == "1" ]]; then
      echo "workmux-stub: LLM did not return a concise branch name" >&2
      exit 1
    fi

    local generated="${STUB_AUTO_NAME:-feature/generated-name}"
    printf '  Branch: %s\n' "${generated}"
    printf 'Worktree: /tmp/worktrees/%s\n' "${generated##*/}"
    printf 'Branch:   %s\n' "${generated}"
    printf 'Base:     main\n'
    return 0
  fi

  if [[ -z "${branch}" ]]; then
    die "expected a branch name"
  fi

  if [[ -n "${STUB_STATE:-}" ]]; then
    mkdir -p "${STUB_STATE}"
    printf '%s' "${prompt_file}" > "${STUB_STATE}/prompt_path"
  fi

  printf 'workmux add\n'
  printf 'branch: %s\n' "${branch}"
  printf 'open-if-exists: %s\n' "${open_if_exists}"
  if [[ "${STUB_CAPTURE_TERM:-}" == "1" ]]; then
    printf 'term: %s\n' "${TERM:-<unset>}"
  fi
  if [[ "${STUB_CAPTURE_TMUX:-}" == "1" ]]; then
    printf 'tmux: %s\n' "${TMUX:-<unset>}"
  fi
  if [[ -n "${base_branch}" ]]; then
    printf 'base: %s\n' "${base_branch}"
  fi
  printf 'prompt:\n'
  cat "${prompt_file}"
  printf 'prompt-file-exists: '
  if [[ -e "${prompt_file}" ]]; then
    printf 'yes\n'
  else
    printf 'no\n'
  fi
}

main "$@"
