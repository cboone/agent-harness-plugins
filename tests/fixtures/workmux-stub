#!/usr/bin/env bash
# Test stub for workmux add.
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "${REPO_ROOT:?REPO_ROOT is required}/bin/lib/git-environment.bash"

function die() {
  echo "workmux-stub: ${1}" >&2
  exit "${2:-1}"
}

function main() {
  if [[ $# -lt 2 || "${1}" != "add" ]]; then
    die "expected workmux add invocation"
  fi
  shift

  local branch=""
  local prompt_file=""
  local base_branch=""
  local config_file="" agent=""
  local open_if_exists="false"

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --config | --agent)
        [[ $# -ge 2 ]] || die "${1} requires a value"
        if [[ "${1}" == --config ]]; then config_file="${2}"; else agent="${2}"; fi
        shift 2
        ;;
      --open-if-exists)
        open_if_exists="true"
        shift
        ;;
      -A | --auto-name | --dry-run)
        die "naming invocations are forbidden"
        ;;
      -P)
        if [[ $# -lt 2 ]]; then
          die "-P requires a prompt file"
        fi
        prompt_file="${2}"
        shift 2
        ;;
      --base)
        if [[ $# -lt 2 ]]; then
          die "--base requires a branch"
        fi
        base_branch="${2}"
        shift 2
        ;;
      -*)
        die "unexpected argument: ${1}"
        ;;
      *)
        if [[ -n "${branch}" ]]; then
          die "unexpected argument: ${1}"
        fi
        branch="${1}"
        shift
        ;;
    esac
  done

  if [[ -z "${prompt_file}" ]]; then
    die "missing -P prompt file"
  fi

  if [[ -z "${branch}" ]]; then
    die "expected a branch name"
  fi

  if [[ -n "${STUB_STATE:-}" ]]; then
    mkdir -p "${STUB_STATE}"
    if [[ -e "${STUB_STATE}/workmux_called" ]]; then
      die "expected exactly one workmux invocation"
    fi
    touch "${STUB_STATE}/workmux_called"
    printf '%s' "${prompt_file}" > "${STUB_STATE}/prompt_path"
    # Records the process group, so a test can confirm an awaited launch runs
    # in its own.
    ps -o pgid= -p "$$" | tr -d ' ' > "${STUB_STATE}/pgid"
  fi

  if [[ -n "${STUB_WORKMUX_REAL_WORKTREE:-}" ]]; then
    git worktree add --quiet "${STUB_WORKMUX_REAL_WORKTREE}" "${branch}"
  fi

  printf 'workmux add\n'
  if [[ -n "${STUB_STATE:-}" ]]; then
    touch "${STUB_STATE}/output-ready"
  fi
  if [[ -n "${STUB_WORKMUX_RELEASE_FIFO:-}" ]]; then
    local _release
    IFS= read -r _release < "${STUB_WORKMUX_RELEASE_FIFO}"
  fi

  # Delay remaining output and prompt access to expose premature log reads or prompt removal.
  if [[ -n "${STUB_WORKMUX_SLEEP:-}" ]]; then
    sleep "${STUB_WORKMUX_SLEEP}"
  fi

  printf 'branch: %s\n' "${branch}"
  if [[ -n "${config_file}" ]]; then printf 'config: %s\n' "${config_file}"; fi
  if [[ -n "${agent}" ]]; then printf 'agent: %s\n' "${agent}"; fi
  printf 'open-if-exists: %s\n' "${open_if_exists}"
  if [[ "${STUB_CAPTURE_TERM:-}" == "1" ]]; then
    printf 'term: %s\n' "${TERM:-<unset>}"
  fi
  if [[ "${STUB_CAPTURE_TMUX:-}" == "1" ]]; then
    printf 'tmux: %s\n' "${TMUX:-<unset>}"
  fi
  if [[ -n "${base_branch}" ]]; then
    printf 'base: %s\n' "${base_branch}"
  fi
  printf 'prompt:\n'
  cat "${prompt_file}"
  printf 'prompt-file-exists: '
  if [[ -e "${prompt_file}" ]]; then
    printf 'yes\n'
  else
    printf 'no\n'
  fi

  # Records the worktree for the git stub's `git worktree list`, unless
  # STUB_WORKMUX_SKIP_WORKTREE=1. Runs before any STUB_WORKMUX_EXIT failure,
  # so a failed launch can still leave a worktree.
  if [[ -n "${STUB_GIT_WORKTREE_PORCELAIN_FILE:-}" && "${STUB_WORKMUX_SKIP_WORKTREE:-}" != "1" ]]; then
    printf 'worktree /worktrees/%s\nHEAD abc123\nbranch refs/heads/%s\n\n' "${branch//\//-}" "${branch}" >> "${STUB_GIT_WORKTREE_PORCELAIN_FILE}"
  fi

  if [[ -n "${STUB_WORKMUX_EXIT:-}" ]]; then
    printf 'workmux-stub: failing with status %s\n' "${STUB_WORKMUX_EXIT}" >&2
    exit "${STUB_WORKMUX_EXIT}"
  fi
}

main "$@"
