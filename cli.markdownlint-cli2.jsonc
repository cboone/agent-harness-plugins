{
  // CLI-only markdownlint-cli2 config that adds ESM custom rules.
  //
  // The VSCode markdownlint extension cannot import ESM modules due to a
  // VS Code platform limitation, so customRules are kept out of the
  // auto-discovered .markdownlint-cli2.jsonc and loaded here via --config.
  // https://github.com/DavidAnson/vscode-markdownlint/issues/349
  //
  // Rule configuration is duplicated from .markdownlint-cli2.jsonc because
  // --config replaces auto-discovery entirely.

  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",

  "config": {
    "extends": ".markdownlint.jsonc",
  },

  // dist/ holds the generated Codex and OpenCode mirrors. Linting them reports
  // every finding a second time, and dist/opencode/skills/* are symlinks back
  // into plugins/, so fast-glob followed them and linted each source file three
  // times over. A finding there is also unfixable in place: the only remedy is
  // to edit the source and rebuild.
  "ignores": [".workmux/", "**/node_modules/**", "dist/"],

  // markdownlint-rule-force-align-table-columns was removed here. It supplied
  // MD060A, a duplicate of the built-in MD060 pinned to the aligned style, and
  // because MD060 itself was never set the two ran together on every table and
  // emitted opposing instructions: MD060 said remove the padding, MD060A said
  // add it. Prettier performs the alignment now, and .markdownlint.jsonc sets
  // MD060 to false.
  //
  // This file still has to exist: @github/markdownlint-github is also ESM, so
  // the VS Code limitation above is unchanged by that removal.
  "customRules": ["@github/markdownlint-github", "markdownlint-rule-relative-links"],
}
