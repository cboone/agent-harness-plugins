# Optional checks that align with the write-bash-scripts style guide.
#
# check-extra-masked-returns (SC2312) and check-set-e-suppressed (SC2310) are
# deliberately NOT enabled. The audit and build scripts here route every network
# lookup through a helper that swallows its own failures on purpose, because one
# unreachable registry must not abort a whole run and suppress its report. Those
# two checks flag that pattern at every call site, so enabling them would mean
# either 44 inline suppressions or fighting the design. CI runs shellcheck at
# its default severity, so every check listed below is actually enforced.
enable=add-default-case
enable=avoid-negated-conditions
enable=avoid-nullary-conditions
enable=check-unassigned-uppercase
enable=deprecate-which
enable=quote-safe-variables
enable=require-double-brackets
enable=require-variable-braces
enable=useless-use-of-cat

# Follow source directives for cross-file analysis
external-sources=true
