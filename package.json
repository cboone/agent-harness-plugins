{
  "private": true,
  "packageManager": "yarn@4.12.0",
  "description": "Lint tooling for cboone-cc-plugins",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn lint:md && yarn lint:prettier",
    "lint:fix": "yarn lint:md:fix && yarn format",
    "lint:md": "markdownlint-cli2 --config cli.markdownlint-cli2.jsonc \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --config cli.markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:prettier": "prettier --check .",
    "validate": "bin/validate-plugins"
  },
  "devDependencies": {
    "@github/markdownlint-github": "^0.8.0",
    "markdownlint-cli2": "^0.20.0",
    "markdownlint-rule-force-align-table-columns": "^0.1.1",
    "markdownlint-rule-relative-links": "^4.2.0",
    "prettier": "^3.8.1"
  }
}
