{
  "private": true,
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "description": "Lint tooling for agent-harness-plugins",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "yarn lint:md && yarn lint:prettier",
    "lint:fix": "yarn lint:md:fix && yarn format",
    "lint:md": "markdownlint-cli2 --config cli.markdownlint-cli2.jsonc \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --config cli.markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:prettier": "prettier --check .",
    "validate": "bin/validate-plugins"
  },
  "devDependencies": {
    "@github/markdownlint-github": "0.8.3",
    "markdownlint-cli2": "0.23.2",
    "markdownlint-rule-relative-links": "5.1.2",
    "prettier": "3.9.6"
  }
}
