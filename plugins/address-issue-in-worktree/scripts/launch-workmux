#!/usr/bin/env bash
# launch-workmux -- Create a worktree + tmux window via workmux, fully detached.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function usage() {
  cat << 'USAGE_TEXT'
Usage: launch-workmux <branch-name> [--base <branch>]
       launch-workmux --auto-name [--issue <n>] [--base <branch>]

Create a worktree and tmux window via workmux, fully detached from the
calling process. Waits briefly for workmux to initialize, then outputs
the log and cleans up. Reads the workmux prompt from stdin.

With --auto-name, the branch name comes from workmux's own generator
(`workmux add -A --dry-run`), which reads the prompt. Whatever it returns
is used as-is, apart from inserting the issue number when --issue is given.

Arguments:
  branch-name      Name of the git branch to create/open

Options:
  --auto-name      Ask workmux to generate the branch name from the prompt
  --issue <n>      Insert issue number <n> into the generated name; reuse an
                   existing local branch for that issue when one exists.
                   Requires --auto-name.
  --base <branch>  Specify the base branch for the worktree
  -h, --help       Show this help
USAGE_TEXT
}

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

function remove_file_if_present() {
  local file="${1}"

  if [[ ! -e "${file}" && ! -L "${file}" ]]; then
    return 0
  fi

  if rm -- "${file}" 2> /dev/null; then
    return 0
  fi

  [[ ! -e "${file}" && ! -L "${file}" ]]
}

function write_escaped_prompt() {
  local prompt_file="${1}"
  local raw_prompt status

  if [[ -t 0 ]]; then
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  raw_prompt="$(mktemp "${prompt_file}.raw.XXXXXX")"
  cat > "${raw_prompt}"

  if [[ ! -s "${raw_prompt}" ]]; then
    remove_file_if_present "${raw_prompt}"
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  set +e
  sed -e 's/{{/{{ "{{" }}/g' \
    -e 's/{%/{{ "{%" }}/g' \
    -e 's/{#/{{ "{#" }}/g' \
    "${raw_prompt}" > "${prompt_file}"
  status=$?
  set -e

  remove_file_if_present "${raw_prompt}"
  if ((status != 0)); then
    remove_file_if_present "${prompt_file}"
    return "${status}"
  fi
}

function run_workmux_and_cleanup_prompt() {
  local prompt_file="${1}"
  local status
  shift

  set +e
  "${@}"
  status=$?
  set -e

  remove_file_if_present "${prompt_file}"
  return "${status}"
}

function worktree_path_for_branch() {
  local branch="${1}"
  local line path="" branch_ref=""

  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      worktree\ *)
        path="${line#worktree }"
        branch_ref=""
        ;;
      branch\ refs/heads/*)
        branch_ref="${line#branch refs/heads/}"
        ;;
      "") # End of one worktree record in `git worktree list --porcelain`.
        if [[ "${branch_ref}" == "${branch}" && -n "${path}" ]]; then
          printf '%s' "${path}"
          return 0
        fi
        path=""
        branch_ref=""
        ;;
      *) # Other porcelain fields (HEAD, bare, detached) are not needed here.
        ;;
    esac
  done < <(git worktree list --porcelain 2> /dev/null || true)

  if [[ "${branch_ref}" == "${branch}" && -n "${path}" ]]; then
    printf '%s' "${path}"
    return 0
  fi

  return 1
}

function tmux_socket_candidates() {
  local uid dir socket socket_dir
  local -a dirs=()

  uid="$(id -u)"
  if [[ -n "${TMUX_TMPDIR:-}" ]]; then
    dirs+=("${TMUX_TMPDIR}/tmux-${uid}")
  fi
  dirs+=("/tmp/tmux-${uid}" "/private/tmp/tmux-${uid}")

  for dir in "${dirs[@]}"; do
    [[ -d "${dir}" ]] || continue
    for socket in "${dir}"/*; do
      [[ -S "${socket}" ]] || continue
      socket_dir="$(cd "$(dirname "${socket}")" && pwd -P)"
      printf '%s/%s\n' "${socket_dir}" "$(basename "${socket}")"
    done
  done | sort -u
}

function resolved_tmux_env() {
  if [[ -n "${TMUX:-}" ]]; then
    printf '%s' "${TMUX}"
    return
  fi

  if [[ -n "${WORKMUX_TMUX:-}" ]]; then
    printf '%s' "${WORKMUX_TMUX}"
    return
  fi

  command -v tmux > /dev/null || return 0

  local cwd socket pane_id pane_command pane_path server_pid candidate
  local count=0
  cwd="$(pwd -P)"

  while IFS= read -r socket; do
    while IFS='|' read -r pane_id pane_command pane_path server_pid; do
      if [[ -d "${pane_path}" ]]; then
        if ! pane_path="$(cd "${pane_path}" 2> /dev/null && pwd -P)"; then
          continue
        fi
      fi
      [[ "${pane_path}" == "${cwd}" ]] || continue

      case "${pane_command}" in
        codex* | cx) ;;
        *) continue ;;
      esac

      candidate="${socket},${server_pid},${pane_id}"
      count=$((count + 1))
    done < <(tmux -S "${socket}" list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}|#{pid}' 2> /dev/null || true)
  done < <(tmux_socket_candidates)

  if ((count == 1)); then
    printf '%s' "${candidate}"
  fi

  return 0
}

function codex_pane_for_path() {
  local tmux_env="${1}" worktree_path="${2}"
  local pane_id pane_command pane_path candidate
  local count=0

  [[ -n "${tmux_env}" ]] || return 0
  [[ -d "${worktree_path}" ]] || return 0
  if ! worktree_path="$(cd "${worktree_path}" 2> /dev/null && pwd -P)"; then
    return 0
  fi

  while IFS='|' read -r pane_id pane_command pane_path; do
    if [[ -d "${pane_path}" ]]; then
      if ! pane_path="$(cd "${pane_path}" 2> /dev/null && pwd -P)"; then
        continue
      fi
    fi
    [[ "${pane_path}" == "${worktree_path}" ]] || continue

    case "${pane_command}" in
      codex* | cx) ;;
      *) continue ;;
    esac

    candidate="${pane_id}"
    count=$((count + 1))
  done < <(env "TMUX=${tmux_env}" tmux list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}' 2> /dev/null || true)

  if ((count == 1)); then
    printf '%s' "${candidate}"
  fi

  return 0
}

function send_prompt_to_codex_pane() {
  local tmux_env="${1}" worktree_path="${2}" prompt_file="${3}" safe_name="${4}"
  local pane_id buffer delay tmux_status

  [[ -s "${prompt_file}" ]] || return 0
  [[ -n "${tmux_env}" ]] || return 0

  pane_id="$(codex_pane_for_path "${tmux_env}" "${worktree_path}" || true)"
  if [[ -z "${pane_id}" ]]; then
    return 0
  fi

  buffer="workmux-prompt-${safe_name}"
  delay="${WORKMUX_CODEX_PROMPT_SUBMIT_DELAY_SECONDS:-0.5}"

  tmux_status=0
  set +e
  env "TMUX=${tmux_env}" tmux load-buffer -b "${buffer}" "${prompt_file}"
  tmux_status=$?
  if ((tmux_status == 0)); then
    env "TMUX=${tmux_env}" tmux paste-buffer -t "${pane_id}" -b "${buffer}"
    tmux_status=$?
  fi
  if ((tmux_status == 0)); then
    sleep "${delay}"
    env "TMUX=${tmux_env}" tmux send-keys -t "${pane_id}" Enter
    tmux_status=$?
  fi
  if ((tmux_status == 0)); then
    sleep "${delay}"
    env "TMUX=${tmux_env}" tmux send-keys -t "${pane_id}" Enter
    tmux_status=$?
  fi
  env "TMUX=${tmux_env}" tmux delete-buffer -b "${buffer}" > /dev/null 2>&1
  set -e

  if ((tmux_status == 0)); then
    printf 'Sent prompt to existing Codex pane for %s\n' "${worktree_path}"
  fi

  return 0
}

function run_workmux_command() {
  local -a command=(workmux "${@}")
  local -a env_args=()
  local tmux_env
  tmux_env="$(resolved_tmux_env)"

  if [[ -n "${tmux_env}" ]]; then
    env_args+=("TMUX=${tmux_env}")
  fi

  if [[ -n "${WORKMUX_TERM:-}" ]]; then
    env_args+=("TERM=${WORKMUX_TERM}")
  elif [[ "${TERM:-}" == "dumb" && -n "${tmux_env}" ]]; then
    env_args+=(TERM=tmux-256color)
  fi

  if ((${#env_args[@]} > 0)); then
    env "${env_args[@]}" "${command[@]}"
  else
    "${command[@]}"
  fi
}

function run_workmux_with_existing_prompt_fallback() {
  local prompt_file="${1}" existing_worktree_path="${2}" safe_name="${3}"
  local status tmux_env prompt_to_send
  shift 3

  set +e
  run_workmux_command "${@}"
  status=$?
  set -e

  if ((status == 0)) && [[ -n "${existing_worktree_path}" ]]; then
    tmux_env="$(resolved_tmux_env)"
    prompt_to_send="${existing_worktree_path}/.workmux/PROMPT-${safe_name}.md"
    if [[ ! -s "${prompt_to_send}" ]]; then
      prompt_to_send="${prompt_file}"
    fi
    send_prompt_to_codex_pane "${tmux_env}" "${existing_worktree_path}" "${prompt_to_send}" "${safe_name}" || true
  fi

  return "${status}"
}

function existing_branch_for_issue() {
  local issue="${1}"
  local line match=""
  local count=0
  # Any number of path segments may precede the number, so "feature/42-x" and
  # "user/feature/42-x" both count as branches for issue 42.
  local pattern='^([^/]+/)*'"${issue}"'(-|$)'
  local -a candidates=()

  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -n "${line}" ]] || continue
    if [[ "${line}" =~ ${pattern} ]]; then
      candidates+=("${line}")
      match="${line}"
      count=$((count + 1))
    fi
  done < <(git for-each-ref --format='%(refname:short)' refs/heads/ 2> /dev/null || true)

  if ((count > 1)); then
    printf '%s: issue %s matches more than one local branch:\n' "${SCRIPT_NAME}" "${issue}" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    printf '%s: pass an explicit branch name instead\n' "${SCRIPT_NAME}" >&2
    return 1
  fi

  printf '%s' "${match}"
}

function last_branch_line() {
  local file="${1}"
  local line result=""
  local pattern='^[[:space:]]*Branch:[[:space:]]+(.+)$'

  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${pattern} ]]; then
      result="${BASH_REMATCH[1]}"
    fi
  done < "${file}"

  printf '%s' "${result}"
}

function strip_issue_number() {
  local slug="${1}"
  local issue="${2}"

  if [[ "${slug}" == "${issue}" || "${slug}" == "issue-${issue}" || "${slug}" == "issue${issue}" ]]; then
    return 0
  fi

  slug="${slug#"${issue}"-}"
  slug="${slug#"issue-${issue}"-}"
  slug="${slug#"issue${issue}"-}"
  # Only a trailing "-issue-N" is dropped. A bare trailing "-N" can belong to
  # the name itself, as in "migrate-to-python-3" for issue 3.
  slug="${slug%"-issue-${issue}"}"

  # Only an explicit "issue-N" marker is dropped from the middle of the name. A
  # bare interior "-N-" carries meaning often enough that removing it loses
  # more than it saves: "python-3-support" for issue 3 would become
  # "python-support". The cost of leaving it is the number appearing twice.
  while [[ "${slug}" == *-"issue-${issue}"-* ]]; do
    slug="${slug/-"issue-${issue}"-/-}"
  done
  while [[ "${slug}" == *-"issue${issue}"-* ]]; do
    slug="${slug/-"issue${issue}"-/-}"
  done

  printf '%s' "${slug}"
}

function validate_branch_name() {
  local name="${1}"

  # A leading hyphen would reach `workmux add` in option position.
  if [[ "${name}" == -* ]]; then
    die "workmux returned a branch name starting with a hyphen: ${name}"
  fi

  if command -v git > /dev/null && ! git check-ref-format --branch "${name}" > /dev/null 2>&1; then
    die "workmux returned a name git rejects as a branch: ${name}"
  fi
}

function normalize_branch_name() {
  local raw="${1}"
  local issue="${2:-}"
  local name prefix slug

  name="${raw//$'\r'/}"
  name="$(printf '%s' "${name}" | tr '[:upper:]' '[:lower:]')"
  while [[ "${name}" == [[:space:]]* ]]; do
    name="${name#?}"
  done
  while [[ "${name}" == *[[:space:]] ]]; do
    name="${name%?}"
  done

  if [[ -z "${name}" ]]; then
    die "workmux returned an empty branch name"
  fi

  if [[ -z "${issue}" ]]; then
    validate_branch_name "${name}"
    printf '%s' "${name}"
    return 0
  fi

  if [[ "${name}" == */* ]]; then
    prefix="${name%%/*}"
    slug="${name#*/}"
  else
    prefix=""
    slug="${name}"
  fi

  # Only the first slash separates the type prefix; the rest belong to the slug.
  slug="${slug//\//-}"
  slug="$(strip_issue_number "${slug}" "${issue}")"

  if [[ -z "${slug}" ]]; then
    slug="${issue}"
  else
    slug="${issue}-${slug}"
  fi

  if [[ -n "${prefix}" ]]; then
    name="${prefix}/${slug}"
  else
    name="${slug}"
  fi

  validate_branch_name "${name}"
  printf '%s' "${name}"
}

function generate_branch_name() {
  local prompt_file="${1}"
  local issue="${2:-}"
  local out err raw
  local status=0

  out="$(mktemp "/tmp/workmux-autoname.out.XXXXXX")"
  err="$(mktemp "/tmp/workmux-autoname.err.XXXXXX")"

  # Called directly rather than through run_workmux_command: a dry run creates
  # no tmux target, so it needs neither the TMUX plumbing nor the pane scan
  # that resolving it costs.
  set +e
  workmux add -A -P "${prompt_file}" --dry-run < /dev/null > "${out}" 2> "${err}"
  status=$?
  set -e

  if ((status != 0)); then
    cat "${err}" >&2
    remove_file_if_present "${out}"
    remove_file_if_present "${err}"
    printf '%s: workmux could not generate a branch name\n' "${SCRIPT_NAME}" >&2
    return "${status}"
  fi

  raw="$(last_branch_line "${out}")"
  remove_file_if_present "${out}"
  remove_file_if_present "${err}"

  if [[ -z "${raw}" ]]; then
    die "could not read a branch name from workmux --dry-run output"
  fi

  normalize_branch_name "${raw}" "${issue}"
}

function do_launch() {
  local branch="${1}"
  local base_branch="${2:-}"
  local auto_name="${3:-false}"
  local issue="${4:-}"
  local safe_name existing_worktree_path log prompt_file
  local provisional_name

  if [[ "${auto_name}" == "true" ]]; then
    if [[ -n "${issue}" ]]; then
      provisional_name="issue-${issue}"
    else
      provisional_name="auto-name"
    fi
  else
    provisional_name="${branch//\//-}"
  fi

  prompt_file="$(mktemp "/tmp/workmux-prompt-${provisional_name}.md.XXXXXX")"

  write_escaped_prompt "${prompt_file}"

  if [[ "${auto_name}" == "true" ]]; then
    local reused=""

    if [[ -n "${issue}" ]]; then
      if ! reused="$(existing_branch_for_issue "${issue}")"; then
        remove_file_if_present "${prompt_file}"
        return 1
      fi
    fi

    if [[ -n "${reused}" ]]; then
      branch="${reused}"
      printf 'Reusing branch %s for issue %s\n' "${branch}" "${issue}"
    else
      if ! branch="$(generate_branch_name "${prompt_file}" "${issue}")"; then
        remove_file_if_present "${prompt_file}"
        return 1
      fi
      printf 'Generated branch name: %s\n' "${branch}"
    fi
  fi

  safe_name="${branch//\//-}"
  existing_worktree_path="$(worktree_path_for_branch "${branch}" || true)"

  log="$(mktemp "/tmp/workmux-${safe_name}.log.XXXXXX")"

  local -a cmd=(
    run_workmux_with_existing_prompt_fallback
    "${prompt_file}" "${existing_worktree_path}" "${safe_name}"
    add "${branch}" --open-if-exists -P "${prompt_file}"
  )
  if [[ -n "${base_branch}" ]]; then
    cmd+=(--base "${base_branch}")
  fi

  run_workmux_and_cleanup_prompt "${prompt_file}" "${cmd[@]}" > "${log}" 2>&1 &
  disown
  sleep "${WORKMUX_LAUNCH_WAIT_SECONDS:-8}"

  cat "${log}"
  remove_file_if_present "${log}"
}

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local base_branch=""
  local auto_name="false"
  local issue=""
  local -a positional=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --base)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          usage >&2
          die "--base requires a branch name"
        fi
        base_branch="${2}"
        shift 2
        ;;
      --auto-name)
        auto_name="true"
        shift
        ;;
      --issue)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          usage >&2
          die "--issue requires an issue number"
        fi
        issue="${2}"
        shift 2
        ;;
      -*)
        die "unknown option: ${1}"
        ;;
      *)
        positional+=("${1}")
        shift
        ;;
    esac
  done

  if [[ "${auto_name}" == "true" ]]; then
    if [[ ${#positional[@]} -ne 0 ]]; then
      usage >&2
      die "--auto-name takes no branch-name argument, got ${#positional[@]}"
    fi

    if [[ -n "${issue}" && ! "${issue}" =~ ^[1-9][0-9]*$ ]]; then
      usage >&2
      die "--issue requires a positive integer, got: ${issue}"
    fi

    do_launch "" "${base_branch}" "true" "${issue}"
    return
  fi

  if [[ -n "${issue}" ]]; then
    usage >&2
    die "--issue requires --auto-name"
  fi

  if [[ ${#positional[@]} -ne 1 ]]; then
    usage >&2
    die "expected 1 argument (branch-name), got ${#positional[@]}"
  fi

  do_launch "${positional[0]}" "${base_branch}" "false" ""
}

main "$@"
