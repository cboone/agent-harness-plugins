#!/usr/bin/env bash
# resolve-copilot-threads: Fetch, reply to, and resolve Copilot PR review threads
# Author: Christopher Boone
# Date: 2026-02-06
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

# =============================================================================
# Copilot author detection heuristics
# =============================================================================
# Author logins matched unconditionally:
#   - copilot-pull-request-reviewer: Copilot code review bot (primary)
#   - copilot-pull-request-reviewer[bot]: same bot as reported by the REST API
#   - copilot: Copilot as REST reports its inline review comments ("Copilot")
#   - github-copilot[bot]: GitHub Copilot bot account
#
# Author logins matched with body signature verification:
#   - github-actions[bot]: Copilot sometimes posts via GitHub Actions;
#     matched only when the comment body starts with a severity tag
#     (e.g., [nitpick], [suggestion], [important], [critical], [note])
#
# GraphQL and REST disagree on the suffix for the same account: GraphQL
# author.login reports "copilot-pull-request-reviewer" while REST user.login
# reports "copilot-pull-request-reviewer[bot]", and REST reports inline review
# comments as "Copilot". Every command compares logins case-insensitively
# against this one list: fetch, fetch-reviews and audit.
#
# The github-actions[bot] rule applies to thread comments only, in fetch and
# audit. Its severity tag is a thread-comment convention, so fetch-reviews
# never matches it.
# =============================================================================
readonly COPILOT_DIRECT_LOGINS='["copilot-pull-request-reviewer", "copilot-pull-request-reviewer[bot]", "copilot", "github-copilot[bot]"]'
readonly COPILOT_ACTIONS_LOGIN="github-actions[bot]"
readonly COPILOT_SEVERITY_PATTERN="^\\s*\\[(nitpick|suggestion|important|critical|note)\\]"

function usage() {
  cat << USAGE_TEXT
Usage: ${SCRIPT_NAME} <command> [arguments]

Manage GitHub Copilot PR review feedback: threads via GraphQL, review bodies
via REST.

Commands:
  fetch <owner> <repo> <pr_number>                    Fetch unresolved Copilot threads
  fetch-reviews <owner> <repo> <pr_number> [--skip <ids>] [--head <sha>]
                                                      Fetch Copilot review bodies
  parse-reviews [--skip <ids>] [--head <sha>]         Select Copilot reviews from JSON on stdin
  audit <owner> <repo> <pr_number>                    List Copilot items the fetches cannot reach
  parse-audit                                          Audit pull request JSON read from stdin
  resolve <thread_id>                                  Resolve a review thread
  reply <thread_id> [--body-file <path>]               Reply to a review thread
  reply-and-resolve <thread_id> [--body-file <path>]   Reply and resolve

Options:
  -h, --help    Show this help

The reply and reply-and-resolve commands read the reply body from --body-file
or stdin if --body-file is not specified.

Copilot files some findings in a review body instead of an inline thread, where
they have no thread id and cannot be replied to or resolved. fetch-reviews
returns each Copilot review's complete raw body for the caller to read, with
the review comment ids it links to. --skip leaves out review ids already read,
written comma-separated, and --head always keeps the newest review of that
commit. parse-reviews is the same selection over review JSON on stdin, for
testing and for reprocessing a saved response.

audit counts every Copilot review, review comment and pull request comment
by surface, and lists any the two fetch commands do not reach. parse-audit is
the same join over {reviews, reviewComments, issueComments, threads} JSON on stdin.

Examples:
  ${SCRIPT_NAME} fetch octocat hello-world 42
  ${SCRIPT_NAME} fetch-reviews octocat hello-world 42
  ${SCRIPT_NAME} fetch-reviews octocat hello-world 42 --skip 5449428489,5449507605 --head 1a2b3c4
  gh api repos/octocat/hello-world/pulls/42/reviews | ${SCRIPT_NAME} parse-reviews
  ${SCRIPT_NAME} audit octocat hello-world 42
  ${SCRIPT_NAME} resolve PRRT_kwDONZ...
  echo "Explanation here" | ${SCRIPT_NAME} reply PRRT_kwDONZ...
  ${SCRIPT_NAME} reply PRRT_kwDONZ... --body-file response.md
  ${SCRIPT_NAME} reply-and-resolve PRRT_kwDONZ... --body-file response.md
USAGE_TEXT
}

function die() {
  echo "Error: ${1}" >&2
  exit "${2:-1}"
}

function require_jq() {
  if ! command -v jq > /dev/null 2>&1; then
    die "jq is required but not found. Install it: https://jqlang.github.io/jq/download/"
  fi
}

# Checks the GitHub CLI is installed and authenticated. Kept separate from
# require_jq so parse-reviews and parse-audit, which only transform JSON on
# stdin, run in environments with no GitHub credentials (the test suite, for example).
function require_gh() {
  if ! command -v gh > /dev/null 2>&1; then
    die "gh (GitHub CLI) is required but not found. Install it: https://cli.github.com"
  fi

  if ! gh auth status > /dev/null 2>&1; then
    die "Not authenticated with GitHub. Run: gh auth login"
  fi
}

function check_dependencies() {
  require_gh
  require_jq
}

# Reads reply body from --body-file argument or stdin.
# Arguments:
#   [--body-file <path>] - Read body from file (optional)
# Outputs:
#   Reply body text to stdout
function read_body() {
  case "$#" in
    0)
      cat
      ;;
    2)
      if [[ "$1" != "--body-file" ]]; then
        die "Invalid argument '$1'. Expected '--body-file <path>' or no arguments."
      fi
      if [[ -z "${2:-}" ]]; then
        die "Missing path after --body-file"
      fi
      if [[ ! -f "$2" ]]; then
        die "File not found: $2"
      fi
      cat -- "$2"
      ;;
    *)
      die "Invalid arguments to read_body. Expected no arguments or '--body-file <path>'."
      ;;
  esac
}

# Sends a reply to a review thread via GraphQL mutation.
# Arguments:
#   $1 - Thread ID (e.g., PRRT_kwDONZ...)
#   $2 - Reply body text
# Outputs:
#   Comment ID to stdout
function send_reply() {
  local thread_id="${1}"
  local body="${2}"

  local response
  local comment_id

  # shellcheck disable=SC2016
  # $variables in the query are GraphQL references, not shell variables
  response="$(
    gh api graphql \
      -f threadId="${thread_id}" \
      --raw-field body="${body}" \
      -f query='
        mutation($threadId: ID!, $body: String!) {
          addPullRequestReviewThreadReply(input: {
            pullRequestReviewThreadId: $threadId,
            body: $body
          }) {
            comment { id }
          }
        }
      '
  )"

  if jq -e '.errors and (.errors | length > 0)' > /dev/null <<< "${response}"; then
    local error_message
    error_message="$(jq -r '.errors[0].message // "unknown GraphQL error"' <<< "${response}")"
    die "Failed to send reply: ${error_message}"
  fi

  comment_id="$(jq -r '.data.addPullRequestReviewThreadReply.comment.id // empty' <<< "${response}")"
  if [[ -z "${comment_id}" || "${comment_id}" == "null" ]]; then
    die "Failed to send reply: missing comment id in GraphQL response"
  fi

  printf '%s\n' "${comment_id}"
}

# Exits with the first GraphQL error in a paginated review-thread response.
# Arguments:
#   $1 - Response from gh api graphql --paginate --slurp, one object per page
function die_on_thread_query_errors() {
  local graphql_error
  graphql_error="$(jq -r 'map(.errors? // []) | add | .[0].message? // empty' <<< "${1}")"
  if [[ -n "${graphql_error}" ]]; then
    die "GraphQL error while fetching threads: ${graphql_error}"
  fi
}

# Fetches all unresolved Copilot-authored review threads for a PR.
# Uses gh --paginate --slurp for automatic cursor-based pagination.
# Arguments:
#   $1 - Repository owner
#   $2 - Repository name
#   $3 - Pull request number
# Outputs:
#   JSON array of unresolved Copilot threads to stdout
function do_fetch() {
  local owner="${1}"
  local repo="${2}"
  local pr_number="${3}"

  local response

  # shellcheck disable=SC2016
  # $variables in the query are GraphQL references, not shell variables
  response="$(
    gh api graphql \
      --paginate \
      --slurp \
      -f owner="${owner}" \
      -f repo="${repo}" \
      -F pr_number="${pr_number}" \
      -f query='
        query($owner: String!, $repo: String!, $pr_number: Int!, $endCursor: String) {
          repository(owner: $owner, name: $repo) {
            pullRequest(number: $pr_number) {
              reviewThreads(first: 100, after: $endCursor) {
                pageInfo {
                  hasNextPage
                  endCursor
                }
                nodes {
                  id
                  isResolved
                  isOutdated
                  path
                  line
                  originalLine
                  startLine
                  originalStartLine
                  comments(first: 20) {
                    nodes {
                      databaseId
                      url
                      author { login }
                      body
                    }
                  }
                }
              }
            }
          }
        }
      '
  )"

  # Check for GraphQL errors before running the normalization filter
  die_on_thread_query_errors "${response}"

  # Validate that the response contains the expected data shape.
  # Invalid owner/repo/PR number can return null data without GraphQL errors.
  local null_path
  null_path="$(
    printf '%s' "${response}" \
      | jq -r '
          [.[] | .data as $d |
            if $d.repository == null then "repository"
            elif $d.repository.pullRequest == null then "pullRequest"
            else empty
            end
          ] | first // empty
        '
  )"

  if [[ -n "${null_path}" ]]; then
    die "Invalid response: ${null_path} is null. Verify the owner, repo, and PR number are correct."
  fi

  printf '%s' "${response}" \
    | jq \
      --argjson direct_logins "${COPILOT_DIRECT_LOGINS}" \
      --arg actions_login "${COPILOT_ACTIONS_LOGIN}" \
      --arg severity_pattern "${COPILOT_SEVERITY_PATTERN}" \
      '
        [
          .[].data.repository.pullRequest.reviewThreads.nodes[]
          | select(.isResolved == false)
          | select(.comments.nodes | length > 0)
          | .comments.nodes[0] as $first
          | (($first.author.login? // "") | if type == "string" then ascii_downcase else "" end) as $login
          | select(
              ($direct_logins | any(. == $login))
              or (
                $login == $actions_login
                and (($first.body? // "") | test($severity_pattern; "i"))
              )
            )
          | (.line // .originalLine // .startLine // .originalStartLine) as $ln
          | {
              id: .id,
              path: .path,
              location: (.path + ":" + (if $ln then ($ln | tostring) else "(no-line)" end)),
              isOutdated: .isOutdated,
              comments: [.comments.nodes[] | {author: (.author.login? // ""), body: .body, databaseId: .databaseId, url: .url}]
            }
        ]
      '
}

# =============================================================================
# Review bodies
# =============================================================================
# Copilot files some feedback in a review body rather than an inline thread,
# where it has no thread id and cannot be replied to or resolved. The body is
# returned raw and complete, for the caller to read: Copilot reshapes its
# review-body layout often, and any parse of that layout breaks on the next
# reshape, while the text itself always says what Copilot found.
#
# Every field here comes from the REST review object, never from the body's
# layout, except threadLinks. Those are the review comment ids the body links
# to through GitHub's "#discussion_r<id>" URL fragment, extracted anywhere in
# the text as a hint for matching a concern to its thread. A body that links
# differently yields an empty list and nothing else changes.
#
# Selection is by review id, not by time. --skip names reviews a caller has
# already read, and --head names the current head commit, whose newest review
# is always returned, skipped or not, so every caller reads what Copilot
# currently says about the head.
# =============================================================================

# Selects Copilot reviews from an array of GitHub review objects.
# Arguments:
#   [--skip <id,id,...>] - Leave out these review ids
#   [--head <sha>]       - Always keep the newest review whose commit is this
# Outputs:
#   JSON array of {id, url, submittedAt, commitId, threadLinks, body} to
#   stdout, oldest first
function do_parse_reviews() {
  local skip=""
  local head=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip)
        if [[ $# -lt 2 ]]; then
          die "Missing value after $1"
        fi
        # Repeated --skip values add up rather than replace each other.
        skip="${skip:+${skip},}$2"
        shift 2
        ;;
      --head)
        if [[ $# -lt 2 ]]; then
          die "Missing value after $1"
        fi
        if [[ -n "${head}" ]]; then
          die "--head given more than once"
        fi
        head="$2"
        shift 2
        ;;
      *)
        die "Invalid argument '$1'. Expected '--skip <id,id,...>' or '--head <sha>'."
        ;;
    esac
  done

  if [[ -n "${skip}" && ! "${skip}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    die "Invalid --skip value '${skip}'. Expected review ids separated by commas, such as 5449428489,5449507605."
  fi
  # GitHub reports commit_id in full, and an abbreviated SHA would never
  # equal it, silently dropping the head review.
  if [[ -n "${head}" && ! "${head}" =~ ^[0-9a-f]{40}$ ]]; then
    die "Invalid --head value '${head}'. Expected the full 40-character commit SHA."
  fi

  local input
  input="$(cat)"

  # Validate the shape before filtering. A failed gh call, or a hand-piped
  # error payload, otherwise surfaces as an opaque jq indexing error.
  local input_type
  if ! input_type="$(jq -r 'type' 2> /dev/null <<< "${input}")"; then
    die "Invalid review JSON: could not parse input as JSON."
  fi

  if [[ "${input_type}" != "array" ]]; then
    die "Invalid review JSON: expected an array of review objects, got ${input_type}. Pass the output of: gh api repos/OWNER/REPO/pulls/N/reviews"
  fi

  if ! jq -e 'all(type == "object")' > /dev/null <<< "${input}"; then
    die "Invalid review JSON: every element must be a review object."
  fi

  # Definitions shared by the warning pass and the selection below. Login
  # access is safe, matching the thread path: a null, absent or malformed
  # user yields no match rather than aborting the run.
  # shellcheck disable=SC2016
  # $variables in the filter are jq bindings, not shell variables
  local review_defs='
    def by_copilot:
      (.user.login? // "") as $login
      | ($login | type) == "string"
        and ($direct_logins | any(. == ($login | ascii_downcase)));
    def skipped:
      .id as $id
      | $skip | if . == "" then [] else split(",") | map(tonumber) end
      | any(. == $id);
  '

  # A Copilot review whose body is present but not a string cannot be read,
  # so it is left out. This names each one not already skipped by id, so it
  # is visible rather than silent, and audit reports the same reviews as
  # uncovered.
  local skipped_id
  while IFS= read -r skipped_id; do
    echo "Warning: skipping review ${skipped_id}: its body is not a string." >&2
  done < <(
    jq -r --argjson direct_logins "${COPILOT_DIRECT_LOGINS}" --arg skip "${skip}" "${review_defs}"'
      .[]
      | select(by_copilot)
      | select(.body != null and (.body | type) != "string")
      | select(skipped | not)
      | .id // "with no id"
    ' <<< "${input}"
  )

  # shellcheck disable=SC2016
  # $variables in the filter are jq bindings, not shell variables
  jq \
    --argjson direct_logins "${COPILOT_DIRECT_LOGINS}" \
    --arg skip "${skip}" \
    --arg head "${head}" \
    "${review_defs}"'
      [
        .[]
        | select(by_copilot)
        # A null body is an empty one: the review states nothing in its
        # body, and any findings it has are inline threads.
        | select(.body == null or (.body | type) == "string")
        | .body //= ""
      ]
      | sort_by(.submitted_at // "")
      # The newest review of the head is kept even when skipped.
      | ([.[] | select($head != "" and .commit_id == $head)] | last | .id) as $head_review
      | map(select(.id == $head_review or (skipped | not)))
      | map({
          id: .id,
          url: .html_url,
          submittedAt: .submitted_at,
          # The commit the review ran against, which is how a caller tells
          # a review of the current head from one of an older push.
          commitId: .commit_id,
          threadLinks: (
            [.body | match("#discussion_r([0-9]+)"; "g") | .captures[0].string | tonumber]
            | unique
          ),
          body: .body
        })
    ' <<< "${input}"
}

# Fetches Copilot review bodies for a PR.
# Arguments:
#   $1 - Repository owner
#   $2 - Repository name
#   $3 - Pull request number
#   [--skip <id,id,...>] [--head <sha>] - Passed through to do_parse_reviews
# Outputs:
#   JSON array of Copilot reviews to stdout
function do_fetch_reviews() {
  local owner="${1}"
  local repo="${2}"
  local pr_number="${3}"
  shift 3

  # gh writes its own diagnostic to stderr, which passes through untouched, so
  # this message adds the request context rather than guessing at the cause.
  # A wrong owner, repo, or PR number is only one possibility; missing token
  # scopes, unauthorized SSO, and rate limiting all land here too.
  local response
  if ! response="$(gh api --paginate "repos/${owner}/${repo}/pulls/${pr_number}/reviews")"; then
    die "Failed to fetch reviews for ${owner}/${repo}#${pr_number}. See the gh error above for the cause."
  fi

  # Flattened to one array, as audit does, so a gh that prints one array per
  # page cannot split the reviews into several documents.
  jq -sc 'add // []' <<< "${response}" | do_parse_reviews ${1+"$@"}
}

# =============================================================================
# Surface audit
# =============================================================================
# fetch reads unresolved threads that Copilot opened, and fetch-reviews reads
# Copilot review bodies. Copilot can also write somewhere neither looks: a
# comment on the pull request itself, a reply inside a thread someone else
# opened, or a review comment no thread holds. The audit counts every Copilot
# item on the pull request by where it appears and lists any item the two
# typed commands do not reach, including a review whose body is not a string,
# so feedback that arrives somewhere new shows up as an entry rather than as
# silence.
#
# REST reports Copilot's inline comments as "Copilot", GraphQL as
# "copilot-pull-request-reviewer", and REST reviews as
# "copilot-pull-request-reviewer[bot]", so logins are compared lowercased
# against the direct-login list.
# =============================================================================

# Joins already-fetched pull request data into the surface audit.
# Arguments:
#   None; reads {reviews, reviewComments, issueComments, threads} on stdin.
#   reviews, reviewComments and issueComments are REST arrays; threads is an
#   array of {isResolved, comments: [{databaseId, login, body}]}, where only
#   the first comment needs a body.
# Outputs:
#   JSON audit object to stdout
function do_parse_audit() {
  local input
  input="$(cat)"

  if ! jq -e 'type == "object" and ([.reviews, .reviewComments, .issueComments, .threads] | all(type == "array"))' > /dev/null 2>&1 <<< "${input}"; then
    die "Invalid audit JSON: expected an object with reviews, reviewComments, issueComments and threads arrays."
  fi

  # The join below indexes into every element, so a malformed one would
  # otherwise abort with a raw jq error that names no field.
  local malformed
  malformed="$(jq -r '
    if (.reviews | all(type == "object")) | not then "reviews: every element must be an object"
    elif (.reviewComments | all(type == "object")) | not then "reviewComments: every element must be an object"
    elif (.issueComments | all(type == "object")) | not then "issueComments: every element must be an object"
    elif (.threads | all(type == "object" and (.comments | type) == "array" and (.comments | all(type == "object")))) | not
    then "threads: every element must be an object with a comments array of objects"
    else empty
    end
  ' <<< "${input}")"
  if [[ -n "${malformed}" ]]; then
    die "Invalid audit JSON: ${malformed}."
  fi

  # The input reaches jq on stdin rather than as an argument, because review
  # bodies can be long enough together to exceed the argument size limit.
  # shellcheck disable=SC2016
  # $variables in the filter are jq bindings, not shell variables
  jq \
    --argjson direct_logins "${COPILOT_DIRECT_LOGINS}" \
    --arg actions_login "${COPILOT_ACTIONS_LOGIN}" \
    --arg severity_pattern "${COPILOT_SEVERITY_PATTERN}" \
    '
      # A login or body that is not a string reads as empty, so one
      # malformed comment cannot abort the join with a raw jq error.
      def text: if type == "string" then . else "" end;

      def is_copilot($login; $body):
        ($login | text | ascii_downcase) as $lower
        | ($direct_logins | map(ascii_downcase) | any(. == $lower))
          or ($lower == $actions_login and ($body | text | test($severity_pattern; "i")));

      # Reviews match the direct logins only, as fetch-reviews does: the
      # severity-tag rule is for thread comments.
      def is_copilot_reviewer($login): is_copilot($login; "");

      def excerpt: text | gsub("[[:space:]]+"; " ") | .[0:200];

      (.reviews | map(select(is_copilot_reviewer(.user.login?)))) as $reviews
      | (.reviewComments | map(select(is_copilot(.user.login?; .body)))) as $review_comments
      | (.issueComments | map(select(is_copilot(.user.login?; .body)))) as $issue_comments
      | .threads as $threads
      # Each thread, keyed by the database id of every comment it holds.
      | (
          [
            $threads[]
            | . as $thread
            | .comments[]
            | {key: (.databaseId | tostring), value: $thread}
          ]
          | from_entries
        ) as $thread_of
      | {
          surfaces: {
            reviews: ($reviews | length),
            reviewComments: ($review_comments | length),
            issueComments: ($issue_comments | length)
          },
          uncovered: (
            [
              $review_comments[]
              | . as $comment
              | $thread_of[$comment.id | tostring] as $thread
              | if $thread == null then
                  {surface: "review-comment", reason: "in no thread", id: .id, url: .html_url, path: .path, excerpt: (.body | excerpt)}
                # The opener is judged the way the thread fetch judges it,
                # body included, so a thread that the thread fetch reports
                # is never reported here as well.
                elif ($thread.isResolved | not)
                     and (is_copilot($thread.comments[0].login; $thread.comments[0].body) | not) then
                  {surface: "review-comment", reason: "reply in a thread Copilot did not open", id: .id, url: .html_url, path: .path, excerpt: (.body | excerpt)}
                else empty
                end
            ]
            + [
              $issue_comments[]
              | {surface: "issue-comment", reason: "pull request comment", id: .id, url: .html_url, path: null, excerpt: (.body | excerpt)}
            ]
            # fetch-reviews leaves out a review whose body is not a string,
            # so only a read by hand can settle it.
            + [
              $reviews[]
              | select(.body != null and (.body | type) != "string")
              | {surface: "review", reason: "body is not a string", id: .id, url: .html_url, path: null, excerpt: ""}
            ]
          )
        }
    ' <<< "${input}"
}

# Fetches every review thread on a PR, resolved or not, with the database id
# and author of each comment and the first comment's body, for the surface
# audit.
#
# Each thread's comments are read only to their first 100, deliberately. The
# index never decides which comments the audit sees: those come from the
# paginated REST read of every review comment, and each is then looked up
# here. A comment past the cap is absent from the index, so the audit reports
# it as being in no thread rather than leaving it out. The cap can mislabel
# the reason on such a thread, but it cannot hide a comment.
# Arguments:
#   $1 - Repository owner
#   $2 - Repository name
#   $3 - Pull request number
# Outputs:
#   JSON array of {isResolved, comments: [{databaseId, login, body}]} to
#   stdout, where body is null on every comment but the first
function fetch_thread_index() {
  local owner="${1}"
  local repo="${2}"
  local pr_number="${3}"

  local response
  # shellcheck disable=SC2016
  # $variables in the query are GraphQL references, not shell variables
  if ! response="$(
    gh api graphql \
      --paginate \
      --slurp \
      -f owner="${owner}" \
      -f repo="${repo}" \
      -F pr_number="${pr_number}" \
      -f query='
        query($owner: String!, $repo: String!, $pr_number: Int!, $endCursor: String) {
          repository(owner: $owner, name: $repo) {
            pullRequest(number: $pr_number) {
              reviewThreads(first: 100, after: $endCursor) {
                pageInfo {
                  hasNextPage
                  endCursor
                }
                nodes {
                  isResolved
                  comments(first: 100) {
                    nodes {
                      databaseId
                      author { login }
                      body
                    }
                  }
                }
              }
            }
          }
        }
      '
  )"; then
    die "Failed to fetch review threads for ${owner}/${repo}#${pr_number}. See the gh error above for the cause."
  fi

  die_on_thread_query_errors "${response}"

  # A wrong owner, repo or number returns null data without an error, the
  # same shape do_fetch guards against. Read as an empty index, it would
  # report every Copilot review comment as being in no thread.
  if jq -e 'any(.[]; .data.repository == null or .data.repository.pullRequest == null)' > /dev/null <<< "${response}"; then
    die "Invalid response while fetching threads for ${owner}/${repo}#${pr_number}: no such pull request."
  fi

  # Only the first comment keeps its body, which is all the audit reads,
  # to judge the thread opener as the thread fetch does.
  jq '
    [
      .[].data.repository.pullRequest.reviewThreads.nodes[]
      | {
          isResolved,
          comments: [
            .comments.nodes
            | to_entries[]
            | {
                databaseId: .value.databaseId,
                login: (.value.author.login? // ""),
                body: (if .key == 0 then .value.body else null end)
              }
          ]
        }
    ]
  ' <<< "${response}"
}

# Fetches every Copilot surface on a PR and audits what the typed commands
# cannot reach.
# Arguments:
#   $1 - Repository owner
#   $2 - Repository name
#   $3 - Pull request number
# Outputs:
#   JSON audit object to stdout
function do_audit() {
  local owner="${1}"
  local repo="${2}"
  local pr_number="${3}"

  local reviews
  local review_comments
  local issue_comments
  local threads

  if ! reviews="$(gh api --paginate "repos/${owner}/${repo}/pulls/${pr_number}/reviews")"; then
    die "Failed to fetch reviews for ${owner}/${repo}#${pr_number}. See the gh error above for the cause."
  fi
  if ! review_comments="$(gh api --paginate "repos/${owner}/${repo}/pulls/${pr_number}/comments")"; then
    die "Failed to fetch review comments for ${owner}/${repo}#${pr_number}. See the gh error above for the cause."
  fi
  if ! issue_comments="$(gh api --paginate "repos/${owner}/${repo}/issues/${pr_number}/comments")"; then
    die "Failed to fetch pull request comments for ${owner}/${repo}#${pr_number}. See the gh error above for the cause."
  fi
  threads="$(fetch_thread_index "${owner}" "${repo}" "${pr_number}")"

  # Passed on stdin rather than as arguments, for the size reason given in
  # do_parse_audit. Each REST response is flattened to one array first, so a
  # response that arrives as one array per page cannot shift the documents
  # this join reads by position.
  local surface
  local flattened=()
  for surface in "${reviews}" "${review_comments}" "${issue_comments}"; do
    flattened+=("$(jq -sc 'add // []' <<< "${surface}")")
  done

  printf '%s\n%s\n%s\n%s\n' "${flattened[0]}" "${flattened[1]}" "${flattened[2]}" "${threads}" \
    | jq -s '{reviews: .[0], reviewComments: .[1], issueComments: .[2], threads: .[3]}' \
    | do_parse_audit
}

# Resolves a review thread via GraphQL mutation.
# Arguments:
#   $1 - Thread ID (e.g., PRRT_kwDONZ...)
# Outputs:
#   "true" on success to stdout
function do_resolve() {
  local thread_id="${1}"

  local response

  # shellcheck disable=SC2016
  # $variables in the query are GraphQL references, not shell variables
  response="$(
    gh api graphql \
      -f threadId="${thread_id}" \
      -f query='
        mutation($threadId: ID!) {
          resolveReviewThread(input: {threadId: $threadId}) {
            thread { isResolved }
          }
        }
      '
  )"

  # Check for GraphQL errors before extracting the result
  if jq -e '.errors and (.errors | length > 0)' > /dev/null <<< "${response}"; then
    local error_message
    error_message="$(jq -r '.errors[0].message // "unknown GraphQL error"' <<< "${response}")"
    die "Failed to resolve review thread ${thread_id}: ${error_message}"
  fi

  local is_resolved
  is_resolved="$(jq -r '.data.resolveReviewThread.thread.isResolved' <<< "${response}")"

  if [[ "${is_resolved}" != "true" ]]; then
    die "Failed to resolve review thread ${thread_id}: isResolved=${is_resolved}"
  fi

  echo "${is_resolved}"
}

# Replies to a review thread via GraphQL mutation.
# Reads body from --body-file or stdin.
# Arguments:
#   $1 - Thread ID
#   [--body-file <path>] - Read body from file; reads from stdin otherwise
# Outputs:
#   Comment ID to stdout
function do_reply() {
  local thread_id="${1}"
  shift

  local body
  body=$(read_body "$@")

  send_reply "${thread_id}" "${body}"
}

# Replies to and resolves a review thread.
# Reads body from --body-file or stdin.
# Arguments:
#   $1 - Thread ID
#   [--body-file <path>] - Read body from file; reads from stdin otherwise
# Outputs:
#   "true" on success to stdout (consistent with do_resolve)
function do_reply_and_resolve() {
  local thread_id="${1}"
  shift

  local body
  body=$(read_body "$@")

  send_reply "${thread_id}" "${body}" > /dev/null

  do_resolve "${thread_id}"
}

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local command="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  # Validate command before checking dependencies so that missing/unknown
  # commands show usage errors rather than confusing dependency failures.
  case "${command}" in
    fetch | fetch-reviews | audit | resolve | reply | reply-and-resolve)
      check_dependencies
      ;;
    parse-reviews | parse-audit)
      # Reads stdin and touches no GitHub API, so it needs neither the CLI nor
      # credentials.
      require_jq
      ;;
    "")
      usage
      exit 1
      ;;
    *)
      die "Unknown command: ${command}. Use '${SCRIPT_NAME} --help' for usage."
      ;;
  esac

  case "${command}" in
    fetch)
      [[ $# -ne 3 ]] && die "Usage: ${SCRIPT_NAME} fetch <owner> <repo> <pr_number>"
      do_fetch "$1" "$2" "$3"
      ;;
    fetch-reviews)
      [[ $# -lt 3 ]] && die "Usage: ${SCRIPT_NAME} fetch-reviews <owner> <repo> <pr_number> [--skip <ids>] [--head <sha>]"
      do_fetch_reviews "$@"
      ;;
    parse-reviews)
      do_parse_reviews ${1+"$@"}
      ;;
    audit)
      [[ $# -ne 3 ]] && die "Usage: ${SCRIPT_NAME} audit <owner> <repo> <pr_number>"
      do_audit "$1" "$2" "$3"
      ;;
    parse-audit)
      [[ $# -ne 0 ]] && die "Usage: ${SCRIPT_NAME} parse-audit (reads pull request JSON on stdin)"
      do_parse_audit
      ;;
    resolve)
      [[ $# -ne 1 ]] && die "Usage: ${SCRIPT_NAME} resolve <thread_id>"
      do_resolve "$1"
      ;;
    reply)
      [[ $# -ne 1 && $# -ne 3 ]] && die "Usage: ${SCRIPT_NAME} reply <thread_id> [--body-file <path>]"
      do_reply "$@"
      ;;
    reply-and-resolve)
      [[ $# -ne 1 && $# -ne 3 ]] && die "Usage: ${SCRIPT_NAME} reply-and-resolve <thread_id> [--body-file <path>]"
      do_reply_and_resolve "$@"
      ;;
    *)
      # Unreachable: the validation case above dies on unknown commands.
      die "Unknown command: ${command}"
      ;;
  esac
}

main "$@"
