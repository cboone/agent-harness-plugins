#!/usr/bin/env bash
# launch-workmux — Create a worktree + tmux window via workmux, fully detached.
# Usage: launch-workmux <branch-name> <prompt-file>
set -euo pipefail

branch="${1:?Usage: launch-workmux <branch> <prompt-file>}"
prompt_file="${2:?Usage: launch-workmux <branch> <prompt-file>}"
log="$(mktemp "/tmp/workmux-${branch}.XXXXXX.log")"

workmux add "$branch" --open-if-exists -P "$prompt_file" > "$log" 2>&1 &
disown
sleep 8

cat "$log"
rm -f "$log"
