#!/usr/bin/env bash
# launch-workmux -- Create a worktree + tmux window via workmux, fully detached.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function usage() {
  cat << 'USAGE_TEXT'
Usage: launch-workmux <branch-name> [--base <branch>]

Create a worktree and tmux window via workmux, fully detached from the
calling process. Waits briefly for workmux to initialize, then outputs
the log and cleans up. Reads the workmux prompt from stdin.

Arguments:
  branch-name      Name of the git branch to create/open

Options:
  --base <branch>  Specify the base branch for the worktree
  -h, --help       Show this help
USAGE_TEXT
}

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

function remove_file_if_present() {
  local file="${1}"

  if [[ ! -e "${file}" && ! -L "${file}" ]]; then
    return 0
  fi

  if rm -- "${file}" 2> /dev/null; then
    return 0
  fi

  [[ ! -e "${file}" && ! -L "${file}" ]]
}

function write_escaped_prompt() {
  local prompt_file="${1}"
  local raw_prompt status

  if [[ -t 0 ]]; then
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  raw_prompt="$(mktemp "${prompt_file}.raw.XXXXXX")"
  cat > "${raw_prompt}"

  if [[ ! -s "${raw_prompt}" ]]; then
    remove_file_if_present "${raw_prompt}"
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  set +e
  sed -e 's/{{/{{ "{{" }}/g' \
    -e 's/{%/{{ "{%" }}/g' \
    -e 's/{#/{{ "{#" }}/g' \
    "${raw_prompt}" > "${prompt_file}"
  status=$?
  set -e

  remove_file_if_present "${raw_prompt}"
  if ((status != 0)); then
    remove_file_if_present "${prompt_file}"
    return "${status}"
  fi
}

function run_workmux_and_cleanup_prompt() {
  local prompt_file="${1}"
  local status
  shift

  set +e
  "${@}"
  status=$?
  set -e

  remove_file_if_present "${prompt_file}"
  return "${status}"
}

function tmux_socket_candidates() {
  local uid dir socket socket_dir
  local -a dirs=()

  uid="$(id -u)"
  if [[ -n "${TMUX_TMPDIR:-}" ]]; then
    dirs+=("${TMUX_TMPDIR}/tmux-${uid}")
  fi
  dirs+=("/tmp/tmux-${uid}" "/private/tmp/tmux-${uid}")

  for dir in "${dirs[@]}"; do
    [[ -d "${dir}" ]] || continue
    for socket in "${dir}"/*; do
      [[ -S "${socket}" ]] || continue
      socket_dir="$(cd "$(dirname "${socket}")" && pwd -P)"
      printf '%s/%s\n' "${socket_dir}" "$(basename "${socket}")"
    done
  done | sort -u
}

function resolved_tmux_env() {
  if [[ -n "${TMUX:-}" ]]; then
    printf '%s' "${TMUX}"
    return
  fi

  if [[ -n "${WORKMUX_TMUX:-}" ]]; then
    printf '%s' "${WORKMUX_TMUX}"
    return
  fi

  command -v tmux > /dev/null || return 0

  local cwd socket pane_id pane_command pane_path server_pid candidate
  local count=0
  cwd="$(pwd -P)"

  while IFS= read -r socket; do
    while IFS='|' read -r pane_id pane_command pane_path server_pid; do
      if [[ -d "${pane_path}" ]]; then
        pane_path="$(cd "${pane_path}" && pwd -P)"
      fi
      [[ "${pane_path}" == "${cwd}" ]] || continue

      case "${pane_command}" in
        codex* | cx) ;;
        *) continue ;;
      esac

      candidate="${socket},${server_pid},${pane_id}"
      count=$((count + 1))
    done < <(tmux -S "${socket}" list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}|#{pid}' 2> /dev/null || true)
  done < <(tmux_socket_candidates)

  if ((count == 1)); then
    printf '%s' "${candidate}"
  fi

  return 0
}

function run_workmux_command() {
  local -a command=(workmux "${@}")
  local -a env_args=()
  local tmux_env
  tmux_env="$(resolved_tmux_env)"

  if [[ -n "${tmux_env}" ]]; then
    env_args+=("TMUX=${tmux_env}")
  fi

  if [[ -n "${WORKMUX_TERM:-}" ]]; then
    env_args+=("TERM=${WORKMUX_TERM}")
  elif [[ "${TERM:-}" == "dumb" && -n "${tmux_env}" ]]; then
    env_args+=(TERM=tmux-256color)
  fi

  if ((${#env_args[@]} > 0)); then
    env "${env_args[@]}" "${command[@]}"
  else
    "${command[@]}"
  fi
}

function do_launch() {
  local branch="${1}"
  local base_branch="${2:-}"
  local safe_name="${branch//\//-}"
  local log prompt_file
  prompt_file="$(mktemp "/tmp/workmux-prompt-${safe_name}.md.XXXXXX")"

  write_escaped_prompt "${prompt_file}"

  log="$(mktemp "/tmp/workmux-${safe_name}.log.XXXXXX")"

  local -a cmd=(run_workmux_command add "${branch}" --open-if-exists -P "${prompt_file}")
  if [[ -n "${base_branch}" ]]; then
    cmd+=(--base "${base_branch}")
  fi

  run_workmux_and_cleanup_prompt "${prompt_file}" "${cmd[@]}" > "${log}" 2>&1 &
  disown
  sleep "${WORKMUX_LAUNCH_WAIT_SECONDS:-8}"

  cat "${log}"
  remove_file_if_present "${log}"
}

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local base_branch=""
  local -a positional=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --base)
        base_branch="${2:?--base requires a branch name}"
        shift 2
        ;;
      -*)
        die "unknown option: ${1}"
        ;;
      *)
        positional+=("${1}")
        shift
        ;;
    esac
  done

  if [[ ${#positional[@]} -ne 1 ]]; then
    usage >&2
    die "expected 1 argument (branch-name), got ${#positional[@]}"
  fi

  do_launch "${positional[0]}" "${base_branch}"
}

main "$@"
