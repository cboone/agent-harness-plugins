#!/usr/bin/env bash
# launch-workmux -- Create a worktree + tmux window via workmux, fully detached.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function usage() {
  cat << 'USAGE_TEXT'
Usage: launch-workmux <branch-name> <prompt-file> [--base <branch>]

Create a worktree and tmux window via workmux, fully detached from the
calling process. Waits briefly for workmux to initialize, then outputs
the log and cleans up.

Arguments:
  branch-name      Name of the git branch to create/open
  prompt-file      Path to the workmux prompt file

Options:
  --base <branch>  Specify the base branch for the worktree
  -h, --help       Show this help
USAGE_TEXT
}

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

# Escape MiniJinja delimiters so workmux's template engine emits them
# literally. Without this, prompts containing GitHub Actions expressions
# (`${{ ... }}`), Jinja/Liquid/Tera/Helm/Vue templates, or Handlebars-style
# tokens are parsed as template variables and rejected with "undefined
# variables". Each `{{ "{{" }}`, `{{ "{%" }}`, and `{{ "{#" }}` evaluates back
# to the literal two-character delimiter at render time, so the rendered
# prompt stored in `<worktree>/.workmux/PROMPT-*.md` matches the input
# verbatim.
function escape_minijinja_delimiters() {
  local input="${1}"
  local output="${2}"
  sed -e 's/{{/{{ "{{" }}/g' \
    -e 's/{%/{{ "{%" }}/g' \
    -e 's/{#/{{ "{#" }}/g' \
    "${input}" > "${output}"
}

function do_launch() {
  local branch="${1}"
  local prompt_file="${2}"
  local base_branch="${3:-}"
  local safe_name="${branch//\//-}"
  local log escaped_prompt
  log="$(mktemp "/tmp/workmux-${safe_name}.XXXXXX.log")"
  escaped_prompt="$(mktemp "/tmp/workmux-prompt-escaped.XXXXXX")"

  escape_minijinja_delimiters "${prompt_file}" "${escaped_prompt}"

  local -a cmd=(workmux add "${branch}" --open-if-exists -P "${escaped_prompt}")
  if [[ -n "${base_branch}" ]]; then
    cmd+=(--base "${base_branch}")
  fi

  "${cmd[@]}" > "${log}" 2>&1 &
  disown
  sleep 8

  cat "${log}"
  rm -f "${log}" "${escaped_prompt}"
}

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local base_branch=""
  local -a positional=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --base)
        base_branch="${2:?--base requires a branch name}"
        shift 2
        ;;
      -*)
        die "unknown option: ${1}"
        ;;
      *)
        positional+=("${1}")
        shift
        ;;
    esac
  done

  if [[ ${#positional[@]} -ne 2 ]]; then
    usage >&2
    die "expected 2 arguments (branch-name, prompt-file), got ${#positional[@]}"
  fi

  do_launch "${positional[0]}" "${positional[1]}" "${base_branch}"
}

main "$@"
