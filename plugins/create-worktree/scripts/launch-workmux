#!/usr/bin/env bash
# launch-workmux -- Create a worktree + tmux window via workmux, fully detached.
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

function usage() {
  cat << 'USAGE_TEXT'
Usage: launch-workmux <branch-name> [--base <branch>] [--await-completion]
       launch-workmux --generated-name <candidate> [--issue <n>] [--base <branch>]
                      [--await-completion]
       launch-workmux --resolve-issue-branch <n>

Create a worktree and tmux window via workmux, fully detached from the
calling process. Both launch forms read the workmux prompt from stdin. By
default the launcher waits WORKMUX_LAUNCH_WAIT_SECONDS (default 8) for
workmux to initialize, then prints the log and removes it.

With --generated-name, the invoking agent supplies the candidate. The launcher
validates it and inserts the issue number when --issue is given.

Arguments:
  branch-name      Name of the git branch to create/open

Options:
  --generated-name <candidate>  Use the name generated by the invoking agent
  --issue <n>      Insert issue number <n> into the generated name; reuse an
                   existing local branch for that issue when one exists.
                   When several local branches match, lists them and exits 1.
                   Requires --generated-name.
  --base <branch>  Specify the base branch for the worktree
  --await-completion
                   Wait for `workmux add` to exit instead of for a fixed
                   interval, then confirm a worktree exists for the branch and
                   print `Worktree ready: PATH`. Exits 1 when workmux fails or
                   no worktree appears, and 124 when
                   WORKMUX_LAUNCH_TIMEOUT_SECONDS (default 90) passes while
                   workmux is still running. The launch runs in its own
                   process group. After a timeout it keeps running: its
                   output keeps going to `log` in the state directory the
                   launcher names, and its exit status goes to `status` when
                   it exits, for the caller to read and remove.
  --resolve-issue-branch <n>
                   Print the local branch the launcher would reuse for issue
                   <n>, or nothing when none matches. Reads no stdin and
                   creates nothing. Exits 3 and lists the candidates when
                   several match, and 1 when git cannot list local branches.
  -h, --help       Show this help
USAGE_TEXT
}

function die() {
  echo "${SCRIPT_NAME}: ${1}" >&2
  exit "${2:-1}"
}

function remove_file_if_present() {
  local file="${1}"

  if [[ ! -e "${file}" && ! -L "${file}" ]]; then
    return 0
  fi

  if rm -- "${file}" 2> /dev/null; then
    return 0
  fi

  [[ ! -e "${file}" && ! -L "${file}" ]]
}

function write_escaped_prompt() {
  local prompt_file="${1}"
  local raw_prompt status

  if [[ -t 0 ]]; then
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  raw_prompt="$(mktemp "${prompt_file}.raw.XXXXXX")"
  cat > "${raw_prompt}"

  if [[ ! -s "${raw_prompt}" ]]; then
    remove_file_if_present "${raw_prompt}"
    remove_file_if_present "${prompt_file}"
    die "expected prompt content on stdin"
  fi

  set +e
  sed -e 's/{{/{{ "{{" }}/g' \
    -e 's/{%/{{ "{%" }}/g' \
    -e 's/{#/{{ "{#" }}/g' \
    "${raw_prompt}" > "${prompt_file}"
  status=$?
  set -e

  remove_file_if_present "${raw_prompt}"
  if ((status != 0)); then
    remove_file_if_present "${prompt_file}"
    return "${status}"
  fi
}

function run_workmux_and_cleanup_prompt() {
  local prompt_file="${1}"
  local status
  shift

  set +e
  "${@}"
  status=$?
  set -e

  remove_file_if_present "${prompt_file}"
  return "${status}"
}

# Prints the branch's worktree path. Returns 1 when it has none, and 2 when git
# cannot list worktrees.
function worktree_path_for_branch() {
  local branch="${1}"
  local porcelain line path="" branch_ref=""

  if ! porcelain="$(git worktree list --porcelain 2> /dev/null)"; then
    return 2
  fi

  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      worktree\ *)
        path="${line#worktree }"
        branch_ref=""
        ;;
      branch\ refs/heads/*)
        branch_ref="${line#branch refs/heads/}"
        ;;
      "") # End of one worktree record in `git worktree list --porcelain`.
        if [[ "${branch_ref}" == "${branch}" && -n "${path}" ]]; then
          printf '%s' "${path}"
          return 0
        fi
        path=""
        branch_ref=""
        ;;
      *) # Other porcelain fields (HEAD, bare, detached) are not needed here.
        ;;
    esac
  done <<< "${porcelain}"

  if [[ "${branch_ref}" == "${branch}" && -n "${path}" ]]; then
    printf '%s' "${path}"
    return 0
  fi

  return 1
}

function tmux_socket_candidates() {
  local uid dir socket socket_dir
  local -a dirs=()

  uid="$(id -u)"
  if [[ -n "${TMUX_TMPDIR:-}" ]]; then
    dirs+=("${TMUX_TMPDIR}/tmux-${uid}")
  fi
  dirs+=("/tmp/tmux-${uid}" "/private/tmp/tmux-${uid}")

  for dir in "${dirs[@]}"; do
    [[ -d "${dir}" ]] || continue
    for socket in "${dir}"/*; do
      [[ -S "${socket}" ]] || continue
      socket_dir="$(cd "$(dirname "${socket}")" && pwd -P)"
      printf '%s/%s\n' "${socket_dir}" "$(basename "${socket}")"
    done
  done | sort -u
}

function resolved_tmux_env() {
  if [[ -n "${TMUX:-}" ]]; then
    printf '%s' "${TMUX}"
    return
  fi

  if [[ -n "${WORKMUX_TMUX:-}" ]]; then
    printf '%s' "${WORKMUX_TMUX}"
    return
  fi

  command -v tmux > /dev/null || return 0

  local cwd socket pane_id pane_command pane_path server_pid candidate
  local count=0
  cwd="$(pwd -P)"

  while IFS= read -r socket; do
    while IFS='|' read -r pane_id pane_command pane_path server_pid; do
      if [[ -d "${pane_path}" ]]; then
        if ! pane_path="$(cd "${pane_path}" 2> /dev/null && pwd -P)"; then
          continue
        fi
      fi
      [[ "${pane_path}" == "${cwd}" ]] || continue

      case "${pane_command}" in
        codex* | cx) ;;
        *) continue ;;
      esac

      candidate="${socket},${server_pid},${pane_id}"
      count=$((count + 1))
    done < <(tmux -S "${socket}" list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}|#{pid}' 2> /dev/null || true)
  done < <(tmux_socket_candidates)

  if ((count == 1)); then
    printf '%s' "${candidate}"
  fi

  return 0
}

function codex_pane_for_path() {
  local tmux_env="${1}" worktree_path="${2}"
  local pane_id pane_command pane_path candidate
  local count=0

  [[ -n "${tmux_env}" ]] || return 0
  [[ -d "${worktree_path}" ]] || return 0
  if ! worktree_path="$(cd "${worktree_path}" 2> /dev/null && pwd -P)"; then
    return 0
  fi

  while IFS='|' read -r pane_id pane_command pane_path; do
    if [[ -d "${pane_path}" ]]; then
      if ! pane_path="$(cd "${pane_path}" 2> /dev/null && pwd -P)"; then
        continue
      fi
    fi
    [[ "${pane_path}" == "${worktree_path}" ]] || continue

    case "${pane_command}" in
      codex* | cx) ;;
      *) continue ;;
    esac

    candidate="${pane_id}"
    count=$((count + 1))
  done < <(env "TMUX=${tmux_env}" tmux list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}' 2> /dev/null || true)

  if ((count == 1)); then
    printf '%s' "${candidate}"
  fi

  return 0
}

function send_prompt_to_codex_pane() {
  local tmux_env="${1}" worktree_path="${2}" prompt_file="${3}" safe_name="${4}"
  local pane_id buffer delay tmux_status

  [[ -s "${prompt_file}" ]] || return 0
  [[ -n "${tmux_env}" ]] || return 0

  pane_id="$(codex_pane_for_path "${tmux_env}" "${worktree_path}" || true)"
  if [[ -z "${pane_id}" ]]; then
    return 0
  fi

  buffer="workmux-prompt-${safe_name}"
  delay="${WORKMUX_CODEX_PROMPT_SUBMIT_DELAY_SECONDS:-0.5}"

  tmux_status=0
  set +e
  env "TMUX=${tmux_env}" tmux load-buffer -b "${buffer}" "${prompt_file}"
  tmux_status=$?
  if ((tmux_status == 0)); then
    env "TMUX=${tmux_env}" tmux paste-buffer -t "${pane_id}" -b "${buffer}"
    tmux_status=$?
  fi
  if ((tmux_status == 0)); then
    sleep "${delay}"
    env "TMUX=${tmux_env}" tmux send-keys -t "${pane_id}" Enter
    tmux_status=$?
  fi
  if ((tmux_status == 0)); then
    sleep "${delay}"
    env "TMUX=${tmux_env}" tmux send-keys -t "${pane_id}" Enter
    tmux_status=$?
  fi
  env "TMUX=${tmux_env}" tmux delete-buffer -b "${buffer}" > /dev/null 2>&1
  set -e

  if ((tmux_status == 0)); then
    printf 'Sent prompt to existing Codex pane for %s\n' "${worktree_path}"
  fi

  return 0
}

function run_workmux_command() {
  local -a command=(workmux "${@}")
  local -a env_args=()
  local tmux_env
  tmux_env="$(resolved_tmux_env)"

  if [[ -n "${tmux_env}" ]]; then
    env_args+=("TMUX=${tmux_env}")
  fi

  if [[ -n "${WORKMUX_TERM:-}" ]]; then
    env_args+=("TERM=${WORKMUX_TERM}")
  elif [[ "${TERM:-}" == "dumb" && -n "${tmux_env}" ]]; then
    env_args+=(TERM=tmux-256color)
  fi

  if ((${#env_args[@]} > 0)); then
    env "${env_args[@]}" "${command[@]}"
  else
    "${command[@]}"
  fi
}

function run_workmux_with_existing_prompt_fallback() {
  local prompt_file="${1}" existing_worktree_path="${2}" safe_name="${3}"
  local status tmux_env prompt_to_send
  shift 3

  set +e
  run_workmux_command "${@}"
  status=$?
  set -e

  if ((status == 0)) && [[ -n "${existing_worktree_path}" ]]; then
    tmux_env="$(resolved_tmux_env)"
    prompt_to_send="${existing_worktree_path}/.workmux/PROMPT-${safe_name}.md"
    if [[ ! -s "${prompt_to_send}" ]]; then
      prompt_to_send="${prompt_file}"
    fi
    send_prompt_to_codex_pane "${tmux_env}" "${existing_worktree_path}" "${prompt_to_send}" "${safe_name}" || true
  fi

  return "${status}"
}

# Prints the one local branch for an issue, or nothing. Returns 3 when several
# match, and 1 when git cannot list branches, so a failure never reads as none.
function existing_branch_for_issue() {
  local issue="${1}"
  local refs line match=""
  local count=0
  # Any number of path segments may precede the number, so "feature/42-x" and
  # "user/feature/42-x" both count as branches for issue 42. A slash ends the
  # number too: normalize_branch_name turns "feature/issue-42/ui" into
  # "feature/42/ui", so without it the launcher could not find a branch it
  # had itself created.
  local pattern='^([^/]+/)*'"${issue}"'(-|/|$)'
  local -a candidates=()

  if ! refs="$(git for-each-ref --format='%(refname:short)' refs/heads/)"; then
    printf '%s: cannot list local branches to look for issue %s\n' "${SCRIPT_NAME}" "${issue}" >&2
    return 1
  fi

  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -n "${line}" ]] || continue
    if [[ "${line}" =~ ${pattern} ]]; then
      candidates+=("${line}")
      match="${line}"
      count=$((count + 1))
    fi
  done <<< "${refs}"

  if ((count > 1)); then
    printf '%s: issue %s matches more than one local branch:\n' "${SCRIPT_NAME}" "${issue}" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    printf '%s: pass an explicit branch name instead\n' "${SCRIPT_NAME}" >&2
    return 3
  fi

  printf '%s' "${match}"
}

function strip_issue_number() {
  local slug="${1}"
  local issue="${2}"

  if [[ "${slug}" == "${issue}" || "${slug}" == "issue-${issue}" || "${slug}" == "issue${issue}" ]]; then
    return 0
  fi

  slug="${slug#"${issue}"-}"
  slug="${slug#"issue-${issue}"-}"
  slug="${slug#"issue${issue}"-}"
  # Only a trailing "-issue-N" is dropped. A bare trailing "-N" can belong to
  # the name itself, as in "migrate-to-python-3" for issue 3.
  slug="${slug%"-issue-${issue}"}"

  # Only an explicit "issue-N" marker is dropped from the middle of the name. A
  # bare interior "-N-" carries meaning often enough that removing it loses
  # more than it saves: "python-3-support" for issue 3 would become
  # "python-support". The cost of leaving it is the number appearing twice.
  while [[ "${slug}" == *-"issue-${issue}"-* ]]; do
    slug="${slug/-"issue-${issue}"-/-}"
  done
  while [[ "${slug}" == *-"issue${issue}"-* ]]; do
    slug="${slug/-"issue${issue}"-/-}"
  done

  printf '%s' "${slug}"
}

function validate_branch_name() {
  local name="${1}"

  # A leading hyphen would reach `workmux add` in option position.
  if [[ "${name}" == -* ]]; then
    die "branch name starting with a hyphen: ${name}"
  fi

  if command -v git > /dev/null && ! git check-ref-format --branch "${name}" > /dev/null 2>&1; then
    die "git rejects branch name: ${name}"
  fi
}

function normalize_branch_name() {
  local raw="${1}"
  local issue="${2:-}"
  local name prefix slug rest

  # Preserve the invoking agent's case and repository naming conventions.
  name="${raw//$'\r'/}"
  while [[ "${name}" == [[:space:]]* ]]; do
    name="${name#?}"
  done
  while [[ "${name}" == *[[:space:]] ]]; do
    name="${name%?}"
  done

  if [[ -z "${name}" ]]; then
    die "generated candidate is empty"
  fi

  if [[ -z "${issue}" ]]; then
    validate_branch_name "${name}"
    printf '%s' "${name}"
    return 0
  fi

  if [[ "${name}" == */* ]]; then
    prefix="${name%%/*}"
    slug="${name#*/}"
  else
    prefix=""
    slug="${name}"
  fi

  # The number goes into the segment right after the type prefix. Any deeper
  # segments are part of the supplied candidate, so they are carried through
  # rather than flattened: feat/search/ui for issue 42 is feat/42-search/ui.
  if [[ "${slug}" == */* ]]; then
    rest="/${slug#*/}"
    slug="${slug%%/*}"
  else
    rest=""
  fi

  slug="$(strip_issue_number "${slug}" "${issue}")"

  if [[ -z "${slug}" ]]; then
    slug="${issue}"
  else
    slug="${issue}-${slug}"
  fi

  if [[ -n "${prefix}" ]]; then
    name="${prefix}/${slug}${rest}"
  else
    name="${slug}${rest}"
  fi

  validate_branch_name "${name}"
  printf '%s' "${name}"
}

# The detached half of --await-completion. Records workmux's exit status, then
# tries to create the handoff directory. If it does, the caller is still waiting
# and removes the state directory. If not, the caller timed out, and the status
# and log stay behind as the record of the launch.
#
# Ignores hangups so a departing terminal or harness cannot stop `workmux add`
# partway through creating a worktree.
function run_detached_launch() {
  local state_dir="${1}" prompt_file="${2}"
  local status=0
  shift 2

  trap '' HUP

  # Captured with `||`, not `set +e`: the helper re-enables errexit on return.
  run_workmux_and_cleanup_prompt "${prompt_file}" "${@}" > "${state_dir}/log" 2>&1 || status=$?
  {
    printf '%s\n' "${status}" > "${state_dir}/status.tmp" \
      && mv -- "${state_dir}/status.tmp" "${state_dir}/status"
  } || true
  mkdir "${state_dir}/handoff" 2> /dev/null || true
}

# The waiting half of --await-completion. Polls for the handoff directory, not
# the status file, because the handoff decides who owns the state directory.
function await_launch() {
  local state_dir="${1}" branch="${2}" timeout="${3}"
  local attempts=$((timeout * 5))
  local status worktree_path lookup_status

  while [[ ! -d "${state_dir}/handoff" ]] && ((attempts > 0)); do
    sleep 0.2
    attempts=$((attempts - 1))
  done

  if [[ ! -d "${state_dir}/handoff" ]] && mkdir "${state_dir}/handoff" 2> /dev/null; then
    cat "${state_dir}/log" 2> /dev/null || true
    printf '%s: workmux add for %s is still running after %ss; stopped waiting\n' "${SCRIPT_NAME}" "${branch}" "${timeout}" >&2
    lookup_status=0
    worktree_path="$(worktree_path_for_branch "${branch}")" || lookup_status=$?
    case "${lookup_status}" in
      0) printf '%s: a worktree for %s exists at %s, but the launch has not finished\n' "${SCRIPT_NAME}" "${branch}" "${worktree_path}" >&2 ;;
      1) printf '%s: no worktree for %s exists yet\n' "${SCRIPT_NAME}" "${branch}" >&2 ;;
      *) printf '%s: git cannot list worktrees, so the worktree state for %s is unknown\n' "${SCRIPT_NAME}" "${branch}" >&2 ;;
    esac
    printf '%s: its output continues in %s/log, and it writes its exit status to %s/status when it exits; remove %s after reading them\n' "${SCRIPT_NAME}" "${state_dir}" "${state_dir}" "${state_dir}" >&2
    return 124
  fi

  status="$(cat "${state_dir}/status" 2> /dev/null || true)"
  cat "${state_dir}/log" 2> /dev/null || true
  rm -r -f -- "${state_dir}"

  if [[ "${status}" != "0" ]]; then
    printf '%s: workmux add for %s failed with status %s\n' "${SCRIPT_NAME}" "${branch}" "${status:-unknown}" >&2
    return 1
  fi

  lookup_status=0
  worktree_path="$(worktree_path_for_branch "${branch}")" || lookup_status=$?
  if ((lookup_status == 1)); then
    printf '%s: workmux add exited 0, but git lists no worktree for %s\n' "${SCRIPT_NAME}" "${branch}" >&2
    return 1
  elif ((lookup_status != 0)); then
    printf '%s: workmux add exited 0, but git cannot list worktrees to confirm %s\n' "${SCRIPT_NAME}" "${branch}" >&2
    return 1
  fi

  printf 'Worktree ready: %s\n' "${worktree_path}"
}

function do_launch() {
  local branch="${1}"
  local base_branch="${2:-}"
  local generated_name="${3:-}"
  local issue="${4:-}"
  local await_completion="${5:-false}"
  local timeout="${6:-}"
  local safe_name existing_worktree_path log prompt_file state_dir
  local provisional_name

  if [[ -n "${generated_name}" ]]; then
    if [[ -n "${issue}" ]]; then
      provisional_name="issue-${issue}"
    else
      provisional_name="generated-name"
    fi
  else
    provisional_name="${branch//\//-}"
  fi

  prompt_file="$(mktemp "${TMPDIR:-/tmp}/workmux-prompt-${provisional_name}.md.XXXXXX")"

  write_escaped_prompt "${prompt_file}"

  if [[ -n "${generated_name}" ]]; then
    local reused=""

    if [[ -n "${issue}" ]]; then
      if ! reused="$(existing_branch_for_issue "${issue}")"; then
        remove_file_if_present "${prompt_file}"
        return 1
      fi
    fi

    if [[ -n "${reused}" ]]; then
      branch="${reused}"
      printf 'Reusing branch %s for issue %s\n' "${branch}" "${issue}"
    else
      if ! branch="$(normalize_branch_name "${generated_name}" "${issue}")"; then
        remove_file_if_present "${prompt_file}"
        return 1
      fi
      printf 'Generated branch name: %s\n' "${branch}"
    fi
  fi

  safe_name="${branch//\//-}"
  # Not fatal: only the prompt resend to an existing pane needs this path.
  local lookup_status=0
  existing_worktree_path="$(worktree_path_for_branch "${branch}")" || lookup_status=$?
  if ((lookup_status == 2)); then
    printf '%s: git cannot list worktrees; launching %s without checking for an existing one\n' "${SCRIPT_NAME}" "${branch}" >&2
  fi

  local -a cmd=(
    run_workmux_with_existing_prompt_fallback
    "${prompt_file}" "${existing_worktree_path}" "${safe_name}"
    add "${branch}" --open-if-exists -P "${prompt_file}"
  )
  if [[ -n "${base_branch}" ]]; then
    cmd+=(--base "${base_branch}")
  fi

  if [[ "${await_completion}" == "true" ]]; then
    state_dir="$(mktemp -d "${TMPDIR:-/tmp}/workmux-launch-${safe_name}.XXXXXX")"
    # Job control gives the launch its own process group, so a harness that
    # stops this launcher's group on a tool timeout does not stop `workmux add`.
    # stderr is discarded to hide a spurious bash "child setpgid" error, printed
    # when the parent sets the group first.
    set -m
    { run_detached_launch "${state_dir}" "${prompt_file}" "${cmd[@]}" < /dev/null > /dev/null 2>&1 & } 2> /dev/null
    set +m
    disown
    await_launch "${state_dir}" "${branch}" "${timeout}"
    return
  fi

  log="$(mktemp "${TMPDIR:-/tmp}/workmux-${safe_name}.log.XXXXXX")"

  run_workmux_and_cleanup_prompt "${prompt_file}" "${cmd[@]}" > "${log}" 2>&1 &
  disown
  sleep "${WORKMUX_LAUNCH_WAIT_SECONDS:-8}"

  cat "${log}"
  remove_file_if_present "${log}"
}

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  local base_branch=""
  local generated_name=""
  local generated_mode="false"
  local issue=""
  local await_completion="false"
  local timeout=""
  local resolve_issue=""
  local resolve_mode="false"
  local arg_count=$#
  local -a positional=()

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --resolve-issue-branch)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          usage >&2
          die "--resolve-issue-branch requires an issue number"
        fi
        resolve_issue="${2}"
        resolve_mode="true"
        shift 2
        ;;
      --await-completion)
        await_completion="true"
        shift
        ;;
      --base)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          usage >&2
          die "--base requires a branch name"
        fi
        base_branch="${2}"
        shift 2
        ;;
      --auto-name)
        die "--auto-name is obsolete; generate a candidate in the invoking agent and pass --generated-name <candidate>"
        ;;
      --generated-name)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          die "--generated-name requires a nonempty candidate"
        fi
        if [[ "${generated_mode}" == "true" ]]; then
          die "--generated-name may only be supplied once"
        fi
        generated_name="${2}"
        generated_mode="true"
        shift 2
        ;;
      --issue)
        if [[ $# -lt 2 || -z "${2}" ]]; then
          usage >&2
          die "--issue requires an issue number"
        fi
        issue="${2}"
        shift 2
        ;;
      -*)
        die "unknown option: ${1}"
        ;;
      *)
        positional+=("${1}")
        shift
        ;;
    esac
  done

  # Preflight mode reads branches only: no prompt on stdin, no launch.
  if [[ "${resolve_mode}" == "true" ]]; then
    if ((arg_count != 2)); then
      usage >&2
      die "--resolve-issue-branch takes no other arguments"
    fi

    if [[ ! "${resolve_issue}" =~ ^[1-9][0-9]*$ ]]; then
      usage >&2
      die "--resolve-issue-branch requires a positive integer, got: ${resolve_issue}"
    fi

    local reused
    reused="$(existing_branch_for_issue "${resolve_issue}")" || exit $?
    if [[ -n "${reused}" ]]; then
      printf '%s\n' "${reused}"
    fi
    return
  fi

  if [[ "${await_completion}" == "true" ]]; then
    # Below Claude Code's 120-second Bash tool timeout, so this bound ends the
    # wait first.
    timeout="${WORKMUX_LAUNCH_TIMEOUT_SECONDS:-90}"
    if [[ ! "${timeout}" =~ ^[1-9][0-9]*$ ]]; then
      die "WORKMUX_LAUNCH_TIMEOUT_SECONDS must be a positive integer, got: ${timeout}"
    fi
  fi

  if [[ -n "${generated_name}" ]]; then
    if [[ ${#positional[@]} -ne 0 ]]; then
      usage >&2
      die "--generated-name takes no branch-name argument, got ${#positional[@]}"
    fi

    if [[ -n "${issue}" && ! "${issue}" =~ ^[1-9][0-9]*$ ]]; then
      usage >&2
      die "--issue requires a positive integer, got: ${issue}"
    fi

    generated_name="$(normalize_branch_name "${generated_name}")"
    do_launch "" "${base_branch}" "${generated_name}" "${issue}" "${await_completion}" "${timeout}"
    return
  fi

  if [[ -n "${issue}" ]]; then
    usage >&2
    die "--issue requires --generated-name"
  fi

  if [[ ${#positional[@]} -ne 1 ]]; then
    usage >&2
    die "expected 1 argument (branch-name), got ${#positional[@]}"
  fi

  validate_branch_name "${positional[0]}"
  do_launch "${positional[0]}" "${base_branch}" "" "" "${await_completion}" "${timeout}"
}

main "$@"
