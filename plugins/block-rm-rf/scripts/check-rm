#!/usr/bin/env bash
set -euo pipefail

# Reads the Bash tool input from stdin and blocks recursive rm commands.
# Exit code 2 tells Claude Code to reject the tool use.

command="$(jq -r '.input.command // empty')"

if printf '%s' "$command" | grep -qE 'rm\s+(-[a-zA-Z]*r|-R|--recursive)'; then
  echo "Use 'trash' instead of recursive rm. It moves files to the system Trash instead of permanently deleting them." >&2
  exit 2
fi
