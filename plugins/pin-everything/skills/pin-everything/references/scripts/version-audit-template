#!/usr/bin/env bash
# Template for bin/version-audit. Audits version surfaces that Dependabot does
# not cover and writes a Markdown report to stdout. Empty output means no drift.
#
# This file is a TEMPLATE consumed by the pin-everything skill. The skill reads
# it, tailors the SCAN_PATHS list and the audit_* function calls at the bottom
# to the consuming repo's actual surfaces, and writes the result to that repo's
# bin/version-audit.
#
# Surfaces audited:
#   - Node.js in whichever Node version file the repo uses (.tool-versions with
#     a `nodejs` line, .nvmrc, or .node-version). Drift is checked against the
#     latest release in the same major series as the pinned version (so repos
#     intentionally on a Current/non-LTS major are not falsely flagged).
#   - package.json packageManager (Yarn or pnpm via Corepack)
#   - Release-tagged SHA-pinned action refs (those whose comment is a numeric
#     `# vX.Y.Z` tag). Drift is checked against `releases/latest`, falling
#     back to the highest semver-looking entry under `repos/<r>/tags` for
#     repos that publish tags without creating GitHub Releases. Channel/branch
#     pins (`# stable`, `# main`) are out of scope because there is no
#     upstream "latest version" to compare against
#   - npx <tool>@<version> pins
#   - go install <path>@v<version> pins for known tools
#   - cargo install --version <X> <crate> pins
#   - Python install pins across every uv / pip verb: pip install, uv pip install,
#     uv add, uv tool install, and uvx (all using `<pkg>==<X>` form)
#
# Requires: gh (authenticated), jq, curl.

set -euo pipefail

# Requires Bash 4+ (associative arrays via `declare -A`). macOS ships /bin/bash
# 3.2 by default; install a newer Bash via Homebrew (`brew install bash`) and
# invoke this script via its shebang (`./bin/version-audit`) so /usr/bin/env
# picks up the Homebrew-installed bash from PATH.
if ((BASH_VERSINFO[0] < 4)); then
  echo "version-audit: Bash 4+ required (found ${BASH_VERSION}). On macOS, run 'brew install bash' and invoke as ./bin/version-audit." >&2
  exit 1
fi

# Resolve to the repo root so all relative paths below (TOOL_VERSIONS_FILE,
# PACKAGE_JSON, SCAN_PATHS) work regardless of the caller's working directory.
repo_root=$(git rev-parse --show-toplevel 2> /dev/null || true)
if [[ -z "${repo_root}" ]]; then
  echo "version-audit: must be run inside a git repository" >&2
  exit 1
fi
cd "${repo_root}"

# REPLACE: SCAN_PATHS lists the directories the audit greps for embedded pins.
# Tailor this to the consuming repo's layout. Defaults match cboone-cc-plugins.
SCAN_PATHS=(.github/ plugins/)

TOOL_VERSIONS_FILE=".tool-versions"
PACKAGE_JSON="package.json"
readonly TOOL_VERSIONS_FILE PACKAGE_JSON SCAN_PATHS

drift_rows=()

function record_drift() {
  local category="${1}" name="${2}" current="${3}" latest="${4}" location="${5}"
  drift_rows+=("${category}|${name}|${current}|${latest}|${location}")
}

function github_latest_release() {
  local repo="${1}" latest
  # Prefer GitHub Releases when the repo publishes them.
  latest=$(gh api "repos/${repo}/releases/latest" --jq '.tag_name' 2> /dev/null || true)
  if [[ -n "${latest}" ]]; then
    printf '%s\n' "${latest}"
    return
  fi
  # Fall back to the highest semver-looking tag for repos that publish version
  # tags without creating GitHub Releases (otherwise audit_actions would
  # silently skip drift for valid SHA-pinned refs against those repos).
  # `sort -V` does version-aware ordering and handles the common `v` prefix.
  gh api "repos/${repo}/tags" --paginate --jq '.[].name' 2> /dev/null \
    | grep -E '^v?[0-9]+(\.[0-9]+)+$' \
    | sort -V \
    | tail -n 1 \
    || true
}

# 1. Node.js — read whichever Node version file the repo uses.
#
# Skill step 4 prefers reusing the file local tooling already reads (.nvmrc for
# nvm, .node-version for nodenv) over introducing a parallel .tool-versions.
# Mirror that priority order here so the audit inspects the actual source of
# truth rather than silently missing drift when the repo uses .nvmrc instead.
#
# Drift is checked against the latest release in the same major series as the
# pinned version, NOT against the latest LTS unconditionally. Repos that
# intentionally pin a Current (odd-numbered, non-LTS) major like Node 23 should
# not be told to "downgrade" to the latest LTS major every audit cycle; they
# should only be flagged when the upstream cuts a newer patch within the same
# major. If the file holds a non-numeric value (an .nvmrc alias like `lts/*`,
# `node`, or `latest`; a major-only pin like `22`), the same-major lookup
# returns no match and the audit silently skips the row — those values are not
# pins and the script has nothing to compare against.

function audit_node() {
  local current="" source="" major latest

  if [[ -f "${TOOL_VERSIONS_FILE}" ]]; then
    current=$(awk '/^nodejs / {print $2; exit}' "${TOOL_VERSIONS_FILE}")
    if [[ -n "${current}" ]]; then
      source="${TOOL_VERSIONS_FILE}"
    fi
  fi
  if [[ -z "${current}" && -f ".nvmrc" ]]; then
    current=$(head -n 1 .nvmrc | sed 's/^v//; s/[[:space:]]//g')
    if [[ -n "${current}" ]]; then
      source=".nvmrc"
    fi
  fi
  if [[ -z "${current}" && -f ".node-version" ]]; then
    current=$(head -n 1 .node-version | sed 's/^v//; s/[[:space:]]//g')
    if [[ -n "${current}" ]]; then
      source=".node-version"
    fi
  fi
  if [[ -z "${current}" ]]; then
    return
  fi

  # Require an exact `X.Y.Z` form: a non-numeric or partial value (alias,
  # major-only) cannot be matched against a same-major upstream release.
  if [[ ! "${current}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    return
  fi
  major="${current%%.*}"

  latest=$(curl -fsSL https://nodejs.org/dist/index.json 2> /dev/null \
    | jq -r --arg prefix "v${major}." \
      'first(.[] | select(.version | startswith($prefix))) | .version // empty' \
    | sed 's/^v//' || true)
  if [[ -z "${latest}" ]]; then
    return
  fi

  if [[ "${current}" != "${latest}" ]]; then
    record_drift "Node.js" "nodejs (${major}.x)" "${current}" "${latest}" "${source}"
  fi
}

# 2. Yarn / pnpm version in package.json packageManager
#
# Corepack supports both Yarn (`yarn@X.Y.Z+sha512.<hash>`) and pnpm
# (`pnpm@X.Y.Z+sha512.<hash>`) under the same `packageManager` field. Audit
# whichever is present; npm has no equivalent integrity surface.

function audit_packagemanager() {
  if [[ ! -f "${PACKAGE_JSON}" ]]; then
    return
  fi

  local declaration mgr current latest
  declaration=$(jq -r '.packageManager // empty' "${PACKAGE_JSON}")
  if [[ "${declaration}" =~ ^yarn@([0-9.]+) ]]; then
    mgr="yarn"
    current="${BASH_REMATCH[1]}"
    latest=$(curl -fsSL https://repo.yarnpkg.com/tags 2> /dev/null \
      | jq -r '.latest.stable // empty' || true)
  elif [[ "${declaration}" =~ ^pnpm@([0-9.]+) ]]; then
    mgr="pnpm"
    current="${BASH_REMATCH[1]}"
    latest=$(curl -fsSL https://registry.npmjs.org/pnpm/latest 2> /dev/null \
      | jq -r '.version // empty' || true)
  else
    return
  fi

  if [[ -z "${latest}" ]]; then
    return
  fi

  if [[ "${current}" != "${latest}" ]]; then
    record_drift "packageManager" "${mgr} (Corepack)" "${current}" "${latest}" "${PACKAGE_JSON}"
  fi
}

# 3. SHA-pinned third-party action refs

function audit_actions() {
  declare -A seen=()
  local line file content repo current key latest
  while IFS= read -r line; do
    file="${line%%:*}"
    content="${line#*:}"
    # Only release-tagged pins (numeric `# vX.Y.Z` comment) are audited.
    # Channel/branch pins (`# stable`, `# main`) are intentionally out of scope:
    # they have no upstream "latest version" to compare against and would need a
    # different "pinned SHA vs. branch HEAD" check entirely.
    if [[ "${content}" =~ ([a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)(/[^@]*)?@[a-f0-9]{40}[[:space:]]+#[[:space:]]+(v?[0-9]+(\.[0-9]+)*) ]]; then
      repo="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[3]}"
      # Key dedup by repo+current so divergent pins (same action at two
      # different versions in the repo) are each checked rather than masked
      # by whichever pin happens to be grepped first.
      key="${repo}|${current}"
      if [[ -n "${seen[${key}]:-}" ]]; then
        continue
      fi
      seen[${key}]=1
      latest=$(github_latest_release "${repo}")
      if [[ -n "${latest}" && "${latest#v}" != "${current#v}" ]]; then
        record_drift "Actions" "${repo}" "${current}" "${latest}" "${file}"
      fi
    fi
  done < <(grep -rHE 'uses:[[:space:]]+[a-zA-Z0-9._/-]+@[a-f0-9]{40}' "${SCAN_PATHS[@]}" 2> /dev/null || true)
}

# 4. npx <tool>@<version> pins

function npm_latest() {
  local pkg="${1}"
  # Scoped packages (e.g. `@taplo/cli`) require the `/` between scope and name
  # to be URL-encoded; otherwise the registry returns 404.
  local encoded="${pkg//\//%2f}"
  curl -fsSL "https://registry.npmjs.org/${encoded}/latest" 2> /dev/null | jq -r '.version // empty' || true
}

function audit_npx_pins() {
  declare -A seen=()
  local line file content pkg current key latest
  while IFS= read -r line; do
    file="${line%%:*}"
    content="${line#*:}"
    if [[ "${content}" =~ npx[[:space:]]+(@?[a-zA-Z0-9._/-]+)@([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      pkg="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      key="${pkg}|${current}"
      if [[ -n "${seen[${key}]:-}" ]]; then
        continue
      fi
      seen[${key}]=1
      latest=$(npm_latest "${pkg}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "npx pin" "${pkg}" "${current}" "${latest}" "${file}"
      fi
    fi
  done < <(grep -rHE 'npx[[:space:]]+@?[a-zA-Z0-9._/-]+@[0-9]+\.[0-9]+\.[0-9]+' "${SCAN_PATHS[@]}" 2> /dev/null || true)
}

# 5. go install <path>@v<version> pins for known tools
#
# REPLACE: extend path_to_repo with the install paths the consuming repo uses.
# Maps go-install paths to a GitHub repo whose latest release is the
# upstream-of-record. Unknown paths are skipped.

function audit_go_install_pins() {
  declare -A path_to_repo=(
    ['github.com/golangci/golangci-lint/v2/cmd/golangci-lint']='golangci/golangci-lint'
    ['golang.org/x/vuln/cmd/govulncheck']='golang/vuln'
    ['github.com/goreleaser/goreleaser/v2']='goreleaser/goreleaser'
    ['github.com/rhysd/actionlint/cmd/actionlint']='rhysd/actionlint'
    ['mvdan.cc/sh/v3/cmd/shfmt']='mvdan/sh'
    ['github.com/google/yamlfmt/cmd/yamlfmt']='google/yamlfmt'
  )
  declare -A seen=()
  local line file content install_path current key repo latest
  while IFS= read -r line; do
    file="${line%%:*}"
    content="${line#*:}"
    if [[ "${content}" =~ go[[:space:]]install[[:space:]]+([a-zA-Z0-9./-]+)@(v[0-9]+(\.[0-9]+)*) ]]; then
      install_path="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      repo="${path_to_repo[${install_path}]:-}"
      if [[ -z "${repo}" ]]; then
        continue
      fi
      key="${install_path}|${current}"
      if [[ -n "${seen[${key}]:-}" ]]; then
        continue
      fi
      seen[${key}]=1
      latest=$(github_latest_release "${repo}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "go install" "${install_path}" "${current}" "${latest}" "${file}"
      fi
    fi
  done < <(grep -rHE 'go install [a-zA-Z0-9./-]+@v[0-9]+' "${SCAN_PATHS[@]}" 2> /dev/null || true)
}

# 6. cargo install --version <X> <crate> pins

function crates_io_latest() {
  local crate="${1}"
  curl -fsSL "https://crates.io/api/v1/crates/${crate}" 2> /dev/null | jq -r '.crate.max_stable_version // empty' || true
}

function audit_cargo_install_pins() {
  declare -A seen=()
  local line file content current crate key latest
  while IFS= read -r line; do
    file="${line%%:*}"
    content="${line#*:}"
    if [[ "${content}" =~ cargo[[:space:]]install[[:space:]]+(--locked[[:space:]]+)?--version[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+)[[:space:]]+([a-zA-Z0-9_-]+) ]]; then
      current="${BASH_REMATCH[2]}"
      crate="${BASH_REMATCH[3]}"
      key="${crate}|${current}"
      if [[ -n "${seen[${key}]:-}" ]]; then
        continue
      fi
      seen[${key}]=1
      latest=$(crates_io_latest "${crate}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "cargo install" "${crate}" "${current}" "${latest}" "${file}"
      fi
    fi
  done < <(grep -rHE 'cargo install (--locked )?--version [0-9]+\.[0-9]+' "${SCAN_PATHS[@]}" 2> /dev/null || true)
}

# 7. Python install pins across every uv / pip verb (pip install, uv pip install,
# uv add, uv tool install, uvx) — all use `<pkg>==<X>` and resolve against PyPI.

function pypi_latest() {
  local pkg="${1}"
  curl -fsSL "https://pypi.org/pypi/${pkg}/json" 2> /dev/null | jq -r '.info.version // empty' || true
}

function audit_python_install_pins() {
  declare -A seen=()
  local line file content rest pkg current key latest
  while IFS= read -r line; do
    file="${line%%:*}"
    content="${line#*:}"
    # Walk every `pkg==X.Y.Z` token on the line. Bash regex via `=~` only matches
    # the first occurrence per attempt, so a single-shot match would silently
    # skip drift for additional requirements on the same line (e.g.
    # `pip install 'ruff==X' 'mypy==Y'` or `uv add 'foo==X' 'bar==Y'`). After
    # each match, advance `rest` past the matched substring and try again until
    # no further requirement matches. PyPI package names may include `.` (e.g.,
    # `zope.interface`), `-`, and `_`; PEP 503 normalizes them but the surface
    # form preserves the original.
    rest="${content}"
    while [[ "${rest}" =~ \'?([a-zA-Z0-9._-]+)==([0-9]+(\.[0-9]+)*)\'? ]]; do
      pkg="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      rest="${rest#*"${BASH_REMATCH[0]}"}"
      key="${pkg}|${current}"
      if [[ -n "${seen[${key}]:-}" ]]; then
        continue
      fi
      seen[${key}]=1
      latest=$(pypi_latest "${pkg}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "python install" "${pkg}" "${current}" "${latest}" "${file}"
      fi
    done
    # Allow arbitrary flags / quoting between the install command and the
    # `pkg==X.Y.Z` requirement so forms like `pip install --upgrade 'pkg==1.2.3'`,
    # `uv add --dev 'pkg==1.2.3'`, `uv tool install --force 'pkg==1.2.3'`, and
    # `uvx --from 'pkg==1.2.3' cmd` are not silently skipped. The extraction
    # regex inside the function still anchors on the unquoted `pkg==version`
    # token. Match every Python install verb that resolves against PyPI:
    # `pip install`, `uv pip install`, `uv add`, `uv tool install`, `uvx`.
  done < <(grep -rHE '(pip install|uv (pip install|add|tool install)|uvx)[[:space:]].*[a-zA-Z0-9._-]+==[0-9]' "${SCAN_PATHS[@]}" 2> /dev/null || true)
}

# Print Markdown report

function print_report() {
  if ((${#drift_rows[@]} == 0)); then
    return
  fi

  printf '<!-- version-audit -->\n\n'
  printf '## Version drift\n\n'
  printf 'Surfaces that Dependabot does not cover have drifted from upstream. Each row lists the current pinned version and the latest available.\n\n'
  printf '| Category | Name | Current | Latest | Location |\n'
  printf '| --- | --- | --- | --- | --- |\n'

  local row category name current latest location
  for row in "${drift_rows[@]}"; do
    IFS='|' read -r category name current latest location <<< "${row}"
    printf '| %s | `%s` | `%s` | `%s` | %s |\n' \
      "${category}" "${name}" "${current}" "${latest}" "${location}"
  done

  printf '\n---\n_Generated by `bin/version-audit`._\n'
}

# REPLACE: drop audit_* calls for surfaces the consuming repo does not use.
audit_node
audit_packagemanager
audit_actions
audit_npx_pins
audit_go_install_pins
audit_cargo_install_pins
audit_python_install_pins
print_report
