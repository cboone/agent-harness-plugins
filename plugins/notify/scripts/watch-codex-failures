#!/usr/bin/env bash
# watch-codex-failures -- Follow one owned Codex rollout for terminal failures.
set -euo pipefail

READER_PID=""
READER_DIR=""
WATCHDOG_PID=""

function stop_reader() {
  if [[ -n "${READER_PID}" ]]; then
    kill "${READER_PID}" 2> /dev/null || true # error-output-allow: owned reader may already have exited
    wait "${READER_PID}" 2> /dev/null || true # error-output-allow: stopping the owned follower intentionally produces a signal exit
    READER_PID=""
  fi
}

# Sets BYTE_COUNT without launching a subprocess or changing notification locales.
function count_bytes() {
  local LC_ALL=C
  BYTE_COUNT=${#1}
}

function cleanup() {
  if [[ -n "${WATCHDOG_PID}" ]]; then
    kill "${WATCHDOG_PID}" 2> /dev/null || true # error-output-allow: owned supervisor may have exited
    wait "${WATCHDOG_PID}" 2> /dev/null || true # error-output-allow: intentional owned supervisor termination
  fi
  stop_reader
  if [[ -n "${READER_DIR}" ]]; then rm -r "${READER_DIR}"; fi
}

# Preserve the supervisor's status while closing the follower on every exit.
function stop_owner_watch() {
  local timer_pid="${1}" reader_pid="${2}" status="${3}"
  trap - EXIT
  trap '' TERM INT
  if [[ -n "${timer_pid}" ]]; then
    kill "${timer_pid}" 2> /dev/null || true # error-output-allow: owned timer may have stopped
    wait "${timer_pid}" 2> /dev/null || true # error-output-allow: intentional owned timer termination
  fi
  kill "${reader_pid}" 2> /dev/null || true # error-output-allow: owned follower may have stopped
  exit "${status}"
}

function watch_owner() {
  local owner_pid="${1}" reader_pid="${2}" sleeper="" status
  trap 'stop_owner_watch "${sleeper}" "${reader_pid}" "$?"' EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT
  while kill -0 "${owner_pid}" 2> /dev/null; do # error-output-allow: explicit owner-existence predicate
    sleep 3 &
    sleeper=$!
    if wait "${sleeper}"; then
      sleeper=""
    else
      status=$?
      sleeper=""
      exit "${status}"
    fi
  done
  exit 0
}

function usage() {
  cat << 'USAGE'
Usage: watch-codex-failures --rollout PATH (--owner-pid PID | --once) [options]

  --thread-id ID       Expected thread identity; otherwise use session_meta
  --session-name NAME  Banner name; defaults to the thread ID
  --tmux-session NAME  Originating tmux session, supplied by the launcher
  --tmux-window NAME   Originating tmux window, supplied by the launcher
  --cwd PATH          Originating directory; defaults to the launch directory
  --tier TIER         top, lead, worker or untiered
  --owner-pid PID     Follow new records until this supervising process exits
  --once              Process existing records to EOF, then exit
  -h, --help          Show this help

Follow mode skips existing completions. --once deliberately processes history.
Only the given rollout supplies events. No socket or daemon is used.
USAGE
}

function die() {
  printf 'watch-codex-failures: %s\n' "${1}" >&2
  exit 1
}

function main() {
  local rollout="" owner_pid="" once=false expected="" name="" tmux_session="" tmux_window=""
  local cwd="${PWD}" tier="${NOTIFY_TIER:-}" option value script_dir
  while (($#)); do
    option="${1}"
    case "${option}" in
      --once)
        once=true
        shift
        continue
        ;;
      -h | --help)
        usage
        return
        ;;
      --rollout | --owner-pid | --thread-id | --session-name | --tmux-session | --tmux-window | --cwd | --tier)
        (($# >= 2)) || die "${option} requires a value"
        value="${2}"
        [[ -n "${value}" ]] || die "${option} requires a non-empty value"
        case "${option}" in
          --rollout) rollout="${value}" ;;
          --owner-pid) owner_pid="${value}" ;;
          --thread-id) expected="${value}" ;;
          --session-name) name="${value}" ;;
          --tmux-session) tmux_session="${value}" ;;
          --tmux-window) tmux_window="${value}" ;;
          --cwd) cwd="${value}" ;;
          --tier) tier="${value}" ;;
          *) die "unknown option: ${option}" ;;
        esac
        shift 2
        ;;
      *) die "unknown option: ${option}" ;;
    esac
  done
  if [[ "${rollout}" != /* ]]; then rollout="${PWD}/${rollout}"; fi
  [[ -n "${rollout}" && -f "${rollout}" && -r "${rollout}" ]] || die 'a readable rollout file is required'
  if [[ "${once}" == true ]]; then
    [[ -z "${owner_pid}" ]] || die '--once and --owner-pid are mutually exclusive'
  else
    [[ "${owner_pid}" =~ ^[1-9][0-9]*$ ]] || die '--owner-pid requires a positive PID'
    kill -0 "${owner_pid}" 2> /dev/null || die 'the supervising process is not running' # error-output-allow: process-existence predicate receives the explicit supervising-process diagnostic
  fi
  case "${tier}" in
    '' | top | lead | worker | untiered) ;;
    *) die 'invalid tier' ;;
  esac
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  local initial_bytes bytes_read=0 BYTE_COUNT=0 startup_suffix
  initial_bytes="$(LC_ALL=C wc -c < "${rollout}")"
  if [[ "${once}" == false ]]; then
    startup_suffix="$(head -c "${initial_bytes}" "${rollout}" | tail -n 1 && printf '.')"
    startup_suffix="${startup_suffix%.}"
    if [[ "${startup_suffix}" != *$'\n' ]]; then
      count_bytes "${startup_suffix}"
      initial_bytes=$((initial_bytes - BYTE_COUNT))
    fi
  fi
  cd -- "${cwd}"
  trap cleanup EXIT
  trap 'exit 143' TERM
  trap 'exit 130' INT

  local line line_bytes partial="" record identity="" subagent=false state=startup action turn kind message key marker payload alerter_path claim_error key_json
  local record_subagent supervisor_status reader_status owner_running
  exec 3< "${rollout}" # error-output-allow: retained rollout descriptor; open errors remain live
  [[ "${once}" == false ]] || state=final-drain
  while true; do
    line=""
    if IFS= read -r line <&3; then
      line="${partial}${line}"
      partial=""
      count_bytes "${line}"
      line_bytes=${BYTE_COUNT}
      bytes_read=$((bytes_read + line_bytes + 1))
      record="$(printf '%s' "${line}" | jq -r --arg identity "${identity}" -f "${script_dir}/codex-failure.jq")" || die 'invalid rollout record'
      [[ -n "${record}" ]] || continue
      IFS=$'\t' read -r action value record_subagent turn kind message key_json <<< "${record}"
      # jq's TSV encoding escapes only backslashes, tabs, CR and LF. Prefixes
      # keep empty fields intact through Bash's whitespace-delimited read.
      printf -v action '%b' "${action:1}"
      printf -v value '%b' "${value:1}"
      printf -v record_subagent '%b' "${record_subagent:1}"
      printf -v turn '%b' "${turn:1}"
      printf -v kind '%b' "${kind:1}"
      printf -v message '%b' "${message:1}"
      printf -v key_json '%b' "${key_json:1}"
      if [[ "${action}" == meta ]]; then
        [[ -n "${value}" ]] || value="${expected}"
        [[ -n "${value}" ]] || die 'session_meta has no thread identity'
        [[ -z "${identity}" || "${identity}" == "${value}" ]] || die 'rollout thread identity changed'
        [[ -z "${expected}" || "${expected}" == "${value}" ]] || die 'rollout does not match --thread-id'
        identity="${value}"
        subagent="${record_subagent}"
        if [[ "${state}" == startup ]]; then
          bytes_read=${initial_bytes}
          exec 3<&- # error-output-allow: close owned metadata reader before starting the persistent follower
          READER_DIR="$(mktemp -d "${TMPDIR:-/tmp}/notify-reader.XXXXXX")"
          mkfifo "${READER_DIR}/records"
          tail -c "+$((initial_bytes + 1))" -f "${rollout}" > "${READER_DIR}/records" &
          READER_PID=$!
          exec 3< "${READER_DIR}/records" # error-output-allow: persistent follower FIFO; errors remain on stderr
          watch_owner "${owner_pid}" "${READER_PID}" &
          WATCHDOG_PID=$!
          state=following
        fi
        continue
      fi
      [[ -n "${identity}" ]] || die 'terminal record precedes session_meta'
      [[ "${state}" != startup && "${subagent}" == false ]] || continue
      key="$(printf '%s\n' "${key_json}" | shasum -a 256 | cut -d ' ' -f 1)"
      marker="${XDG_CACHE_HOME:-${HOME}/.cache}/agent-harness-notify/codex-failures/${key}"
      [[ ! -e "${marker}" && ! -L "${marker}" ]] || continue
      if ! alerter_path="$(command -v alerter)" || [[ ! -f "${alerter_path}" || ! -x "${alerter_path}" ]]; then
        die "alerter is not executable (thread ${identity}, turn ${turn})"
      fi
      mkdir -p "$(dirname "${marker}")"
      # Claim delivery once across concurrent readers and restarts. Never retry an uncertain delivery.
      if claim_error="$( (
        set -o noclobber
        : > "${marker}"
      ) 2>&1)"; then # error-output-allow: exclusive file claim retains errors for non-contention failure diagnostics
        payload="$(jq -nc --arg kind "${kind}" --arg message "${message}" --arg session_id "${identity}" --arg turn_id "${turn}" \
          --arg session_name "${name}" --arg tmux_session "${tmux_session}" --arg tmux_window "${tmux_window}" \
          '{kind:$kind,message:$message,session_id:$session_id,turn_id:$turn_id,session_name:$session_name,
            tmux_session:$tmux_session,tmux_window:$tmux_window}')"
        printf '%s' "${payload}" | NOTIFY_TIER="${tier}" "${script_dir}/notify" codex-failure
      elif [[ ! -e "${marker}" && ! -L "${marker}" ]]; then
        die "cannot claim failure delivery: ${claim_error}"
      fi
    else
      partial="${partial}${line}"
      [[ -n "${identity}" ]] || die 'rollout has no session_meta'
      if [[ "${state}" == final-drain ]]; then
        [[ -z "${partial}" ]] || die 'incomplete rollout record at EOF'
        if [[ -n "${READER_PID}" ]]; then
          wait "${READER_PID}" || die 'rollout reader failed'
          READER_PID=""
        fi
        break
      fi
      owner_running=false
      if kill -0 "${owner_pid}" 2> /dev/null; then # error-output-allow: unexpected EOF requires stopping the owned supervisor before waiting
        owner_running=true
        kill "${WATCHDOG_PID}" 2> /dev/null || true # error-output-allow: supervisor may already be exiting after closing the follower
      fi
      reader_status=0
      wait "${READER_PID}" || reader_status=$?
      READER_PID=""
      supervisor_status=0
      wait "${WATCHDOG_PID}" || supervisor_status=$?
      WATCHDOG_PID=""
      if ((supervisor_status != 0)); then
        die "owner supervisor exited with status ${supervisor_status} (owner ${owner_pid}, rollout ${rollout}; reader status ${reader_status})"
      fi
      [[ "${owner_running}" == false ]] || die 'rollout reader stopped before its owner'
      if ((reader_status != 0 && reader_status != 143)); then
        die "rollout reader exited with status ${reader_status} (rollout ${rollout})"
      fi
      exec 3<&- # error-output-allow: close owned follower FIFO before the final byte-offset drain
      partial=""
      tail -c "+$((bytes_read + 1))" "${rollout}" > "${READER_DIR}/records" &
      READER_PID=$!
      exec 3< "${READER_DIR}/records" # error-output-allow: final drain FIFO; reader stderr remains live
      state=final-drain
    fi
  done
}

main "$@"
