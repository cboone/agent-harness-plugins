#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Run declared private plants; publish records only from verified JSON evidence."""

import argparse
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


# Keep module bytecode out of the shipped plugin.
sys.dont_write_bytecode = True
from checked_core import (
    require, parse_json, digest, failure_cause, write_json, relative, read_regular,
    command, valid_step, reserve_outputs,
)

SCHEMA = 1
BEGIN = "<!-- checked-plants:start -->"
END = "<!-- checked-plants:end -->"


def load_manifest(path):
    data, mode = read_regular(path)
    manifest = parse_json(data)
    require(isinstance(manifest, dict), "manifest must be an object")
    variants = manifest.get("variants", [])
    controls = manifest.get("controls", [])
    require(isinstance(variants, list) and isinstance(controls, list) and (variants or controls),
            "declare at least one assertion variant or green control")
    names = [v.get("name") if isinstance(v, dict) else None for v in variants + controls]
    require(all(isinstance(n, str) and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,63}", n) for n in names),
            "variant names must be simple lowercase labels")
    require(len(set(names)) == len(names), "variant names must be unique")
    return manifest, dict(sha256=digest(data), mode=mode)


def declarations(manifest):
    return [("plant", v) for v in manifest.get("variants", [])] + [("control", v) for v in manifest.get("controls", [])]


def outcome(kind):
    return "red" if kind == "plant" else "control-green"


def validate_manifest(manifest):
    inputs = manifest.get("inputs")
    require(isinstance(inputs, list) and inputs, "declare every source, script, patch and fixture in inputs")
    for name in inputs:
        relative(name)
    require(len(set(inputs)) == len(inputs), "duplicate input")
    require(not ({"manifest", "runner"} & set(inputs)), "reserved input name")
    require(manifest.get("check") in inputs, "check script must be an input")
    require(manifest.get("setup") is None or manifest["setup"] in inputs, "setup script must be an input")
    timeout = manifest.get("timeout", 60)
    require(type(timeout) in (int, float) and 0 < timeout <= 3600, "timeout must be in (0, 3600]")
    for kind, variant in declarations(manifest):
        require(variant.get("patch") in inputs, "variant/control patch must be an input")
        if kind == "plant":
            expectation(variant.get("red"), red=True)
        else:
            require("red" not in variant, "a green control cannot declare a red expectation")
    expectation(manifest.get("green"), red=False)


def expectation(value, *, red):
    require(isinstance(value, dict), "check expectation must be an object")
    code = value.get("exit_code")
    require(type(code) is int and (1 <= code <= 125 if red else code == 0), "invalid expected check exit")
    for key in ("contains", "excludes"):
        items = value.get(key, [])
        require(isinstance(items, list) and all(isinstance(s, str) and s for s in items),
                "output predicates must be lists of nonempty literal strings")
    require(bool(value.get("contains")), "require named assertion/progress evidence")


def snapshot(path, manifest, fingerprints=None, retain=True):
    paths = {"manifest": path, "runner": Path(__file__).resolve()}
    paths.update({name: path.parent / relative(name) for name in manifest["inputs"]})
    fingerprints = {} if fingerprints is None else fingerprints
    contents = {}
    for name, source in paths.items():
        try:
            data, mode = read_regular(source, root=path.parent if name not in ("manifest", "runner") else None)
            fingerprints[name] = dict(sha256=digest(data), mode=mode)
            if name == "runner":
                module_data, module_mode = read_regular(Path(__file__).resolve().with_name("checked_core.py"))
                fingerprints[name]["core"] = dict(sha256=digest(module_data), mode=module_mode)
            if retain:
                contents[name] = (data, mode)
        except (OSError, ValueError) as error:
            fingerprints[name] = None
            contents[name] = f"missing/unreadable input {name}: " + failure_cause(error)
    return fingerprints, contents


def materialize(root, manifest, contents):
    for name in manifest["inputs"]:
        target = root / name
        target.parent.mkdir(parents=True, exist_ok=True)
        data, mode = contents[name]
        target.write_bytes(data)
        target.chmod(mode)


def checked(argv, root, timeout):
    result = command(argv, root, timeout, git_boundary=True)
    require(valid_step(result) and result["exit_code"] == 0, f"step failed: {argv}: {result}")
    return result


def matches(result, wanted):
    output = result["stdout"] + result["stderr"]
    return (valid_step(result) and type(result["exit_code"]) is int and result["exit_code"] == wanted["exit_code"]
            and all(s in output for s in wanted["contains"])
            and not any(s in output for s in wanted.get("excludes", [])))


def check(root, manifest, row, phase):
    timeout = manifest.get("timeout", 60)
    if manifest.get("setup"):
        row[phase + "_setup"] = command(["bash", "-euo", "pipefail", "--", manifest["setup"]], root, timeout)
        require(valid_step(row[phase + "_setup"]) and row[phase + "_setup"]["exit_code"] == 0,
                f"{phase} setup failed: {row[phase + '_setup']}")
    row[phase] = command(["bash", "-euo", "pipefail", "--", manifest["check"]], root, timeout)
    require(valid_step(row[phase]), f"{phase} check incomplete, timed out or truncated: {row[phase]}")


def run_variant(parent, manifest, contents, variant, row):
    root = parent / "subject"
    root.mkdir()
    materialize(root, manifest, contents)
    try:
        check(root, manifest, row, "baseline")
        require(matches(row["baseline"], manifest["green"]), "baseline control failed")
        patch = parent / "variant.patch"
        patch.write_bytes(contents[variant["patch"]][0])
        git_context = parent / "patch.git"
        checked(["git", "init", "--bare", "--quiet", "--template=", str(git_context)],
                parent, manifest.get("timeout", 60))
        for args in (["--check"], []):
            checked(["git", "--git-dir=" + str(git_context.resolve()), "--work-tree=" + str(root.resolve()),
                     "apply", *args, str(patch)], root, manifest.get("timeout", 60))
        if row["kind"] == "plant":
            check(root, manifest, row, "red")
            require(matches(row["red"], variant["red"]), "plant did not satisfy its named assertion verdict")
            row.update(status="red", reason="named assertion reached")
        else:
            check(root, manifest, row, "control")
            require(matches(row["control"], manifest["green"]), "green control failed")
            row.update(status="control-green", reason="green control verified")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        row.update(status="setup-error", reason=failure_cause(error))
    finally:
        try:
            # Discard only this runner-owned copy, including generated files.
            shutil.rmtree(root)
            root.mkdir()
            materialize(root, manifest, contents)
            row["restored"] = all(read_regular(root / name, root=root) == contents[name]
                                  for name in manifest["inputs"])
            require(row["restored"], "restored input differs")
            check(root, manifest, row, "green")
            row["green_passed"] = matches(row["green"], manifest["green"])
            require(row["green_passed"], "restored control failed")
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            row["restore_error"] = failure_cause(error)
            row.update(status="setup-error", reason=row["reason"] + "; restore: " + row["restore_error"])


def run(path, out):
    out.mkdir(parents=True, exist_ok=False)
    report = dict(schema=SCHEMA, manifest=str(path), complete=False, success=False,
                  inputs={}, inputs_unchanged=False, results=[], reason="run did not complete")
    write_json(out / "results.json", report)
    try:
        manifest, parsed = load_manifest(path)
        report["results"] = [dict(kind=kind, name=v["name"], status="unrun", reason="preceding variant/control did not complete",
                                  restored=False, green_passed=False) for kind, v in declarations(manifest)]
        validate_manifest(manifest)
        before, contents = snapshot(path, manifest, report["inputs"])
        require(all(v is not None for v in before.values()),
                "; ".join(contents[k] for k, v in before.items() if v is None))
        require(before["manifest"] == parsed, "manifest changed after parsing")
        for row, (_, variant) in zip(report["results"], declarations(manifest), strict=True):
            with tempfile.TemporaryDirectory(prefix="checked-plant-") as work:
                run_variant(Path(work), manifest, contents, variant, row)
            if row["status"] != outcome(row["kind"]) or not row["restored"] or not row["green_passed"]:
                break
        current, failures = snapshot(path, manifest, retain=False)
        require(not failures, "; ".join(failures.values()))
        report["inputs_unchanged"] = current == before
        require(report["inputs_unchanged"], "inputs changed during run")
        report["success"] = all(r["status"] == outcome(r["kind"]) and r["restored"] and r["green_passed"]
                                for r in report["results"])
        report["reason"] = "all variants verified" if report["success"] else "one or more variants failed or never ran"
    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:
        report["reason"] = failure_cause(error)
        if report["results"] and all(r["status"] == "unrun" for r in report["results"]):
            report["results"][0].update(status="setup-error", reason=report["reason"])
    finally:
        report["complete"] = True
        write_json(out / "results.json", report)
    print(str(out / "results.json"))
    return 0 if report["success"] else 1


def verified(value):
    require(value["schema"] == SCHEMA and value["complete"] is True and value["success"] is True
            and value["inputs_unchanged"] is True, "incomplete or failed result")
    path = Path(value["manifest"])
    manifest, parsed = load_manifest(path)
    validate_manifest(manifest)
    current, failures = snapshot(path, manifest, retain=False)
    require(not failures, "; ".join(failures.values()))
    require(current["manifest"] == parsed, "manifest changed after parsing")
    require(value["inputs"] == current, "stale input fingerprints")
    rows = value["results"]
    require([(r["kind"], r["name"]) for r in rows] == [(kind, v["name"]) for kind, v in declarations(manifest)],
            "missing or reordered variants/controls")
    for row, (kind, variant) in zip(rows, declarations(manifest), strict=True):
        require(row["status"] == outcome(kind) and row["restored"] is True and row["green_passed"] is True,
                "variant/control failed or unrun")
        phase = "red" if kind == "plant" else "control"
        expected = variant["red"] if kind == "plant" else manifest["green"]
        for phase, wanted in (("baseline", manifest["green"]), (phase, expected), ("green", manifest["green"])):
            require(matches(row[phase], wanted), "missing check evidence: " + phase)
            if manifest.get("setup"):
                require(valid_step(row[phase + "_setup"])
                        and type(row[phase + "_setup"]["exit_code"]) is int and row[phase + "_setup"]["exit_code"] == 0,
                        "setup failed or unrun: " + phase)
    return manifest


def render(result, ledger, status):
    value = parse_json(read_regular(result)[0])
    manifest = verified(value)
    protected = {result.resolve(), Path(__file__).resolve(), Path(value["manifest"]).resolve(), Path(__file__).resolve().with_name("checked_core.py").resolve()}
    protected.update((Path(value["manifest"]).parent / p).resolve() for p in manifest["inputs"])
    require(ledger.resolve() != status.resolve() and not ({ledger.resolve(), status.resolve()} & protected),
            "record destinations must differ and cannot overwrite evidence or inputs")
    sentences = []
    for row in value["results"]:
        phase = "red" if row["kind"] == "plant" else "control"
        sentences.append(f"{row['kind']} {row['name']}: {row['reason']}; {phase} exit {row[phase]['exit_code']}; "
                         f"restored; green exit {row['green']['exit_code']}.")
    block = BEGIN + "\n\n## Verified plants and controls\n\n" + "\n\n".join(sentences) + f"\n\nEvidence: `{result}`.\n\n" + END
    with reserve_outputs([ledger, status], protected) as ((ledger_stream, status_stream), contents):
        text = contents[0].decode("utf-8")
        require(text.count(BEGIN) == text.count(END) and text.count(BEGIN) <= 1, "invalid ledger markers")
        if BEGIN in text:
            before, rest = text.split(BEGIN)
            _, after = rest.split(END)
            text = before + block + after
        else:
            text = text.rstrip() + "\n\n" + block + "\n"
        line = "Verification from JSON: " + " ".join(sentences)
        for stream, content in ((ledger_stream, text), (status_stream, line + f" Evidence: {result}.\n")):
            stream.seek(0)
            stream.write(content.encode("utf-8"))
            stream.truncate()
            stream.flush()
    print(line)
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    execute = sub.add_parser("run")
    execute.add_argument("manifest", type=Path)
    execute.add_argument("out", type=Path)
    publish = sub.add_parser("render")
    publish.add_argument("result", type=Path)
    publish.add_argument("--ledger", required=True, type=Path)
    publish.add_argument("--status", required=True, type=Path)
    args = parser.parse_args()
    try:
        if args.action == "run":
            return run(args.manifest.absolute(), args.out.resolve())
        return render(args.result.absolute(), args.ledger.absolute(), args.status.absolute())
    except (OSError, ValueError, KeyError, TypeError) as error:
        print("Refused: " + failure_cause(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
