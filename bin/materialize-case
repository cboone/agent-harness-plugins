#!/usr/bin/env bash
# materialize-case -- Check out a frozen review corpus case as a git worktree.
#
# The corpus keeps each case's metadata on its main branch and each case's
# frozen commits under refs/cases/<id>/base and refs/cases/<id>/head, orphan
# histories that share no ancestor with main. Worktrees are added from a local
# bare cache that has fetched case refs only and never main, so main is
# unreachable from the materialized tree and a reviewer working in it cannot
# read CASE.md or defects.yaml. That isolation is the whole point: a reviewer
# that can reach the answer key measures nothing. The cache is per corpus, so
# it accumulates the refs of every case materialized from it.
#
# refs/cases/ rather than refs/heads/ because GitHub raises a push event only
# for a branch or a tag. A frozen tree carries its own .github/workflows/, so
# pushing these as branches ran each source repository's CI inside the corpus
# repository. A custom ref is stored and fetched the same way and starts
# nothing.
#
# The base commit is the merge base of the pull request the case was frozen
# from, so it is an ancestor of the head commit. That ancestry is what
# `git diff BASE...HEAD` needs, and the three-dot form is what the reviewers
# under test are given, so it is checked before the worktree is handed over.
#
# Named refspecs, not raw SHAs, are what the fetch asks for. Whether a raw-SHA
# fetch is served depends on the server's protocol version and its
# uploadpack.allow*SHA1InWant settings, so it is not something to rely on;
# asking for the ref works regardless. The named fetch also keeps the objects
# reachable in the cache, so they survive gc between runs, and it fails with
# "could not fetch refs/cases/..." rather than an opaque object-id error. The
# recorded SHA is checked separately, by verify_ref_matches.
#
# Exit codes:
#   0 - The worktree was created, or the prune succeeded
#   1 - The case, its commits, or the target directory made that impossible
#   2 - Usage error, or a corpus that is not a git repository
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

readonly SHA_PATTERN='^[0-9a-f]{40}$'

# A case ID names a directory and two ref paths, so it may not carry a path
# separator, a leading dot, or an uppercase letter. This is narrower than
# git check-ref-format: `001-a..b` and `001-a.lock` match and git would still
# reject them, which the fetch reports.
readonly CASE_ID_PATTERN='^[0-9][0-9][0-9]-[a-z0-9][a-z0-9.-]*$'

readonly E_FINDING=1
readonly E_USAGE=2

# Set by read_sha_file. A function that exits inside a command substitution
# ends only the subshell, so the value comes back through a global instead.
SHA_VALUE=""

# The worktree this run created, and the cache it belongs to, so the EXIT trap
# can undo a worktree that was added and then refused. Cleared once the tree
# has passed verification and is the caller's to keep.
CREATED_WORKTREE=""
CREATED_IN_CACHE=""

function usage() {
  printf '%s\n' \
    "Usage: ${SCRIPT_NAME} [--corpus DIR] [--cache DIR] [--offline] CASE TARGET" \
    "       ${SCRIPT_NAME} [--corpus DIR] [--cache DIR] --prune" \
    "" \
    "Check out a frozen review corpus case as a detached git worktree at TARGET." \
    "" \
    "Options:" \
    "  --corpus DIR   Corpus checkout (default: \${REVIEW_CASE_CORPUS_DIR})" \
    "  --cache DIR    Bare object cache (default: <corpus>/.cache/cases.git)" \
    "  --offline      Fail rather than fetch a ref the cache is missing" \
    "  --prune        Forget worktree registrations whose directory is gone" \
    "  -h, --help     Show this help" \
    "" \
    "Reports KEY=value lines a harness can parse:" \
    "  CASE=001-example  WORKTREE=/abs/path  BASE=<sha>  HEAD=<sha>" \
    "" \
    "Examples:" \
    "  ${SCRIPT_NAME} 001-snappy-tick-refresh-race \"\${TMPDIR}/case\"" \
    "  ${SCRIPT_NAME} --corpus ~/Development/review-case-corpus --prune"
}

function die() {
  echo "Error: ${1}" >&2
  exit "${2:-${E_FINDING}}"
}

# Removes a worktree this run created but did not vouch for. Leaving it would
# hand the caller the very tree the refusal was about, and would make a retry
# against the same target fail as "not empty" instead of saying what is wrong.
function cleanup() {
  [[ -n "${CREATED_WORKTREE}" ]] || return 0

  git -C "${CREATED_IN_CACHE}" worktree remove --force "${CREATED_WORKTREE}" > /dev/null 2>&1 \
    || rm -rf "${CREATED_WORKTREE}"
  git -C "${CREATED_IN_CACHE}" worktree prune > /dev/null 2>&1 || true
}

# Reads a SHA file into SHA_VALUE, rejecting anything that is not a single
# 40-character hex value. A non-empty second line leaves a newline in the
# value, which the anchored pattern refuses, so no line count is needed;
# trailing blank lines are stripped by the substitution and tolerated.
function read_sha_file() {
  local path="${1}"

  [[ -f "${path}" ]] || die "${path} does not exist"
  SHA_VALUE="$(cat "${path}")"
  [[ "${SHA_VALUE}" =~ ${SHA_PATTERN} ]] \
    || die "${path} must hold exactly one 40-character hex SHA"
}

function validate_corpus() {
  local corpus="${1}"

  [[ -n "${corpus}" ]] \
    || die "no corpus given; pass --corpus DIR or set REVIEW_CASE_CORPUS_DIR" "${E_USAGE}"
  [[ -d "${corpus}" ]] || die "corpus ${corpus} is not a directory" "${E_USAGE}"
  git -C "${corpus}" rev-parse --git-dir > /dev/null 2>&1 \
    || die "corpus ${corpus} is not a git repository" "${E_USAGE}"
}

# Makes a path absolute before git sees it. Every git call runs under
# `git -C "${cache}"`, so a relative target would land inside the cache rather
# than beside the caller.
function absolute_path() {
  local path="${1}"

  case "${path}" in
    /*) printf '%s\n' "${path}" ;;
    *) printf '%s\n' "${PWD}/${path}" ;;
  esac
}

function ensure_cache() {
  local cache="${1}"
  local corpus="${2}"
  local corpus_abs

  corpus_abs="$(absolute_path "${corpus}")"

  if [[ ! -d "${cache}" ]]; then
    git init --quiet --bare "${cache}" \
      || die "could not create the object cache at ${cache}" "${E_USAGE}"
  fi

  git -C "${cache}" rev-parse --git-dir > /dev/null 2>&1 \
    || die "cache ${cache} is not a git repository" "${E_USAGE}"

  # Re-adding an existing remote fails, and set-url on a missing one fails too,
  # so branch on whether it is already there and make the URL current either way.
  if git -C "${cache}" remote get-url corpus > /dev/null 2>&1; then
    git -C "${cache}" remote set-url corpus "${corpus_abs}" \
      || die "could not point the cache at ${corpus_abs}"
  else
    git -C "${cache}" remote add corpus "${corpus_abs}" \
      || die "could not point the cache at ${corpus_abs}"
  fi
}

# Brings the case's two refs into the cache under the same names, which keeps
# the objects reachable so they are not collected between runs.
function fetch_case_refs() {
  local cache="${1}"
  local case_id="${2}"

  git -C "${cache}" fetch --quiet --no-tags corpus \
    "+refs/cases/${case_id}/base:refs/cases/${case_id}/base" \
    "+refs/cases/${case_id}/head:refs/cases/${case_id}/head" \
    || die "could not fetch refs/cases/${case_id}/{base,head} from the corpus"
}

function verify_ref_matches() {
  local cache="${1}"
  local ref="${2}"
  local expected="${3}"
  local label="${4}"
  local actual

  actual="$(git -C "${cache}" rev-parse --verify --quiet "${ref}^{commit}" || true)"
  [[ -n "${actual}" ]] \
    || die "${ref} is missing from the cache; re-run without --offline"
  [[ "${actual}" == "${expected}" ]] \
    || die "${label} records ${expected} but ${ref} points at ${actual}"
}

# A materialized tree holding corpus metadata would hand the reviewer the
# answer key. A correctly frozen case does not contain it, so this asserts the
# property rather than repairing it: a hit means the case was frozen wrongly,
# which is what the fixture's metadata-in-tree scenario builds.
function verify_no_metadata() {
  local target="${1}"
  local leaked=""
  local name

  for name in cases CASE.md defects.yaml; do
    if [[ -e "${target}/${name}" ]]; then
      leaked="${leaked} ${name}"
    fi
  done

  [[ -z "${leaked}" ]] \
    || die "the frozen tree carries corpus metadata (${leaked# }); the case is mis-frozen"
}

function check_target_available() {
  local target="${1}"

  [[ -e "${target}" ]] || return 0

  # An existing empty directory is fine; git worktree add accepts one.
  [[ -d "${target}" ]] || die "target ${target} exists and is not a directory"
  local entries
  entries="$(find "${target}" -mindepth 1 -maxdepth 1 -print -quit)"
  [[ -z "${entries}" ]] || die "target ${target} is not empty"
}

function materialize() {
  local corpus="${1}"
  local cache="${2}"
  local case_id="${3}"
  local target="${4}"
  local offline="${5}"
  local case_dir base_sha head_sha

  [[ "${case_id}" =~ ${CASE_ID_PATTERN} ]] \
    || die "case ID ${case_id} is not of the form NNN-repo-slug" "${E_USAGE}"

  case_dir="${corpus}/cases/${case_id}"
  [[ -d "${case_dir}" ]] || die "no case ${case_id} in ${corpus}/cases" "${E_USAGE}"

  read_sha_file "${case_dir}/BASE"
  base_sha="${SHA_VALUE}"
  read_sha_file "${case_dir}/HEAD"
  head_sha="${SHA_VALUE}"

  target="$(absolute_path "${target}")"
  check_target_available "${target}"

  ensure_cache "${cache}" "${corpus}"
  if [[ "${offline}" == "no" ]]; then
    fetch_case_refs "${cache}" "${case_id}"
  fi
  verify_ref_matches "${cache}" "refs/cases/${case_id}/base" "${base_sha}" "BASE"
  verify_ref_matches "${cache}" "refs/cases/${case_id}/head" "${head_sha}" "HEAD"

  git -C "${cache}" merge-base --is-ancestor "${base_sha}" "${head_sha}" \
    || die "BASE ${base_sha} is not an ancestor of HEAD ${head_sha}; three-dot diffs would be wrong"

  trap cleanup EXIT
  CREATED_IN_CACHE="${cache}"
  git -C "${cache}" worktree add --quiet --detach "${target}" "${head_sha}" \
    || die "could not add a worktree for ${case_id} at ${target}"
  CREATED_WORKTREE="${target}"

  verify_no_metadata "${target}"

  # Verified, so the tree is the caller's and the trap must leave it alone.
  CREATED_WORKTREE=""

  printf 'CASE=%s\n' "${case_id}"
  printf 'WORKTREE=%s\n' "${target}"
  printf 'BASE=%s\n' "${base_sha}"
  printf 'HEAD=%s\n' "${head_sha}"
}

function main() {
  local corpus="${REVIEW_CASE_CORPUS_DIR:-}"
  local cache=""
  local offline="no"
  local prune="no"
  local -a positional=()

  while [[ ${#} -gt 0 ]]; do
    case "${1}" in
      --corpus)
        [[ ${#} -ge 2 ]] || die "--corpus needs a directory" "${E_USAGE}"
        corpus="${2}"
        shift 2
        ;;
      --cache)
        [[ ${#} -ge 2 ]] || die "--cache needs a directory" "${E_USAGE}"
        cache="${2}"
        shift 2
        ;;
      --offline)
        offline="yes"
        shift
        ;;
      --prune)
        prune="yes"
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      -*)
        die "unknown option ${1}" "${E_USAGE}"
        ;;
      *)
        positional+=("${1}")
        shift
        ;;
    esac
  done

  if [[ -z "${cache}" ]]; then
    validate_corpus "${corpus}"
    cache="${corpus}/.cache/cases.git"
  fi

  if [[ "${prune}" == "yes" ]]; then
    [[ ${#positional[@]} -eq 0 ]] \
      || die "--prune takes no case or target" "${E_USAGE}"
    [[ -d "${cache}" ]] || die "no cache at ${cache}" "${E_USAGE}"
    git -C "${cache}" rev-parse --git-dir > /dev/null 2>&1 \
      || die "cache ${cache} is not a git repository" "${E_USAGE}"
    git -C "${cache}" worktree prune || die "could not prune worktrees in ${cache}"
    return 0
  fi

  if [[ ${#positional[@]} -ne 2 ]]; then
    usage >&2
    exit "${E_USAGE}"
  fi

  validate_corpus "${corpus}"
  materialize "${corpus}" "${cache}" "${positional[0]}" "${positional[1]}" "${offline}"
}

main "$@"
