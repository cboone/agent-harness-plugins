#!/usr/bin/env bash
# Audits version surfaces that Dependabot does not cover and writes a
# Markdown report to stdout. Empty output means no drift.
#
# Surfaces audited:
#   - .tool-versions (Node.js)
#   - package.json packageManager (Yarn via Corepack)
#   - All SHA-pinned action refs (third-party and cboone/gh-actions)
#   - npx <tool>@<version> pins in skill templates
#   - go install <path>@v<version> pins for known tools
#   - cargo install --version <X> <crate> pins
#   - pip / uv install <pkg>==<X> pins
#
# Requires: gh (authenticated), jq, curl.
set -euo pipefail

TOOL_VERSIONS_FILE=".tool-versions"
PACKAGE_JSON="package.json"
# crates.io rejects requests that do not identify themselves with a descriptive
# User-Agent (HTTP 403), so every outbound registry call sends one.
USER_AGENT="agent-harness-plugins version-audit (+https://github.com/cboone/agent-harness-plugins)"
readonly TOOL_VERSIONS_FILE PACKAGE_JSON USER_AGENT

drift_rows=()

function record_drift() {
  local category="${1}" name="${2}" current="${3}" latest="${4}" location="${5}"
  drift_rows+=("${category}|${name}|${current}|${latest}|${location}")
}

# Every lookup helper must swallow its own failures. Under `set -euo pipefail` a
# bare `latest=$(curl ... | jq ...)` aborts the whole run on any network or HTTP
# error, so the `if [[ -z "${latest}" ]]` guards at each call site never get to
# run and the report is never printed.
function fetch_json() {
  curl -fsSL -H "User-Agent: ${USER_AGENT}" "${1}" 2> /dev/null || true
}

# Documentation comments in the scripts and templates this repository ships
# spell out the very patterns these audits grep for (for example
# `uv add --dev "pkg==1.2.3"`), so drop any line that is itself a comment.
# The optional leading `path:` group lets this work on both bare `grep -h`
# output and the `grep -r` output that carries a filename.
function strip_comment_lines() {
  grep -vE '^([^:]*:)?[[:space:]]*#' || true
}

function github_latest_release() {
  local repo="${1}"
  gh api "repos/${repo}/releases/latest" --jq '.tag_name' 2> /dev/null || true
}

# ─── 1. Audit Node.js version in .tool-versions ──────────────────────────────

function audit_node() {
  if [[ ! -f "${TOOL_VERSIONS_FILE}" ]]; then
    return
  fi

  local current latest
  current=$(awk '/^nodejs / {print $2; exit}' "${TOOL_VERSIONS_FILE}")
  if [[ -z "${current}" ]]; then
    return
  fi

  latest=$(fetch_json https://nodejs.org/dist/index.json \
    | jq -r 'first(.[] | select(.lts != false)) | .version' \
    | sed 's/^v//' || true)
  if [[ -z "${latest}" ]]; then
    return
  fi

  if [[ "${current}" != "${latest}" ]]; then
    record_drift "Node.js" "nodejs (LTS)" "${current}" "${latest}" "${TOOL_VERSIONS_FILE}"
  fi
}

# ─── 2. Audit Yarn version in package.json packageManager ────────────────────

function audit_yarn() {
  if [[ ! -f "${PACKAGE_JSON}" ]]; then
    return
  fi

  local declaration current latest
  declaration=$(jq -r '.packageManager // empty' "${PACKAGE_JSON}")
  if [[ ! "${declaration}" =~ ^yarn@([0-9.]+) ]]; then
    return
  fi
  current="${BASH_REMATCH[1]}"

  latest=$(fetch_json https://repo.yarnpkg.com/tags \
    | jq -r '.latest.stable // empty' || true)
  if [[ -z "${latest}" ]]; then
    return
  fi

  if [[ "${current}" != "${latest}" ]]; then
    record_drift "Yarn" "yarn (Corepack)" "${current}" "${latest}" "${PACKAGE_JSON}"
  fi
}

# ─── 3. Audit SHA-pinned third-party action refs ─────────────────────────────

function audit_actions() {
  declare -A seen=()
  local line file repo current latest seen_key
  while IFS= read -r line; do
    # Anchor on `uses:` so the leading `path:` that grep -r prepends cannot be
    # captured as the repository name.
    if [[ "${line}" =~ uses:[[:space:]]+([a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)(/[^@]*)?@[a-f0-9]{40}[[:space:]]+#[[:space:]]+(v?[0-9]+(\.[0-9]+)*) ]]; then
      repo="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[3]}"
      seen_key="${repo}@${current}"
      if [[ -n "${seen[${seen_key}]:-}" ]]; then
        continue
      fi
      seen[${seen_key}]=1
      # The grep below spans both the repository's own workflows and the skill
      # templates, so report where the pin actually lives instead of assuming.
      file="${line%%:*}"
      latest=$(github_latest_release "${repo}")
      if [[ -n "${latest}" && "${latest#v}" != "${current#v}" ]]; then
        record_drift "Actions" "${repo}" "${current}" "${latest}" "${file}"
      fi
    fi
  done < <(grep -rE 'uses:[[:space:]]+[a-zA-Z0-9._/-]+@[a-f0-9]{40}' .github/ plugins/ 2> /dev/null | strip_comment_lines)
}

# ─── 4. Audit npx <tool>@<version> pins ──────────────────────────────────────

function npm_latest() {
  local pkg="${1}"
  fetch_json "https://registry.npmjs.org/${pkg}/latest" | jq -r '.version // empty' || true
}

function audit_npx_pins() {
  declare -A seen=()
  local line pkg current latest seen_key
  while IFS= read -r line; do
    if [[ "${line}" =~ npx[[:space:]]+(@?[a-zA-Z0-9._/-]+)@([0-9]+\.[0-9]+\.[0-9]+) ]]; then
      pkg="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      seen_key="${pkg}@${current}"
      if [[ -n "${seen[${seen_key}]:-}" ]]; then
        continue
      fi
      seen[${seen_key}]=1
      latest=$(npm_latest "${pkg}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "npx pin" "${pkg}" "${current}" "${latest}" "skill templates"
      fi
    fi
  done < <(grep -rhE 'npx[[:space:]]+@?[a-zA-Z0-9._/-]+@[0-9]+\.[0-9]+\.[0-9]+' plugins/ 2> /dev/null | strip_comment_lines)
}

# ─── 5. Audit go install <path>@v<version> pins for known tools ──────────────
#
# Maps go-install paths to a GitHub repo whose latest release is the
# upstream-of-record. Unknown paths are skipped.

function audit_go_install_pins() {
  declare -A path_to_repo=(
    ['github.com/golangci/golangci-lint/v2/cmd/golangci-lint']='golangci/golangci-lint'
    ['golang.org/x/vuln/cmd/govulncheck']='golang/vuln'
    ['github.com/goreleaser/goreleaser/v2']='goreleaser/goreleaser'
    ['github.com/rhysd/actionlint/cmd/actionlint']='rhysd/actionlint'
    ['mvdan.cc/sh/v3/cmd/shfmt']='mvdan/sh'
  )
  declare -A seen=()
  local line install_path current repo latest seen_key
  while IFS= read -r line; do
    if [[ "${line}" =~ go[[:space:]]install[[:space:]]+([a-zA-Z0-9./-]+)@(v[0-9]+(\.[0-9]+)*) ]]; then
      install_path="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      repo="${path_to_repo[${install_path}]:-}"
      if [[ -z "${repo}" ]]; then
        continue
      fi
      seen_key="${install_path}@${current}"
      if [[ -n "${seen[${seen_key}]:-}" ]]; then
        continue
      fi
      seen[${seen_key}]=1
      latest=$(github_latest_release "${repo}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "go install" "${install_path}" "${current}" "${latest}" "skill templates"
      fi
    fi
  done < <(grep -rhE 'go install [a-zA-Z0-9./-]+@v[0-9]+' plugins/ 2> /dev/null | strip_comment_lines)
}

# ─── 6. Audit cargo install --version <X> <crate> pins ───────────────────────

function crates_io_latest() {
  local crate="${1}"
  fetch_json "https://crates.io/api/v1/crates/${crate}" | jq -r '.crate.max_stable_version // empty' || true
}

function audit_cargo_install_pins() {
  declare -A seen=()
  local line current crate latest seen_key
  while IFS= read -r line; do
    if [[ "${line}" =~ cargo[[:space:]]install[[:space:]]+(--locked[[:space:]]+)?--version[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+)[[:space:]]+([a-zA-Z0-9_-]+) ]]; then
      current="${BASH_REMATCH[2]}"
      crate="${BASH_REMATCH[3]}"
      seen_key="${crate}@${current}"
      if [[ -n "${seen[${seen_key}]:-}" ]]; then
        continue
      fi
      seen[${seen_key}]=1
      latest=$(crates_io_latest "${crate}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "cargo install" "${crate}" "${current}" "${latest}" "skill templates"
      fi
    fi
  done < <(grep -rhE 'cargo install (--locked )?--version [0-9]+\.[0-9]+' plugins/ 2> /dev/null | strip_comment_lines)
}

# ─── 7. Audit pip / uv install <pkg>==<X> pins ───────────────────────────────

function pypi_latest() {
  local pkg="${1}"
  fetch_json "https://pypi.org/pypi/${pkg}/json" | jq -r '.info.version // empty' || true
}

function audit_pip_install_pins() {
  declare -A seen=()
  local line pkg current latest seen_key
  while IFS= read -r line; do
    if [[ "${line}" =~ \'?([a-zA-Z0-9_-]+)==([0-9]+(\.[0-9]+)*)\'? ]]; then
      pkg="${BASH_REMATCH[1]}"
      current="${BASH_REMATCH[2]}"
      seen_key="${pkg}@${current}"
      if [[ -n "${seen[${seen_key}]:-}" ]]; then
        continue
      fi
      seen[${seen_key}]=1
      latest=$(pypi_latest "${pkg}")
      if [[ -n "${latest}" && "${latest}" != "${current}" ]]; then
        record_drift "pip / uv install" "${pkg}" "${current}" "${latest}" "skill templates"
      fi
    fi
  done < <(grep -rhE '(pip install|uv (pip install|add( --dev)?)) +.?[a-zA-Z0-9_-]+==[0-9]' plugins/ 2> /dev/null | strip_comment_lines)
}

# ─── 8. Print Markdown report ────────────────────────────────────────────────

function print_report() {
  if ((${#drift_rows[@]} == 0)); then
    return
  fi

  printf '<!-- version-audit -->\n\n'
  printf '## Version drift\n\n'
  printf 'Surfaces that Dependabot does not cover have drifted from upstream. Each row lists the current pinned version and the latest available.\n\n'
  printf '| Category | Name | Current | Latest | Location |\n'
  printf '| --- | --- | --- | --- | --- |\n'

  local row category name current latest location
  for row in "${drift_rows[@]}"; do
    IFS='|' read -r category name current latest location <<< "${row}"
    # The backticks below are literal Markdown, not command substitution.
    # shellcheck disable=SC2016
    printf '| %s | `%s` | `%s` | `%s` | %s |\n' \
      "${category}" "${name}" "${current}" "${latest}" "${location}"
  done

  # Literal Markdown backticks again.
  # shellcheck disable=SC2016
  printf '\n---\n_Generated by `bin/version-audit`._\n'
}

audit_node
audit_yarn
audit_actions
audit_npx_pins
audit_go_install_pins
audit_cargo_install_pins
audit_pip_install_pins
print_report
