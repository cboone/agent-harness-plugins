#!/usr/bin/env bash
# Regenerates the Codex marketplace and plugin roots from the canonical plugins.
#
# Skills are copied with one sanctioned change: `disable-model-invocation: true`
# becomes an agents/openai.yaml invocation policy, because Codex has no
# frontmatter counterpart. Everything else passes through, above all the
# description, which is the one routing description every harness activates on.
# Rule 16b of bin/validate-plugins permits exactly that difference and no other,
# so a further harness-specific transformation is a design change rather than
# something this script can do quietly.
set -euo pipefail

CLAUDE_MARKETPLACE="${CLAUDE_MARKETPLACE:-.claude-plugin/marketplace.json}"
CODEX_MARKETPLACE="${CODEX_MARKETPLACE:-.agents/plugins/marketplace.json}"
CODEX_DIST_DIR="${CODEX_DIST_DIR:-dist/codex}"
# Where the tree is written (CODEX_DIST_DIR) and the path it records inside its
# own output (CODEX_DIST_LABEL) are normally the same. They separate only for
# callers that regenerate the tree somewhere else purely to compare it:
# bin/validate-plugins builds into a temp directory but must still produce
# output byte-identical to the committed tree, so it pins the label.
CODEX_DIST_LABEL="${CODEX_DIST_LABEL:-${CODEX_DIST_DIR}}"
readonly CLAUDE_MARKETPLACE CODEX_MARKETPLACE CODEX_DIST_DIR CODEX_DIST_LABEL

errors=0

function error() {
  echo "::error::$1" >&2
  errors=$((errors + 1))
}

function marketplace_value() {
  local plugin_name="${1}" jq_filter="${2}"

  jq -r --arg name "${plugin_name}" ".plugins[] | select(.name == \$name) | ${jq_filter}" "${CLAUDE_MARKETPLACE}"
}

function plugin_source_path() {
  local plugin_name="${1}"

  marketplace_value "${plugin_name}" '(.source | if type == "string" then . else .path end) // empty'
}

function remove_existing_dir() {
  local path="${1}"

  if [[ ! -e "${path}" ]]; then
    return
  fi

  if [[ ! -d "${path}" ]]; then
    error "Refusing to replace '${path}' because it is not a directory"
    return
  fi

  rm -r "${path}"
}

# A source README at plugins/<name>/README.md reaches the root README with two
# "../" hops. Its mirror sits that many levels deeper again, one per component
# of CODEX_DIST_LABEL, so derive the prefix instead of hardcoding "../../../../"
# and silently producing broken links if the output directory ever moves.
function generated_readme_root_prefix() {
  local depth component
  depth=2
  while IFS= read -r component; do
    if [[ -n "${component}" ]]; then
      depth=$((depth + 1))
    fi
  done < <(tr '/' '\n' <<< "${CODEX_DIST_LABEL}")

  local prefix="" i
  for ((i = 0; i < depth; i++)); do
    prefix+="../"
  done
  printf '%s' "${prefix}"
}

function rewrite_generated_readme_links() {
  local readme="${1}"

  if [[ ! -f "${readme}" ]]; then
    return
  fi

  local prefix
  prefix="$(generated_readme_root_prefix)"
  README_ROOT_PREFIX="${prefix}" perl -0pi -e 'my $prefix = $ENV{"README_ROOT_PREFIX"}; s/\]\(\.\.\/\.\.\/README\.md/](${prefix}README.md/g' "${readme}"
}

# Returns 0 when the frontmatter sets disable-model-invocation to true. Rule 21
# of bin/validate-plugins restricts the value to an unquoted true or false, so
# no other spelling of truth reaches here.
function disables_model_invocation() {
  local skill_md="${1}"

  awk '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter && $0 == "---" {
      exit
    }

    in_frontmatter && $0 ~ /^disable-model-invocation:[[:space:]]*true[[:space:]]*$/ {
      found = 1
      exit
    }

    END {
      exit !found
    }
  ' "${skill_md}"
}

# Codex offers a skill to the model whatever its SKILL.md frontmatter says:
# measured against Codex CLI 0.155.1, a skill carrying
# `disable-model-invocation: true` still appears in the model's skill list,
# while one whose agents/openai.yaml sets policy.allow_implicit_invocation to
# false does not. Copying the field through would therefore lose the skill
# author's intent silently, so the generated copy drops the line and states the
# same policy the way Codex reads it.
#
# A skill that already ships its own agents/openai.yaml is an error rather than
# an overwrite. No skill ships one today, and merging an invocation policy into
# an existing interface or dependencies block is a decision for whoever adds
# that file.
function translate_generated_skills() {
  local plugin_dir="${1}" source_dir="${2}" skill_md skill_dir skill_name agents_yaml

  for skill_md in "${plugin_dir}"/skills/*/SKILL.md; do
    if [[ ! -f "${skill_md}" ]]; then
      continue
    fi
    if ! disables_model_invocation "${skill_md}"; then
      continue
    fi

    skill_dir="$(dirname "${skill_md}")"
    skill_name="$(basename "${skill_dir}")"
    agents_yaml="${skill_dir}/agents/openai.yaml"
    if [[ -e "${agents_yaml}" ]]; then
      error "Skill '${source_dir}/skills/${skill_name}' sets disable-model-invocation and ships its own agents/openai.yaml; merge the invocation policy into that file by hand"
      continue
    fi

    # Only the opening frontmatter block is filtered, so a body line that starts
    # with the same key is left alone.
    perl -ni -e '
      if ($. == 1 && /^---$/) { $frontmatter = 1; print; next }
      if ($frontmatter && /^---$/) { $frontmatter = 0; print; next }
      next if $frontmatter && /^disable-model-invocation:/;
      print;
    ' "${skill_md}"

    mkdir -p "${skill_dir}/agents"
    printf '%s\n' \
      '# Generated by bin/build-codex-marketplace from the canonical SKILL.md.' \
      '# Codex has no frontmatter field for invocation policy, so the Claude Code' \
      '# disable-model-invocation field is expressed here instead.' \
      'policy:' \
      '  allow_implicit_invocation: false' \
      > "${agents_yaml}"
  done
}

function write_codex_marketplace() {
  local output_dir
  output_dir="$(dirname "${CODEX_MARKETPLACE}")"
  mkdir -p "${output_dir}"
  cp "${CLAUDE_MARKETPLACE}" "${CODEX_MARKETPLACE}"

  while IFS= read -r plugin_name; do
    PLUGIN_NAME="${plugin_name}" DIST_DIR="${CODEX_DIST_LABEL}" perl -0pi -e 'my $name = $ENV{"PLUGIN_NAME"}; my $dist = $ENV{"DIST_DIR"}; s/"source": "\.\/plugins\/\Q$name\E"/"source": ".\/$dist\/plugins\/$name"/g' "${CODEX_MARKETPLACE}"
  done < <(jq -r '.plugins[].name' "${CLAUDE_MARKETPLACE}")
}

function copy_codex_plugin_roots() {
  local plugin_name source_path source_dir target_dir

  remove_existing_dir "${CODEX_DIST_DIR}"
  if [[ ${errors} -gt 0 ]]; then
    return
  fi

  mkdir -p "${CODEX_DIST_DIR}/plugins"

  while IFS= read -r plugin_name; do
    source_path="$(plugin_source_path "${plugin_name}")"
    if [[ -z "${source_path}" ]]; then
      error "Marketplace entry '${plugin_name}' is missing a source path"
      continue
    fi

    source_dir="${source_path#./}"
    if [[ "${source_path}" == "${source_dir}" ]]; then
      error "Marketplace entry '${plugin_name}' source '${source_path}' must start with ./"
      continue
    fi
    if [[ ! -d "${source_dir}" ]]; then
      error "Marketplace entry '${plugin_name}' source '${source_path}' does not exist"
      continue
    fi

    target_dir="${CODEX_DIST_DIR}/plugins/${plugin_name}"
    mkdir -p "${target_dir}"
    cp -R "${source_dir}/." "${target_dir}"
    rewrite_generated_readme_links "${target_dir}/README.md"
    translate_generated_skills "${target_dir}" "${source_dir}"
  done < <(jq -r '.plugins[].name' "${CLAUDE_MARKETPLACE}")
}

function validate_outputs() {
  local plugin_name expected_source actual_source

  while IFS= read -r plugin_name; do
    expected_source="./${CODEX_DIST_LABEL}/plugins/${plugin_name}"
    actual_source="$(jq -r --arg name "${plugin_name}" '.plugins[] | select(.name == $name) | .source' "${CODEX_MARKETPLACE}")"
    if [[ "${actual_source}" != "${expected_source}" ]]; then
      error "Codex marketplace entry '${plugin_name}' source '${actual_source}' does not match '${expected_source}'"
    fi
  done < <(jq -r '.plugins[].name' "${CLAUDE_MARKETPLACE}")
}

# plugin_source_path reads both the string and the {"path": ...} object form,
# but write_codex_marketplace only rewrites the string form, so an object-form
# entry would be copied correctly and then left pointing at ./plugins/<name>.
# Every entry uses the string form today; fail loudly rather than emit a bad
# source.
function validate_source_forms() {
  local plugin_name source_type

  while IFS= read -r plugin_name; do
    source_type="$(marketplace_value "${plugin_name}" '.source | type')"
    if [[ "${source_type}" != "string" ]]; then
      error "Marketplace entry '${plugin_name}' uses a ${source_type} source; only the string form is supported"
    fi
  done < <(jq -r '.plugins[].name' "${CLAUDE_MARKETPLACE}")
}

function main() {
  if [[ ! -f "${CLAUDE_MARKETPLACE}" ]]; then
    error "Canonical marketplace '${CLAUDE_MARKETPLACE}' does not exist"
  else
    validate_source_forms
  fi

  if [[ ${errors} -gt 0 ]]; then
    echo "${errors} validation error(s); refusing to build Codex marketplace." >&2
    exit 1
  fi

  write_codex_marketplace
  copy_codex_plugin_roots
  validate_outputs

  if [[ ${errors} -gt 0 ]]; then
    echo "${errors} validation error(s); Codex marketplace build failed." >&2
    exit 1
  fi

  echo "Built Codex marketplace at ${CODEX_MARKETPLACE}"
  echo "Built Codex plugin roots at ${CODEX_DIST_DIR}/plugins"
}

main "${@}"
