#!/usr/bin/env bash
# Directory runs share the heavy lock; named documents and discovery run directly.
set -euo pipefail

# shellcheck source=bin/lib/git-environment.bash
source "$(dirname "${BASH_SOURCE[0]}")/lib/git-environment.bash"

function main() {
  local bin_dir path='tests/scrut/' arg
  bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for arg in "$@"; do
    case "${arg}" in
      -h | --help | --list) exec "${bin_dir}/lib/run-scrut-documents" "$@" ;;
      -*) ;;
      *) path="${arg}" ;;
    esac
  done
  if [[ -d "${path:-tests/scrut/}" ]]; then
    exec "${bin_dir}/run-heavy-suite" "${bin_dir}/lib/run-scrut-documents" "$@"
  fi
  exec "${bin_dir}/lib/run-scrut-documents" "$@"
}

main "$@"
