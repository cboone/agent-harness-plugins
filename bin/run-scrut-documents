#!/usr/bin/env bash
# run-scrut-documents -- Run scrut documents in parallel, one scrut per document.
#
# CI runs each document under tests/scrut/ as its own matrix job, so the suite
# takes as long as its slowest document. A single `scrut test tests/scrut/`
# runs documents one after another instead, which locally costs the sum of
# them all. This runs one `scrut --shell bash test DOCUMENT` per document, up
# to SCRUT_JOBS at a time, and so brings a local run close to CI's shape.
#
# Each document writes to its own log, and the logs are printed in document
# order once every document has finished, so one document's output is never
# interleaved with another's. A one-line notice is printed as each document
# finishes, so a long run still shows progress.
#
# Documents are found by name under PATH, so a new document joins without
# registration. CI's scrut-documents job builds its matrix from `--list`, so
# local runs and the CI matrix cover the same documents.
#
# The scrut environment is inherited from the caller: the Makefile wraps this
# in `env $(SCRUT_UNSET) $(SCRUT_ENV)`, exactly as it wrapped scrut itself.
#
# Exit codes:
#   0 - Every document passed, or --list printed the documents
#   1 - At least one document failed
#   2 - Usage error, an unreadable path, or no documents found
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME

readonly DEFAULT_PATH='tests/scrut/'

readonly E_FAILED=1
readonly E_USAGE=2

# Removed by the EXIT trap. Global so the trap can reach it after main returns.
LOG_DIR=""

function usage() {
  printf '%s\n' \
    "Usage: ${SCRIPT_NAME} [PATH]" \
    "       ${SCRIPT_NAME} --list [PATH]" \
    "" \
    "Run every scrut document under PATH, one scrut process per document and up" \
    "to SCRUT_JOBS at a time, then print each document's output in order and" \
    "name every failing document. PATH may be a directory or a single document," \
    "which runs in the foreground with live output. PATH defaults to ${DEFAULT_PATH}" \
    "" \
    "Options:" \
    "  --list      Print the documents that would run, one per line, and exit" \
    "  -h, --help  Show this help" \
    "" \
    "Environment:" \
    "  SCRUT_JOBS  Documents to run at once (default: the CPU count); 1 runs them" \
    "              one after another"
}

function usage_error() {
  printf '%s: %s\n' "${SCRIPT_NAME}" "$1" >&2
  printf 'Run %s --help for usage.\n' "${SCRIPT_NAME}" >&2
  exit "${E_USAGE}"
}

function cleanup() {
  if [[ -n "${LOG_DIR}" ]]; then
    rm -rf -- "${LOG_DIR}"
  fi
}

# Prints the documents under $1, sorted, one per line. Symlinks count, as they
# do for scrut and for CI.
function list_documents() {
  local path="$1"

  if [[ -f "${path}" ]]; then
    printf '%s\n' "${path}"
    return
  fi

  find "${path}" \( -type f -o -type l \) \
    \( -name '*.md' -o -name '*.markdown' -o -name '*.scrut' -o -name '*.t' -o -name '*.cram' \) \
    | LC_ALL=C sort
}

function default_jobs() {
  local count
  count="$(getconf _NPROCESSORS_ONLN 2> /dev/null || sysctl -n hw.ncpu 2> /dev/null || true)"
  if [[ "${count}" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "${count}"
  else
    printf '1\n'
  fi
}

# Runs one document, called by xargs through `bash -c`. It always exits 0 and
# records scrut's status in a file instead, because xargs stops launching new
# commands after one exits 255 and folds every other failure into 123, and the
# summary needs each document's own result.
function run_document() {
  local index="$1"
  local document="$2"
  local log="${RUN_SCRUT_LOG_DIR}/${index}.log"
  local status=0
  local started="${SECONDS}"

  scrut --shell bash test "${document}" > "${log}" 2>&1 < /dev/null || status=$?

  local elapsed=$((SECONDS - started))
  printf '%s\n' "${status}" > "${RUN_SCRUT_LOG_DIR}/${index}.status"
  printf '%s\n' "${elapsed}" > "${RUN_SCRUT_LOG_DIR}/${index}.seconds"
  if ((status == 0)); then
    printf 'finished %s: passed (%ss)\n' "${document}" "${elapsed}"
  else
    printf 'finished %s: FAILED, exit %s (%ss)\n' "${document}" "${status}" "${elapsed}"
  fi
}

function run_parallel() {
  local jobs="$1"
  shift
  local -a documents=("$@")
  local count="${#documents[@]}"

  LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/run-scrut-documents.XXXXXX")"
  export RUN_SCRUT_LOG_DIR="${LOG_DIR}"
  export -f run_document

  printf 'Running %s scrut documents, %s at a time\n' "${count}" "${jobs}"

  local i
  # shellcheck disable=SC2016 # $1 and $2 expand in the child bash, not here.
  for ((i = 0; i < count; i++)); do
    printf '%s\0%s\0' "${i}" "${documents[i]}"
  done | xargs -0 -n 2 -P "${jobs}" bash -c 'run_document "$1" "$2"' run_document

  local -a failed=()
  local status elapsed
  for ((i = 0; i < count; i++)); do
    status="$(cat "${LOG_DIR}/${i}.status" 2> /dev/null || printf 'missing')"
    elapsed="$(cat "${LOG_DIR}/${i}.seconds" 2> /dev/null || printf '?')"
    printf '\n'
    if [[ "${status}" == 0 ]]; then
      printf '==> %s: passed (%ss)\n' "${documents[i]}" "${elapsed}"
    else
      printf '==> %s: FAILED, exit %s (%ss)\n' "${documents[i]}" "${status}" "${elapsed}"
      failed+=("${documents[i]}")
    fi
    cat "${LOG_DIR}/${i}.log" 2> /dev/null || printf '(no output recorded)\n'
  done

  printf '\n'
  if ((${#failed[@]} == 0)); then
    printf 'All %s scrut documents passed.\n' "${count}"
    return 0
  fi

  printf '%s of %s scrut documents failed:\n' "${#failed[@]}" "${count}"
  printf '  %s\n' "${failed[@]}"
  return "${E_FAILED}"
}

function main() {
  local list_only=false
  local path=""

  while (($# > 0)); do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      --list) list_only=true ;;
      -*) usage_error "unknown option: $1" ;;
      *)
        if [[ -n "${path}" ]]; then
          usage_error "expected at most one PATH"
        fi
        path="$1"
        ;;
    esac
    shift
  done
  path="${path:-${DEFAULT_PATH}}"

  if [[ ! -e "${path}" ]]; then
    usage_error "no such file or directory: ${path}"
  fi

  local jobs="${SCRUT_JOBS:-}"
  if [[ -z "${jobs}" ]]; then
    jobs="$(default_jobs)"
  elif [[ ! "${jobs}" =~ ^[1-9][0-9]*$ ]]; then
    usage_error "SCRUT_JOBS must be a positive integer, got: ${jobs}"
  fi

  local -a documents=()
  local document
  while IFS= read -r document; do
    documents+=("${document}")
  done < <(list_documents "${path}")

  if ((${#documents[@]} == 0)); then
    printf '%s: no scrut documents found under %s\n' "${SCRIPT_NAME}" "${path}" >&2
    exit "${E_USAGE}"
  fi

  if [[ "${list_only}" == true ]]; then
    printf '%s\n' "${documents[@]}"
    return 0
  fi

  if ! command -v scrut > /dev/null; then
    printf '%s: scrut is required: https://github.com/facebookincubator/scrut\n' "${SCRIPT_NAME}" >&2
    exit "${E_USAGE}"
  fi

  # One document gains nothing from a log, and running it in the foreground
  # keeps scrut's live output, as `make test-scrut SCRUT_TEST_DIR=...` always had.
  if ((${#documents[@]} == 1)); then
    exec scrut --shell bash test "${documents[0]}"
  fi

  trap cleanup EXIT
  run_parallel "${jobs}" "${documents[@]}"
}

main "$@"
