#!/usr/bin/env bash
# Checks that the cross-references inside skill bodies resolve.
#
# Skills point at each other by name and at files by repository-relative path,
# and nothing used to check that either target existed. A rename or a move left
# the stale reference in place, and it failed only in the downstream project
# that loaded the skill: bootstrap-project sent agents to
# plugins/set-up-ci/commands/set-up-ci.md long after commands/ became skills/,
# under a plugin name (setup-ci) that no longer existed either.
#
# Skills also compose each other, and a user who installs plugins one at a time
# can end up with a workflow whose next step names a skill that is not there.
# Every such step is written "Invoke the `NAME` skill", and the skill declares
# NAME under a "## Skill dependencies" section as required or optional. This
# script checks that each composition is declared, that each declaration
# resolves, names the skill in only one category, is actually used, and follows
# the documented form. docs/plugin-development.md describes the convention.
#
# Paths resolve against the current working directory, which must be the
# repository root. Pass explicit files to check only those; the scrut suite does
# that against fixture trees.
set -euo pipefail

# Path prefixes that can only mean a file in this repository. A project a skill
# is being run against has no plugins/ or dist/codex/ of its own, so these
# resolve everywhere without asking the author what they meant.
UNAMBIGUOUS_PREFIXES="plugins|dist/codex|dist/opencode"

# Prefixes a skill body shares with the project it is scaffolding. Most bin/ and
# docs/ mentions here name a file the skill *creates* in the target project
# (bin/version-audit, docs/plans/todo/), not one that lives in this repository,
# and because the two layouts match, some of those resolve against this
# repository by coincidence rather than by correctness. They are checked only in
# a file that declares its frame with
#
#   <!-- validate-plugins: repository-paths -->
DECLARED_PREFIXES="bin|docs"

# Over half the reference files carry nothing this script can act on, and each
# one otherwise costs five extraction pipelines to find that out. This pattern
# is the cheap first pass that skips them.
#
# Every branch is the loosest form of an extraction below, and the directive
# comments are included so a file holding only a stale ignore entry is still
# reported. It may therefore over-match, admitting a file that turns out to have
# no candidate; it must never under-match, which would silently stop checking a
# file. Widen it whenever an extraction is added or widened.
#
# tests/scrut/check-cross-references.md exercises every extraction end to end,
# so each one passes through here: narrowing this pattern past an extraction
# fails that suite rather than quietly reducing what gets checked.
#
# A SKILL.md whose only candidate is its dependency block holds none of the
# other branches, so the section heading is a branch of its own.
CANDIDATE_PREFILTER='\$\{CLAUDE_PLUGIN_ROOT\}/|\./references/|(plugins|dist/codex|dist/opencode|bin|docs)/|`/|skill|Skill dependencies|validate-plugins:'

# The one phrase that marks composition. Suggestions to the user, redirects to
# an adjacent skill and "Pairs with" text are worded differently on purpose, so
# they need no declaration. Lowercase names only: `NAME` is a stand-in. The
# backticks are literal text to match, not a command substitution.
# shellcheck disable=SC2016
COMPOSITION_PATTERN='[Ii]nvoke the `/?[a-z][a-z0-9-]*` skill'

readonly UNAMBIGUOUS_PREFIXES DECLARED_PREFIXES CANDIDATE_PREFILTER COMPOSITION_PATTERN

errors=0
reference_errors=0

function error() {
  echo "::error::$1"
  errors=$((errors + 1))
}

# Only an unresolved reference or a stale ignore entry can be answered with an
# ignore comment, so only those earn the closing notice that explains one.
function reference_error() {
  error "$1"
  reference_errors=$((reference_errors + 1))
}

# The skill bodies to scan: every SKILL.md plus the reference material beside
# it, at any depth, since set-up-linters and the write-* skills nest their
# references under topic directories.
function skill_markdown_files() {
  find plugins -type f -name '*.md' -path 'plugins/*/skills/*' | sort
}

# Exemptions are declared per file rather than per line, because most of the
# references that need one sit inside an ordered list or a table row where an
# HTML comment would break the Markdown. An entry is the reference exactly as
# this script reports it:
#
#   <!-- validate-plugins: ignore /config ./references/BASH.md -->
#
# Several such comments may appear in one file. An entry that matches nothing is
# an error in its own right, so a stale exemption cannot quietly hollow out the
# check the way a stale reference hollowed out the review process.
function declared_ignores() {
  { grep -oE '<!--[[:space:]]*validate-plugins:[[:space:]]*ignore[[:space:]]+[^>]*-->' "${1}" || true; } \
    | sed -E -e 's|^.*ignore[[:space:]]+||' -e 's|[[:space:]]*-->$||' \
    | tr -s '[:space:]' '\n' \
    | { grep -v '^$' || true; } \
    | sort -u
}

function declares_repository_paths() {
  grep -qE '<!--[[:space:]]*validate-plugins:[[:space:]]*repository-paths([^A-Za-z0-9-]|$)' "${1}"
}

# The declaration comments are dropped before extraction so an entry listed in
# an ignore comment is not itself mistaken for a reference. A declaration
# therefore belongs on a line of its own: prose sharing the line goes with it.
function scannable_lines() {
  grep -v '<!--[[:space:]]*validate-plugins:' "${1}" || true
}

# A path- or name-shaped string is a stand-in rather than a reference when a
# segment is a glob, an angle-bracket or shell-variable slot, an ellipsis, an
# all-caps token such as PLUGIN-NAME, or a date placeholder.
function is_placeholder() {
  local candidate="${1}"

  case "${candidate}" in
    *'*'* | *'<'* | *'>'* | *'$'* | *'{'* | *'}'*) return 0 ;;
    *) ;;
  esac

  if [[ "${candidate}" =~ (^|/)(\.\.\.|[A-Z][A-Z0-9_-]*)(/|$) ]] || [[ "${candidate}" =~ YYYY ]]; then
    return 0
  fi

  return 1
}

function contains_line() {
  printf '%s\n' "${1}" | grep -Fxq -- "${2}"
}

# Emits one "kind<TAB>reference<TAB>resolved path" record per distinct candidate
# in the file. Collecting them before judging any of them lets an ignore entry
# be matched against what was actually found.
#
# ${CLAUDE_PLUGIN_ROOT}/... resolves against the plugin that ships the skill.
# Its scripts/ subtree is left alone: rule 18 of bin/validate-plugins already
# resolves those and checks the executable bit besides, and the reference
# material explaining how to bundle a script names example scripts that were
# never meant to exist.
#
# ./references/... is how a SKILL.md points at the material beside it, so it
# resolves against the skill directory rather than the repository root.
#
# Two spellings carry a skill name in prose: the slash-command form a user
# types, and a backticked name sitting next to the word "skill". Both name a
# directory under plugins/. A bare backticked name is not checked, because
# nothing distinguishes `set-up-ci` from `lean-toolchain` without reading the
# sentence around it.
function collect_candidates() {
  local file="${1}" plugin="${2}" skill_dir="${3}" prefixes="${4}"
  local body rest candidate name

  body="$(scannable_lines "${file}")"

  # The ${CLAUDE_PLUGIN_ROOT} and the backticks in the extractions below are
  # literal text this script matches, not an expansion or a substitution.
  # shellcheck disable=SC2016
  {
    while IFS= read -r rest; do
      [[ -n "${rest}" ]] || continue
      [[ "${rest}" == scripts/* ]] && continue
      is_placeholder "${rest}" && continue
      printf 'plugin-root\t${CLAUDE_PLUGIN_ROOT}/%s\tplugins/%s/%s\n' "${rest}" "${plugin}" "${rest}"
    done < <(printf '%s\n' "${body}" \
      | grep -oE '\$\{CLAUDE_PLUGIN_ROOT\}/[A-Za-z0-9._${}/*<>-]+' \
      | sed -e 's|^\${CLAUDE_PLUGIN_ROOT}/||' -e 's|/*$||' \
      | sort -u)

    while IFS= read -r rest; do
      [[ -n "${rest}" ]] || continue
      is_placeholder "${rest}" && continue
      printf 'references\t./references/%s\t%s/references/%s\n' "${rest}" "${skill_dir}" "${rest}"
    done < <(printf '%s\n' "${body}" \
      | grep -oE '(^|[^A-Za-z0-9._/-])\./references/[A-Za-z0-9._*<>-]+(/[A-Za-z0-9._*<>-]+)*' \
      | sed -E -e 's|^.*\./references/||' -e 's|/*$||' \
      | sort -u)

    while IFS= read -r candidate; do
      [[ -n "${candidate}" ]] || continue
      is_placeholder "${candidate}" && continue
      printf 'path\t%s\t%s\n' "${candidate}" "${candidate}"
    done < <(printf '%s\n' "${body}" \
      | grep -oE "(^|[^A-Za-z0-9._/-])(${prefixes})/[A-Za-z0-9._*<>-]+(/[A-Za-z0-9._*<>-]+)*" \
      | sed -E -e 's|^[^A-Za-z0-9._/-]||' -e 's|/*$||' \
      | sort -u)

    while IFS= read -r name; do
      [[ -n "${name}" ]] || continue
      printf 'skill\t/%s\tplugins/%s\n' "${name}" "${name}"
    done < <(printf '%s\n' "${body}" \
      | grep -oE '`/[a-z][a-z0-9-]*`' \
      | tr -d '`' \
      | sed 's|^/||' \
      | sort -u)

    while IFS= read -r name; do
      [[ -n "${name}" ]] || continue
      printf 'skill\t%s\tplugins/%s\n' "${name}" "${name}"
    done < <({
      printf '%s\n' "${body}" | grep -oE '`[a-z][a-z0-9-]+`[[:space:]]+skills?([^A-Za-z0-9-]|$)'
      printf '%s\n' "${body}" | grep -oE 'skills?[[:space:]]+`[a-z][a-z0-9-]+`'
    } | grep -oE '`[a-z0-9-]+`' | tr -d '`' | sort -u)
  } | sort -u
}

function report_unresolved() {
  local file="${1}" kind="${2}" reference="${3}" resolved="${4}"

  case "${kind}" in
    path) reference_error "${file} references ${reference} but no such path exists in this repository" ;;
    skill) reference_error "${file} references the skill ${reference} but ${resolved} does not exist" ;;
    *) reference_error "${file} references ${reference} but ${resolved} does not exist" ;;
  esac
}

# Emits one record per finding in a SKILL.md's "## Skill dependencies" section:
#
#   required<TAB>NAME, optional<TAB>NAME   a declared dependency
#   malformed<TAB>LINE                     a line outside the documented form
#   missing<TAB>Required|Optional          a category line that is absent
#   duplicate-section<TAB>                 a second section
#
# The section runs from its heading to the next heading. Frontmatter and fenced
# code are skipped, so a skill that shows the format in an example does not
# declare anything by doing so.
function dependency_records() {
  awk '
    function close_section() {
      if (!seen_required) {
        print "missing\tRequired"
      }
      if (!seen_optional) {
        print "missing\tOptional"
      }
      in_section = 0
    }

    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter {
      if ($0 == "---") {
        in_frontmatter = 0
      }
      next
    }

    /^[[:space:]]*(```|~~~)/ {
      in_fence = !in_fence
      if (in_section) {
        print "malformed\t" $0
      }
      next
    }

    in_fence {
      if (in_section) {
        print "malformed\t" $0
      }
      next
    }

    /^#+[[:space:]]/ {
      if (in_section) {
        close_section()
      }
      if ($0 ~ /^##[[:space:]]+Skill dependencies[[:space:]]*$/) {
        sections++
        if (sections > 1) {
          print "duplicate-section\t"
        }
        in_section = 1
        seen_required = 0
        seen_optional = 0
      }
      next
    }

    !in_section || /^[[:space:]]*$/ {
      next
    }

    {
      line = $0
      if (sub(/^- \*\*Required:\*\* /, "")) {
        category = "required"
        count = ++seen_required
      } else if (sub(/^- \*\*Optional:\*\* /, "")) {
        category = "optional"
        count = ++seen_optional
      } else {
        print "malformed\t" line
        next
      }

      if (count > 1 || ($0 != "None" && $0 !~ /^`[a-z][a-z0-9-]*`(, `[a-z][a-z0-9-]*`)*$/)) {
        print "malformed\t" line
        next
      }
      if ($0 == "None") {
        next
      }

      n = split($0, names, /, /)
      for (i = 1; i <= n; i++) {
        gsub(/`/, "", names[i])
        print category "\t" names[i]
      }
    }

    END {
      if (in_section) {
        close_section()
      }
    }
  ' "${1}"
}

# The SKILL.md without its dependency section, so a declaration cannot count as
# its own use.
function lines_outside_dependency_section() {
  awk '
    /^[[:space:]]*(```|~~~)/ {
      in_fence = !in_fence
    }

    !in_fence && /^#+[[:space:]]/ {
      in_section = ($0 ~ /^##[[:space:]]+Skill dependencies[[:space:]]*$/)
    }

    !in_section {
      print
    }
  ' "${1}"
}

function composition_references() {
  # The backticks in the sed expression are literal text, not a substitution.
  # shellcheck disable=SC2016
  scannable_lines "${1}" \
    | { grep -oE "${COMPOSITION_PATTERN}" || true; } \
    | sed -E 's|^.*`/?([a-z0-9-]+)`.*$|\1|' \
    | sort -u
}

function declared_dependencies() {
  local skill_md="${1}"

  [[ -f "${skill_md}" ]] || return 0
  dependency_records "${skill_md}" | awk -F '\t' '$1 == "required" || $1 == "optional" { print $2 }' | sort -u
}

function skill_exists() {
  local candidate

  for candidate in plugins/*/skills/"${1}"/SKILL.md; do
    [[ -f "${candidate}" ]] && return 0
  done
  return 1
}

# A composition in a reference file belongs to the workflow that loads it, so
# it is checked against the owning SKILL.md's declarations.
function check_compositions() {
  local file="${1}" skill_dir="${2}"
  local skill_md="${skill_dir}/SKILL.md"
  local references declared name

  references="$(composition_references "${file}")"
  [[ -n "${references}" ]] || return 0

  declared="$(declared_dependencies "${skill_md}")"

  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    if ! contains_line "${declared}" "${name}"; then
      error "${file} invokes the ${name} skill, but ${skill_md} does not declare it under ## Skill dependencies"
    fi
  done <<< "${references}"
}

# A declared name is used when the workflow names it, backticked with or
# without a leading slash, anywhere outside the dependency section: selection
# lists such as bootstrap-project's name their candidates bare.
function check_declarations() {
  local skill_md="${1}" skill_dir="${2}"
  local records kind value required="" optional="" body name

  records="$(dependency_records "${skill_md}")"
  [[ -n "${records}" ]] || return 0

  while IFS=$'\t' read -r kind value; do
    case "${kind}" in
      malformed) error "${skill_md} has a malformed ## Skill dependencies line '${value}'; write '- **Required:**' or '- **Optional:**' followed by None or backticked skill names separated by commas" ;;
      missing) error "${skill_md} ## Skill dependencies has no '- **${value}:**' line; write None for an empty category" ;;
      duplicate-section) error "${skill_md} has more than one ## Skill dependencies section" ;;
      required) required="${required}${value}"$'\n' ;;
      optional) optional="${optional}${value}"$'\n' ;;
      *) ;;
    esac
  done <<< "${records}"

  body="$(
    lines_outside_dependency_section "${skill_md}"
    if [[ -d "${skill_dir}/references" ]]; then
      find "${skill_dir}/references" -type f -name '*.md' -exec cat {} +
    fi
  )"

  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    error "${skill_md} declares ${name} more than once in one ## Skill dependencies category"
  done < <({
    printf '%s' "${required}" | sort | uniq -d
    printf '%s' "${optional}" | sort | uniq -d
  })

  while IFS= read -r name; do
    [[ -n "${name}" ]] || continue
    if contains_line "${required}" "${name}" && contains_line "${optional}" "${name}"; then
      error "${skill_md} declares ${name} as both required and optional"
    fi
    if ! skill_exists "${name}"; then
      error "${skill_md} declares the dependency ${name}, but no plugins/*/skills/${name}/SKILL.md exists"
    fi
    if ! grep -qE "\`/?${name}\`" <<< "${body}"; then
      error "${skill_md} declares the dependency ${name} but never names it outside ## Skill dependencies"
    fi
  done < <(printf '%s' "${required}${optional}" | sort -u)
}

function check_file() {
  local file="${1}"
  local plugin skill_dir prefixes candidates ignores matched
  local kind reference resolved entry

  grep -qE "${CANDIDATE_PREFILTER}" "${file}" || return 0

  plugin="${file#plugins/}"
  plugin="${plugin%%/*}"

  skill_dir="${file%/references/*}"
  skill_dir="${skill_dir%/SKILL.md}"

  prefixes="${UNAMBIGUOUS_PREFIXES}"
  if declares_repository_paths "${file}"; then
    prefixes="${prefixes}|${DECLARED_PREFIXES}"
  fi

  candidates="$(collect_candidates "${file}" "${plugin}" "${skill_dir}" "${prefixes}")"
  ignores="$(declared_ignores "${file}")"
  matched=""

  while IFS=$'\t' read -r kind reference resolved; do
    [[ -n "${kind}" ]] || continue

    if [[ -n "${ignores}" ]] && contains_line "${ignores}" "${reference}"; then
      matched="${matched}${reference}"$'\n'
      continue
    fi

    if [[ "${kind}" == "skill" ]]; then
      [[ -d "${resolved}" ]] || report_unresolved "${file}" "${kind}" "${reference}" "${resolved}"
    else
      [[ -e "${resolved}" ]] || report_unresolved "${file}" "${kind}" "${reference}" "${resolved}"
    fi
  done <<< "${candidates}"

  while IFS= read -r entry; do
    [[ -n "${entry}" ]] || continue
    if ! contains_line "${matched}" "${entry}"; then
      reference_error "${file} ignores ${entry} but no reference by that name was found; drop the stale ignore entry"
    fi
  done <<< "${ignores}"

  check_compositions "${file}" "${skill_dir}"
  if [[ "${file}" == */SKILL.md ]]; then
    check_declarations "${file}" "${skill_dir}"
  fi
}

function main() {
  if [[ ! -d plugins ]]; then
    echo "check-cross-references: no plugins/ directory in $(pwd)" >&2
    exit 2
  fi

  local file
  if [[ ${#} -gt 0 ]]; then
    for file in "${@}"; do
      check_file "${file}"
    done
  else
    while IFS= read -r file; do
      check_file "${file}"
    done < <(skill_markdown_files)
  fi

  if [[ ${errors} -gt 0 ]]; then
    if [[ ${reference_errors} -gt 0 ]]; then
      echo "::notice::A reference that illustrates the project a skill runs against, rather than naming something in this repository, is exempted by listing it exactly as reported above in a <!-- validate-plugins: ignore ... --> comment in the same file."
    fi
    exit 1
  fi

  echo "All skill cross-references resolve."
}

main "${@}"
