#!/usr/bin/env bash
# Validates plugin structure and marketplace consistency.
set -euo pipefail

MARKETPLACE=".claude-plugin/marketplace.json"
CODEX_MARKETPLACE=".agents/plugins/marketplace.json"
CODEX_DIST_DIR="dist/codex"
readonly MARKETPLACE CODEX_MARKETPLACE CODEX_DIST_DIR

errors=0

function error() {
  echo "::error::$1"
  errors=$((errors + 1))
}

function warning() {
  echo "::warning::$1"
}

function is_semver() {
  [[ "${1}" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]
}

# ─── 1. Every plugin directory has plugin.json ───────────────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  if [[ ! -f "${dir}.claude-plugin/plugin.json" ]]; then
    error "Plugin '${local_name}' is missing .claude-plugin/plugin.json"
  fi
done

# ─── 2. Every plugin directory has README.md ─────────────────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  if [[ ! -f "${dir}README.md" ]]; then
    error "Plugin '${local_name}' is missing README.md"
  fi
done

# ─── 3. plugin.json name matches directory name ─────────────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  local_json="${dir}.claude-plugin/plugin.json"
  if [[ ! -f "${local_json}" ]]; then
    continue
  fi

  json_name="$(jq -r '.name' "${local_json}")"
  if [[ "${json_name}" != "${local_name}" ]]; then
    error "Plugin '${local_name}': plugin.json name '${json_name}' does not match directory name"
  fi
done

# ─── 4. Required fields in plugin.json ───────────────────────────────────────

PLUGIN_REQUIRED_FIELDS=("author" "description" "homepage" "keywords" "license" "name" "repository" "version")
readonly PLUGIN_REQUIRED_FIELDS

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  local_json="${dir}.claude-plugin/plugin.json"
  if [[ ! -f "${local_json}" ]]; then
    continue
  fi

  for field in "${PLUGIN_REQUIRED_FIELDS[@]}"; do
    value="$(jq -r ".${field} // empty" "${local_json}")"
    if [[ -z "${value}" ]]; then
      error "Plugin '${local_name}': plugin.json missing required field '${field}'"
    fi
  done
done

# ─── 4b. Plugin manifest versions are strict SemVer ─────────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  local_json="${dir}.claude-plugin/plugin.json"
  [[ -f "${local_json}" ]] || continue

  plugin_version="$(jq -r '.version // empty' "${local_json}")"
  if ! is_semver "${plugin_version}"; then
    error "Plugin '${local_name}': plugin.json version '${plugin_version}' must be MAJOR.MINOR.PATCH"
  fi
done

# ─── 5. Every plugin directory is registered in marketplace.json ─────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  match="$(jq -r --arg name "${local_name}" '.plugins[] | select(.name == $name) | .name' "${MARKETPLACE}")"
  if [[ -z "${match}" ]]; then
    error "Plugin '${local_name}' is not registered in marketplace.json"
  fi
done

# ─── 6. Every marketplace entry points to an existing directory ──────────────

marketplace_count="$(jq '.plugins | length' "${MARKETPLACE}")"
for ((i = 0; i < marketplace_count; i++)); do
  entry_name="$(jq -r ".plugins[${i}].name" "${MARKETPLACE}")"
  entry_source="$(jq -r ".plugins[${i}].source" "${MARKETPLACE}")"
  if [[ ! -d "${entry_source}" ]]; then
    error "Marketplace entry '${entry_name}': source '${entry_source}' does not exist"
  fi
done

# ─── 6b. Source paths start with ./ ──────────────────────────────────────────

for ((i = 0; i < marketplace_count; i++)); do
  entry_name="$(jq -r ".plugins[${i}].name" "${MARKETPLACE}")"
  entry_source="$(jq -r ".plugins[${i}].source" "${MARKETPLACE}")"
  if [[ "${entry_source}" != ./* ]]; then
    error "Marketplace entry '${entry_name}': source '${entry_source}' must start with ./"
  fi
done

# ─── 7. Required fields in marketplace entries ───────────────────────────────

MARKETPLACE_REQUIRED_FIELDS=("author" "category" "description" "homepage" "keywords" "license" "name" "repository" "source")
readonly MARKETPLACE_REQUIRED_FIELDS

for ((i = 0; i < marketplace_count; i++)); do
  entry_name="$(jq -r ".plugins[${i}].name" "${MARKETPLACE}")"
  for field in "${MARKETPLACE_REQUIRED_FIELDS[@]}"; do
    value="$(jq -r ".plugins[${i}].${field} // empty" "${MARKETPLACE}")"
    if [[ -z "${value}" ]]; then
      error "Marketplace entry '${entry_name}': missing required field '${field}'"
    fi
  done
done

# ─── 8. Marketplace holds no duplicate version state ────────────────────────

if jq -e '.metadata | has("version")' "${MARKETPLACE}" > /dev/null; then
  error "Marketplace metadata must not contain a version"
fi

for ((i = 0; i < marketplace_count; i++)); do
  entry_name="$(jq -r ".plugins[${i}].name" "${MARKETPLACE}")"
  if jq -e ".plugins[${i}] | has(\"version\")" "${MARKETPLACE}" > /dev/null; then
    error "Marketplace entry '${entry_name}' must not contain a version"
  fi
done

# ─── 9. Marketplace plugins array is in alphabetical order ──────────────────

sorted="$(jq -r '.plugins[].name' "${MARKETPLACE}" | sort)"
actual="$(jq -r '.plugins[].name' "${MARKETPLACE}")"

if [[ "${sorted}" != "${actual}" ]]; then
  error "Marketplace plugins array is not in alphabetical order by name"
fi

# ─── 10. .codex-plugin/plugin.json name matches directory name ──────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  codex_json="${dir}.codex-plugin/plugin.json"
  if [[ ! -f "${codex_json}" ]]; then
    continue
  fi

  json_name="$(jq -r '.name' "${codex_json}")"
  if [[ "${json_name}" != "${local_name}" ]]; then
    error "Plugin '${local_name}': .codex-plugin/plugin.json name '${json_name}' does not match directory name"
  fi
done

# ─── 12. Required fields in .codex-plugin/plugin.json ───────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  codex_json="${dir}.codex-plugin/plugin.json"
  if [[ ! -f "${codex_json}" ]]; then
    continue
  fi

  for field in "${PLUGIN_REQUIRED_FIELDS[@]}"; do
    value="$(jq -r ".${field} // empty" "${codex_json}")"
    if [[ -z "${value}" ]]; then
      error "Plugin '${local_name}': .codex-plugin/plugin.json missing required field '${field}'"
    fi
  done
done

# ─── 13. Dual manifests agree on shared fields ──────────────────────────────
# When both .claude-plugin/plugin.json and .codex-plugin/plugin.json exist,
# they must agree on identity and metadata fields. `description` and `hooks`
# are allowed to differ (description for system-specific phrasing; hooks is
# the whole reason for a separate codex manifest).

DUAL_MANIFEST_SHARED_FIELDS=("author" "homepage" "keywords" "license" "name" "repository" "version")
readonly DUAL_MANIFEST_SHARED_FIELDS

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  claude_json="${dir}.claude-plugin/plugin.json"
  codex_json="${dir}.codex-plugin/plugin.json"
  if [[ ! -f "${claude_json}" ]] || [[ ! -f "${codex_json}" ]]; then
    continue
  fi

  for field in "${DUAL_MANIFEST_SHARED_FIELDS[@]}"; do
    claude_value="$(jq -cS ".${field}" "${claude_json}")"
    codex_value="$(jq -cS ".${field}" "${codex_json}")"
    if [[ "${claude_value}" != "${codex_value}" ]]; then
      error "Plugin '${local_name}': field '${field}' differs between .claude-plugin/plugin.json (${claude_value}) and .codex-plugin/plugin.json (${codex_value})"
    fi
  done
done

# ─── 14. Hook plugins declare Codex hook registration ───────────────────────

for dir in plugins/*/; do
  local_name="$(basename "${dir}")"
  hooks_json="${dir}hooks/hooks.json"
  codex_json="${dir}.codex-plugin/plugin.json"

  if [[ ! -f "${hooks_json}" ]]; then
    continue
  fi

  if [[ ! -f "${codex_json}" ]]; then
    error "Plugin '${local_name}': hooks/hooks.json requires .codex-plugin/plugin.json for Codex hook registration"
    continue
  fi

  codex_hooks="$(jq -r 'if (.hooks | type) == "string" then .hooks else "" end' "${codex_json}")"
  if [[ -z "${codex_hooks}" ]]; then
    error "Plugin '${local_name}': .codex-plugin/plugin.json missing non-empty string field 'hooks'"
  fi
done

# ─── 15. Generated Codex marketplace mirrors the Claude marketplace ─────────

if [[ ! -f "${CODEX_MARKETPLACE}" ]]; then
  error "Codex marketplace '${CODEX_MARKETPLACE}' does not exist; run bin/build-codex-marketplace"
else
  claude_plugin_names="$(jq -r '.plugins[].name' "${MARKETPLACE}" | sort)"
  codex_plugin_names="$(jq -r '.plugins[].name' "${CODEX_MARKETPLACE}" | sort)"
  if [[ "${claude_plugin_names}" != "${codex_plugin_names}" ]]; then
    error "Codex marketplace plugin set differs from ${MARKETPLACE}"
  fi

  claude_metadata="$(jq -cS '.metadata' "${MARKETPLACE}")"
  codex_metadata="$(jq -cS '.metadata' "${CODEX_MARKETPLACE}")"
  if [[ "${claude_metadata}" != "${codex_metadata}" ]]; then
    error "Codex marketplace metadata differs from ${MARKETPLACE}"
  fi

  for ((i = 0; i < marketplace_count; i++)); do
    entry_name="$(jq -r ".plugins[${i}].name" "${CODEX_MARKETPLACE}")"
    entry_source="$(jq -r ".plugins[${i}].source" "${CODEX_MARKETPLACE}")"
    expected_source="./${CODEX_DIST_DIR}/plugins/${entry_name}"
    if [[ "${entry_source}" != "${expected_source}" ]]; then
      error "Codex marketplace entry '${entry_name}': source '${entry_source}' must be '${expected_source}'"
    fi
  done
fi

# ─── 16. Generated Codex plugin roots are current ───────────────────────────

function validate_codex_generated_output() {
  local expected_root expected_marketplace expected_dist
  expected_root="$(mktemp -d "${TMPDIR:-/tmp}/codex-marketplace.XXXXXX")"
  expected_marketplace="${expected_root}/.agents/plugins/marketplace.json"
  expected_dist="${expected_root}/dist/codex"

  # The regenerated tree must be byte-identical to the committed one, so pin the
  # label the build records inside its output (marketplace sources and README
  # link depth) to the real location even though the files land in a temp dir.
  if ! env CODEX_MARKETPLACE="${expected_marketplace}" CODEX_DIST_DIR="${expected_dist}" CODEX_DIST_LABEL="${CODEX_DIST_DIR}" bin/build-codex-marketplace > /dev/null; then
    error "Could not regenerate Codex marketplace for validation"
    rm -r "${expected_root}"
    return
  fi

  if [[ ! -f "${CODEX_MARKETPLACE}" ]]; then
    error "Codex marketplace '${CODEX_MARKETPLACE}' does not exist; run bin/build-codex-marketplace"
  elif ! diff -q "${expected_marketplace}" "${CODEX_MARKETPLACE}" > /dev/null; then
    error "Codex marketplace '${CODEX_MARKETPLACE}' is out of date; run bin/build-codex-marketplace"
  fi

  if [[ ! -d "${CODEX_DIST_DIR}" ]]; then
    error "Codex distribution '${CODEX_DIST_DIR}' does not exist; run bin/build-codex-marketplace"
  elif ! diff -qr "${expected_dist}" "${CODEX_DIST_DIR}" > /dev/null; then
    error "Codex distribution '${CODEX_DIST_DIR}' is out of date; run bin/build-codex-marketplace"
  fi

  rm -r "${expected_root}"
}

validate_codex_generated_output

# ─── 16b. Generated Codex skills differ only by the sanctioned translation ──
#
# Rule 16 proves dist/codex matches what the generator produces today, which
# would still pass if the generator started rewriting skills. Codex must see
# the same name, routing description and dependency block that Claude Code and
# OpenCode load, so every generated SKILL.md is compared with its canonical
# source here rather than taken on trust.
#
# One difference is sanctioned. Codex has no frontmatter field for invocation
# policy and ignores `disable-model-invocation`, so the generator drops that
# line and writes agents/openai.yaml instead. This rule reproduces that single
# edit independently of the generator, so any further transformation has to
# change this rule on purpose rather than slip in through the generator.

# Prints the file with the named frontmatter field's line removed. Only the
# opening block is filtered, matching bin/build-codex-marketplace.
function skill_without_frontmatter_field() {
  local skill_md="${1}" field="${2}"

  awk -v field="${field}" '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      print
      next
    }

    in_frontmatter && $0 == "---" {
      in_frontmatter = 0
      print
      next
    }

    in_frontmatter && index($0, field ":") == 1 {
      next
    }

    {
      print
    }
  ' "${skill_md}"
}

# Returns 0 when the frontmatter sets disable-model-invocation to true. Rule 21
# restricts the value to an unquoted true or false, so no other spelling of
# truth reaches here.
function frontmatter_disables_model_invocation() {
  local skill_md="${1}"

  awk '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter && $0 == "---" {
      exit
    }

    in_frontmatter && $0 ~ /^disable-model-invocation:[[:space:]]*true[[:space:]]*$/ {
      found = 1
      exit
    }

    END {
      exit !found
    }
  ' "${skill_md}"
}

while IFS= read -r plugin_name; do
  for skill_md in "plugins/${plugin_name}"/skills/*/SKILL.md; do
    [[ -f "${skill_md}" ]] || continue
    generated_skill_md="${CODEX_DIST_DIR}/${skill_md}"
    generated_agents_yaml="$(dirname "${generated_skill_md}")/agents/openai.yaml"

    if [[ ! -f "${generated_skill_md}" ]]; then
      error "Generated Codex skill '${generated_skill_md}' is missing; run bin/build-codex-marketplace"
      continue
    fi

    if frontmatter_disables_model_invocation "${skill_md}"; then
      if ! cmp -s <(skill_without_frontmatter_field "${skill_md}" disable-model-invocation) "${generated_skill_md}"; then
        error "Generated Codex skill '${generated_skill_md}' differs from its canonical source '${skill_md}' by more than the translated disable-model-invocation line"
      fi
      if [[ ! -f "${generated_agents_yaml}" ]]; then
        error "Generated Codex skill '${generated_skill_md}' drops disable-model-invocation without writing '${generated_agents_yaml}'"
      elif ! grep -q '^policy:' "${generated_agents_yaml}" \
        || ! grep -qE '^[[:space:]]+allow_implicit_invocation:[[:space:]]*false[[:space:]]*$' "${generated_agents_yaml}"; then
        error "Generated Codex manifest '${generated_agents_yaml}' does not set policy.allow_implicit_invocation to false"
      fi
    else
      if ! cmp -s "${skill_md}" "${generated_skill_md}"; then
        error "Generated Codex skill '${generated_skill_md}' differs from its canonical source '${skill_md}'; the generator copies SKILL.md files unchanged unless disable-model-invocation is translated"
      fi

      # An agents manifest a skill ships itself is copied like any other file,
      # so it is held to the same identity the SKILL.md is.
      canonical_agents_yaml="$(dirname "${skill_md}")/agents/openai.yaml"
      if [[ ! -f "${canonical_agents_yaml}" ]]; then
        if [[ -f "${generated_agents_yaml}" ]]; then
          error "Generated Codex skill '${generated_skill_md}' gained '${generated_agents_yaml}', which its canonical source does not ship"
        fi
      elif [[ ! -f "${generated_agents_yaml}" ]]; then
        error "Generated Codex manifest '${generated_agents_yaml}' is missing; run bin/build-codex-marketplace"
      elif ! cmp -s "${canonical_agents_yaml}" "${generated_agents_yaml}"; then
        error "Generated Codex manifest '${generated_agents_yaml}' differs from its canonical source '${canonical_agents_yaml}'"
      fi
    fi
  done
done < <(jq -r '.plugins[].name' "${MARKETPLACE}")

for generated_skill_md in "${CODEX_DIST_DIR}"/plugins/*/skills/*/SKILL.md; do
  [[ -f "${generated_skill_md}" ]] || continue
  if [[ ! -f "${generated_skill_md#"${CODEX_DIST_DIR}/"}" ]]; then
    error "Generated Codex skill '${generated_skill_md}' has no canonical source"
  fi
done

# ─── 17. The Codex skill inventory fits Codex's discovery budget ────────────
#
# Codex starts each session with one line per installed skill:
#
#   - {plugin}:{skill}: {description} (file: {path})
#
# It budgets that list at 2 percent of the model's context window, charging
# ceil(bytes / 4) tokens per line, or at 8,000 characters when the context
# window is unknown. Over budget it shortens descriptions from the end, then
# omits skills. Names and paths cost about as much as the descriptions, so this
# rule renders every generated dist/codex skill the way Codex does and budgets
# the whole line. It ignores Codex's path aliasing, which only lowers the cost.
#
# The generated copy is what Codex reads, so the inventory is measured there.
# Rule 16b holds each generated SKILL.md byte-identical to its canonical
# source, so the per-description checks run once, on the canonical copies that
# every harness shares.
#
# The constants come from the milestone 1 baseline in
# docs/reviews/codex-consumption.md. Revisit them only when the reference model
# or the set of skills Codex bundles changes, since the reserve measures those
# skills, and record that change there. Never raise them to fit content; tighten
# the routing descriptions instead.

CODEX_REFERENCE_MODEL="gpt-6-astra"
# The model's context window in tokens. Set it empty to model an unknown window,
# which selects Codex's character fallback.
CODEX_REFERENCE_CONTEXT_WINDOW="${CODEX_REFERENCE_CONTEXT_WINDOW-272000}"
CODEX_CONTEXT_WINDOW_PERCENT=2
CODEX_BYTES_PER_TOKEN=4
CODEX_FALLBACK_BUDGET_CHARACTERS=8000
# Codex's bundled system skills share the budget: 567 tokens with unaliased
# paths at the baseline, rounded up. Held in bytes so the same reserve applies
# to the character fallback, where characters never outnumber bytes.
CODEX_SYSTEM_SKILL_RESERVE_BYTES="${CODEX_SYSTEM_SKILL_RESERVE_BYTES-2400}"
# A fixed 15-character home directory keeps the cost independent of the machine.
CODEX_INVENTORY_HOME="/Users/username"
MAX_SKILL_DESCRIPTION_CHARACTERS=1024
# The primary budget's average share per skill at the baseline: 4,840 tokens
# after the reserve is 19,360 bytes, or 317 per skill across 61 skills. Names,
# paths and line syntax average 164 bytes of each line, leaving 153 characters
# for a description, rounded down.
ROUTED_DESCRIPTION_WARNING_CHARACTERS=150
readonly CODEX_REFERENCE_MODEL CODEX_REFERENCE_CONTEXT_WINDOW CODEX_CONTEXT_WINDOW_PERCENT \
  CODEX_BYTES_PER_TOKEN CODEX_FALLBACK_BUDGET_CHARACTERS CODEX_SYSTEM_SKILL_RESERVE_BYTES \
  CODEX_INVENTORY_HOME MAX_SKILL_DESCRIPTION_CHARACTERS ROUTED_DESCRIPTION_WARNING_CHARACTERS

function frontmatter_name() {
  awk '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter && $0 == "---" {
      exit
    }

    in_frontmatter && $0 ~ /^name:/ {
      line = $0
      sub(/^name:[[:space:]]*/, "", line)
      sub(/[[:space:]]+$/, "", line)
      print line
      exit
    }
  ' "${1}"
}

function frontmatter_description() {
  local file="${1}"

  awk '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter && collecting {
      if ($0 ~ /^[[:space:]]+/) {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        description = description (description == "" ? "" : " ") line
        next
      }
      printed = 1
      print description
      exit
    }

    in_frontmatter && $0 ~ /^description:/ {
      line = $0
      sub(/^description:[[:space:]]*/, "", line)
      if (line ~ /^[>|][-+]?[[:space:]]*$/) {
        collecting = 1
        next
      }
      printed = 1
      print line
      exit
    }

    in_frontmatter && $0 == "---" {
      exit
    }

    END {
      if (collecting && !printed) {
        print description
      }
    }
  ' "${file}"
}

function byte_count() {
  printf '%s' "${1}" | LC_ALL=C wc -c | tr -d ' '
}

# UTF-8 continuation bytes are 0x80 through 0xBF; every other byte starts a
# character. Counting that way gives the same answer under any locale.
function character_count() {
  printf '%s' "${1}" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' '
}

function check_skill_fields() {
  local skill_md="${1}"
  local name description description_length

  name="$(frontmatter_name "${skill_md}")"
  description="$(frontmatter_description "${skill_md}")"
  description_length="$(character_count "${description}")"

  if [[ -z "${name}" ]]; then
    error "Skill '${skill_md}' has an empty name"
  fi
  if [[ -z "${description}" ]]; then
    error "Skill '${skill_md}' has an empty description"
  elif [[ ${description_length} -gt ${MAX_SKILL_DESCRIPTION_CHARACTERS} ]]; then
    error "Skill '${skill_md}' description is ${description_length} characters, exceeding the ${MAX_SKILL_DESCRIPTION_CHARACTERS}-character limit"
  elif [[ ${description_length} -gt ${ROUTED_DESCRIPTION_WARNING_CHARACTERS} ]]; then
    warning "Skill '${skill_md}' routing description is ${description_length} characters; keep it within ${ROUTED_DESCRIPTION_WARNING_CHARACTERS}, its average share of the Codex discovery budget"
  fi
}

for skill_md in plugins/*/skills/*/SKILL.md; do
  [[ -f "${skill_md}" ]] || continue
  check_skill_fields "${skill_md}"
done

if [[ -n "${CODEX_REFERENCE_CONTEXT_WINDOW}" ]] && ! [[ "${CODEX_REFERENCE_CONTEXT_WINDOW}" =~ ^[1-9][0-9]*$ ]]; then
  error "CODEX_REFERENCE_CONTEXT_WINDOW must be a positive integer or empty"
fi
if ! [[ "${CODEX_SYSTEM_SKILL_RESERVE_BYTES}" =~ ^[0-9]+$ ]]; then
  error "CODEX_SYSTEM_SKILL_RESERVE_BYTES must be a non-negative integer"
fi

marketplace_name="$(jq -r '.name // empty' "${CODEX_MARKETPLACE}" 2> /dev/null || true)"
inventory_count=0
inventory_tokens=0
inventory_bytes=0
inventory_characters=0
inventory_description_bytes=0
inventory_entries=""

for skill_md in "${CODEX_DIST_DIR}"/plugins/*/skills/*/SKILL.md; do
  [[ -f "${skill_md}" ]] || continue

  skill_plugin="${skill_md#"${CODEX_DIST_DIR}/plugins/"}"
  skill_plugin="${skill_plugin%%/*}"
  skill_dir="$(basename "$(dirname "${skill_md}")")"
  skill_name="$(frontmatter_name "${skill_md}")"
  description="$(frontmatter_description "${skill_md}")"
  description_length="$(character_count "${description}")"

  plugin_manifest="${CODEX_DIST_DIR}/plugins/${skill_plugin}/.codex-plugin/plugin.json"
  [[ -f "${plugin_manifest}" ]] || plugin_manifest="${CODEX_DIST_DIR}/plugins/${skill_plugin}/.claude-plugin/plugin.json"
  plugin_version="$(jq -r '.version // empty' "${plugin_manifest}" 2> /dev/null || true)"

  # Codex cuts an over-long description to 1,021 characters plus "...". The
  # length is already an error above; mirroring the cut keeps the total honest.
  if [[ ${description_length} -gt ${MAX_SKILL_DESCRIPTION_CHARACTERS} ]]; then
    description="$(printf '%s' "${description}" | awk -v limit="$((MAX_SKILL_DESCRIPTION_CHARACTERS - 3))" '{ print substr($0, 1, limit) "..." }')"
  fi

  line="- ${skill_plugin}:${skill_name}: ${description} (file: ${CODEX_INVENTORY_HOME}/.codex/plugins/cache/${marketplace_name}/${skill_plugin}/${plugin_version}/skills/${skill_dir}/SKILL.md)"
  line_bytes=$(($(byte_count "${line}") + 1))
  line_tokens=$(((line_bytes + CODEX_BYTES_PER_TOKEN - 1) / CODEX_BYTES_PER_TOKEN))

  inventory_count=$((inventory_count + 1))
  inventory_tokens=$((inventory_tokens + line_tokens))
  inventory_bytes=$((inventory_bytes + line_bytes))
  inventory_characters=$((inventory_characters + $(character_count "${line}") + 1))
  inventory_description_bytes=$((inventory_description_bytes + $(byte_count "${description}")))
  inventory_entries+="${line_tokens}"$'\t'"${skill_plugin}:${skill_name}"$'\n'
done

if [[ "${CODEX_SYSTEM_SKILL_RESERVE_BYTES}" =~ ^[0-9]+$ ]] && [[ ${inventory_count} -gt 0 ]]; then
  reserve_tokens=$(((CODEX_SYSTEM_SKILL_RESERVE_BYTES + CODEX_BYTES_PER_TOKEN - 1) / CODEX_BYTES_PER_TOKEN))
  fallback_available=$((CODEX_FALLBACK_BUDGET_CHARACTERS - CODEX_SYSTEM_SKILL_RESERVE_BYTES))
  largest_entries="$(printf '%s' "${inventory_entries}" | sort -t $'\t' -k1,1nr -k2,2 | head -5 | awk -F '\t' '{ printf "%s%s (%s)", (NR > 1 ? ", " : ""), $2, $1 }')"
  inventory_breakdown="Descriptions are ${inventory_description_bytes} of its ${inventory_bytes} bytes; names, paths and line syntax are the rest. Largest entries in tokens: ${largest_entries}. Tighten the largest routing descriptions rather than raising the budget."

  if [[ -z "${CODEX_REFERENCE_CONTEXT_WINDOW}" ]]; then
    echo "Codex skill inventory: ${inventory_count} skills cost ${inventory_characters} of ${fallback_available} characters available under the ${CODEX_FALLBACK_BUDGET_CHARACTERS}-character fallback; no reference context window is set."
    if [[ ${inventory_characters} -gt ${fallback_available} ]]; then
      error "Codex skill inventory is ${inventory_characters} characters, over the ${fallback_available} available (${CODEX_FALLBACK_BUDGET_CHARACTERS}-character fallback budget less a ${CODEX_SYSTEM_SKILL_RESERVE_BYTES}-character system-skill reserve). ${inventory_breakdown}"
    fi
  elif [[ "${CODEX_REFERENCE_CONTEXT_WINDOW}" =~ ^[1-9][0-9]*$ ]]; then
    primary_budget=$((CODEX_REFERENCE_CONTEXT_WINDOW * CODEX_CONTEXT_WINDOW_PERCENT / 100))
    [[ ${primary_budget} -gt 0 ]] || primary_budget=1
    primary_available=$((primary_budget - reserve_tokens))
    echo "Codex skill inventory: ${inventory_count} skills cost ${inventory_tokens} of ${primary_available} tokens available under the ${primary_budget}-token budget for ${CODEX_REFERENCE_MODEL}, and ${inventory_characters} of ${fallback_available} characters available under the ${CODEX_FALLBACK_BUDGET_CHARACTERS}-character fallback."
    if [[ ${inventory_tokens} -gt ${primary_available} ]]; then
      error "Codex skill inventory costs ${inventory_tokens} tokens, over the ${primary_available} available (${primary_budget}-token budget for ${CODEX_REFERENCE_MODEL} less a ${reserve_tokens}-token system-skill reserve). ${inventory_breakdown}"
    fi
  fi
fi

# ─── 18. Skill script references resolve to a shipped, executable script ────
#
# A skill invokes a bundled script by writing "${CLAUDE_PLUGIN_ROOT}/scripts/NAME",
# which Claude Code substitutes with the installed plugin root when the skill loads.
# Two things can go wrong silently, so both are checked here:
#
#   a. The referenced script does not exist (or is not executable) in the plugin.
#   b. The skill uses a version-blind locator glob ("**/PLUGIN/scripts/NAME") instead.
#      That shape matches this repository's layout but never the installed cache,
#      which interposes a version directory. The corrected fallback form,
#      "**/PLUGIN/**/scripts/NAME", is allowed because it tolerates that segment.
#
# Only SKILL.md bodies are scanned. Files under references/ legitimately contain
# both spellings as documentation.

for skill_md in plugins/*/skills/*/SKILL.md; do
  [[ -f "${skill_md}" ]] || continue

  skill_plugin="${skill_md#plugins/}"
  skill_plugin="${skill_plugin%%/*}"

  while IFS= read -r script_name; do
    [[ -n "${script_name}" ]] || continue

    script_path="plugins/${skill_plugin}/scripts/${script_name}"
    if [[ ! -f "${script_path}" ]]; then
      error "${skill_md} references \${CLAUDE_PLUGIN_ROOT}/scripts/${script_name} but ${script_path} does not exist"
    elif [[ ! -x "${script_path}" ]]; then
      error "${skill_md} references \${CLAUDE_PLUGIN_ROOT}/scripts/${script_name} but ${script_path} is not executable"
    fi
  done < <(grep -oE '\$\{CLAUDE_PLUGIN_ROOT\}/scripts/[A-Za-z0-9._-]+' "${skill_md}" \
    | sed 's|.*/scripts/||' | sort -u)

  if grep -qE '\*\*/[a-z0-9-]+/scripts/' "${skill_md}"; then
    error "${skill_md} uses a version-blind locator glob (**/<plugin>/scripts/...); use \${CLAUDE_PLUGIN_ROOT}/scripts/... instead, with **/<plugin>/**/scripts/... only as a fallback"
  fi
done

# ─── 19. Skill cross-references resolve ─────────────────────────────────────
# bin/check-cross-references owns the path and skill-name checks and emits its
# own ::error:: and ::warning:: annotations, so its findings are relayed and
# counted rather than re-derived here. It is a separate script so it can be
# exercised on its own against the fixture trees in tests/scrut/. A passing run
# still relays its warnings, which would otherwise be discarded with its
# success line.

if ! cross_reference_output="$(bin/check-cross-references 2>&1)"; then
  printf '%s\n' "${cross_reference_output}"
  cross_reference_errors="$(grep -c '^::error::' <<< "${cross_reference_output}" || true)"
  if [[ "${cross_reference_errors}" -gt 0 ]]; then
    errors=$((errors + cross_reference_errors))
  else
    error "bin/check-cross-references failed without reporting a finding"
  fi
else
  grep '^::warning::' <<< "${cross_reference_output}" || true
fi

# ─── 20. Bundled review checklists are current ──────────────────────────────
# bin/build-review-checklists copies each style guide's review checklist into
# set-up-review-config, because a skill can read only the files its own plugin
# ships. A hand edit to a copy, or a checklist edit without a rebuild, would
# install a checklist that no longer matches its guide, so the copies are
# regenerated into a temporary directory and compared. Rule 16 cannot see this:
# it rebuilds dist/codex from whatever plugins/ holds, stale copies included.
# guides.md must also name every copy, or a bundled checklist would have no
# detection rule and never be installed.

REVIEW_CHECKLISTS_DIR="plugins/set-up-review-config/skills/set-up-review-config/references/checklists"
REVIEW_GUIDES_FILE="plugins/set-up-review-config/skills/set-up-review-config/references/guides.md"
readonly REVIEW_CHECKLISTS_DIR REVIEW_GUIDES_FILE

function validate_review_checklists() {
  local expected_dir output relayed expected committed name

  expected_dir="$(mktemp -d "${TMPDIR:-/tmp}/review-checklists.XXXXXX")"
  if ! output="$(env REVIEW_CHECKLISTS_DIR="${expected_dir}" bin/build-review-checklists 2>&1)"; then
    printf '%s\n' "${output}"
    relayed="$(grep -c '^::error::' <<< "${output}" || true)"
    if [[ "${relayed}" -gt 0 ]]; then
      errors=$((errors + relayed))
    else
      error "bin/build-review-checklists failed without reporting a finding"
    fi
    rm -r "${expected_dir}"
    return
  fi

  for expected in "${expected_dir}"/*.md; do
    [[ -e "${expected}" ]] || continue
    committed="${REVIEW_CHECKLISTS_DIR}/${expected##*/}"
    if [[ ! -f "${committed}" ]]; then
      error "Review checklist copy '${committed}' is missing; run make build"
    elif ! cmp -s "${expected}" "${committed}"; then
      error "Review checklist copy '${committed}' does not match its source; edit the style guide's references/review-checklist.md, not the copy, and run make build"
    fi
  done

  for committed in "${REVIEW_CHECKLISTS_DIR}"/*.md; do
    [[ -e "${committed}" ]] || continue
    name="${committed##*/}"
    if [[ ! -f "${expected_dir}/${name}" ]]; then
      error "Review checklist copy '${committed}' has no source checklist; run make build"
    elif ! grep -qF "./references/checklists/${name}" "${REVIEW_GUIDES_FILE}" 2> /dev/null; then
      error "'${REVIEW_GUIDES_FILE}' does not name ./references/checklists/${name}; add detection and routing rules for it"
    fi
  done

  rm -r "${expected_dir}"
}

validate_review_checklists

# ─── 21. Skill frontmatter fields are on the allowlist ──────────────────────
#
# Claude Code accepts around twenty SKILL.md frontmatter fields, Codex and
# OpenCode document two, and both ignore what they do not recognize. A
# misspelling such as `disable-model-invokation` therefore has no effect
# anywhere and reports nothing. This rule names the fields this repository
# ships, so a typo fails here instead of going unnoticed.
#
# Widening the allowlist is deliberate work, not a formality: each new field
# needs its Codex and OpenCode handling measured and recorded in
# docs/plugin-development.md, because a field Claude Code honors can be silently
# dropped by the other two. `disable-model-invocation` is the case in point, and
# the only field with a Codex counterpart today.

SKILL_FRONTMATTER_ALLOWLIST=(
  name
  description
  license
  compatibility
  metadata
  allowed-tools
  disable-model-invocation
  paths
  context
  agent
  argument-hint
)
readonly SKILL_FRONTMATTER_ALLOWLIST

function is_allowed_frontmatter_field() {
  local candidate="${1}" allowed

  for allowed in "${SKILL_FRONTMATTER_ALLOWLIST[@]}"; do
    if [[ "${allowed}" == "${candidate}" ]]; then
      return 0
    fi
  done

  return 1
}

# Prints one tab-separated key and value per top-level frontmatter entry.
# Indented lines belong to the key above them, so only column-zero keys count,
# and a body line that happens to look like a key never reaches the caller.
function frontmatter_entries() {
  local skill_md="${1}"

  awk '
    NR == 1 && $0 == "---" {
      in_frontmatter = 1
      next
    }

    in_frontmatter && $0 == "---" {
      exit
    }

    in_frontmatter && /^[^[:space:]#][^:]*:/ {
      field = $0
      sub(/:.*/, "", field)
      value = $0
      sub(/^[^:]*:[[:space:]]*/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print field "\t" value
    }
  ' "${skill_md}"
}

for skill_md in plugins/*/skills/*/SKILL.md; do
  [[ -f "${skill_md}" ]] || continue

  while IFS=$'\t' read -r field value; do
    [[ -n "${field}" ]] || continue

    if ! is_allowed_frontmatter_field "${field}"; then
      error "Skill '${skill_md}' declares frontmatter field '${field}', which is not on the allowlist; see the skill frontmatter section of docs/plugin-development.md"
    fi

    # The generator and rule 16b both match an unquoted true, so a value they
    # cannot read would translate to nothing and lose the author's intent.
    if [[ "${field}" == "disable-model-invocation" ]] \
      && [[ "${value}" != "true" && "${value}" != "false" ]]; then
      error "Skill '${skill_md}' must write disable-model-invocation as an unquoted true or false"
    fi
  done < <(frontmatter_entries "${skill_md}")
done

# ─── Summary ────────────────────────────────────────────────────────────────

if [[ ${errors} -gt 0 ]]; then
  echo "${errors} plugin validation error(s) found."
  exit 1
fi

echo "All plugin validations passed."
