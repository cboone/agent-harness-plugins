#!/usr/bin/env bash
# Validates JSON syntax for all .json files in the repository.
set -euo pipefail

errors=0

# shellcheck disable=SC2312
# find in process substitution masks its exit code; acceptable here since
# find is only walking local directories and failure is effectively impossible.
while IFS= read -r -d '' file; do
  if ! jq empty "${file}" 2> /dev/null; then
    echo "::error file=${file}::Invalid JSON syntax"
    errors=$((errors + 1))
  fi
done < <(find . -name node_modules -prune -o -name '.yarn' -prune -o -name '*.json' -print0)

if [[ ${errors} -gt 0 ]]; then
  echo "${errors} JSON file(s) have syntax errors."
  exit 1
fi

echo "All JSON files are valid."
