#!/usr/bin/env bash
# Runs alerter with the given arguments and stops it with SIGKILL WAIT_LIMIT
# seconds later unless it has exited. ./notify launches it detached, so the
# harness never waits on it.
#
# A waiting alerter polls usernoted, at a cost that grows with the number
# waiting. SIGKILL leaves the delivered banner in Notification Center, while
# SIGTERM or SIGINT would make alerter remove it.
#
# Must parse under macOS /bin/bash 3.2, what `env bash` finds without Homebrew.
set -euo pipefail

# alerter's own timeout, a backstop for when this script is stopped before its
# SIGKILL: alerter removes the banner when it expires.
readonly FIRE_TIMEOUT=86400

# Seconds alerter gets to post its banner, capped at 60. The nine-digit match
# keeps bash arithmetic from overflowing.
WAIT_LIMIT=2
if [[ "${NOTIFY_WAIT_LIMIT:-}" =~ ^[1-9][0-9]{0,8}$ ]]; then
  WAIT_LIMIT=$((NOTIFY_WAIT_LIMIT > 60 ? 60 : NOTIFY_WAIT_LIMIT))
fi
readonly WAIT_LIMIT

function main() {
  alerter "$@" --timeout "${FIRE_TIMEOUT}" > /dev/null 2>&1 < /dev/null &
  local pid=$! waited=0
  while [[ "${waited}" -lt "${WAIT_LIMIT}" ]] && kill -0 "${pid}" 2> /dev/null; do
    sleep 1
    waited=$((waited + 1))
  done
  kill -KILL "${pid}" 2> /dev/null || true
}

main "$@"
