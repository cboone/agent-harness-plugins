#!/usr/bin/env bash
# Sends macOS notifications via alerter for Claude Code and Codex CLI hooks.
# OpenCode has its own TypeScript implementation under ../opencode/.
#
# Each hook event is a subcommand; reads the hook's JSON payload from stdin
# and shells out to alerter with per-event title, subtitle, body, sound, group,
# and per-harness icon. Events fire detached so the harness is not blocked on
# user interaction.
set -euo pipefail

SCRIPT_NAME="$(basename "${0}")"
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
ASSETS_DIR="${SCRIPT_DIR}/../assets"
FOCUS_SCRIPT="${SCRIPT_DIR}/focus-pane"
readonly SCRIPT_NAME SCRIPT_DIR ASSETS_DIR FOCUS_SCRIPT

# Default content-body length budgets (alerter wraps; macOS truncates around 4 lines).
readonly BODY_LIMIT_DEFAULT=140
readonly BODY_LIMIT_ASSISTANT_TAIL=120
readonly BODY_LIMIT_USER_HEAD=55
readonly BODY_LIMIT_ASSISTANT_TAIL_PAIRED=60
readonly BODY_LIMIT_USER_FALLBACK=120

# Detached fire-and-forget timeout (24h).
readonly FIRE_TIMEOUT=86400

function usage() {
  cat << 'USAGE_TEXT'
Usage: notify <subcommand>

Subcommands:
  cc-idle       Claude Code Notification:idle_prompt
  cc-elicit     Claude Code Notification:elicitation_dialog
  cc-permission Claude Code Notification:permission_prompt
  cc-compact    Claude Code PreCompact:auto
  cc-stop       Claude Code Stop
  codex-stop    Codex Stop

Each subcommand reads its hook payload as JSON on stdin.
USAGE_TEXT
}

# -----------------------------------------------------------------------------
# Generic helpers
# -----------------------------------------------------------------------------

function truncate_with_ellipsis() {
  local text="${1}"
  local limit="${2:-80}"
  if [[ "${#text}" -le "${limit}" ]]; then
    printf '%s' "${text}"
    return
  fi
  if [[ "${limit}" -lt 1 ]]; then
    return
  fi
  printf '%s…' "${text:0:$((limit - 1))}"
}

function project_name() {
  basename "${PWD}"
}

function compute_branch_suffix() {
  local branch
  branch="$(git branch --show-current 2> /dev/null)" || branch=""
  branch="${branch:-unknown}"
  if [[ "${branch}" == */* ]]; then
    branch="${branch#*/}"
  fi
  printf '%s' "${branch}"
}

function compute_pane_title() {
  if [[ -z "${TMUX_PANE:-}" ]]; then
    return 0
  fi
  local title
  title="$(tmux display-message -t "${TMUX_PANE}" -p '#T' 2> /dev/null)" || return 0
  if [[ -z "${title}" ]]; then
    return 0
  fi
  local cwd_basename
  cwd_basename="$(basename "${PWD}")"
  case "${title}" in
    "${cwd_basename}" | zsh | bash | fish | sh | tmux | ssh | nvim | vim | "-zsh" | "-bash") return 0 ;;
    *) printf '%s' "${title}" ;;
  esac
}

function compute_subtitle() {
  local project
  project="$(project_name)"
  local pane_title
  pane_title="$(compute_pane_title)"
  if [[ -n "${pane_title}" ]]; then
    printf '%s · %s' "${project}" "${pane_title}"
    return
  fi
  local branch_suffix
  branch_suffix="$(compute_branch_suffix)"
  printf '%s · %s' "${project}" "${branch_suffix}"
}

function compute_tmux_state() {
  if [[ -z "${TMUX_PANE:-}" ]]; then
    return 0
  fi
  tmux display-message -t "${TMUX_PANE}" -p '#S|#I|#P' 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Transcript extractors (Claude Code JSONL)
# -----------------------------------------------------------------------------

# Walk transcript backward, find the most recent message of the given role,
# extract its concatenated text content. Handles both string content (legacy)
# and array-of-blocks content (current). Uses process substitution rather than
# a pipe so an early break does not SIGPIPE the producer.
function extract_last_message_text() {
  local transcript_path="${1}"
  local role="${2}"
  local limit="${3:-${BODY_LIMIT_DEFAULT}}"

  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi

  local found=""
  while IFS= read -r line; do
    if [[ -n "${found}" ]]; then
      continue
    fi

    local msg_type
    msg_type="$(printf '%s' "${line}" | jq -r '.type // empty' 2> /dev/null)" || continue
    # Accept both "user" and "human" — Claude Code's older transcript format
    # used "human"; current versions use "user".
    if [[ "${role}" == "user" ]]; then
      if [[ "${msg_type}" != "user" && "${msg_type}" != "human" ]]; then
        continue
      fi
    elif [[ "${msg_type}" != "${role}" ]]; then
      continue
    fi

    local text
    text="$(printf '%s' "${line}" | jq -r '
      (.message.content // empty) as $c
      | if ($c | type) == "string" then $c
        elif ($c | type) == "array" then
          ($c | map(select(.type == "text") | .text) | join(" "))
        else "" end
    ' 2> /dev/null)" || continue

    # Skip Claude Code slash-command synthetic messages.
    case "${text}" in
      "<command-"* | "<local-"*) continue ;;
      *) ;;
    esac

    if [[ -n "${text}" ]]; then
      found="${text}"
    fi
  done < <(tac "${transcript_path}" 2> /dev/null || true)

  if [[ -n "${found}" ]]; then
    truncate_with_ellipsis "${found}" "${limit}"
  fi
}

function extract_last_user_message() {
  extract_last_message_text "${1}" "user" "${2:-${BODY_LIMIT_DEFAULT}}"
}

function extract_last_assistant_message() {
  extract_last_message_text "${1}" "assistant" "${2:-${BODY_LIMIT_DEFAULT}}"
}

# Returns JSON {name, input} for the most recent tool_use in any assistant
# message, or empty if there is none. Used to identify which tool a Claude
# Code permission_prompt is about.
function get_pending_tool_use() {
  local transcript_path="${1}"
  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi

  local found=""
  while IFS= read -r line; do
    if [[ -n "${found}" ]]; then
      continue
    fi

    local msg_type
    msg_type="$(printf '%s' "${line}" | jq -r '.type // empty' 2> /dev/null)" || continue
    if [[ "${msg_type}" != "assistant" ]]; then
      continue
    fi

    local tool_use
    tool_use="$(printf '%s' "${line}" | jq -c '
      (.message.content // [])
      | map(select(.type == "tool_use"))
      | last
      | select(. != null)
      | {name: .name, input: .input}
    ' 2> /dev/null)" || continue

    if [[ -n "${tool_use}" && "${tool_use}" != "null" ]]; then
      found="${tool_use}"
    fi
  done < <(tac "${transcript_path}" 2> /dev/null || true)

  if [[ -n "${found}" ]]; then
    printf '%s' "${found}"
  fi
}

# -----------------------------------------------------------------------------
# Tool preview formatting
# -----------------------------------------------------------------------------

function tool_name() {
  local tool_json="${1}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi
  printf '%s' "${tool_json}" | jq -r '.name // empty' 2> /dev/null || true
}

function tool_preview() {
  local tool_json="${1}"
  local limit="${2:-${BODY_LIMIT_DEFAULT}}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi

  local name
  name="$(tool_name "${tool_json}")"
  local preview=""
  case "${name}" in
    Bash) preview="$(printf '%s' "${tool_json}" | jq -r '.input.command // empty')" ;;
    Edit | Write | Read) preview="$(printf '%s' "${tool_json}" | jq -r '.input.file_path // empty')" ;;
    WebFetch) preview="$(printf '%s' "${tool_json}" | jq -r '.input.url // empty')" ;;
    Grep | Glob) preview="$(printf '%s' "${tool_json}" | jq -r '.input.pattern // empty')" ;;
    Task) preview="$(printf '%s' "${tool_json}" | jq -r '.input.description // empty')" ;;
    NotebookEdit) preview="$(printf '%s' "${tool_json}" | jq -r '.input.notebook_path // empty')" ;;
    *) preview="" ;;
  esac

  if [[ -n "${preview}" ]]; then
    # Collapse newlines so the body stays single-line in the alert.
    preview="${preview//$'\n'/ }"
    truncate_with_ellipsis "${preview}" "${limit}"
  fi
}

# -----------------------------------------------------------------------------
# alerter dispatch
# -----------------------------------------------------------------------------

# Fires alerter detached. The wrapper script captures alerter's stdout and
# dispatches click actions to focus-pane, then exits. The harness is not
# blocked on user interaction. An empty sound argument suppresses the
# `--sound` flag so the notification is silent.
function fire_alerter_detached() {
  local title="${1}" subtitle="${2}" message="${3}"
  local sound="${4}" group="${5}" icon="${6}"

  local tmux_state session="" window="" pane=""
  tmux_state="$(compute_tmux_state)"
  if [[ -n "${tmux_state}" ]]; then
    IFS='|' read -r session window pane <<< "${tmux_state}"
  fi
  local term_program="${TERM_PROGRAM:-}"

  local sound_args=()
  if [[ -n "${sound}" ]]; then
    sound_args=(--sound "${sound}")
  fi

  # Detached subshell: alerter blocks waiting for user interaction inside,
  # parent function returns immediately so the harness is not blocked.
  (
    local result
    result="$(alerter \
      --title "${title}" \
      --subtitle "${subtitle}" \
      --message "${message}" \
      "${sound_args[@]}" \
      --group "${group}" \
      --app-icon "${icon}" \
      --timeout "${FIRE_TIMEOUT}" \
      2> /dev/null)" || true
    case "${result}" in
      *@CONTENTCLICKED*)
        "${FOCUS_SCRIPT}" \
          "${term_program}" \
          "${session}" \
          "${window}" \
          "${pane}" \
          > /dev/null 2>&1 || true
        ;;
      *) ;;
    esac
  ) > /dev/null 2>&1 < /dev/null &
  # Best-effort detach. In non-interactive shells without job control,
  # `disown` can fail; under `set -e` that would abort the hook and skip
  # the notification. The background subshell is already detached via the
  # redirections above, so swallowing this error is safe.
  disown 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Claude Code event handlers
# -----------------------------------------------------------------------------

function do_cc_idle() {
  local input transcript_path
  input="$(cat)"
  transcript_path="$(printf '%s' "${input}" | jq -r '.transcript_path // empty')"

  local subtitle body
  subtitle="$(compute_subtitle)"
  body="$(extract_last_assistant_message "${transcript_path}" "${BODY_LIMIT_ASSISTANT_TAIL}")"
  if [[ -z "${body}" ]]; then
    body="Waiting for input"
  fi

  fire_alerter_detached \
    "Claude Code · Idle" \
    "${subtitle}" \
    "${body}" \
    "Tink" \
    "claude-idle" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_elicit() {
  local input message subtitle body
  input="$(cat)"
  message="$(printf '%s' "${input}" | jq -r '.message // empty')"
  subtitle="$(compute_subtitle)"

  if [[ -n "${message}" ]]; then
    body="$(truncate_with_ellipsis "${message//$'\n'/ }" "${BODY_LIMIT_DEFAULT}")"
  else
    body="Needs input"
  fi

  fire_alerter_detached \
    "Claude Code · Question" \
    "${subtitle}" \
    "${body}" \
    "Tink" \
    "claude-elicit" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_permission() {
  local input transcript_path
  input="$(cat)"
  transcript_path="$(printf '%s' "${input}" | jq -r '.transcript_path // empty')"

  local subtitle base
  base="$(compute_subtitle)"

  local pending name preview
  pending="$(get_pending_tool_use "${transcript_path}")"
  name="$(tool_name "${pending}")"
  preview="$(tool_preview "${pending}" "${BODY_LIMIT_DEFAULT}")"

  if [[ -n "${name}" ]]; then
    subtitle="${base} · ${name}"
  else
    subtitle="${base}"
  fi

  local body
  if [[ -n "${preview}" ]]; then
    body="${preview}"
  elif [[ -n "${name}" ]]; then
    body="${name}"
  else
    body="$(printf '%s' "${input}" | jq -r '.message // "Needs permission"')"
  fi

  fire_alerter_detached \
    "Claude Code · Permission" \
    "${subtitle}" \
    "${body}" \
    "Funk" \
    "claude-permission" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_compact() {
  # Drain stdin so Claude Code does not see EPIPE.
  cat > /dev/null

  local subtitle
  subtitle="$(compute_subtitle)"

  fire_alerter_detached \
    "Claude Code · Compacting" \
    "${subtitle}" \
    "Auto-compacting context" \
    "Pop" \
    "claude-compact" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_stop() {
  local input transcript_path
  input="$(cat)"
  transcript_path="$(printf '%s' "${input}" | jq -r '.transcript_path // empty')"

  local subtitle
  subtitle="$(compute_subtitle)"

  local user_msg assistant_tail
  user_msg="$(extract_last_user_message "${transcript_path}" "${BODY_LIMIT_USER_HEAD}")"
  assistant_tail="$(extract_last_assistant_message "${transcript_path}" "${BODY_LIMIT_ASSISTANT_TAIL_PAIRED}")"

  local body
  if [[ -n "${user_msg}" && -n "${assistant_tail}" ]]; then
    body="${user_msg} → ${assistant_tail}"
  elif [[ -n "${user_msg}" ]]; then
    body="$(extract_last_user_message "${transcript_path}" "${BODY_LIMIT_USER_FALLBACK}")"
  elif [[ -n "${assistant_tail}" ]]; then
    body="${assistant_tail}"
  else
    body="Task completed"
  fi

  fire_alerter_detached \
    "Claude Code · Done" \
    "${subtitle}" \
    "${body}" \
    "Glass" \
    "claude-stop" \
    "${ASSETS_DIR}/claude-code.png"
}

# -----------------------------------------------------------------------------
# Codex event handlers
# -----------------------------------------------------------------------------

# Codex Stop fires once per "no follow-up needed" sampling cycle in turn.rs's
# turn loop, which means a single user turn can produce multiple Stop events
# when Stop hooks request continuation or compaction re-enters the loop. The
# notification uses a deliberately soft Tink sound so successive firings
# within a turn (same group, so they replace in place) are not disruptive.
# The body comes straight from the payload's `last_assistant_message`, which
# Codex provides directly, so we do not walk the transcript here.
function do_codex_stop() {
  local input
  input="$(cat)"

  local subtitle
  subtitle="$(compute_subtitle)"

  local assistant_tail
  assistant_tail="$(printf '%s' "${input}" | jq -r '.last_assistant_message // empty')"

  local body
  if [[ -n "${assistant_tail}" ]]; then
    assistant_tail="${assistant_tail//$'\n'/ }"
    body="$(truncate_with_ellipsis "${assistant_tail}" "${BODY_LIMIT_DEFAULT}")"
  else
    body="Task completed"
  fi

  fire_alerter_detached \
    "Codex · Done" \
    "${subtitle}" \
    "${body}" \
    "Tink" \
    "codex-stop" \
    "${ASSETS_DIR}/codex.png"
}

# -----------------------------------------------------------------------------
# Dispatcher
# -----------------------------------------------------------------------------

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  case "${1:-}" in
    cc-idle) do_cc_idle ;;
    cc-elicit) do_cc_elicit ;;
    cc-permission) do_cc_permission ;;
    cc-compact) do_cc_compact ;;
    cc-stop) do_cc_stop ;;
    codex-stop) do_codex_stop ;;
    "")
      echo "Error: subcommand required" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Error: unknown subcommand: ${1}" >&2
      echo "Use '${SCRIPT_NAME} --help' to see available subcommands." >&2
      exit 1
      ;;
  esac
}

main "${@}"
