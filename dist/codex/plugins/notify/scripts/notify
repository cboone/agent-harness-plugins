#!/usr/bin/env bash
# Sends macOS notifications via alerter for Claude Code and Codex CLI hooks.
#
# Each hook event is a subcommand; reads the hook's JSON payload from stdin
# and shells out to alerter with per-event title, subtitle, body, sound, group,
# and per-harness icon. Titles name the action; the icon names the harness.
# Events fire detached, and each alerter is stopped shortly after launch.
# A session placed in a tier (top, lead or worker) by NOTIFY_TIER or a tiers
# file posts only what nothing else brings to the person; see resolve_tier.
#
# Must parse under macOS /bin/bash 3.2, what `env bash` finds without Homebrew.
# A syntax error exits 2, and Claude Code treats exit 2 as blocking the event.
set -euo pipefail

SCRIPT_NAME="$(basename "${0}")"
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
ASSETS_DIR="${SCRIPT_DIR}/../assets"
readonly SCRIPT_NAME SCRIPT_DIR ASSETS_DIR

# Body length budget: a banner shows about two lines, an expanded alert about four.
readonly BODY_LIMIT=140

# Backstop if run_alerter never sends its SIGKILL. alerter removes the banner
# when this expires.
readonly FIRE_TIMEOUT=86400

# Seconds alerter gets to post its banner. A waiting alerter polls usernoted, at
# a cost that grows with the number waiting. The nine-digit match keeps the
# comparison from overflowing.
WAIT_LIMIT=2
if [[ "${NOTIFY_WAIT_LIMIT:-}" =~ ^[1-9][0-9]{0,8}$ ]]; then
  WAIT_LIMIT=$((NOTIFY_WAIT_LIMIT > 60 ? 60 : NOTIFY_WAIT_LIMIT))
fi
readonly WAIT_LIMIT

readonly TIERS_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/agent-harness-notify/tiers"

# Separates tmux names with a character tmux preserves and names cannot contain.
readonly TMUX_FIELD_SEP=$'\037'

# Reduces a reply to plain prose for a banner body. Lengths count Unicode code
# points.
# - Input past 20,000 characters is ignored.
# - A JSON object reply with a string `summary` is summarized from that field.
# - Headings, list items and paragraphs become separate sentences, joined by a
#   period when one lacks closing punctuation.
# - Prose wins. Without prose, status lines (a leading ▸, or two or more " · "
#   separators) are used; without either, the first code or table line is.
#   An unclosed fence is read as prose.
# - Whole sentences are kept in order within $limit. A sentence that no longer
#   fits is cut at a word boundary with "…" when it is the first sentence or at
#   least 40 characters remain; otherwise it and every later sentence are
#   dropped.
# Read with `read -d ''` because bash 3.2 cannot parse this heredoc inside $().
IFS= read -r -d '' SUMMARY_JQ << 'JQ' || true
def cut($n):
  if length <= $n then .
  elif $n < 1 then ""
  else .[0:$n - 1] as $head
    | (if (.[$n - 1:$n] | test("^\\s")) or ($head | test("\\s") | not) then $head
       else $head | sub("\\s+\\S*$"; "") end)
    | sub("\\s+$"; "") + "…" end;
def inline:
  gsub("\\[(?<t>[^\\]]*)\\]\\([^)]*\\)"; "\(.t)")
  | gsub("\\*\\*|__|`"; "")
  | gsub("(?<![\\p{L}\\p{N}_*])\\*(?<t>[^*\\s][^*]*)\\*"; "\(.t)")
  | sub("^\\s*(#{1,6}|[-*+>▸•]|[0-9]+\\.)\\s+"; "");
def is_status: test("^\\s*▸") or ([scan(" · ")] | length) >= 2;
def is_table_rule: test("^[\\s|:-]+$") and test("\\|") and test("-");
# Indexes of table lines, found by a separator row under a header containing a pipe,
# with or without leading pipes; the table runs until a line without a pipe.
def table_rows($lines):
  reduce range(1; $lines | length) as $i ({};
    if ($lines[$i] | is_table_rule) and ($lines[$i - 1] | test("\\|")) then
      (first(range($i + 1; $lines | length) | select(($lines[.] | test("\\|")) | not)) // ($lines | length)) as $end
      | reduce range($i - 1; $end) as $j (.; .["\($j)"] = true)
    else . end);
def table_cells: gsub("^\\s*\\||\\|\\s*$"; "") | gsub("\\s*\\|\\s*"; " · ");
def flush:
  if .cur != "" then .out += [{t: .cur, k: "prose"}] | .cur = "" else . end;
def units_of($lines):
  table_rows($lines) as $table
  | (reduce range(0; $lines | length) as $i ({fence: -1, mark: 0, cur: "", out: []};
    $lines[$i] as $l
    | if ($l | test("^\\s*(```|~~~)")) then
        flush | (if .fence < 0 then .fence = $i | .mark = (.out | length) else .fence = -1 end)
      elif .fence >= 0 then .out += [{t: $l, k: "code"}]
      elif $table["\($i)"] or ($l | test("^\\s*\\|")) then
        (if ($l | is_table_rule) then . else flush | .out += [{t: ($l | table_cells), k: "code"}] end)
      elif ($l | test("^\\s*$")) then flush
      elif ($l | is_status) then flush | .out += [{t: ($l | inline), k: "status"}]
      elif ($l | test("^\\s*(#{1,6}|[-*+>•]|[0-9]+\\.)\\s")) then flush | .cur = ($l | inline)
      else .cur = ((.cur + " " + ($l | inline)) | ltrimstr(" ")) end)) as $r
  | if $r.fence >= 0 then $r.out[0:$r.mark] + units_of($lines[$r.fence + 1:])
    else ($r | flush | .out) end;
def units:
  .[0:20000] | split("\n") as $lines
  | units_of($lines)
  | map(.t |= (gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ")) | select(.t != ""));
def sentences:
  units
  | (if any(.[]; .k == "prose") then map(select(.k == "prose"))
     elif any(.[]; .k == "status") then map(select(.k == "status"))
     else .[0:1] end)
  | length as $n
  | to_entries
  | map(.key as $i | .value.t
      | (if $i < $n - 1 and (test("[.!?:]$") | not) then . + "." else . end)
      | [scan("(?:[^.!?]|[.!?]+(?!\\s|$))+(?:[.!?]+(?=\\s|$))?") | ltrimstr(" ") | select(length > 0)])
  | add // [];
def summary($limit):
  sentences
  | reduce .[] as $x ({t: "", done: false};
      if .done then .
      else (if .t == "" then 0 else 1 end) as $sep
        | ($limit - (.t | length) - $sep) as $room
        | (if $sep == 1 then " " else "" end) as $gap
        | if ($x | length) <= $room then .t += $gap + $x
          elif .t == "" or $room >= 40 then .t += $gap + ($x | cut($room)) | .done = true
          else .done = true end
      end)
  | .t;
(try fromjson catch null) as $j
| (if ($j | type) == "object" and ($j.summary | type) == "string" then $j.summary else . end)
| summary($limit)
JQ
readonly SUMMARY_JQ

function usage() {
  cat << 'USAGE_TEXT'
Usage: notify <subcommand>

Subcommands:
  cc-elicit         Claude Code Notification:elicitation_dialog
  cc-permission     Claude Code Notification:permission_prompt
  cc-question       Claude Code PreToolUse:AskUserQuestion
  cc-stop           Claude Code Stop
  cc-failure        Claude Code StopFailure (error or safeguard refusal)
  codex-failure     Normalized terminal failure from the rollout watcher
  cc-turn-start     Claude Code UserPromptSubmit (resets completion deduplication)
  codex-question    Codex PreToolUse:request_user_input
  codex-stop        Codex Stop
  codex-turn-start  Codex UserPromptSubmit (resets completion deduplication)
  explain [TRANSCRIPT]
                    Print this pane's tier, subtitle and sounds, reading the
                    session name from TRANSCRIPT or $CLAUDE_CODE_SESSION_ID's

Each hook subcommand reads its hook payload as JSON on stdin.
USAGE_TEXT
}

# -----------------------------------------------------------------------------
# Generic helpers
# -----------------------------------------------------------------------------

# Truncation runs in jq so lengths count characters whatever the hook's locale.
function truncate_with_ellipsis() {
  printf '%s' "${1}" | jq -Rrs --argjson n "${2:-80}" \
    'if length <= $n then . elif $n < 1 then "" else .[0:$n - 1] + "…" end' 2> /dev/null || true
}

# Keeps the end of the text, so a long path still shows its file name.
function truncate_from_left() {
  printf '%s' "${1}" | jq -Rrs --argjson n "${2}" \
    'if length <= $n then . elif $n < 1 then "" else "…" + .[length - $n + 1:] end' 2> /dev/null || true
}

function summarize_reply() {
  printf '%s' "${1}" | jq -Rrs --argjson limit "${2:-${BODY_LIMIT}}" "${SUMMARY_JQ}" 2> /dev/null || true
}

# Prints the hook payload's string field $1 without NUL bytes, or nothing.
function hook_string() {
  printf '%s' "${HOOK_INPUT}" | jq -r --arg key "${1}" '.[$key] // empty | strings | gsub("\u0000"; "")' 2> /dev/null || true
}

function repo_root() {
  local root
  root="$(git rev-parse --show-toplevel 2> /dev/null)" || root=""
  printf '%s' "${root:-${PWD}}"
}

# Names the repository rather than the worktree folder: worktrees share the
# primary checkout's git directory, so its parent names the repository.
function repo_name() {
  local common name
  common="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || common=""
  if [[ -z "${common}" ]]; then
    basename "${PWD}"
    return
  fi
  name="$(basename "${common}")"
  case "${name}" in
    .git | .bare) name="$(basename "$(dirname "${common}")")" ;;
    *.git) name="${name%.git}" ;;
    *) ;;
  esac
  printf '%s' "${name}"
}

# Prints how many of the sound files $1-0, $1-1, ... exist in ~/Library/Sounds
# before the first gap.
function count_sound_variants() {
  local stem="${1}" count=0 base
  while :; do
    base="${HOME}/Library/Sounds/${stem}-${count}"
    if [[ -f "${base}.aiff" || -f "${base}.wav" || -f "${base}.caf" ]]; then
      count=$((count + 1))
    else
      break
    fi
  done
  printf '%s' "${count}"
}

# A tiered session takes its tier's <prefix>-<tier>-<role>-<n> subset, then the
# plain <prefix>-<role>-<n> set. POSIX cksum hashes the place, or else the
# repository name, without a trailing newline. Equal role counts select equal
# indices; missing roles retain built-in sounds.
function resolve_sound() {
  local builtin="${1}" prefix="${NOTIFY_SOUND_SET:-}" role
  if [[ ! "${prefix}" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf '%s' "${builtin}"
    return
  fi
  case "${builtin}" in
    Glass) role=stop ;;
    Funk) role=permission ;;
    Tink) role=attention ;;
    *)
      printf '%s' "${builtin}"
      return
      ;;
  esac

  local stem count=0
  if [[ -n "${TIER}" ]]; then
    stem="${prefix}-${TIER}-${role}"
    count="$(count_sound_variants "${stem}")"
  fi
  if [[ "${count}" -eq 0 ]]; then
    stem="${prefix}-${role}"
    count="$(count_sound_variants "${stem}")"
  fi
  if [[ "${count}" -eq 0 ]]; then
    printf '%s' "${builtin}"
    return
  fi

  local key="${PLACE}" checksum
  if [[ -z "${key}" ]]; then
    key="$(repo_name)"
  fi
  checksum="$(printf '%s' "${key}" | cksum)"
  checksum="${checksum%% *}"
  printf '%s' "${stem}-$((checksum % count))"
}

function compute_branch_suffix() {
  local branch
  branch="$(git branch --show-current 2> /dev/null)" || branch=""
  branch="${branch:-unknown}"
  if [[ "${branch}" == */* ]]; then
    branch="${branch#*/}"
  fi
  printf '%s' "${branch}"
}

# Prints the tmux pane title without leading status glyphs such as Claude
# Code's ✳ or spinner frames, or nothing when the title names no task.
function compute_pane_title() {
  local repo="${1}"
  if [[ -z "${TMUX_PANE:-}" ]]; then
    return 0
  fi
  local title
  title="$(tmux display-message -t "${TMUX_PANE}" -p '#T' 2> /dev/null)" || return 0
  title="$(printf '%s' "${title}" | jq -Rr 'sub("^[^\\p{L}\\p{N}#(\\[]+"; "") | sub("\\s+$"; "")' 2> /dev/null)" || return 0
  local cwd_basename
  cwd_basename="$(basename "${PWD}")"
  case "${title}" in
    "" | "${cwd_basename}" | "${repo}" | zsh | bash | fish | sh | tmux | ssh | nvim | vim | "-zsh" | "-bash") return 0 ;;
    "Claude Code" | Codex) return 0 ;;
    *) ;;
  esac
  # A shell's default user@host:path title names no task.
  if [[ "${title}" =~ ^[^[:space:]@]+@[^[:space:]:]+: ]]; then
    return 0
  fi
  printf '%s' "${title}"
}

function compute_subtitle() {
  local repo task
  repo="$(repo_name)"
  task="$(compute_pane_title "${repo}")"
  if [[ -z "${task}" ]]; then
    task="$(compute_branch_suffix)"
  fi
  printf '%s · %s' "${repo}" "${task}"
}

# -----------------------------------------------------------------------------
# Session tiers
# -----------------------------------------------------------------------------

# Set by resolve_tier. TIER is top, lead or worker, or empty for an untiered
# session; TIER_RULE says what set it. PLACE is "<tmux session>: <window>" for
# a tiered session in tmux, or empty.
TIER=""
TIER_RULE=""
PLACE=""
# Read at most once per event.
TMUX_SESSION=""
TMUX_WINDOW=""
SESSION_NAME=""
SESSION_NAME_READ=false

# Sets SESSION_NAME from transcript $1: the newest agent-name (--name) or
# custom-title (rename) record. grep keeps a large transcript out of jq, and
# the type check drops lines that only quote such a record.
function read_session_name() {
  local transcript_path="${1}"
  [[ "${SESSION_NAME_READ}" == false ]] || return 0
  SESSION_NAME_READ=true
  if [[ "${HARNESS}" != claude || -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi
  SESSION_NAME="$(grep -E '"type":"(agent-name|custom-title)"' "${transcript_path}" 2> /dev/null \
    | jq -Rnr 'reduce (inputs | fromjson? | objects) as $record (null;
        if $record.type == "agent-name" then ($record.agentName | strings) // .
        elif $record.type == "custom-title" then ($record.customTitle | strings) // .
        else . end)
      // empty' 2> /dev/null)" || SESSION_NAME=""
}

# Sets TMUX_SESSION and TMUX_WINDOW for $TMUX_PANE, or leaves them empty.
function read_tmux_names() {
  [[ "${EXPLICIT_CONTEXT:-false}" == false ]] || return 0
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  local names
  names="$(tmux display-message -t "${TMUX_PANE}" -p "#{session_name}${TMUX_FIELD_SEP}#{window_name}" 2> /dev/null)" || return 0
  [[ "${names}" == *"${TMUX_FIELD_SEP}"* ]] || return 0
  TMUX_SESSION="${names%%"${TMUX_FIELD_SEP}"*}"
  TMUX_WINDOW="${names#*"${TMUX_FIELD_SEP}"}"
}

# Sets PLACE from the tmux names, dropping the private-use glyphs of icon fonts,
# which banners cannot render. A window named only with them gives way to the
# Claude session name from transcript $1, else to the tmux session alone.
function compute_place() {
  local transcript_path="${1}" window
  [[ -n "${TMUX_SESSION}" ]] || return 0
  window="$(printf '%s' "${TMUX_WINDOW}" | jq -Rr 'gsub("\\p{Co}"; "") | gsub("^\\s+|\\s+$"; "")' 2> /dev/null)" || window=""
  if [[ -z "${window}" ]]; then
    read_session_name "${transcript_path}"
    window="${SESSION_NAME}"
  fi
  PLACE="${TMUX_SESSION}${window:+: ${window}}"
}

# Sets TIER and TIER_RULE from NOTIFY_TIER, else from the first matching rule
# in the tiers file, then PLACE for a tiered session. Skips lines without a
# tier name, unknown fields and patterns bash cannot compile (=~ returns 2);
# an empty field matches nothing. An unreadable tiers file counts as absent, so
# hooks post as untiered. $1 is the transcript, read only for a `name` rule or
# PLACE.
function resolve_tier() {
  local transcript_path="${1}" file="${TIERS_FILE}"
  case "${NOTIFY_TIER:-}" in
    top | lead | worker)
      TIER="${NOTIFY_TIER}"
      TIER_RULE="NOTIFY_TIER=${NOTIFY_TIER}"
      ;;
    *) ;;
  esac
  if [[ ! -f "${file}" || ! -r "${file}" ]]; then
    file=""
  fi
  if [[ -z "${TIER}" && -z "${file}" ]]; then
    return 0
  fi
  read_tmux_names

  if [[ -z "${TIER}" ]]; then
    local socket="${TMUX:-}" server="" line number=0 tier field pattern value
    if [[ -n "${socket}" ]]; then
      socket="${socket%%,*}"
      server="${socket##*/}"
    fi
    while IFS= read -r line || [[ -n "${line}" ]]; do
      number=$((number + 1))
      read -r tier field pattern <<< "${line%$'\r'}"
      case "${tier}" in
        top | lead | worker) ;;
        *) continue ;;
      esac
      case "${field}" in
        window) value="${TMUX_WINDOW}" ;;
        session) value="${TMUX_SESSION}" ;;
        server) value="${server}" ;;
        name)
          read_session_name "${transcript_path}"
          value="${SESSION_NAME}"
          ;;
        dir) value="${CLAUDE_PROJECT_DIR:-${PWD}}" ;;
        *) continue ;;
      esac
      if [[ -n "${value}" && -n "${pattern}" && "${value}" =~ ${pattern} ]]; then
        TIER="${tier}"
        TIER_RULE="line ${number}: ${tier} ${field} ${pattern}"
        break
      fi
    done < "${file}"
  fi

  if [[ -n "${TIER}" ]]; then
    compute_place "${transcript_path}"
  fi
}

# Succeeds when the session's tier keeps event $1 (stop, plan or question) from
# posting. Workers report by message and never ask the person anything. A top
# or lead session puts its questions and plans on the coordinator's list first.
# Permission prompts and elicitation dialogs post in every tier.
function tier_silences() {
  case "${TIER}:${1}" in
    worker:stop | top:plan | lead:plan | ?*:question) return 0 ;;
    *) return 1 ;;
  esac
}

function tier_title() {
  if [[ "${TIER}" == worker ]]; then
    printf 'Worker: %s' "${1}"
  else
    printf '%s' "${1}"
  fi
}

function banner_subtitle() {
  if [[ -n "${PLACE}" ]]; then
    printf '%s' "${PLACE}"
  else
    compute_subtitle
  fi
}

# -----------------------------------------------------------------------------
# Transcript extractors (Claude Code JSONL)
# -----------------------------------------------------------------------------

# Each extractor streams a transcript newest line first and stops at the current
# turn's user prompt, so time and memory follow the current turn and an earlier
# turn is never consulted. Records (type "human" in older transcripts) are
# classified as:
# - "prompt": a user message that is not a tool result, a meta record (such as
#   a skill expansion or system reminder) or local-command output. A
#   slash-command invocation (`<command-message>…`) starts a turn, so it is a
#   prompt;
# - "result": a user record carrying tool results;
# - "assistant", and "other" for everything else.
TURN_JQ="$(cat "${SCRIPT_DIR}/claude-transcript.jq")"$'\n'
readonly TURN_JQ

# Prints the text of the current turn's last assistant message, or nothing.
IFS= read -r -d '' LAST_TEXT_JQ << 'JQ' || true
first(turn[] | select(kind == "assistant")
  | (if (content | type) == "string" then content
     else [blocks | select(.type == "text") | .text | strings] | join("\n") end)
  | select(. != "")) // empty
| gsub("\u0000"; "")
JQ
readonly LAST_TEXT_JQ

# Prints {name, input} for the tool call a permission prompt is about, or
# nothing. Candidates are the current turn's tool_use blocks without a
# tool_result yet, oldest first, since Claude Code asks about parallel calls in
# order. The selection depends on what the prompt's message says:
# - $plan (the plan-approval message): the newest ExitPlanMode call, or a bare
#   ExitPlanMode when the call is not in the transcript yet;
# - $wanted (a tool named in the message): the oldest call with that name, or
#   for an MCP display name such as "github - create_issue (MCP)" or
#   "Create Issue", the oldest MCP call matching it by server and tool, then by
#   tool, then by a tool name the display name ends with;
# - neither (the generic message): the oldest call that is not a question or a
#   plan, then a plan, then a question.
IFS= read -r -d '' PENDING_JQ << 'JQ' || true
def norm: ascii_downcase | gsub("[^a-z0-9]"; "");
def mcp_full: ltrimstr("mcp__") | norm;
def mcp_tool: split("__") | last | norm;
# Keeps only the string fields previews read, capped, so a large Write never
# passes through the shell. A plan keeps its first heading outside fenced code,
# or else its first non-blank line.
def preview_input:
  .input | if type == "object" then
    {command, file_path, notebook_path, url, pattern, description,
     plan: ((.plan | strings | split("\n")
       | [foreach .[] as $l ({fence: false};
           if ($l | test("^\\s*(```|~~~)")) then .fence = (.fence | not) | .skip = true else .skip = .fence end;
           if .skip then empty else $l end)]
       | (map(select(test("^#{1,6}\\s"))) | first) // (map(select(test("\\S"))) | first)) // null)}
    | with_entries(select(.value | type == "string") | .value |= .[0:4096])
  else {} end;
turn
| ([.[] | select(kind == "result") | blocks | select(.type == "tool_result")
    | .tool_use_id | strings | {(.): true}] | add // {}) as $answered
| [reverse[] | select(kind == "assistant") | blocks | select(.type == "tool_use")
    | select($answered[.id // "" | tostring] != true)
    | {name: (.name // "" | tostring), input: preview_input}] as $calls
| [$calls[] | select(.name | startswith("mcp__"))] as $mcp
| ($wanted | sub("\\s*\\(MCP\\)\\s*$"; "") | norm) as $short
| if $plan then
    ([$calls[] | select(.name == "ExitPlanMode")] | last) // {name: "ExitPlanMode", input: {}}
  elif $wanted != "" then
    first($calls[] | select(.name == $wanted))
    // (if $short == "" then empty
        else first($mcp[] | select((.name | mcp_full) == $short))
          // first($mcp[] | select((.name | mcp_tool) == $short))
          // first($mcp[] | select((.name | mcp_tool) as $tool | $tool != "" and ($short | endswith($tool))))
        end)
    // empty
  else
    first($calls[] | select(.name != "AskUserQuestion" and .name != "ExitPlanMode"))
    // first($calls[] | select(.name == "ExitPlanMode"))
    // first($calls[] | select(.name == "AskUserQuestion"))
    // empty
  end
JQ
readonly PENDING_JQ

# Prints "background" when the current Claude Code turn did not start with the
# user's prompt, or nothing; read after TURN_JQ. Newest first, the turn's
# main-session user records share a promptId and end at one with another, or at
# a TURN_JQ prompt without one. Only a "human" turnOrigin, or else origin.kind,
# is the user's; with neither, a turn whose messages, compaction summaries
# aside, are all meta is background. A turn without a promptId is unknown.
IFS= read -r -d '' TURN_ORIGIN_JQ << 'JQ' || true
[label $out
  | foreach (inputs | (fromjson? // null) | objects | select(is_user and .isSidechain != true)) as $r
      (null; . // (($r.promptId | strings) // null);
       if ($r.promptId | type) == "string" then
         (if $r.promptId == . then
            $r | {origin: (.turnOrigin // (.origin | objects | .kind) // null), isMeta, isCompactSummary, message: (is_result | not)}
          else break $out end)
       elif ($r | kind) == "prompt" then break $out
       else empty end)]
| [.[] | .origin | strings] as $origins
| [.[] | select(.message and .isCompactSummary != true)] as $messages
| if ($origins | length) > 0 then
    (if any($origins[]; . == "human") then empty else "background" end)
  elif ($messages | length) > 0 and all($messages[]; .isMeta == true) then "background"
  else empty end
JQ
readonly TURN_ORIGIN_JQ

# Prints "answered" when the person answered or rejected an AskUserQuestion or
# ExitPlanMode call in the current Claude Code turn; read after TURN_JQ. Only
# Claude Code's fixed rejection text marks an error result as the person's; if
# that text changes, rejections stop counting and Done posts.
IFS= read -r -d '' ANSWERED_JQ << 'JQ' || true
def text: .content | if type == "string" then . elif type == "array" then [.[] | objects | .text | strings] | join(" ") else "" end;
def from_person: .is_error != true or (text | startswith("The user doesn't want to proceed"));
turn
| [.[] | select(kind == "assistant") | blocks | select(.type == "tool_use")
    | select(.name == "AskUserQuestion" or .name == "ExitPlanMode") | .id | strings] as $asked
| [.[] | select(kind == "result") | blocks | select(.type == "tool_result") | select(from_person)
    | .tool_use_id | strings] as $results
| if any($asked[]; . as $id | any($results[]; . == $id)) then "answered" else empty end
JQ
readonly ANSWERED_JQ

# Prints file $1 newest line first. Stock macOS has tail -r but no tac. Its
# stderr is silenced because jq stops reading at the turn's prompt.
function reverse_lines() {
  if command -v tac > /dev/null 2>&1; then
    tac "${1}" 2> /dev/null
  else
    tail -r "${1}" 2> /dev/null
  fi
}

function extract_last_assistant_text() {
  local transcript_path="${1}"
  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi
  reverse_lines "${transcript_path}" | jq -Rnr "${TURN_JQ} ${LAST_TEXT_JQ}" 2> /dev/null || true
}

# Prints "headless" for `codex exec`, `e` or `review`, "interactive" for another
# Codex command, or nothing when the parent is not Codex. `ps` loses argument
# boundaries, so after an option that may take a value, or a word that names no
# command, the parent's terminal decides: the interactive TUI always has one.
# The commands and flags follow `codex --help` in Codex 0.162.1.
function codex_parent_command() {
  local tty args word
  local -a words
  read -r tty args <<< "$(ps -ww -o tty=,args= -p "${PPID}" 2> /dev/null)" || return 0
  read -r -a words <<< "${args}"
  [[ "${#words[@]}" -gt 0 && "${words[0]##*/}" == codex ]] || return 0
  for word in "${words[@]:1}"; do
    case "${word}" in
      --strict-config | --oss | --approve-for-me | --dangerously-bypass-approvals-and-sandbox | \
        --dangerously-bypass-hook-trust | --worktree | --search | --no-alt-screen | --no-daemon) ;;
      exec | e | review)
        echo headless
        return 0
        ;;
      agents | login | logout | mcp | plugin | app-server | remote-control | app | completion | update | doctor | \
        sandbox | debug | apply | a | resume | queue | archive | delete | migrate-rollouts | unarchive | fork | \
        cloud | exec-server | features | help)
        echo interactive
        return 0
        ;;
      *) break ;;
    esac
  done
  case "${tty}" in
    '' | '?' | '??') echo headless ;;
    *) echo interactive ;;
  esac
}

# Succeeds when the user started the turn or its origin is unknown.
# - Claude Code: TURN_ORIGIN_JQ finds no background origin in transcript $1.
# - Codex: the session is not a subagent and codex_parent_command is not
#   "headless". A resumed session keeps its transcript's first source, so that
#   source decides only when the parent is not Codex.
function turn_started_by_user() {
  local transcript_path="${1}" origin session_source=""
  if [[ "${HARNESS}" == claude ]]; then
    if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
      return 0
    fi
    origin="$(reverse_lines "${transcript_path}" | jq -Rnr "${TURN_JQ} ${TURN_ORIGIN_JQ}" 2> /dev/null)" || true
    [[ "${origin}" != background ]]
    return
  fi
  # `codex exec --ephemeral` writes no transcript, so the parent still decides.
  if [[ -n "${transcript_path}" && -f "${transcript_path}" ]]; then
    session_source="$(head -n 1 "${transcript_path}" 2> /dev/null \
      | jq -r 'select(.type == "session_meta") | .payload.source | if type == "object" then "subagent" else strings end' 2> /dev/null)" || session_source=""
  fi
  [[ "${session_source}" != subagent ]] || return 1
  case "$(codex_parent_command)" in
    headless) return 1 ;;
    interactive) return 0 ;;
    *) [[ "${session_source}" != exec ]] ;;
  esac
}

# Succeeds when the person answered a question or plan prompt in the current
# Claude Code turn of transcript $1. A Codex turn never counts: its errors share
# an answer's shape.
function turn_answered_prompt() {
  local transcript_path="${1}" answered
  if [[ "${HARNESS}" != claude || -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 1
  fi
  answered="$(reverse_lines "${transcript_path}" | jq -Rnr "${TURN_JQ} ${ANSWERED_JQ}" 2> /dev/null)" || true
  [[ "${answered}" == answered ]]
}

# $2 is the tool named by the prompt's message; $3 is "true" for the plan
# approval message. See PENDING_JQ.
function get_pending_tool_use() {
  local transcript_path="${1}"
  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi
  reverse_lines "${transcript_path}" | jq -Rnc --arg wanted "${2:-}" --argjson plan "${3:-false}" "${TURN_JQ} ${PENDING_JQ}" 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Tool preview formatting
# -----------------------------------------------------------------------------

function tool_name() {
  local tool_json="${1}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi
  printf '%s' "${tool_json}" | jq -r '.name // empty' 2> /dev/null || true
}

# Shows a path relative to the repository root, or under ~, keeping its end.
# git resolves symlinks in the root, so the logical working directory is
# tried too.
function display_path() {
  local path="${1}"
  local limit="${2}"
  local base
  for base in "$(repo_root)" "${PWD}"; do
    if [[ "${path}" == "${base}/"* ]]; then
      truncate_from_left "${path#"${base}/"}" "${limit}"
      return
    fi
  done
  if [[ "${path}" == "${HOME}/"* ]]; then
    path='~'"/${path#"${HOME}/"}"
  fi
  truncate_from_left "${path}" "${limit}"
}

# Drops a leading cd into the working directory or repository root.
function strip_working_cd() {
  local command="${1}"
  local dir prefix
  for dir in "${PWD}" "$(repo_root)"; do
    for prefix in "cd ${dir} && " "cd ${dir}; " "cd \"${dir}\" && " "cd \"${dir}\"; " "cd '${dir}' && " "cd '${dir}'; "; do
      if [[ "${command}" == "${prefix}"* ]]; then
        printf '%s' "${command#"${prefix}"}"
        return
      fi
    done
  done
  printf '%s' "${command}"
}

# Prints a one-line preview of a tool's input. MCP tools and tools without a
# known preview field print nothing.
function tool_preview() {
  local tool_json="${1}"
  local limit="${2:-${BODY_LIMIT}}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi

  local name
  name="$(tool_name "${tool_json}")"
  local field=""
  case "${name}" in
    Bash) field='.input.command' ;;
    Edit | Write | Read | NotebookEdit) field='.input.file_path // .input.notebook_path' ;;
    WebFetch) field='.input.url' ;;
    Grep | Glob) field='.input.pattern' ;;
    Task | Agent) field='.input.description' ;;
    *) return 0 ;;
  esac
  local preview
  preview="$(printf '%s' "${tool_json}" | jq -r "(${field}) // empty | strings" 2> /dev/null)" || preview=""
  if [[ -z "${preview}" ]]; then
    return 0
  fi

  case "${name}" in
    Edit | Write | Read | NotebookEdit)
      display_path "${preview}" "${limit}"
      return 0
      ;;
    Bash) preview="$(strip_working_cd "${preview}")" ;;
    *) ;;
  esac
  # Collapse newlines so the body stays single-line in the alert.
  truncate_with_ellipsis "${preview//$'\n'/ }" "${limit}"
}

# Prints the plan line preview_input kept, without Markdown, for ExitPlanMode
# prompts.
function plan_heading() {
  printf '%s' "${1}" | jq -r '
    (.input.plan // "") | strings
    | sub("^\\s*(#{1,6}|[-*+>]|[0-9]+\\.)\\s+"; "") | gsub("\\*\\*|`"; "")
  ' 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# alerter dispatch
# -----------------------------------------------------------------------------

# Stops alerter with SIGKILL WAIT_LIMIT seconds after launch, unless it exits
# first. SIGTERM or SIGINT would make alerter remove its delivered banner.
function run_alerter() {
  local failure_context="${1}"
  shift
  alerter "$@" --timeout "${FIRE_TIMEOUT}" &
  local pid=$! waited=0 backend_status
  while [[ "${waited}" -lt "${WAIT_LIMIT}" ]] && kill -0 "${pid}" 2> /dev/null; do
    sleep 1
    waited=$((waited + 1))
  done
  if [[ -n "${failure_context}" ]] && ! kill -0 "${pid}" 2> /dev/null; then
    if wait "${pid}"; then
      return 0
    else
      backend_status=$?
      printf 'notify: alerter exited with status %s (%s)\n' "${backend_status}" "${failure_context}" >&2
      return "${backend_status}"
    fi
  fi
  kill -KILL "${pid}" 2> /dev/null || true
}

# Fires alerter detached, so the harness is never blocked.
function fire_alerter_detached() {
  local title="${1}" subtitle="${2}" message="${3}"
  local sound="${4}" group="${5}" icon="${6}"
  local failure_context="${7:-}" error_fd=1
  if [[ -n "${failure_context}" ]]; then error_fd=2; fi

  group="${group}-${SESSION_KEY}"
  if [[ "${group}" == *-stop-* ]]; then
    # mkdir is atomic, including when concurrent Stop hooks arrive.
    if ! mkdir "${STATE_DIR}/completed" 2> /dev/null; then
      return 0
    fi
    if originating_pane_visible; then
      return 0
    fi
  fi

  local sound_args=()
  if [[ -n "${sound}" ]]; then
    sound_args=(--sound "${sound}")
  fi

  run_alerter "${failure_context}" \
    --title "${title}" \
    --subtitle "${subtitle}" \
    --message "${message}" \
    ${sound_args[@]+"${sound_args[@]}"} \
    --group "${group}" \
    --app-icon "${icon}" \
    > /dev/null 2>&"${error_fd}" < /dev/null &
  # disown fails without job control, and set -e would then skip the notification.
  disown 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Claude Code event handlers
# -----------------------------------------------------------------------------

# Retries refusal detection because the transcript can lag behind StopFailure.
function failure_is_refusal() {
  local transcript_path="${1}" attempt
  [[ "$(hook_string error)" == invalid_request && -f "${transcript_path}" ]] || return 1
  for attempt in 1 2 3 4 5; do
    if tail -n 20 "${transcript_path}" 2> /dev/null | jq -Rne "${TURN_JQ} shows_refusal" > /dev/null 2>&1; then
      return 0
    fi
    if ((attempt < 5)); then sleep 0.5; fi
  done
  return 1
}

# Failure events bypass completion policy, including focus and origin checks.
function do_cc_failure() {
  local transcript_path name title="Error" message sound
  transcript_path="$(hook_string transcript_path)"
  resolve_tier "${transcript_path}"
  sound="$(resolve_sound Funk)"
  read_tmux_names
  compute_place "${transcript_path}"
  read_session_name "${transcript_path}"
  name="${SESSION_NAME:-$(hook_string session_id)}"
  name="$(truncate_with_ellipsis "${name:-Unknown session}" 70)"
  if failure_is_refusal "${transcript_path}"; then
    title="Refusal"
    message="Turn ended in a safeguard refusal."
  else
    message=""
    if [[ "$(hook_string error)" != invalid_request ]]; then
      message="$(hook_string last_assistant_message)"
    fi
    message="${message:-Turn ended in an API error.}"
  fi
  fire_alerter_detached "$(tier_title "${title}: ${name}")" "$(banner_subtitle)" \
    "$(truncate_with_ellipsis "${message}" "${BODY_LIMIT}")" \
    "${sound}" "${HARNESS}-failure" "${ASSETS_DIR}/claude-code.png"
}

# The watcher supplies presentation context; a shared daemon's pane is unrelated.
function do_codex_failure() {
  local kind name message sound title="Error"
  kind="$(hook_string kind)"
  case "${kind}" in error | refusal) ;; *) return 1 ;; esac
  EXPLICIT_CONTEXT=true
  unset TMUX TMUX_PANE CLAUDE_PROJECT_DIR
  TMUX_SESSION="$(hook_string tmux_session)"
  TMUX_WINDOW="$(hook_string tmux_window)"
  SESSION_NAME="$(hook_string session_name)"
  SESSION_NAME_READ=true
  if [[ "${NOTIFY_TIER:-}" != untiered ]]; then resolve_tier ""; fi
  sound="$(resolve_sound Funk)"
  compute_place ""
  name="${SESSION_NAME:-$(hook_string session_id)}"
  name="$(truncate_with_ellipsis "${name:-Unknown session}" 70)"
  message="$(hook_string message)"
  if [[ "${kind}" == refusal ]]; then
    title="Refusal"
    message="Turn ended in a safeguard refusal."
  fi
  fire_alerter_detached "$(tier_title "${title}: ${name}")" "$(banner_subtitle)" \
    "$(truncate_with_ellipsis "${message:-Turn ended in an API error.}" "${BODY_LIMIT}")" \
    "${sound}" "${HARNESS}-failure" "${ASSETS_DIR}/codex.png" \
    "thread $(hook_string session_id), turn $(hook_string turn_id)"
}

# An MCP server raises the dialog, so in every tier only a banner announces it.
function do_cc_elicit() {
  local message body
  resolve_tier "$(hook_string transcript_path)"
  message="$(hook_string message)"
  body="$(truncate_with_ellipsis "${message//$'\n'/ }" "${BODY_LIMIT}")"

  fire_alerter_detached \
    "$(tier_title Question)" \
    "$(banner_subtitle)" \
    "${body:-Needs input}" \
    "$(resolve_sound Tink)" \
    "claude-elicit" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_permission() {
  local transcript_path message wanted="" plan=false
  transcript_path="$(hook_string transcript_path)"
  resolve_tier "${transcript_path}"
  message="$(hook_string message)"
  # Only the first line names the prompt; the full message is the body only
  # when no tool preview replaces it.
  local first_line="${message%%$'\n'*}"
  message="${message//$'\n'/ }"

  # Interactive sessions send fixed messages; the SDK names the tool. Other
  # messages, such as sandbox network requests, are shown as is.
  local pending="" lookup=true
  case "${first_line}" in
    *"approval for the plan"*) plan=true ;;
    *"wants to enter plan mode"*) wanted="EnterPlanMode" ;;
    *"permission to use "*)
      wanted="${first_line##*permission to use }"
      wanted="${wanted%.}"
      ;;
    "" | "Claude needs your permission" | "Claude needs your permission.") ;;
    *) lookup=false ;;
  esac
  if [[ "${lookup}" == true ]]; then
    pending="$(get_pending_tool_use "${transcript_path}" "${wanted}" "${plan}")"
  fi

  local name
  name="$(tool_name "${pending}")"
  name="${name:-${wanted}}"

  local body=""
  case "${name}" in
    # The PreToolUse question banner already covers this prompt.
    AskUserQuestion) return 0 ;;
    ExitPlanMode)
      if tier_silences plan; then
        return 0
      fi
      body="$(plan_heading "${pending}")"
      fire_alerter_detached \
        "$(tier_title "Plan ready for review")" \
        "$(banner_subtitle)" \
        "$(truncate_with_ellipsis "${body:-Review the proposed plan}" "${BODY_LIMIT}")" \
        "$(resolve_sound Tink)" \
        "claude-plan" \
        "${ASSETS_DIR}/claude-code.png"
      return 0
      ;;
    *) ;;
  esac

  local title="Needs approval"
  if [[ "${name}" == mcp__*__* ]]; then
    # mcp__<server>__<tool>: the tool names the action; the server goes below.
    local server="${name#mcp__}"
    server="${server%__*}"
    title="Approve ${name##*__}?"
    body="$(truncate_with_ellipsis "${server:+${server} }MCP tool" "${BODY_LIMIT}")"
  elif [[ -n "${name}" ]]; then
    title="Approve ${name}?"
    body="$(tool_preview "${pending}" "${BODY_LIMIT}")"
  fi
  if [[ -z "${body}" ]]; then
    body="$(truncate_with_ellipsis "${message}" "${BODY_LIMIT}")"
  fi

  fire_alerter_detached \
    "$(tier_title "${title}")" \
    "$(banner_subtitle)" \
    "${body:-Needs permission}" \
    "$(resolve_sound Funk)" \
    "claude-permission" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_stop() {
  local icon="${1}" transcript_path reply
  transcript_path="$(hook_string transcript_path)"
  # A skipped turn leaves the completion marker alone.
  turn_started_by_user "${transcript_path}" || return 0
  resolve_tier "${transcript_path}"
  if tier_silences stop; then
    return 0
  fi
  # No Done when the person just answered a tiered session's question or plan.
  if [[ -n "${TIER}" ]] && turn_answered_prompt "${transcript_path}"; then
    return 0
  fi

  # A JSON reply's summary is taken before the cap, which would cut the object.
  reply="$(printf '%s' "${HOOK_INPUT}" | jq -r '
    .last_assistant_message // empty | strings
    | (try fromjson catch null) as $j
    | (if ($j | type) == "object" and ($j.summary | type) == "string" then $j.summary else . end)
    | .[0:20000] | gsub("\u0000"; "")' 2> /dev/null)" || reply=""
  # Only a payload without the field falls back to the transcript; an empty
  # reply stays empty rather than borrowing an earlier message.
  if [[ "${HARNESS}" == claude ]] \
    && [[ "$(printf '%s' "${HOOK_INPUT}" | jq -r 'has("last_assistant_message")' 2> /dev/null)" == false ]]; then
    reply="$(extract_last_assistant_text "${transcript_path}")"
  fi

  local body
  body="$(summarize_reply "${reply}")"

  fire_alerter_detached \
    "$(tier_title Done)" \
    "$(banner_subtitle)" \
    "${body:-Task completed}" \
    "$(resolve_sound Glass)" \
    "${HARNESS}-stop" \
    "${ASSETS_DIR}/${icon}.png"
}

# -----------------------------------------------------------------------------
# Shared handlers
# -----------------------------------------------------------------------------

# Prints the bundle identifier of the host terminal, or fails. tmux 3.2 and
# later set TERM_PROGRAM=tmux in panes, so it then comes from
# __CFBundleIdentifier, else the server's global TERM_PROGRAM. Both date from
# the server's start: a client attached from another terminal names the wrong
# application, and the banner posts.
function host_terminal_bundle() {
  local program="${TERM_PROGRAM:-}"
  if [[ "${program}" == tmux ]]; then
    if [[ -n "${__CFBundleIdentifier:-}" ]]; then
      printf '%s' "${__CFBundleIdentifier}"
      return 0
    fi
    program="$(tmux show-environment -g TERM_PROGRAM 2> /dev/null)" || return 1
    program="${program#TERM_PROGRAM=}"
  fi
  case "${program}" in
    Apple_Terminal) printf '%s' com.apple.Terminal ;;
    iTerm.app) printf '%s' com.googlecode.iterm2 ;;
    ghostty) printf '%s' com.mitchellh.ghostty ;;
    WezTerm) printf '%s' com.github.wez.wezterm ;;
    vscode) printf '%s' com.microsoft.VSCode ;;
    alacritty) printf '%s' org.alacritty ;;
    *) return 1 ;;
  esac
}

# Only suppress completion when both the host application and exact pane
# are visible. Unknown application or tmux state preserves notification delivery.
function originating_pane_visible() {
  [[ -n "${TMUX_PANE:-}" && -n "${TMUX:-}" ]] || return 1
  local bundle front clients
  bundle="$(host_terminal_bundle)" || return 1
  front="$(osascript -l JavaScript -e 'ObjC.import("AppKit"); ObjC.unwrap($.NSWorkspace.sharedWorkspace.frontmostApplication.bundleIdentifier)' 2> /dev/null)" || return 1
  [[ "${front}" == "${bundle}" ]] || return 1
  clients="$(tmux list-clients -F '#{pane_id}|#{client_flags}' 2> /dev/null)" || return 1
  local visible flags
  while IFS='|' read -r visible flags; do
    [[ "${visible}" == "${TMUX_PANE}" && ",${flags}," == *,focused,* ]] && return 0
  done <<< "${clients}"
  return 1
}

# Shows the first question; the title counts them when there are several.
# Unexpected tool_input shapes fall back to "Needs input".
function do_question() {
  local icon="${1}" questions count first
  resolve_tier "$(hook_string transcript_path)"
  if tier_silences question; then
    return 0
  fi
  questions="$(printf '%s' "${HOOK_INPUT}" | jq -c '
    (.tool_input // {}) as $input
    | (if ($input | type) == "string" then ($input | fromjson? // {}) else $input end)
    | (if type == "object" then .questions else null end) as $q
    | [($q | if type == "array" then .[] else empty end) | objects | .question | strings | gsub("\n"; " ")]
  ' 2> /dev/null)" || questions='[]'
  count="$(printf '%s' "${questions}" | jq -r 'length' 2> /dev/null)" || count=0
  [[ "${count}" =~ ^[0-9]+$ ]] || count=0
  first="$(printf '%s' "${questions}" | jq -r '.[0] // empty' 2> /dev/null)" || first=""

  local title="Question" suffix="" body
  if [[ "${count}" -gt 1 ]]; then
    title="${count} questions"
    suffix=" (+$((count - 1)) more)"
  fi
  body="$(truncate_with_ellipsis "${first:-Needs input}" "$((BODY_LIMIT - ${#suffix}))")${suffix}"

  fire_alerter_detached "$(tier_title "${title}")" "$(banner_subtitle)" "${body}" \
    "$(resolve_sound Tink)" "${HARNESS}-question" "${ASSETS_DIR}/${icon}.png"
}

# Prints the tier, subtitle and sounds the hooks would use in this pane. The
# session name comes from transcript $1, else from the transcript of
# $CLAUDE_CODE_SESSION_ID, which a `!` command in Claude Code inherits. Fails on
# a tiers file or transcript it cannot read or find, which the hooks pass over.
function do_explain() {
  local transcript_path="${1}" projects_dir candidate
  HARNESS="claude"
  if [[ -e "${TIERS_FILE}" && ! (-f "${TIERS_FILE}" && -r "${TIERS_FILE}") ]]; then
    echo "Error: cannot read the tiers file ${TIERS_FILE}; check that it is a readable file." >&2
    return 1
  fi
  if [[ -n "${transcript_path}" && ! (-f "${transcript_path}" && -r "${transcript_path}") ]]; then
    echo "Error: cannot read the transcript ${transcript_path}." >&2
    return 1
  fi
  if [[ -z "${transcript_path}" && -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
    projects_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/projects"
    # The pattern keeps the ID from adding path segments or glob characters.
    if [[ "${CLAUDE_CODE_SESSION_ID}" =~ ^[A-Za-z0-9-]+$ ]]; then
      for candidate in "${projects_dir}/"*"/${CLAUDE_CODE_SESSION_ID}.jsonl"; do
        if [[ -f "${candidate}" && -r "${candidate}" ]]; then
          transcript_path="${candidate}"
          break
        fi
      done
    fi
    if [[ -z "${transcript_path}" ]]; then
      echo "Error: found no readable transcript for session ${CLAUDE_CODE_SESSION_ID} in ${projects_dir}." >&2
      return 1
    fi
  fi
  resolve_tier "${transcript_path}"
  read_session_name "${transcript_path}"
  printf 'tier: %s\n' "${TIER:-untiered}"
  printf 'rule: %s\n' "${TIER_RULE:-none}"
  printf 'name: %s\n' "${SESSION_NAME:-none}"
  printf 'subtitle: %s\n' "$(banner_subtitle)"
  printf 'sounds: stop %s, permission %s, attention %s\n' \
    "$(resolve_sound Glass)" "$(resolve_sound Funk)" "$(resolve_sound Tink)"
}

# -----------------------------------------------------------------------------
# Dispatcher
# -----------------------------------------------------------------------------

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi
  if [[ "${1:-}" == explain ]]; then
    do_explain "${2:-}"
    exit
  fi

  HOOK_INPUT="$(cat)"
  # Subagent payloads carry agent_id; ignore them so they neither post a banner
  # nor reset the completion marker.
  if [[ -n "$(printf '%s' "${HOOK_INPUT}" | jq -r '.agent_id // empty' 2> /dev/null)" ]]; then
    return 0
  fi
  HARNESS="claude"
  [[ "${1:-}" == codex-* ]] && HARNESS="codex"
  local session_id
  session_id="$(printf '%s' "${HOOK_INPUT}" | jq -r '.session_id // .sessionId // empty' 2> /dev/null)" || session_id=""
  SESSION_KEY="$(printf '%s' "${HARNESS}|${session_id}|${TMUX:-}|${TMUX_PANE:-}|${PWD}" | shasum -a 256 | cut -d ' ' -f 1)"
  STATE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/agent-harness-notify/${SESSION_KEY}"
  mkdir -p "${STATE_DIR}"

  case "${1:-}" in
    cc-turn-start | codex-turn-start) rmdir "${STATE_DIR}/completed" 2> /dev/null || true ;;
    cc-question) do_question "claude-code" ;;
    codex-question) do_question "codex" ;;
    cc-elicit) do_cc_elicit ;;
    cc-permission) do_cc_permission ;;
    cc-stop) do_stop "claude-code" ;;
    cc-failure) do_cc_failure ;;
    codex-failure) do_codex_failure ;;
    codex-stop) do_stop "codex" ;;
    "")
      echo "Error: subcommand required" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Error: unknown subcommand: ${1}" >&2
      echo "Use '${SCRIPT_NAME} --help' to see available subcommands." >&2
      exit 1
      ;;
  esac
}

main "$@"
