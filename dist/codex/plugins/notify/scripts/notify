#!/usr/bin/env bash
# Sends macOS notifications via alerter for Claude Code and Codex CLI hooks.
# OpenCode has its own TypeScript implementation under ../opencode/.
#
# Each hook event is a subcommand; reads the hook's JSON payload from stdin
# and shells out to alerter with per-event title, subtitle, body, sound, group,
# and per-harness icon. Titles name the action; the icon names the harness.
# Events fire detached so the harness is not blocked on user interaction.
#
# Must parse under macOS /bin/bash 3.2, what `env bash` finds without Homebrew.
# A syntax error exits 2, and Claude Code treats exit 2 as blocking the event.
set -euo pipefail

SCRIPT_NAME="$(basename "${0}")"
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
ASSETS_DIR="${SCRIPT_DIR}/../assets"
FOCUS_SCRIPT="${SCRIPT_DIR}/focus-pane"
readonly SCRIPT_NAME SCRIPT_DIR ASSETS_DIR FOCUS_SCRIPT

# Body length budget: a banner shows about two lines, an expanded alert about four.
readonly BODY_LIMIT=140

# Detached fire-and-forget timeout (24h).
readonly FIRE_TIMEOUT=86400

# Reduces a reply to plain prose for a banner body; ../opencode/index.ts
# mirrors it in summarizeReply. Lengths count Unicode code points.
# - Input past 20,000 characters is ignored.
# - A JSON object reply with a string `summary` is summarized from that field.
# - Headings, list items and paragraphs become separate sentences, joined by a
#   period when one lacks closing punctuation.
# - Prose wins. Without prose, status lines (a leading ▸, or two or more " · "
#   separators) are used; without either, the first code or table line is.
#   An unclosed fence is read as prose.
# - Whole sentences are kept in order within $limit. A sentence that no longer
#   fits is cut at a word boundary with "…" when it is the first sentence or at
#   least 40 characters remain; otherwise it and every later sentence are
#   dropped.
# Read with `read -d ''` because bash 3.2 cannot parse this heredoc inside $().
IFS= read -r -d '' SUMMARY_JQ << 'JQ' || true
def cut($n):
  if length <= $n then .
  elif $n < 1 then ""
  else .[0:$n - 1] as $head
    | (if (.[$n - 1:$n] | test("^\\s")) or ($head | test("\\s") | not) then $head
       else $head | sub("\\s+\\S*$"; "") end)
    | sub("\\s+$"; "") + "…" end;
def inline:
  gsub("\\[(?<t>[^\\]]*)\\]\\([^)]*\\)"; "\(.t)")
  | gsub("\\*\\*|__|`"; "")
  | gsub("(?<![\\p{L}\\p{N}_*])\\*(?<t>[^*\\s][^*]*)\\*"; "\(.t)")
  | sub("^\\s*(#{1,6}|[-*+>▸•]|[0-9]+\\.)\\s+"; "");
def is_status: test("^\\s*▸") or ([scan(" · ")] | length) >= 2;
def is_table_rule: test("^[\\s|:-]+$");
def flush:
  if .cur != "" then .out += [{t: .cur, k: "prose"}] | .cur = "" else . end;
def units_of($lines):
  (reduce range(0; $lines | length) as $i ({fence: -1, mark: 0, cur: "", out: []};
    $lines[$i] as $l
    | if ($l | test("^\\s*(```|~~~)")) then
        flush | (if .fence < 0 then .fence = $i | .mark = (.out | length) else .fence = -1 end)
      elif .fence >= 0 then .out += [{t: $l, k: "code"}]
      elif ($l | test("^\\s*\\|")) then
        (if ($l | is_table_rule) then .
         else flush | .out += [{t: ($l | gsub("^\\s*\\||\\|\\s*$"; "") | gsub("\\s*\\|\\s*"; " · ")), k: "code"}] end)
      elif ($l | test("^\\s*$")) then flush
      elif ($l | is_status) then flush | .out += [{t: ($l | inline), k: "status"}]
      elif ($l | test("^\\s*(#{1,6}|[-*+>•]|[0-9]+\\.)\\s")) then flush | .cur = ($l | inline)
      else .cur = ((.cur + " " + ($l | inline)) | ltrimstr(" ")) end)) as $r
  | if $r.fence >= 0 then $r.out[0:$r.mark] + units_of($lines[$r.fence + 1:])
    else ($r | flush | .out) end;
def units:
  .[0:20000] | split("\n") as $lines
  | units_of($lines)
  | map(.t |= (gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ")) | select(.t != ""));
def sentences:
  units
  | (if any(.[]; .k == "prose") then map(select(.k == "prose"))
     elif any(.[]; .k == "status") then map(select(.k == "status"))
     else .[0:1] end)
  | length as $n
  | to_entries
  | map(.key as $i | .value.t
      | (if $i < $n - 1 and (test("[.!?:]$") | not) then . + "." else . end)
      | [scan("(?:[^.!?]|[.!?]+(?!\\s|$))+(?:[.!?]+(?=\\s|$))?") | ltrimstr(" ") | select(length > 0)])
  | add // [];
def summary($limit):
  sentences
  | reduce .[] as $x ({t: "", done: false};
      if .done then .
      else (if .t == "" then 0 else 1 end) as $sep
        | ($limit - (.t | length) - $sep) as $room
        | (if $sep == 1 then " " else "" end) as $gap
        | if ($x | length) <= $room then .t += $gap + $x
          elif .t == "" or $room >= 40 then .t += $gap + ($x | cut($room)) | .done = true
          else .done = true end
      end)
  | .t;
(try fromjson catch null) as $j
| (if ($j | type) == "object" and ($j.summary | type) == "string" then $j.summary else . end)
| summary($limit)
JQ
readonly SUMMARY_JQ

function usage() {
  cat << 'USAGE_TEXT'
Usage: notify <subcommand>

Subcommands:
  cc-elicit         Claude Code Notification:elicitation_dialog
  cc-permission     Claude Code Notification:permission_prompt
  cc-question       Claude Code PreToolUse:AskUserQuestion
  cc-stop           Claude Code Stop
  cc-turn-start     Claude Code UserPromptSubmit (resets completion deduplication)
  codex-question    Codex PreToolUse:request_user_input
  codex-stop        Codex Stop
  codex-turn-start  Codex UserPromptSubmit (resets completion deduplication)

Each subcommand reads its hook payload as JSON on stdin.
USAGE_TEXT
}

# -----------------------------------------------------------------------------
# Generic helpers
# -----------------------------------------------------------------------------

# Truncation runs in jq so lengths count characters whatever the hook's locale.
function truncate_with_ellipsis() {
  printf '%s' "${1}" | jq -Rrs --argjson n "${2:-80}" \
    'if length <= $n then . elif $n < 1 then "" else .[0:$n - 1] + "…" end' 2> /dev/null || true
}

# Keeps the end of the text, so a long path still shows its file name.
function truncate_from_left() {
  printf '%s' "${1}" | jq -Rrs --argjson n "${2}" \
    'if length <= $n then . elif $n < 1 then "" else "…" + .[length - $n + 1:] end' 2> /dev/null || true
}

function summarize_reply() {
  printf '%s' "${1}" | jq -Rrs --argjson limit "${2:-${BODY_LIMIT}}" "${SUMMARY_JQ}" 2> /dev/null || true
}

# Prints the hook payload's string field $1 without NUL bytes, or nothing.
function hook_string() {
  printf '%s' "${HOOK_INPUT}" | jq -r --arg key "${1}" '.[$key] // empty | strings | gsub("\u0000"; "")' 2> /dev/null || true
}

function repo_root() {
  local root
  root="$(git rev-parse --show-toplevel 2> /dev/null)" || root=""
  printf '%s' "${root:-${PWD}}"
}

# Names the repository rather than the worktree folder: worktrees share the
# primary checkout's git directory, so its parent names the repository.
function repo_name() {
  local common name
  common="$(git rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || common=""
  if [[ -z "${common}" ]]; then
    basename "${PWD}"
    return
  fi
  name="$(basename "${common}")"
  case "${name}" in
    .git | .bare) name="$(basename "$(dirname "${common}")")" ;;
    *.git) name="${name%.git}" ;;
    *) ;;
  esac
  printf '%s' "${name}"
}

function compute_branch_suffix() {
  local branch
  branch="$(git branch --show-current 2> /dev/null)" || branch=""
  branch="${branch:-unknown}"
  if [[ "${branch}" == */* ]]; then
    branch="${branch#*/}"
  fi
  printf '%s' "${branch}"
}

# Prints the tmux pane title without leading status glyphs such as Claude
# Code's ✳ or spinner frames, or nothing when the title names no task.
function compute_pane_title() {
  local repo="${1}"
  if [[ -z "${TMUX_PANE:-}" ]]; then
    return 0
  fi
  local title
  title="$(tmux display-message -t "${TMUX_PANE}" -p '#T' 2> /dev/null)" || return 0
  title="$(printf '%s' "${title}" | jq -Rr 'sub("^[^\\p{L}\\p{N}#(\\[]+"; "") | sub("\\s+$"; "")' 2> /dev/null)" || return 0
  local cwd_basename
  cwd_basename="$(basename "${PWD}")"
  case "${title}" in
    "" | "${cwd_basename}" | "${repo}" | zsh | bash | fish | sh | tmux | ssh | nvim | vim | "-zsh" | "-bash") return 0 ;;
    "Claude Code" | Codex | OpenCode) return 0 ;;
    *) ;;
  esac
  # A shell's default user@host:path title names no task.
  if [[ "${title}" =~ ^[^[:space:]@]+@[^[:space:]:]+: ]]; then
    return 0
  fi
  printf '%s' "${title}"
}

function compute_subtitle() {
  local repo task
  repo="$(repo_name)"
  task="$(compute_pane_title "${repo}")"
  if [[ -z "${task}" ]]; then
    task="$(compute_branch_suffix)"
  fi
  printf '%s · %s' "${repo}" "${task}"
}

function compute_tmux_state() {
  if [[ -z "${TMUX_PANE:-}" ]]; then
    return 0
  fi
  tmux display-message -t "${TMUX_PANE}" -p '#{session_id}|#{window_id}|#{pane_id}' 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Transcript extractors (Claude Code JSONL)
# -----------------------------------------------------------------------------

# Each extractor reads a transcript in one jq pass, scanning lines backward from
# the end until the current turn's user prompt, so an earlier turn is never
# consulted. Records are classified as:
# - "prompt": a user message that is not a tool result, a meta record (such as
#   a skill expansion or system reminder) or local-command output. A
#   slash-command invocation (`<command-message>…`) starts a turn, so it is a
#   prompt;
# - "result": a user record carrying tool results;
# - "assistant", and "other" for everything else.
# Read with `read -d ''` because bash 3.2 cannot parse these heredocs inside $().
IFS= read -r -d '' TURN_JQ << 'JQ' || true
def content: (.message | objects | .content) // "";
def kind:
  content as $c
  | if .type == "assistant" then "assistant"
    elif .type == "user" and .isMeta != true then
      (if ($c | type) == "array" and any($c[]?; type == "object" and .type == "tool_result") then "result"
       elif ($c | type) == "string" and ($c | test("^<local-")) then "other"
       else "prompt" end)
    else "other" end;
def turn:
  [inputs] as $lines
  | [label $out | range(($lines | length) - 1; -1; -1) as $i
      | ($lines[$i] | fromjson? // null) | objects
      | if kind == "prompt" then break $out else . end];
def blocks: content | if type == "array" then .[] | objects else empty end;
JQ
readonly TURN_JQ

# Prints the text of the current turn's last assistant message, or nothing.
IFS= read -r -d '' LAST_TEXT_JQ << 'JQ' || true
first(turn[] | select(kind == "assistant")
  | (if (content | type) == "string" then content
     else [blocks | select(.type == "text") | .text | strings] | join("\n") end)
  | select(. != "")) // empty
| gsub("\u0000"; "")
JQ
readonly LAST_TEXT_JQ

# Prints {name, input} for the tool call a permission prompt is about, or
# nothing. Candidates are the current turn's tool_use blocks without a
# tool_result yet, oldest first, since Claude Code asks about parallel calls in
# order. The selection depends on what the prompt's message says:
# - $plan (the plan-approval message): the newest ExitPlanMode call, or a bare
#   ExitPlanMode when the call is not in the transcript yet;
# - $wanted (a tool named in the message): the oldest call with that name, or
#   for an MCP display name such as "github - create_issue (MCP)" or
#   "Create Issue", the oldest MCP call matching it by server and tool, then by
#   tool, then by a tool name the display name ends with;
# - neither (the generic message): the oldest call that is not a question or a
#   plan, then a plan, then a question.
IFS= read -r -d '' PENDING_JQ << 'JQ' || true
def norm: ascii_downcase | gsub("[^a-z0-9]"; "");
def mcp_full: ltrimstr("mcp__") | norm;
def mcp_tool: split("__") | last | norm;
# Keeps only the string fields previews read, capped, and a plan's first
# heading, so a large Write never passes through the shell.
def preview_input:
  .input | if type == "object" then
    {command, file_path, notebook_path, url, pattern, description,
     plan: ((.plan | strings | split("\n") | map(select(test("^#{1,6}\\s"))) | first) // null)}
    | with_entries(select(.value | type == "string") | .value |= .[0:4096])
  else {} end;
turn
| ([.[] | select(kind == "result") | blocks | select(.type == "tool_result")
    | .tool_use_id | strings | {(.): true}] | add // {}) as $answered
| [reverse[] | select(kind == "assistant") | blocks | select(.type == "tool_use")
    | select($answered[.id // "" | tostring] != true)
    | {name: (.name // "" | tostring), input: preview_input}] as $calls
| [$calls[] | select(.name | startswith("mcp__"))] as $mcp
| ($wanted | sub("\\s*\\(MCP\\)\\s*$"; "") | norm) as $short
| if $plan then
    ([$calls[] | select(.name == "ExitPlanMode")] | last) // {name: "ExitPlanMode", input: {}}
  elif $wanted != "" then
    first($calls[] | select(.name == $wanted))
    // (if $short == "" then empty
        else first($mcp[] | select((.name | mcp_full) == $short))
          // first($mcp[] | select((.name | mcp_tool) == $short))
          // first($mcp[] | select((.name | mcp_tool) as $tool | $tool != "" and ($short | endswith($tool))))
        end)
    // empty
  else
    first($calls[] | select(.name != "AskUserQuestion" and .name != "ExitPlanMode"))
    // first($calls[] | select(.name == "ExitPlanMode"))
    // first($calls[] | select(.name == "AskUserQuestion"))
    // empty
  end
JQ
readonly PENDING_JQ

function extract_last_assistant_text() {
  local transcript_path="${1}"
  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi
  jq -Rnr "${TURN_JQ} ${LAST_TEXT_JQ}" 2> /dev/null < "${transcript_path}" || true
}

# $2 is the tool named by the prompt's message; $3 is "true" for the plan
# approval message. See PENDING_JQ.
function get_pending_tool_use() {
  local transcript_path="${1}"
  if [[ -z "${transcript_path}" || ! -f "${transcript_path}" ]]; then
    return 0
  fi
  jq -Rnc --arg wanted "${2:-}" --argjson plan "${3:-false}" "${TURN_JQ} ${PENDING_JQ}" 2> /dev/null < "${transcript_path}" || true
}

# -----------------------------------------------------------------------------
# Tool preview formatting
# -----------------------------------------------------------------------------

function tool_name() {
  local tool_json="${1}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi
  printf '%s' "${tool_json}" | jq -r '.name // empty' 2> /dev/null || true
}

# Shows a path relative to the repository root, or under ~, keeping its end.
# git resolves symlinks in the root, so the logical working directory is
# tried too.
function display_path() {
  local path="${1}"
  local limit="${2}"
  local base
  for base in "$(repo_root)" "${PWD}"; do
    if [[ "${path}" == "${base}/"* ]]; then
      truncate_from_left "${path#"${base}/"}" "${limit}"
      return
    fi
  done
  if [[ "${path}" == "${HOME}/"* ]]; then
    path='~'"/${path#"${HOME}/"}"
  fi
  truncate_from_left "${path}" "${limit}"
}

# Drops a leading cd into the working directory or repository root.
function strip_working_cd() {
  local command="${1}"
  local dir prefix
  for dir in "${PWD}" "$(repo_root)"; do
    for prefix in "cd ${dir} && " "cd ${dir}; " "cd \"${dir}\" && " "cd \"${dir}\"; " "cd '${dir}' && " "cd '${dir}'; "; do
      if [[ "${command}" == "${prefix}"* ]]; then
        printf '%s' "${command#"${prefix}"}"
        return
      fi
    done
  done
  printf '%s' "${command}"
}

# Prints a one-line preview of a tool's input. MCP tools and tools without a
# known preview field print nothing.
function tool_preview() {
  local tool_json="${1}"
  local limit="${2:-${BODY_LIMIT}}"
  if [[ -z "${tool_json}" ]]; then
    return 0
  fi

  local name
  name="$(tool_name "${tool_json}")"
  local field=""
  case "${name}" in
    Bash) field='.input.command' ;;
    Edit | Write | Read | NotebookEdit) field='.input.file_path // .input.notebook_path' ;;
    WebFetch) field='.input.url' ;;
    Grep | Glob) field='.input.pattern' ;;
    Task | Agent) field='.input.description' ;;
    *) return 0 ;;
  esac
  local preview
  preview="$(printf '%s' "${tool_json}" | jq -r "(${field}) // empty | strings" 2> /dev/null)" || preview=""
  if [[ -z "${preview}" ]]; then
    return 0
  fi

  case "${name}" in
    Edit | Write | Read | NotebookEdit)
      display_path "${preview}" "${limit}"
      return 0
      ;;
    Bash) preview="$(strip_working_cd "${preview}")" ;;
    *) ;;
  esac
  # Collapse newlines so the body stays single-line in the alert.
  truncate_with_ellipsis "${preview//$'\n'/ }" "${limit}"
}

# Prints the plan's first heading without Markdown, for ExitPlanMode prompts.
function plan_heading() {
  printf '%s' "${1}" | jq -r '
    (.input.plan // "") | strings | split("\n")
    | map(select(test("^#{1,6}\\s"))) | first // ""
    | sub("^#{1,6}\\s+"; "") | gsub("\\*\\*|`"; "")
  ' 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# alerter dispatch
# -----------------------------------------------------------------------------

# Fires alerter in a detached subshell that routes a body click to focus-pane,
# so the harness is not blocked on user interaction. Groups are suffixed with
# the session key. Stop groups fire once per turn (an atomic mkdir marker) and
# are skipped while the originating pane is visible. An empty sound omits
# --sound, so the notification is silent.
function fire_alerter_detached() {
  local title="${1}" subtitle="${2}" message="${3}"
  local sound="${4}" group="${5}" icon="${6}"

  local tmux_state session="" window="" pane=""
  tmux_state="$(compute_tmux_state)"
  if [[ -n "${tmux_state}" ]]; then
    IFS='|' read -r session window pane <<< "${tmux_state}"
  fi
  local term_program="${TERM_PROGRAM:-}"
  group="${group}-${SESSION_KEY}"
  if [[ "${group}" == *-stop-* ]]; then
    # mkdir is atomic, including when concurrent Stop hooks arrive.
    if ! mkdir "${STATE_DIR}/completed" 2> /dev/null; then
      return 0
    fi
    if originating_pane_visible; then
      return 0
    fi
  fi

  local sound_args=()
  if [[ -n "${sound}" ]]; then
    sound_args=(--sound "${sound}")
  fi

  (
    local result
    result="$(alerter \
      --title "${title}" \
      --subtitle "${subtitle}" \
      --message "${message}" \
      ${sound_args[@]+"${sound_args[@]}"} \
      --group "${group}" \
      --app-icon "${icon}" \
      --timeout "${FIRE_TIMEOUT}" \
      2> /dev/null)" || true
    case "${result}" in
      *@CONTENTCLICKED*)
        "${FOCUS_SCRIPT}" \
          "${term_program}" \
          "${session}" \
          "${window}" \
          "${pane}" \
          > /dev/null 2>&1 || true
        ;;
      *) ;;
    esac
  ) > /dev/null 2>&1 < /dev/null &
  # Best-effort detach. In non-interactive shells without job control,
  # `disown` can fail; under `set -e` that would abort the hook and skip
  # the notification. The background subshell is already detached via the
  # redirections above, so swallowing this error is safe.
  disown 2> /dev/null || true
}

# -----------------------------------------------------------------------------
# Claude Code event handlers
# -----------------------------------------------------------------------------

function do_cc_elicit() {
  local message body
  message="$(hook_string message)"
  body="$(truncate_with_ellipsis "${message//$'\n'/ }" "${BODY_LIMIT}")"

  fire_alerter_detached \
    "Question" \
    "$(compute_subtitle)" \
    "${body:-Needs input}" \
    "Tink" \
    "claude-elicit" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_cc_permission() {
  local transcript_path message wanted="" plan=false
  transcript_path="$(hook_string transcript_path)"
  message="$(hook_string message)"
  # Only the first line names the prompt; the full message is the body only
  # when no tool preview replaces it.
  local first_line="${message%%$'\n'*}"
  message="${message//$'\n'/ }"

  # Interactive sessions send fixed messages; the SDK names the tool. Other
  # messages, such as sandbox network requests, are shown as is.
  local pending="" lookup=true
  case "${first_line}" in
    *"approval for the plan"*) plan=true ;;
    *"wants to enter plan mode"*) wanted="EnterPlanMode" ;;
    *"permission to use "*)
      wanted="${first_line##*permission to use }"
      wanted="${wanted%.}"
      ;;
    "" | "Claude needs your permission" | "Claude needs your permission.") ;;
    *) lookup=false ;;
  esac
  if [[ "${lookup}" == true ]]; then
    pending="$(get_pending_tool_use "${transcript_path}" "${wanted}" "${plan}")"
  fi

  local name
  name="$(tool_name "${pending}")"
  name="${name:-${wanted}}"

  local body=""
  case "${name}" in
    # The PreToolUse question banner already covers this prompt.
    AskUserQuestion) return 0 ;;
    ExitPlanMode)
      body="$(plan_heading "${pending}")"
      fire_alerter_detached \
        "Plan ready for review" \
        "$(compute_subtitle)" \
        "$(truncate_with_ellipsis "${body:-Review the proposed plan}" "${BODY_LIMIT}")" \
        "Tink" \
        "claude-plan" \
        "${ASSETS_DIR}/claude-code.png"
      return 0
      ;;
    *) ;;
  esac

  local title="Needs approval"
  if [[ "${name}" == mcp__*__* ]]; then
    # mcp__<server>__<tool>: the tool names the action; the server goes below.
    local server="${name#mcp__}"
    server="${server%__*}"
    title="Approve ${name##*__}?"
    body="${server:+${server} }MCP tool"
  elif [[ -n "${name}" ]]; then
    title="Approve ${name}?"
    body="$(tool_preview "${pending}" "${BODY_LIMIT}")"
  fi
  if [[ -z "${body}" ]]; then
    body="$(truncate_with_ellipsis "${message}" "${BODY_LIMIT}")"
  fi

  fire_alerter_detached \
    "${title}" \
    "$(compute_subtitle)" \
    "${body:-Needs permission}" \
    "Funk" \
    "claude-permission" \
    "${ASSETS_DIR}/claude-code.png"
}

function do_stop() {
  local icon="${1}"
  local reply
  reply="$(printf '%s' "${HOOK_INPUT}" | jq -r '.last_assistant_message // empty | strings | .[0:20000] | gsub("\u0000"; "")' 2> /dev/null)" || reply=""
  # Only a payload without the field falls back to the transcript; an empty
  # reply stays empty rather than borrowing an earlier message.
  if [[ "${HARNESS}" == claude ]] \
    && [[ "$(printf '%s' "${HOOK_INPUT}" | jq -r 'has("last_assistant_message")' 2> /dev/null)" == false ]]; then
    local transcript_path
    transcript_path="$(hook_string transcript_path)"
    reply="$(extract_last_assistant_text "${transcript_path}")"
  fi

  local body
  body="$(summarize_reply "${reply}")"

  fire_alerter_detached \
    "Done" \
    "$(compute_subtitle)" \
    "${body:-Task completed}" \
    "Glass" \
    "${HARNESS}-stop" \
    "${ASSETS_DIR}/${icon}.png"
}

# -----------------------------------------------------------------------------
# Shared handlers
# -----------------------------------------------------------------------------

# Only suppress completion when both the host application and exact pane
# are visible. Unknown application or tmux state preserves notification delivery.
function originating_pane_visible() {
  [[ -n "${TMUX_PANE:-}" && -n "${TMUX:-}" ]] || return 1
  case "${TERM_PROGRAM:-}" in
    Apple_Terminal | iTerm.app | ghostty | WezTerm | vscode | alacritty) ;;
    *) return 1 ;;
  esac
  local bundle front clients
  bundle="$("${FOCUS_SCRIPT}" --bundle-id "${TERM_PROGRAM:-}")" || return 1
  front="$(osascript -l JavaScript -e 'ObjC.import("AppKit"); ObjC.unwrap($.NSWorkspace.sharedWorkspace.frontmostApplication.bundleIdentifier)' 2> /dev/null)" || return 1
  [[ "${front}" == "${bundle}" ]] || return 1
  clients="$(tmux list-clients -F '#{pane_id}|#{client_flags}' 2> /dev/null)" || return 1
  local visible flags
  while IFS='|' read -r visible flags; do
    [[ "${visible}" == "${TMUX_PANE}" && ",${flags}," == *,focused,* ]] && return 0
  done <<< "${clients}"
  return 1
}

# Shows the first question; the title counts them when there are several.
# Unexpected tool_input shapes fall back to "Needs input".
function do_question() {
  local icon="${1}" questions count first
  questions="$(printf '%s' "${HOOK_INPUT}" | jq -c '
    (.tool_input // {}) as $input
    | (if ($input | type) == "string" then ($input | fromjson? // {}) else $input end)
    | (if type == "object" then .questions else null end) as $q
    | [($q | if type == "array" then .[] else empty end) | objects | .question | strings | gsub("\n"; " ")]
  ' 2> /dev/null)" || questions='[]'
  count="$(printf '%s' "${questions}" | jq -r 'length' 2> /dev/null)" || count=0
  [[ "${count}" =~ ^[0-9]+$ ]] || count=0
  first="$(printf '%s' "${questions}" | jq -r '.[0] // empty' 2> /dev/null)" || first=""

  local title="Question" suffix="" body
  if [[ "${count}" -gt 1 ]]; then
    title="${count} questions"
    suffix=" (+$((count - 1)) more)"
  fi
  body="$(truncate_with_ellipsis "${first:-Needs input}" "$((BODY_LIMIT - ${#suffix}))")${suffix}"

  fire_alerter_detached "${title}" "$(compute_subtitle)" "${body}" \
    "Tink" "${HARNESS}-question" "${ASSETS_DIR}/${icon}.png"
}

# -----------------------------------------------------------------------------
# Dispatcher
# -----------------------------------------------------------------------------

function main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
  fi

  HOOK_INPUT="$(cat)"
  # Subagent payloads carry agent_id; ignore them so they neither post a banner
  # nor reset the completion marker.
  if [[ -n "$(printf '%s' "${HOOK_INPUT}" | jq -r '.agent_id // empty' 2> /dev/null)" ]]; then
    return 0
  fi
  HARNESS="claude"
  [[ "${1:-}" == codex-* ]] && HARNESS="codex"
  local session_id
  session_id="$(printf '%s' "${HOOK_INPUT}" | jq -r '.session_id // .sessionId // empty' 2> /dev/null)" || session_id=""
  SESSION_KEY="$(printf '%s' "${HARNESS}|${session_id}|${TMUX:-}|${TMUX_PANE:-}|${PWD}" | shasum -a 256 | cut -d ' ' -f 1)"
  STATE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/agent-harness-notify/${SESSION_KEY}"
  mkdir -p "${STATE_DIR}"

  case "${1:-}" in
    cc-turn-start | codex-turn-start) rmdir "${STATE_DIR}/completed" 2> /dev/null || true ;;
    cc-question) do_question "claude-code" ;;
    codex-question) do_question "codex" ;;
    cc-elicit) do_cc_elicit ;;
    cc-permission) do_cc_permission ;;
    cc-stop) do_stop "claude-code" ;;
    codex-stop) do_stop "codex" ;;
    "")
      echo "Error: subcommand required" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "Error: unknown subcommand: ${1}" >&2
      echo "Use '${SCRIPT_NAME} --help' to see available subcommands." >&2
      exit 1
      ;;
  esac
}

main "$@"
