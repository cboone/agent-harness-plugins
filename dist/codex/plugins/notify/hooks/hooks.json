{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify cc-idle",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify cc-elicit",
            "type": "command"
          }
        ],
        "matcher": "elicitation_dialog"
      },
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify cc-permission",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify cc-compact",
            "type": "command"
          }
        ],
        "matcher": "auto"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify cc-stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
