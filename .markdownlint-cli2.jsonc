{
  // https://github.com/DavidAnson/markdownlint-cli2#markdownlint-cli2jsonc
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",

  "config": {
    "extends": ".markdownlint.jsonc",
  },

  "ignores": [".workmux/", "node_modules/"],

  // customRules are in cli.markdownlint-cli2.jsonc, loaded via --config in
  // package.json scripts. They cannot live here because the VSCode
  // markdownlint extension fails to import ESM custom rule packages.
  // https://github.com/DavidAnson/vscode-markdownlint/issues/349
}
